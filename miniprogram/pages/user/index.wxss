.user-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 28rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  padding-left: 28rpx;
  overflow: hidden;
  background: #075aa7;
}

.page-content {
  position: relative;
  z-index: 1;
}

.profile-status-mask {
  position: fixed;
  z-index: 2;
  top: 0;
  right: 0;
  left: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(7, 64, 132, 0.98) 0%, rgba(7, 90, 167, 0.94) 82%, rgba(7, 90, 167, 0) 100%);
  transform: translateZ(0);
  will-change: opacity;
}

.profile-header {
  position: relative;
  min-height: 108rpx;
  padding: 14rpx 8rpx 16rpx;
  color: #fff8ee;
}

.profile-eyebrow {
  color: rgba(255, 248, 238, 0.78);
  font-size: 24rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

.profile-title {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 780;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.profile-sprout {
  position: absolute;
  right: 18rpx;
  bottom: 20rpx;
  width: 88rpx;
  height: 50rpx;
  opacity: 0.85;
  transform: rotate(-8deg);
}

.sprout-leaf {
  position: absolute;
  width: 24rpx;
  height: 12rpx;
  background: #86af43;
  border: 2rpx solid rgba(255, 248, 238, 0.5);
  border-radius: 100% 0 100% 0;
}

.sprout-leaf--left { left: 8rpx; top: 12rpx; transform: rotate(18deg); }
.sprout-leaf--right { left: 34rpx; top: 2rpx; transform: rotate(-20deg) scaleX(-1); }
.sprout-dot { position: absolute; right: 3rpx; bottom: 6rpx; width: 15rpx; height: 15rpx; background: #e9aa33; border-radius: 50%; }

.paper-card {
  background: #fff8ee;
  border: 3rpx solid rgba(255, 235, 197, 0.92);
  border-radius: 29rpx 25rpx 31rpx 27rpx;
  box-shadow: 0 9rpx 0 rgba(4, 48, 104, 0.2), 0 18rpx 30rpx rgba(3, 41, 91, 0.18);
  transform: translateZ(0);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.paper-card--pressed,
.paper-button--pressed {
  opacity: 0.92;
  transform: translateY(3rpx) scale(0.988);
}

.profile-card {
  padding: 22rpx 22rpx 8rpx;
}

.profile-summary,
.profile-metrics,
.metric-item,
.profile-edit,
.task-card,
.task-action,
.list-tabs,
.demo-heading,
.persona-row,
.loading-card {
  display: flex;
  align-items: center;
}

.profile-summary {
  min-height: 116rpx;
  border-radius: 20rpx;
  transition: opacity 100ms ease;
}

.profile-summary--pressed { opacity: 0.72; }

.profile-avatar-shell {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  padding: 3rpx;
  overflow: hidden;
  background: #dceef2;
  border: 3rpx solid #f4dfba;
  border-radius: 50%;
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.profile-name {
  overflow: hidden;
  color: #102a43;
  font-size: 31rpx;
  font-weight: 760;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-meta {
  margin-top: 7rpx;
  overflow: hidden;
  color: #627d98;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-edit {
  flex: 0 0 auto;
  min-height: 64rpx;
  gap: 6rpx;
  margin-left: 12rpx;
  color: #176c59;
  font-size: 24rpx;
  font-weight: 650;
  pointer-events: none;
}

.profile-edit-pencil { font-size: 30rpx; }
.profile-arrow { font-size: 34rpx; line-height: 1; }

.profile-metrics {
  min-height: 100rpx;
  margin-top: 16rpx;
  border-top: 2rpx dashed #dfcfb9;
}

.metric-item {
  flex: 1;
  min-width: 0;
  min-height: 92rpx;
  margin: 0;
  padding: 10rpx 4rpx;
  flex-direction: column;
  justify-content: center;
  color: #102a43;
  background: transparent;
  border-radius: 16rpx;
  line-height: 1.2;
  transition: transform 100ms ease, opacity 100ms ease;
}

.metric-item--pressed {
  opacity: 0.86;
  transform: scale(0.96);
}

.metric-item::after,
.list-tab::after,
.state-action::after,
.empty-action::after,
.reset-button::after,
.persona-button::after { display: none; }

.metric-label {
  color: #61758a;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.metric-value {
  margin-top: 5rpx;
  color: #0f7753;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
}

.metric-divider {
  width: 2rpx;
  height: 56rpx;
  background: repeating-linear-gradient(to bottom, #cbbba6 0, #cbbba6 8rpx, transparent 8rpx, transparent 14rpx);
}

.pending-list {
  margin-top: 20rpx;
}

.task-card {
  min-height: 104rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
}

.task-dot {
  flex: 0 0 auto;
  width: 17rpx;
  height: 17rpx;
  background: #d66a2f;
  border: 3rpx solid #f2b167;
  border-radius: 50%;
}

.task-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  word-break: break-all;
}

.task-kicker {
  color: #102a43;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.task-title {
  margin-top: 5rpx;
  overflow: hidden;
  color: #66788a;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-action {
  flex: 0 0 auto;
  gap: 5rpx;
  margin-left: 14rpx;
  color: #a24d25;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.activities-panel {
  margin-top: 20rpx;
  padding: 24rpx 20rpx 20rpx;
}

.activities-title {
  color: #102a43;
  font-size: 36rpx;
  font-weight: 780;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.activities-subtitle {
  margin-top: 5rpx;
  color: #627d98;
  font-size: 24rpx;
  line-height: 1.4;
}

.list-tabs {
  position: relative;
  min-height: 76rpx;
  margin-top: 16rpx;
  padding: 5rpx;
  gap: 2rpx;
  background: #f0e8dc;
  border-radius: 999rpx;
}

.list-tab {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  min-height: 66rpx;
  margin: 0;
  padding: 10rpx 3rpx;
  overflow: hidden;
  color: #627d98;
  background: transparent;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-tab--active {
  color: #0f7753;
  background: #fffdf8;
  box-shadow: 0 4rpx 10rpx rgba(48, 68, 53, 0.1);
  font-weight: 750;
}

.activity-list {
  margin-top: 18rpx;
}

.list-empty {
  min-height: 330rpx;
  padding: 36rpx 20rpx 24rpx;
  text-align: center;
}

.empty-puzzle {
  position: relative;
  width: 82rpx;
  height: 72rpx;
  margin: 0 auto;
  background: #a7d8bf;
  border: 4rpx solid #187454;
  border-radius: 22rpx 19rpx 23rpx 20rpx;
  opacity: 0.78;
}

.empty-puzzle::before {
  position: absolute;
  top: -20rpx;
  left: 25rpx;
  width: 28rpx;
  height: 28rpx;
  background: #a7d8bf;
  border: 4rpx solid #187454;
  border-bottom: 0;
  border-radius: 50% 50% 0 0;
  content: '';
}

.empty-puzzle-eye { position: absolute; top: 24rpx; width: 7rpx; height: 7rpx; background: #123451; border-radius: 50%; }
.empty-puzzle-eye--left { left: 22rpx; }
.empty-puzzle-eye--right { right: 22rpx; }
.empty-puzzle-smile { position: absolute; left: 33rpx; top: 38rpx; width: 14rpx; height: 7rpx; border-bottom: 3rpx solid #123451; border-radius: 0 0 14rpx 14rpx; }

.empty-title,
.state-title {
  margin-top: 24rpx;
  color: #102a43;
  font-size: 29rpx;
  font-weight: 730;
  line-height: 1.4;
}

.empty-copy,
.state-copy {
  margin-top: 8rpx;
  color: #6d7e8c;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-action,
.state-action {
  display: inline-flex;
  min-height: 80rpx;
  margin: 22rpx auto 0;
  padding: 14rpx 28rpx;
  align-items: center;
  justify-content: center;
  color: #11784f;
  background: #e2f3e9;
  border: 2rpx solid #bee1ce;
  border-radius: 18rpx 16rpx 20rpx 17rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.loading-card {
  min-height: 220rpx;
  padding: 30rpx;
}

.loading-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; }
.loading-lines { flex: 1; margin-left: 24rpx; }
.loading-line { width: 62%; height: 24rpx; margin-top: 16rpx; border-radius: 12rpx; }
.loading-line--strong { width: 78%; height: 30rpx; margin-top: 0; }

.skeleton-shimmer {
  background: linear-gradient(100deg, #e4d8c8 25%, #f7efe4 42%, #e4d8c8 60%);
  background-size: 260% 100%;
  animation: skeleton-shimmer 1.35s ease-in-out infinite;
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.state-card {
  min-height: 340rpx;
  padding: 54rpx 30rpx 36rpx;
  text-align: center;
}

.state-symbol {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  color: #fff8ee;
  background: #d66a2f;
  border-radius: 48% 52% 46% 54%;
  font-size: 40rpx;
  font-weight: 800;
}

.demo-panel {
  margin-top: 28rpx;
  padding: 20rpx;
  opacity: 0.88;
}

.demo-heading { justify-content: space-between; gap: 16rpx; }
.demo-title { color: #455a69; font-size: 26rpx; font-weight: 700; }
.demo-description { margin-top: 5rpx; color: #70818d; font-size: 24rpx; line-height: 1.4; }
.reset-button { flex: 0 0 auto; min-height: 66rpx; margin: 0; padding: 10rpx 18rpx; color: #536a78; background: #f4ede3; border-radius: 14rpx; font-size: 24rpx; }
.persona-row { gap: 10rpx; margin-top: 17rpx; }
.persona-button { flex: 1; min-height: 72rpx; margin: 0; padding: 10rpx 8rpx; color: #5c7281; background: #f4ede3; border-radius: 14rpx; font-size: 24rpx; line-height: 1.3; }
.persona-button--active { color: #fff8ee; background: #176c59; }

@media (max-width: 340px) {
  .user-page { padding-right: 22rpx; padding-left: 22rpx; }
  .profile-header { padding-right: 4rpx; padding-left: 4rpx; }
  .profile-title { font-size: 36rpx; }
  .profile-sprout { display: none; }
  .profile-card { padding-right: 16rpx; padding-left: 16rpx; }
  .profile-avatar-shell { width: 88rpx; height: 88rpx; }
  .profile-main { margin-left: 13rpx; }
  .profile-name { font-size: 29rpx; }
  .profile-edit { margin-left: 6rpx; font-size: 0; }
  .profile-edit-pencil { font-size: 30rpx; }
  .profile-arrow { font-size: 32rpx; }
  .metric-label { font-size: 22rpx; }
  .metric-value { font-size: 31rpx; }
  .task-card { flex-wrap: wrap; }
  .task-action { margin-top: 8rpx; margin-left: 33rpx; }
  .activities-panel { padding-right: 14rpx; padding-left: 14rpx; }
  .list-tab { font-size: 22rpx; }
  .persona-row { flex-wrap: wrap; }
  .persona-button { flex: 1 1 190rpx; }
}
