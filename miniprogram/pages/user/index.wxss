.user-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.loading-block {
  margin-top: 40rpx;
  padding: 60rpx 30rpx;
  color: #6a756f;
  text-align: center;
}

.profile-card,
.profile-metrics,
.dashboard-tabs,
.section-heading,
.task-card,
.task-action,
.list-tabs,
.demo-heading,
.persona-row,
.driver-onboarding,
.driver-profile-card,
.driver-task-card,
.driver-task-meta {
  display: flex;
  align-items: center;
}

.profile-card {
  position: relative;
  min-height: 156rpx;
  padding: 24rpx 22rpx;
  overflow: hidden;
}

.profile-avatar-shell {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  padding: 7rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #e4f7ec, #f4fbf7);
  border: 1rpx solid #d8eee2;
  border-radius: 30rpx;
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-main {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.profile-name {
  color: #1d2922;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.profile-meta {
  margin-top: 7rpx;
  color: #748078;
  font-size: 24rpx;
  line-height: 1.4;
}

.profile-gender-reminder {
  display: inline-flex;
  min-height: 38rpx;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  align-items: center;
  color: #a86100;
  background: #fff5df;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.profile-brand-mark {
  position: absolute;
  right: 42rpx;
  bottom: -6rpx;
  width: 86rpx;
  height: 86rpx;
  opacity: 0.13;
}

.profile-arrow,
.task-arrow,
.driver-task-arrow {
  flex: 0 0 auto;
  color: #8b958f;
  font-size: 42rpx;
  line-height: 1;
}

.dashboard-tabs {
  min-height: 88rpx;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 8rpx;
  background: #e8edeb;
  border-radius: 20rpx;
}

.dashboard-tab {
  flex: 1;
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  color: #5d6962;
  background: transparent;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.35;
}

.dashboard-tab--active {
  color: #11784f;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(24, 60, 44, 0.08);
  font-weight: 650;
}

.dashboard-tab--active-driver {
  color: #245b98;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(36, 91, 152, 0.1);
  font-weight: 650;
}

.profile-metrics {
  position: relative;
  min-height: 142rpx;
  margin-top: 14rpx;
  padding: 20rpx 8rpx;
  overflow: hidden;
}

.metric-item {
  position: relative;
  z-index: 2;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.metric-value {
  color: #118557;
  font-size: 36rpx;
  font-weight: 750;
  line-height: 1.2;
}

.metric-label {
  margin-top: 9rpx;
  color: #6b766f;
  font-size: 23rpx;
  line-height: 1.3;
  text-align: center;
}

.metric-divider {
  width: 1rpx;
  height: 66rpx;
  background: #e6ebe8;
}

.metrics-watermark {
  position: absolute;
  right: -18rpx;
  bottom: -24rpx;
  width: 112rpx;
  height: 112rpx;
  opacity: 0.045;
}

.pending-section {
  margin-top: 30rpx;
}

.section-heading {
  justify-content: space-between;
  margin: 0 2rpx 15rpx;
  color: #1d2922;
  font-size: 31rpx;
  font-weight: 680;
}

.count {
  min-width: 42rpx;
  padding: 4rpx 12rpx;
  color: #11784f;
  background: #e5f6ed;
  border-radius: 999rpx;
  font-size: 23rpx;
  text-align: center;
}

.count--driver {
  color: #245b98;
  background: #eaf2fd;
}

.task-card {
  position: relative;
  min-height: 108rpx;
  margin-bottom: 14rpx;
  padding: 19rpx 22rpx;
  overflow: hidden;
}

.task-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  background: #16a36a;
  border-radius: 50%;
}

.task-puzzle-shell {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  margin-left: 15rpx;
  padding: 6rpx;
  background: #eef8f3;
  border-radius: 16rpx;
}

.task-puzzle {
  width: 100%;
  height: 100%;
}

.task-main {
  flex: 1;
  min-width: 0;
  margin-left: 17rpx;
  word-break: break-all;
}

.task-title {
  color: #26322c;
  font-size: 27rpx;
  font-weight: 620;
  line-height: 1.4;
}

.task-time {
  margin-top: 6rpx;
  color: #748078;
  font-size: 23rpx;
}

.task-action {
  flex: 0 0 auto;
  gap: 5rpx;
  margin-left: 14rpx;
  color: #11784f;
  font-size: 23rpx;
}

.task-action .task-arrow {
  font-size: 36rpx;
}

.rides-heading {
  margin: 24rpx 2rpx 0;
}

.rides-title {
  color: #1d2922;
  font-size: 32rpx;
  font-weight: 700;
}

.rides-subtitle {
  margin-top: 7rpx;
  color: #748078;
  font-size: 24rpx;
  line-height: 1.45;
}

.list-tabs {
  position: relative;
  min-height: 88rpx;
  margin: 12rpx 0 14rpx;
  border-bottom: 1rpx solid #dfe6e2;
}

.list-tab {
  position: relative;
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  padding: 16rpx 12rpx;
  color: #68736d;
  background: transparent;
  font-size: 26rpx;
  line-height: 1.35;
}

.list-tab--active {
  color: #11784f;
  font-weight: 680;
}

.list-tab--active::after {
  position: absolute;
  right: 22%;
  bottom: -1rpx;
  left: 22%;
  height: 5rpx;
  background: #16a36a;
  border-radius: 999rpx;
  content: '';
}

.card-visual-shell {
  min-width: 0;
}

.driver-onboarding,
.driver-profile-card,
.driver-task-card {
  margin-top: 14rpx;
  padding: 24rpx;
}

.driver-onboarding {
  flex-wrap: wrap;
  gap: 18rpx;
  background: linear-gradient(145deg, #f7fbff, #f1f8f5);
  border-color: #dce9e3;
}

.driver-onboarding--unavailable {
  background: linear-gradient(145deg, #fffdf8, #f7faf8);
  border-color: #eadfca;
}

.driver-reload-button {
  color: #245b98;
  background: #edf4fd;
  border: 1rpx solid #cddff5;
}

.driver-onboarding-car,
.driver-profile-car {
  flex: 0 0 auto;
  width: 98rpx;
  height: 82rpx;
}

.driver-onboarding-main,
.driver-profile-main {
  flex: 1;
  min-width: 0;
}

.driver-onboarding-title,
.driver-profile-title,
.driver-task-title {
  color: #26384a;
  font-size: 29rpx;
  font-weight: 680;
  line-height: 1.4;
}

.driver-onboarding-copy,
.driver-profile-copy {
  margin-top: 8rpx;
  color: #667a90;
  font-size: 24rpx;
  line-height: 1.6;
}

.driver-info-button {
  flex: 1 0 100%;
  min-height: 88rpx;
  margin: 2rpx 0 0;
  color: #fff;
  background: #3478f6;
  border-radius: 18rpx;
  font-size: 27rpx;
  line-height: 1.35;
}

.driver-guide-card {
  position: relative;
  display: block;
  margin-top: 14rpx;
  padding: 32rpx 28rpx;
  overflow: hidden;
  background: #fff;
  border-color: #dce9e3;
  box-sizing: border-box;
}

.driver-guide-top {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.driver-guide-car {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 116rpx;
}

.driver-guide-info {
  flex: 1;
  min-width: 0;
}

.driver-guide-title {
  color: #1c2520;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 1.35;
  word-break: break-all;
}

.driver-guide-desc {
  margin-top: 8rpx;
  color: #66736c;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.driver-guide-btn {
  display: flex;
  width: 100% !important;
  min-height: 88rpx;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #16a36a;
  border: 0;
  border-radius: 18rpx;
  box-shadow: 0 7rpx 16rpx rgba(22, 163, 106, 0.16);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.35;
  box-sizing: border-box;
}

.driver-guide-btn::after {
  display: none;
  border: 0;
}

.driver-guide-btn--pending {
  color: #52635a;
  background: #e0e8e4;
  box-shadow: none;
}

.driver-guide-btn--attention {
  color: #fff;
  background: #c86418;
  box-shadow: 0 7rpx 16rpx rgba(200, 100, 24, 0.14);
}

.driver-guide-btn--hover {
  opacity: 0.88;
}

.driver-profile-card {
  gap: 18rpx;
  background: #f5f9ff;
  border-color: #dbe8fa;
}

.driver-section-heading {
  margin-top: 24rpx;
}

.driver-task-error {
  min-height: 156rpx;
  gap: 20rpx;
  padding: 24rpx;
  align-items: center;
  justify-content: space-between;
  background: #fffdf8;
  border-color: #eadfca;
}

.driver-task-error-title {
  color: #3d4650;
  font-size: 27rpx;
  font-weight: 680;
  line-height: 1.4;
}

.driver-task-error-copy {
  margin-top: 8rpx;
  color: #75808a;
  font-size: 24rpx;
  line-height: 1.5;
}

.driver-task-retry {
  flex: 0 0 auto;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 24rpx;
  color: #245b98;
  background: #edf4fd;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 1.35;
}

.driver-empty {
  display: flex;
  min-height: 330rpx;
  padding: 48rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.driver-empty-car {
  width: 132rpx;
  height: 104rpx;
  opacity: 0.48;
}

.driver-empty-title {
  margin-top: 22rpx;
  color: #26322c;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 1.4;
}

.driver-empty-description {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: #748078;
  font-size: 24rpx;
  line-height: 1.6;
}

.driver-task-card {
  min-height: 148rpx;
  margin-top: 0;
  margin-bottom: 16rpx;
  gap: 14rpx;
}

.driver-task-copy {
  flex: 1;
  min-width: 0;
}

.driver-task-route {
  color: #245b98;
  font-size: 25rpx;
  font-weight: 680;
  line-height: 1.4;
  word-break: break-all;
}

.driver-task-title {
  margin-top: 10rpx;
  color: #26322c;
  word-break: break-all;
}

.driver-task-meta {
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8rpx 16rpx;
  margin-top: 11rpx;
  color: #718078;
  font-size: 24rpx;
}

.driver-task-car {
  flex: 0 0 auto;
  width: 92rpx;
  height: 76rpx;
}

.driver-task-arrow {
  font-size: 38rpx;
}

.demo-panel {
  margin-top: 42rpx;
  padding: 22rpx;
  background: #f6f8fb;
  border-color: #e3e8ef;
  box-shadow: none;
}

.demo-heading {
  justify-content: space-between;
  gap: 16rpx;
}

.demo-title {
  color: #4d5e70;
  font-size: 25rpx;
  font-weight: 650;
}

.demo-description {
  margin-top: 5rpx;
  color: #788696;
  font-size: 22rpx;
  line-height: 1.4;
}

.reset-button {
  flex: 0 0 auto;
  min-height: 60rpx;
  margin: 0;
  padding: 10rpx 18rpx;
  color: #5d6b7a;
  background: #fff;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

.persona-row {
  gap: 10rpx;
  margin-top: 17rpx;
}

.persona-button {
  flex: 1;
  min-height: 72rpx;
  margin: 0;
  padding: 10rpx 8rpx;
  color: #667583;
  background: #fff;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.35;
}

.persona-button--active {
  color: #fff;
  background: #56718f;
}

@media (max-width: 340px) {
  .profile-card {
    padding: 22rpx 18rpx;
  }

  .profile-avatar-shell {
    width: 100rpx;
    height: 100rpx;
  }

  .profile-main {
    margin-left: 17rpx;
  }

  .profile-brand-mark {
    display: none;
  }

  .metric-label {
    font-size: 22rpx;
  }

  .task-card {
    flex-wrap: wrap;
  }

  .task-action {
    margin-top: 8rpx;
    margin-left: 86rpx;
  }

  .card-visual-shell {
    width: 100%;
  }

  .driver-profile-card {
    flex-wrap: wrap;
  }

  .persona-row {
    flex-wrap: wrap;
  }

  .persona-button {
    flex: 1 1 190rpx;
  }
}
