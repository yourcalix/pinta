.user-page {
  box-sizing: border-box;
  min-height: 100vh;
}

.loading-block {
  margin-top: 80rpx;
  padding: 60rpx 30rpx;
  color: #6a756f;
  text-align: center;
}

.profile-card,
.demo-heading,
.persona-row,
.section-heading,
.task-card,
.task-action,
.list-tabs,
.mini-top {
  display: flex;
  align-items: center;
}

.profile-card {
  padding: 26rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: #fff;
  background: #183c2c;
  border-radius: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-main,
.task-main {
  flex: 1;
  margin-left: 22rpx;
}

.task-main {
  min-width: 0;
  word-break: break-all;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 680;
}

.profile-meta,
.task-time,
.mini-meta {
  margin-top: 8rpx;
  color: #748078;
  font-size: 24rpx;
}

.profile-arrow,
.task-arrow {
  color: #8b958f;
  font-size: 46rpx;
}

.demo-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #f0f6ff;
  border-color: #dae6f9;
}

.demo-heading,
.section-heading,
.mini-top {
  justify-content: space-between;
}

.demo-title {
  color: #244a85;
  font-weight: 650;
}

.demo-description {
  margin-top: 6rpx;
  color: #62789b;
  font-size: 23rpx;
}

.reset-button {
  min-height: 60rpx;
  margin: 0;
  padding: 10rpx 18rpx;
  color: #4c6386;
  background: #fff;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

.persona-row {
  gap: 12rpx;
  margin-top: 20rpx;
}

.persona-button {
  flex: 1;
  min-height: 68rpx;
  margin: 0;
  padding: 10rpx;
  color: #5c6d87;
  background: #fff;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.persona-button--active {
  color: #fff;
  background: #315f9d;
}

.section-heading {
  margin: 34rpx 2rpx 16rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.count {
  min-width: 42rpx;
  padding: 4rpx 12rpx;
  color: #11784f;
  background: #e5f6ed;
  border-radius: 999rpx;
  font-size: 23rpx;
  text-align: center;
}

.task-card {
  min-height: 88rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 24rpx;
}

.task-dot {
  width: 16rpx;
  height: 16rpx;
  background: #16a36a;
  border-radius: 50%;
}

.task-title {
  font-size: 27rpx;
  font-weight: 600;
}

.task-action {
  flex: 0 0 auto;
  gap: 6rpx;
  margin-left: 16rpx;
  color: #11784f;
  font-size: 24rpx;
}

.task-action .task-arrow {
  font-size: 38rpx;
}

.zero-task {
  padding: 28rpx;
  color: #718078;
  font-size: 25rpx;
}

.list-tabs {
  gap: 12rpx;
  margin: 36rpx 0 18rpx;
  padding: 8rpx;
  background: #e9eeeb;
  border-radius: 18rpx;
}

.list-tab {
  flex: 1;
  min-height: 66rpx;
  margin: 0;
  padding: 10rpx;
  color: #68736d;
  background: transparent;
  border-radius: 13rpx;
  font-size: 25rpx;
  line-height: 1.4;
}

.list-tab--active {
  color: #1d2922;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(26, 48, 37, 0.06);
}

.mini-activity {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.mini-type {
  font-size: 24rpx;
  font-weight: 650;
}

.mini-title {
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.dashboard-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 8rpx;
  background: #e8edeb;
  border-radius: 20rpx;
}

.dashboard-tab {
  flex: 1;
  min-height: 80rpx;
  margin: 0;
  color: #5d6962;
  background: transparent;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.dashboard-tab--active {
  color: #126a48;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(24, 60, 44, 0.08);
  font-weight: 650;
}

.dashboard-tab--active-driver {
  color: #245b98;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(36, 91, 152, 0.1);
  font-weight: 650;
}

.driver-onboarding,
.driver-profile-card,
.driver-task-card {
  margin-top: 22rpx;
  padding: 26rpx;
}

.driver-onboarding {
  text-align: center;
}

.driver-onboarding-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto;
  color: #fff;
  background: #3478f6;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.driver-onboarding-title,
.driver-profile-title,
.driver-task-title {
  margin-top: 18rpx;
  color: #26384a;
  font-size: 29rpx;
  font-weight: 650;
}

.driver-onboarding-copy,
.driver-profile-copy {
  margin-top: 10rpx;
  color: #667a90;
  font-size: 24rpx;
  line-height: 1.6;
}

.driver-info-button {
  min-height: 88rpx;
  margin-top: 24rpx;
  color: #fff;
  background: #3478f6;
  border-radius: 18rpx;
  font-size: 27rpx;
}

.driver-profile-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #f5f9ff;
  border-color: #dbe8fa;
}

.driver-profile-title {
  margin-top: 0;
}

.driver-task-card {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.driver-task-route {
  color: #245b98;
  font-size: 25rpx;
  font-weight: 650;
}

.driver-task-title {
  margin-top: 12rpx;
  color: #26322c;
}

.driver-task-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10rpx 18rpx;
  margin-top: 12rpx;
  color: #718078;
  font-size: 24rpx;
}
