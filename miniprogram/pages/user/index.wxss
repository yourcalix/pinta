.user-page {
  padding-top: 28rpx;
}

.loading-block {
  margin-top: 80rpx;
  padding: 60rpx 30rpx;
  color: #6a756f;
  text-align: center;
}

.profile-card,
.demo-heading,
.persona-row,
.section-heading,
.task-card,
.list-tabs,
.mini-top {
  display: flex;
  align-items: center;
}

.profile-card {
  padding: 26rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  color: #fff;
  background: #183c2c;
  border-radius: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-main,
.task-main {
  flex: 1;
  margin-left: 22rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 680;
}

.profile-meta,
.task-time,
.mini-meta {
  margin-top: 8rpx;
  color: #748078;
  font-size: 24rpx;
}

.profile-arrow,
.task-arrow {
  color: #8b958f;
  font-size: 46rpx;
}

.demo-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #f0f6ff;
  border-color: #dae6f9;
}

.demo-heading,
.section-heading,
.mini-top {
  justify-content: space-between;
}

.demo-title {
  color: #244a85;
  font-weight: 650;
}

.demo-description {
  margin-top: 6rpx;
  color: #62789b;
  font-size: 23rpx;
}

.reset-button {
  min-height: 60rpx;
  margin: 0;
  padding: 10rpx 18rpx;
  color: #4c6386;
  background: #fff;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 1.4;
}

.persona-row {
  gap: 12rpx;
  margin-top: 20rpx;
}

.persona-button {
  flex: 1;
  min-height: 68rpx;
  margin: 0;
  padding: 10rpx;
  color: #5c6d87;
  background: #fff;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.persona-button--active {
  color: #fff;
  background: #315f9d;
}

.section-heading {
  margin: 34rpx 2rpx 16rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.count {
  min-width: 42rpx;
  padding: 4rpx 12rpx;
  color: #11784f;
  background: #e5f6ed;
  border-radius: 999rpx;
  font-size: 23rpx;
  text-align: center;
}

.task-card {
  margin-bottom: 14rpx;
  padding: 22rpx 24rpx;
}

.task-dot {
  width: 16rpx;
  height: 16rpx;
  background: #16a36a;
  border-radius: 50%;
}

.task-title {
  font-size: 27rpx;
  font-weight: 600;
}

.zero-task {
  padding: 28rpx;
  color: #718078;
  font-size: 25rpx;
}

.list-tabs {
  gap: 12rpx;
  margin: 36rpx 0 18rpx;
  padding: 8rpx;
  background: #e9eeeb;
  border-radius: 18rpx;
}

.list-tab {
  flex: 1;
  min-height: 66rpx;
  margin: 0;
  padding: 10rpx;
  color: #68736d;
  background: transparent;
  border-radius: 13rpx;
  font-size: 25rpx;
  line-height: 1.4;
}

.list-tab--active {
  color: #1d2922;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(26, 48, 37, 0.06);
}

.mini-activity {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.mini-type {
  font-size: 24rpx;
  font-weight: 650;
}

.mini-title {
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 650;
}
