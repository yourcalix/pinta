<view class="page user-page" style="padding-top: {{contentTopInset}}px;">
  <view wx:if="{{loading}}" class="loading-block surface">正在整理你的协同任务…</view>

  <empty-state
    wx:elif="{{error}}"
    symbol="!"
    title="{{error}}"
    description="检查网络后重试。"
    action-text="重新加载"
    bindaction="loadDashboard"
  />

  <block wx:else>
    <view class="profile-card surface" bindtap="handleProfile" role="button">
      <view class="avatar">{{avatarLetter}}</view>
      <view class="profile-main">
        <view class="profile-name">{{user.profile.nickname}}</view>
        <view class="profile-meta">{{user.profile.city}} · 已确认年满18岁</view>
      </view>
      <text class="profile-arrow">›</text>
    </view>

    <view wx:if="{{isMock}}" class="demo-panel surface">
      <view class="demo-heading">
        <view>
          <view class="demo-title">演示身份</view>
          <view class="demo-description">切换身份可体验申请、审批和成团闭环</view>
        </view>
        <button class="reset-button" bindtap="handleResetDemo">重置</button>
      </view>
      <view class="persona-row">
        <button
          wx:for="{{personas}}"
          wx:key="id"
          class="persona-button {{persona === item.id ? 'persona-button--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="handlePersona"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="dashboard-tabs">
      <button class="dashboard-tab {{dashboardMode === 'rides' ? 'dashboard-tab--active' : ''}}" data-value="rides" bindtap="handleDashboardMode">我的拼车</button>
      <button class="dashboard-tab dashboard-tab--driver {{dashboardMode === 'driver' ? 'dashboard-tab--active-driver' : ''}}" data-value="driver" bindtap="handleDashboardMode">司机任务</button>
    </view>

    <block wx:if="{{dashboardMode === 'rides'}}">

    <view class="section-heading">
      <text>待处理</text>
      <text class="count">{{tasks.length}}</text>
    </view>
    <view wx:if="{{tasks.length}}" class="task-list">
      <view
        wx:for="{{tasks}}"
        wx:key="id"
        class="task-card surface"
        data-task="{{item}}"
        bindtap="handleTaskTap"
        role="button"
        aria-label="{{item.title}}，{{item.actionLabel}}"
      >
        <view class="task-dot"></view>
        <view class="task-main">
          <view class="task-title">{{item.title}}</view>
          <view class="task-time">{{item.displayTime}}</view>
        </view>
        <view class="task-action">
          <text>{{item.actionLabel}}</text>
          <text class="task-arrow">›</text>
        </view>
      </view>
    </view>
    <view wx:else class="zero-task surface">当前没有待处理事项，轻松一下。</view>

    <view class="list-tabs">
      <button class="list-tab {{currentList === 'owned' ? 'list-tab--active' : ''}}" data-value="owned" bindtap="handleListChange">我的发布 {{owned.length}}</button>
      <button class="list-tab {{currentList === 'joined' ? 'list-tab--active' : ''}}" data-value="joined" bindtap="handleListChange">我的参与 {{joined.length}}</button>
    </view>

    <block wx:if="{{currentList === 'owned'}}">
      <view
        wx:for="{{owned}}"
        wx:key="id"
        class="mini-activity surface"
        data-item="{{item}}"
        bindtap="handleActivityTap"
      >
        <view class="mini-top">
          <text class="mini-type" style="color: {{item.typeColor}}">{{item.typeLabel}}</text>
          <status-badge label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
        </view>
        <view class="mini-title">{{item.title}}</view>
        <view class="mini-meta">{{item.memberCount}}/{{item.targetMembers}} 人 · {{item.displayTime}}</view>
      </view>
      <empty-state wx:if="{{!owned.length}}" title="还没有发布活动" description="从发布页选择一个类型，两步即可创建。" />
    </block>

    <block wx:else>
      <view
        wx:for="{{joined}}"
        wx:key="id"
        class="mini-activity surface"
        data-item="{{item}}"
        bindtap="handleActivityTap"
      >
        <view class="mini-top">
          <text class="mini-type" style="color: {{item.typeColor}}">{{item.typeLabel}}</text>
          <status-badge label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
        </view>
        <view class="mini-title">{{item.title}}</view>
        <view class="mini-meta">{{item.memberCount}}/{{item.targetMembers}} 人 · {{item.displayTime}}</view>
      </view>
      <empty-state wx:if="{{!joined.length}}" title="还没有参与活动" description="去发现页看看附近正在拼的活动。" />
    </block>
    </block>

    <block wx:else>
      <view wx:if="{{!driverProfile || !driverProfile.canAcceptRide}}" class="driver-onboarding surface">
        <view class="driver-onboarding-mark">车</view>
        <view class="driver-onboarding-title">{{driverApplication && driverApplication.status === 'SUBMITTED' ? '司机认证审核中' : driverApplication && driverApplication.status === 'NEEDS_MORE_INFO' ? '司机认证需要补充资料' : '成为澳门校园认证合乘司机'}}</view>
        <view class="driver-onboarding-copy">{{driverApplication && driverApplication.status === 'SUBMITTED' ? '审核通过前仍可正常使用乘客功能，暂不能确认承接。' : '仅向已核验身份、驾驶资格及车辆的司机开放确认承接。'}}</view>
        <button class="driver-info-button" bindtap="handleDriverApplicationInfo">{{driverApplication ? '查看认证状态' : '开始司机认证'}}</button>
      </view>

      <block wx:else>
        <view class="driver-profile-card surface">
          <view>
            <view class="driver-profile-title">司机资格已通过</view>
            <view class="driver-profile-copy">已审核车辆 {{driverProfile.vehicles.length}} 辆，接车时间前可确认承接校园合乘行程。</view>
          </view>
          <status-badge label="已认证" tone="info" />
        </view>

        <view class="section-heading">
          <text>已承接任务</text>
          <text class="count">{{driverRides.length}}</text>
        </view>
        <view
          wx:for="{{driverRides}}"
          wx:key="id"
          class="driver-task-card surface"
          data-item="{{item}}"
          bindtap="handleDriverTask"
          role="button"
          aria-label="{{item.activity.title}}，接送时间{{item.pickupLabel}}"
        >
          <view class="driver-task-route">{{item.activity.originLabel}} → {{item.activity.destinationLabel}}</view>
          <view class="driver-task-title">{{item.activity.title}}</view>
          <view class="driver-task-meta">
            <text>{{item.pickupLabel}}</text>
            <text>{{item.rideFulfillment.vehicle.type}} · {{item.rideFulfillment.vehicle.plateMasked}}</text>
          </view>
        </view>
        <empty-state wx:if="{{!driverRides.length}}" title="暂无已承接任务" description="去发现页切换到“我是司机”，查看接车时间前可承接的行程。" />
      </block>
    </block>
  </block>
</view>
