<view class="page discover-page global-background-host" style="padding-top: {{contentTopInset}}px;">
  <launch-splash wx:if="{{launchSplashVisible}}" progress="{{launchProgress}}" exiting="{{launchSplashExiting}}" bindasseterror="handleLaunchAssetError" />

  <image class="global-page-background" src="/assets/images/shared/shared-paper-bg.jpg" mode="aspectFill" aria-hidden="true" />
  <view class="global-page-background-tint" aria-hidden="true"></view>

  <view class="discover-hero">
    <view class="discover-header" role="heading" aria-label="拼吧发现，发现附近正在发生的拼单">
      <view class="discover-header-copy">
        <view class="discover-eyebrow" aria-hidden="true">PINBA DISCOVER</view>
        <view class="discover-art-title" aria-hidden="true"><text class="discover-art-title-base">拼吧 · </text><text class="discover-art-title-accent">发现</text></view>
        <view class="discover-subtitle" aria-hidden="true">发现附近正在发生的拼单</view>
      </view>
      <view class="header-doodle" aria-hidden="true"><view class="header-doodle-line"></view><view class="header-doodle-leaf header-doodle-leaf--left"></view><view class="header-doodle-leaf header-doodle-leaf--right"></view></view>
    </view>
  </view>

  <view class="discover-sheet">
    <view class="campaign-shell" aria-label="拼吧官方推荐">
      <swiper class="campaign-swiper" current="{{currentBanner}}" autoplay="{{banners.length > 1}}" circular="{{banners.length > 1}}" interval="4500" duration="400" bindchange="handleBannerChange">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="campaign-card campaign-card--{{item.tone}}" data-id="{{item.id}}" bindtap="handleBannerTap" hover-class="campaign-card--pressed" hover-stay-time="80" role="button" aria-label="运营推荐，{{item.title}}，{{item.subtitle}}，点击查看详情">
            <view class="campaign-copy">
              <view class="campaign-eyebrow"><text class="campaign-pin" aria-hidden="true">●</text><text>{{item.eyebrow}}</text></view>
              <view class="campaign-title">{{item.title}}</view>
              <view class="campaign-subtitle">{{item.subtitle}}</view>
              <view class="campaign-action">去看看 <text aria-hidden="true">›</text></view>
            </view>
            <view class="campaign-art" aria-hidden="true">
              <view wx:if="{{item.failed}}" class="campaign-art-fallback">✦</view>
              <image wx:else class="campaign-image" src="{{item.imageSrc}}" mode="aspectFit" data-id="{{item.id}}" binderror="handleBannerImageError" aria-hidden="true" />
            </view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{banners.length > 1}}" class="campaign-dots" aria-hidden="true">
        <view wx:for="{{banners}}" wx:key="id" class="campaign-dot {{currentBanner === index ? 'campaign-dot--active' : ''}}"></view>
      </view>
    </view>

    <view class="directory-tools">
      <view class="search-row">
        <view class="search-symbol" aria-hidden="true"><view class="search-glyph"><view class="search-glyph-handle"></view></view></view>
        <input class="search-input" value="{{keyword}}" placeholder="搜索活动、地点或发起人" placeholder-class="search-placeholder" confirm-type="search" aria-label="搜索活动、地点或发起人" bindinput="handleKeywordInput" bindconfirm="handleSearch" />
        <button wx:if="{{keyword}}" class="search-clear-button" bindtap="handleClearKeyword" hover-class="search-clear--pressed" hover-stay-time="80" aria-label="清空搜索关键词"><text aria-hidden="true">×</text></button>
        <button class="search-submit-button" bindtap="handleSearch" aria-label="执行搜索">搜索</button>
      </view>

      <scroll-view class="filter-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}" enable-flex="{{true}}" role="tablist" aria-label="选择拼单类型">
        <view class="filter-track">
          <button wx:for="{{typeOptions}}" wx:key="value" class="filter-chip filter-chip--{{item.value || 'all'}} {{type === item.value ? 'filter-chip--active' : ''}}" data-value="{{item.value}}" bindtap="handleTypeChange" role="tab" aria-selected="{{type === item.value}}">
            <view class="chip-icon-box" aria-hidden="true"><image class="chip-icon-img" src="{{item.iconSrc}}" mode="aspectFit" aria-hidden="true" /></view>
            <text class="chip-label">{{item.label}}</text>
          </button>
        </view>
      </scroll-view>
    </view>

    <view class="session-heading">
      <view class="session-heading-watermark" aria-hidden="true">ACTIVE SESSIONS</view>
      <view class="list-heading">
        <view class="list-heading-title"><text class="list-heading-mark" aria-hidden="true"></text><text class="session-heading-title">{{hasActiveFilters ? '筛选结果' : '正在组队'}}</text></view>
        <view class="list-heading-meta"><text class="list-count" wx:if="{{!loading}}">{{activities.length}} 个活动</text><button wx:if="{{hasActiveFilters}}" class="clear-filter-button" bindtap="handleClearFilters">清除筛选</button></view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="skeleton-list" aria-label="正在加载活动"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card" aria-hidden="true"><view class="skeleton-cover"></view><view class="skeleton-copy"><view class="skeleton-line skeleton-line--short"></view><view class="skeleton-line skeleton-line--title"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-line--medium"></view></view></view></view>

    <view wx:elif="{{activities.length}}">
      <activity-card wx:for="{{activities}}" wx:key="id" item="{{item}}" variant="discover" bindselect="handleCardSelect" />
      <view wx:if="{{loadingMore || loadMoreError || !hasMore}}" class="list-footer" aria-role="status">
        <view wx:if="{{loadingMore}}" class="footer-state"><view class="footer-spinner" aria-hidden="true"></view><text>正在加载更多…</text></view>
        <button wx:elif="{{loadMoreError}}" class="footer-retry-button" bindtap="handleRetryLoadMore">加载更多失败，点击重试</button>
        <view wx:elif="{{!hasMore}}" class="footer-state footer-state--end">— 已经到底啦 · 拼吧 —</view>
      </view>
    </view>

    <view wx:else class="empty-state-shell"><empty-state symbol="{{error ? '!' : '+'}}" title="{{error || (hasActiveFilters ? '没有找到合适的活动' : '暂时还没有拼单')}}" description="{{error ? '检查网络后重试，已加载内容不会丢失。' : (hasActiveFilters ? '换个类型或关键词再试试。' : '发起一个拼单，邀请附近伙伴加入。')}}" action-text="{{error ? '重新加载' : (hasActiveFilters ? '清除筛选' : '去发起拼单')}}" bindaction="handleEmptyAction" /></view>

    <view wx:if="{{memories.length}}" class="memory-section memory-section--ready">
      <view class="memory-section-heading">
        <view class="memory-heading-watermark" aria-hidden="true">FORMED STORIES</view>
        <view class="memory-title">成团记忆</view>
      </view>

      <view class="memory-panel memory-panel--layout-{{memoryLayout}} {{memoriesExpanded ? 'memory-panel--expanded' : ''}}">
        <image class="memory-panel-background" src="/assets/images/discover/formed-memory-editorial-bg.jpg" mode="aspectFill" lazy-load="{{true}}" aria-hidden="true" />
        <view class="memory-panel-background-shade" aria-hidden="true"></view>
        <view class="memory-panel-glow" aria-hidden="true"></view>
        <view class="memory-panel-masthead" aria-hidden="true">
          <view class="memory-art-title">
            <view class="memory-art-title-first">分享你的</view>
            <view class="memory-art-title-second"><text class="memory-panel-masthead-accent">成团</text><text>记忆</text><view class="memory-camera"><view class="memory-camera-lens"></view></view></view>
          </view>
          <view class="memory-panel-masthead-sub">每一次顺利成团，都值得被记住</view>
        </view>
        <view class="memory-grid memory-grid--{{memoryLayout}}">
          <view wx:for="{{featuredMemories}}" wx:key="id" class="memory-card memory-card--{{item.memoryPosition}} memory-card--{{item.typeTone}}" data-id="{{item.id}}" bindtap="handleMemorySelect" hover-class="memory-card--pressed" hover-stay-time="80" role="button" aria-label="{{item.typeLabel}}，{{item.title}}，{{item.memoryFact}}，双击查看活动详情">
            <view class="memory-art" aria-hidden="true">
              <view wx:if="{{item.memoryCoverFailed}}" class="memory-art-fallback">✦</view>
              <image wx:else class="memory-image" src="{{item.memoryCoverSrc}}" mode="aspectFit" lazy-load="{{true}}" data-id="{{item.id}}" binderror="handleMemoryCoverError" aria-hidden="true" />
            </view>
            <view class="memory-card-copy memory-card-copy--{{item.memoryPosition}}">
              <view class="memory-card-title">{{item.title}}</view>
              <view class="memory-type"># {{item.typeLabel}}</view>
              <view wx:if="{{memoryLayout !== 3 || item.memoryPosition === 'lead'}}" class="memory-owner-row">
                <image wx:if="{{item.memoryOwnerAvatar}}" class="memory-owner-avatar" src="{{item.memoryOwnerAvatar}}" mode="aspectFill" aria-hidden="true" />
                <view wx:else class="memory-owner-initial" aria-hidden="true">{{item.ownerInitial}}</view>
                <text class="memory-owner-name">{{item.ownerNickname}}</text>
              </view>
              <view class="memory-card-footer">
                <text class="memory-fact">{{item.memoryFact}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{featuredMemories.length < 2}}" class="memory-placeholder memory-placeholder--top" aria-hidden="true">
            <view class="memory-placeholder-camera"><view class="memory-placeholder-lens"></view></view>
            <view class="memory-placeholder-copy">虚位以待<text>等你成团</text></view>
          </view>
          <view wx:if="{{featuredMemories.length < 3}}" class="memory-placeholder memory-placeholder--bottom" aria-hidden="true">
            <view class="memory-placeholder-camera"><view class="memory-placeholder-lens"></view></view>
            <view class="memory-placeholder-copy">虚位以待<text>等你成团</text></view>
          </view>
        </view>

        <view wx:if="{{extraMemories.length}}" class="memory-extra-list">
          <view wx:for="{{extraMemories}}" wx:key="id" class="memory-extra-card memory-card--{{item.typeTone}}" data-id="{{item.id}}" bindtap="handleMemorySelect" hover-class="memory-card--pressed" role="button" aria-label="{{item.typeLabel}}，{{item.title}}，{{item.memoryFact}}，双击查看活动详情">
            <view class="memory-art" aria-hidden="true">
              <image wx:if="{{!item.memoryCoverFailed}}" src="{{item.memoryCoverSrc}}" mode="aspectFit" data-id="{{item.id}}" binderror="handleMemoryCoverError" aria-hidden="true" />
              <text wx:else>✦</text>
            </view>
            <view class="memory-extra-copy"><view class="memory-extra-title">{{item.title}}</view><view class="memory-type"># {{item.typeLabel}}</view><view class="memory-extra-fact">{{item.memoryFact}}</view></view>
          </view>
        </view>

        <button wx:if="{{hasMoreMemories}}" class="memory-more-button" bindtap="handleToggleMemories" aria-label="{{memoriesExpanded ? '收起更多成团活动' : '展开更多成团活动'}}">
          {{memoriesExpanded ? '收起成团记忆' : '查看更多'}} <text aria-hidden="true">{{memoriesExpanded ? '⌃' : '›'}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
