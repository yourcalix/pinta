<view class="page home-page" style="padding-top: {{contentTopInset}}px;">
  <launch-splash wx:if="{{launchSplashVisible}}" progress="{{launchProgress}}" exiting="{{launchSplashExiting}}" bindasseterror="handleLaunchAssetError" />

  <view class="home-content">
    <view class="home-greeting" role="heading" aria-level="1" aria-label="你好，{{greetingNickname}}，欢迎你回到拼吧">
      <image class="greeting-avatar" src="{{greetingAvatarPath}}" mode="aspectFill" binderror="handleGreetingAvatarError" aria-hidden="true" />
      <view class="greeting-copy">
        <text class="greeting-title">你好，{{greetingNickname}} <text aria-hidden="true">👋</text></text>
        <text class="greeting-subtitle">欢迎你回到拼吧</text>
      </view>
      <view class="greeting-actions">
        <button class="header-action header-action--message" data-action="messages" bindtap="handleHeaderAction" hover-class="control--pressed" aria-label="查看消息"><image class="header-action-icon" src="/assets/icons/home/header-bell.png" mode="aspectFit" aria-hidden="true" /></button>
        <button class="header-action header-action--search" data-action="search" bindtap="handleHeaderAction" hover-class="control--pressed" aria-label="{{searchPanelVisible ? '收起活动搜索' : '搜索活动'}}"><image class="header-action-icon" src="/assets/icons/home/header-search.png" mode="aspectFit" aria-hidden="true" /></button>
      </view>
    </view>

    <view class="home-hero" role="region" aria-label="你的搭子，刚刚好。发现身边同频的人和活动">
      <view class="hero-copy">
        <view class="hero-title"><text>你的搭子，</text><text class="hero-title-accent">刚刚好</text></view>
        <text class="hero-subtitle">发现身边同频的人和活动</text>
      </view>
      <view class="hero-illustration-slot" aria-hidden="true"></view>
    </view>

    <view class="home-shortcuts" aria-label="首页快捷入口">
      <button class="home-shortcut home-shortcut--activities" data-action="activities" bindtap="handleHomeShortcut" hover-class="home-shortcut--pressed" aria-label="组队拼团，看看大家都在聊什么">
        <text class="shortcut-title">组队拼团</text><text class="shortcut-subtitle shortcut-subtitle--activities">看看大家都在聊什么</text>
        <view class="shortcut-icon-slot" aria-hidden="true"><image wx:if="{{shortcutIconPaths.activities}}" src="{{shortcutIconPaths.activities}}" mode="aspectFit" /></view>
        <view class="shortcut-arrow" aria-hidden="true">›</view>
      </button>
      <button class="home-shortcut home-shortcut--memories" data-action="memories" bindtap="handleHomeShortcut" hover-class="home-shortcut--pressed" aria-label="琐碎回忆，记录第一次成团，功能即将上线">
        <text class="shortcut-title">琐碎回忆</text><text class="shortcut-subtitle">记录第一次成团</text>
        <view class="shortcut-icon-slot" aria-hidden="true"><image wx:if="{{shortcutIconPaths.memories}}" src="{{shortcutIconPaths.memories}}" mode="aspectFit" /></view>
        <view class="shortcut-arrow" aria-hidden="true">›</view>
      </button>
      <view class="home-shortcut home-shortcut--placeholder" aria-hidden="true">
        <text class="shortcut-title">暂定</text><text class="shortcut-subtitle">模块占位</text>
        <view class="shortcut-icon-slot" aria-hidden="true"><image wx:if="{{shortcutIconPaths.placeholder}}" src="{{shortcutIconPaths.placeholder}}" mode="aspectFit" /></view>
      </view>
    </view>

    <view id="home-directory-tools" class="directory-tools {{searchPanelVisible ? 'directory-tools--expanded' : ''}}" aria-hidden="{{!searchPanelVisible}}" aria-label="活动搜索与筛选">
      <view class="search-row">
        <view class="search-symbol" aria-hidden="true"></view>
        <input class="search-input" value="{{keyword}}" placeholder="搜索活动、地点或发起人" placeholder-class="search-placeholder" confirm-type="search" aria-label="搜索活动、地点或发起人" bindinput="handleKeywordInput" bindconfirm="handleSearch" />
        <button wx:if="{{keyword}}" class="search-clear-button" bindtap="handleClearKeyword" hover-class="control--pressed" aria-label="清空搜索关键词">×</button>
        <button class="search-submit-button" bindtap="handleSearch" hover-class="control--pressed" aria-label="执行搜索">搜索</button>
      </view>
      <scroll-view class="filter-scroll" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}" enable-flex="{{true}}" role="tablist" aria-label="选择拼单类型">
        <view class="filter-track">
          <button wx:for="{{typeOptions}}" wx:key="value" class="filter-chip {{type === item.value ? 'filter-chip--active' : ''}}" data-value="{{item.value}}" bindtap="handleTypeChange" role="tab" aria-selected="{{type === item.value}}">
            <image class="filter-icon" src="{{item.iconSrc}}" mode="aspectFit" aria-hidden="true" /><text>{{item.label}}</text>
          </button>
        </view>
      </scroll-view>
    </view>

    <view id="hot-pinba-heading" class="home-activity-heading" role="heading" aria-level="2">
      <view class="section-title-row"><text class="section-title">{{hasActiveFilters ? '筛选结果' : '附近拼吧'}}</text><text wx:if="{{!hasActiveFilters}}" class="section-title-detail">· 正在发生</text></view>
      <button wx:if="{{hasNextPage}}" class="load-more-heading {{isPaging || refreshing ? 'load-more-heading--disabled' : ''}}" bindtap="handleLoadMore" disabled="{{isPaging || refreshing}}" hover-class="load-more-heading--pressed" aria-label="查看更多附近活动"><text>{{isPaging ? '正在发现...' : '查看更多'}}</text><text wx:if="{{!isPaging}}" aria-hidden="true"> ›</text></button>
      <button wx:elif="{{hasActiveFilters}}" class="clear-filter-button" bindtap="handleClearFilters">清除筛选</button>
    </view>

    <view class="home-activity-stream">
      <view wx:if="{{loading}}" class="home-activity-grid {{largeTextMode ? 'home-activity-grid--large-text' : ''}}" aria-label="正在加载活动">
        <view wx:for="{{[1,2,3]}}" wx:key="*this" class="activity-skeleton-card" aria-hidden="true"><view class="activity-skeleton-owner"><view class="activity-skeleton-avatar"></view><view class="activity-skeleton-line activity-skeleton-line--owner"></view></view><view class="activity-skeleton-line activity-skeleton-line--title"></view><view class="activity-skeleton-line activity-skeleton-line--title-short"></view><view class="activity-skeleton-cover"></view></view>
      </view>
      <view wx:elif="{{activities.length}}" class="home-activity-grid {{largeTextMode ? 'home-activity-grid--large-text' : ''}}">
        <activity-card wx:for="{{activities}}" wx:key="id" item="{{item}}" variant="home-preview" large-text="{{largeTextMode}}" bindselect="handleCardSelect" />
        <block wx:if="{{isPaging}}"><view wx:for="{{[1,2,3]}}" wx:key="*this" class="activity-skeleton-card" aria-hidden="true"><view class="activity-skeleton-owner"><view class="activity-skeleton-avatar"></view><view class="activity-skeleton-line activity-skeleton-line--owner"></view></view><view class="activity-skeleton-line activity-skeleton-line--title"></view><view class="activity-skeleton-line activity-skeleton-line--title-short"></view><view class="activity-skeleton-cover"></view></view></block>
      </view>
      <view wx:else class="empty-state-shell"><empty-state symbol="{{error ? '!' : '+'}}" title="{{error || (hasActiveFilters ? '没有找到合适的活动' : '暂时还没有拼单')}}" description="{{error ? '检查网络后重试，已加载内容不会丢失。' : (hasActiveFilters ? '换个类型或关键词再试试。' : '发起一个拼单，邀请附近伙伴加入。')}}" action-text="{{error ? '重新加载' : (hasActiveFilters ? '清除筛选' : (hasNextPage ? '查看更多' : '去发起拼单'))}}" bindaction="handleEmptyAction" /></view>
    </view>

  </view>
</view>
