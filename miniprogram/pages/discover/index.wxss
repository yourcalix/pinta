.discover-page {
  padding-top: 30rpx;
}

.hero,
.search-row,
.list-heading,
.scene-tabs-inner {
  display: flex;
  align-items: center;
}

.hero,
.list-heading {
  justify-content: space-between;
}

.eyebrow {
  color: #5e6c64;
  font-size: 24rpx;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 720;
  letter-spacing: -1rpx;
}

.city-pill {
  padding: 14rpx 22rpx;
  color: #11784f;
  background: #e8f5ee;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.search-row {
  min-height: 92rpx;
  margin-top: 30rpx;
  padding: 10rpx 12rpx 10rpx 22rpx;
}

.search-symbol {
  margin-right: 12rpx;
  color: #758079;
  font-size: 36rpx;
}

.search-input {
  flex: 1;
  min-height: 68rpx;
  font-size: 27rpx;
}

.search-button {
  min-height: 66rpx;
  margin: 0;
  padding: 12rpx 24rpx;
  color: #fff;
  background: #16a36a;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.scene-tabs {
  width: 100%;
  margin-top: 26rpx;
  white-space: nowrap;
}

.scene-tabs-inner {
  gap: 14rpx;
}

.scene-tab {
  min-width: 120rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 14rpx 24rpx;
  color: #4c5851;
  background: #fff;
  border: 1rpx solid #e2e8e4;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.scene-tab--active {
  color: #fff;
  background: #183c2c;
  border-color: #183c2c;
}

.list-heading {
  margin: 34rpx 0 18rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.list-count {
  color: #7a857f;
  font-size: 24rpx;
  font-weight: 400;
}

.skeleton-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.skeleton-line {
  height: 22rpx;
  margin-top: 20rpx;
  background: #edf1ef;
  border-radius: 10rpx;
}

.skeleton-line:first-child {
  margin-top: 0;
}

.skeleton-line--short { width: 28%; }
.skeleton-line--title { width: 72%; height: 34rpx; }
.skeleton-line--medium { width: 52%; }
