.discover-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 0;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  padding-left: 0;
  overflow-x: hidden;
  background: #075aa7;
}

.discover-content {
  position: relative;
  z-index: 2;
  padding: 8rpx 28rpx 0;
}

.discover-header,
.search-row,
.list-heading,
.list-heading-title,
.list-heading-meta,
.filter-track {
  display: flex;
  align-items: center;
}

.discover-header {
  position: relative;
  min-height: 108rpx;
  justify-content: space-between;
  gap: 24rpx;
}

.discover-header-copy { min-width: 0; }

.discover-eyebrow {
  color: rgba(255, 248, 232, 0.7);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.discover-title {
  margin-top: 5rpx;
  color: #fff4d8;
  font-size: 42rpx;
  font-weight: 760;
  line-height: 1.2;
  letter-spacing: 1rpx;
  text-shadow: 0 3rpx 0 rgba(4, 48, 104, 0.32);
}

.discover-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 248, 232, 0.86);
  font-size: 23rpx;
  line-height: 1.4;
}

.header-doodle {
  position: relative;
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 74rpx;
  opacity: 0.88;
  transform: rotate(-8deg);
}

.header-doodle-line {
  position: absolute;
  right: 2rpx;
  bottom: 9rpx;
  width: 76rpx;
  height: 34rpx;
  border-top: 5rpx solid #fff0c9;
  border-radius: 50%;
  transform: rotate(18deg);
}

.header-doodle-leaf {
  position: absolute;
  width: 24rpx;
  height: 11rpx;
  border: 4rpx solid #9ccc3b;
  border-radius: 70% 20% 70% 20%;
}

.header-doodle-leaf--left { top: 8rpx; left: 26rpx; transform: rotate(54deg); }
.header-doodle-leaf--right { top: 2rpx; right: 14rpx; transform: rotate(-18deg); }

.search-row {
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 0 6rpx 0 22rpx;
  color: #102a43;
  background: #fff8ee;
  border: 3rpx solid rgba(255, 240, 201, 0.86);
  border-radius: 28rpx 34rpx 30rpx 26rpx;
  box-shadow: 0 10rpx 0 rgba(4, 48, 104, 0.18), 0 18rpx 32rpx rgba(3, 41, 91, 0.2);
}

.search-symbol {
  display: flex;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 10rpx;
  color: #16385c;
}

.search-glyph {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.search-glyph-handle {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 999rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  color: #102a43;
  font-size: 26rpx;
}

.search-placeholder { color: #8b8b82; }

.search-clear-button,
.search-submit-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.search-clear-button { min-width: 88rpx; margin-right: 12rpx; color: #6c6f6a; font-size: 38rpx; }
.search-submit-button { min-width: 88rpx; color: #087c55; font-size: 24rpx; font-weight: 700; }

.filter-scroll {
  width: calc(100% + 28rpx);
  margin-top: 24rpx;
  white-space: nowrap;
}

.filter-track {
  display: inline-flex;
  min-width: 100%;
  align-items: center;
  gap: 14rpx;
  padding-right: 28rpx;
}

.filter-chip {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 144rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 10rpx 20rpx 10rpx 14rpx;
  color: #111;
  background: #fff8ee;
  border: 3rpx solid rgba(255, 240, 201, 0.9);
  border-radius: 25rpx 22rpx 27rpx 23rpx;
  box-shadow: 0 6rpx 0 rgba(4, 48, 104, 0.17);
  font-size: 25rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.chip-icon-box {
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 48rpx;
  height: 48rpx;
  margin-right: 8rpx;
  pointer-events: none;
}

.chip-icon-img {
  display: block;
  width: 100%;
  height: 100%;
  filter: grayscale(1) brightness(0);
  pointer-events: none;
}

.chip-label { pointer-events: none; }

.filter-chip--active {
  color: #111;
  background: #e4f6ea;
  border-color: #b8dfc5;
  box-shadow: 0 6rpx 0 rgba(77, 137, 98, 0.24);
  font-weight: 700;
}

.search-clear-button::after,
.search-submit-button::after,
.filter-chip::after,
.clear-filter-button::after,
.footer-retry-button::after { display: none; }

.list-heading {
  min-height: 88rpx;
  margin: 24rpx 0 12rpx;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  color: #fff4d8;
  font-size: 31rpx;
  font-weight: 700;
}

.list-heading-title { gap: 12rpx; }

.list-heading-mark {
  width: 32rpx;
  height: 8rpx;
  background: #9ccc3b;
  border-radius: 50%;
  transform: rotate(-8deg);
}

.list-heading-meta {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  margin-left: auto;
}

.list-count { color: rgba(255, 248, 232, 0.78); font-size: 23rpx; font-weight: 500; }

.clear-filter-button {
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  color: #fff8ee;
  background: rgba(255, 248, 232, 0.12);
  border: 2rpx solid rgba(255, 248, 232, 0.42);
  border-radius: 22rpx;
  font-size: 23rpx;
  line-height: 1.3;
}

.skeleton-card,
.empty-state-shell {
  background: #fff8ee;
  border: 3rpx solid rgba(255, 240, 201, 0.9);
  box-shadow: 0 10rpx 0 rgba(4, 48, 104, 0.2), 0 18rpx 32rpx rgba(3, 41, 91, 0.18);
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  min-height: 300rpx;
  margin-bottom: 20rpx;
  padding: 18rpx;
  border-radius: 28rpx 24rpx 30rpx 26rpx;
}
.skeleton-cover { flex: 0 0 200rpx; width: 200rpx; height: 254rpx; background: #e8ddce; border-radius: 20rpx; }
.skeleton-copy { flex: 1; min-width: 0; }

.skeleton-line {
  height: 22rpx;
  margin-top: 18rpx;
  background: #e8ddce;
  border-radius: 10rpx;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.skeleton-line:first-child { margin-top: 0; }
.skeleton-line--short { width: 28%; }
.skeleton-line--title { width: 72%; height: 34rpx; }
.skeleton-line--medium { width: 52%; }

.empty-state-shell {
  overflow: hidden;
  border-radius: 30rpx 25rpx 32rpx 27rpx;
}

.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom));
}

.footer-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: rgba(255, 248, 232, 0.86);
  font-size: 24rpx;
}

.footer-state--end { color: rgba(255, 248, 232, 0.66); }

.footer-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 248, 232, 0.34);
  border-top-color: #fff8ee;
  border-radius: 50%;
  animation: footer-spin 0.8s linear infinite;
}

.footer-retry-button {
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 32rpx;
  color: #0b704f;
  background: #fff8ee;
  border-radius: 44rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

@media (max-width: 340px) {
  .skeleton-card { gap: 16rpx; padding: 16rpx; }
  .skeleton-cover { flex-basis: 170rpx; width: 170rpx; height: 230rpx; }
  .discover-content { padding-right: 22rpx; padding-left: 22rpx; }
  .discover-title { font-size: 38rpx; }
  .discover-subtitle { font-size: 22rpx; }
  .header-doodle { flex-basis: 72rpx; width: 72rpx; transform: scale(0.88) rotate(-8deg); }
  .search-row { padding-left: 16rpx; }
  .search-submit-button { min-width: 78rpx; }
  .filter-scroll { width: calc(100% + 22rpx); }
  .filter-track { gap: 10rpx; }
  .filter-chip { min-width: 128rpx; padding: 8rpx 16rpx 8rpx 12rpx; font-size: 23rpx; }
  .chip-icon-box { flex-basis: 42rpx; width: 42rpx; height: 42rpx; margin-right: 6rpx; }
}

@keyframes footer-spin { to { transform: rotate(360deg); } }
@keyframes skeleton-pulse { to { opacity: 0.54; } }
