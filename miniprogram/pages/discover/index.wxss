.discover-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  overflow-x: hidden;
  background: #075aa7;
}

.discover-hero {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  min-height: 340rpx;
  padding: 12rpx 32rpx 64rpx;
}

.discover-header,
.search-row,
.list-heading,
.list-heading-title,
.list-heading-meta,
.filter-track {
  display: flex;
  align-items: center;
}

.discover-header {
  position: relative;
  min-height: 210rpx;
  justify-content: space-between;
  gap: 24rpx;
}

.discover-header-copy { min-width: 0; }

.discover-eyebrow {
  color: rgba(255, 255, 255, 0.64);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 4rpx;
}

.discover-art-title {
  display: inline-flex;
  align-items: baseline;
  margin-top: 10rpx;
  color: #fff;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(1, 35, 76, 0.42), 0 2rpx 4rpx rgba(0, 0, 0, 0.22);
  transform: rotate(-3deg);
  transform-origin: left center;
}

.discover-art-title-accent { color: #ffe600; }

.discover-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.4;
}

.header-doodle {
  position: relative;
  flex: 0 0 86rpx;
  width: 86rpx;
  height: 70rpx;
  opacity: 0.72;
  transform: rotate(-8deg);
}

.header-doodle-line {
  position: absolute;
  right: 2rpx;
  bottom: 9rpx;
  width: 72rpx;
  height: 32rpx;
  border-top: 4rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 50%;
  transform: rotate(18deg);
}

.header-doodle-leaf {
  position: absolute;
  width: 22rpx;
  height: 10rpx;
  border: 4rpx solid #9ccc3b;
  border-radius: 70% 20% 70% 20%;
}

.header-doodle-leaf--left { top: 8rpx; left: 24rpx; transform: rotate(54deg); }
.header-doodle-leaf--right { top: 2rpx; right: 12rpx; transform: rotate(-18deg); }

.discover-sheet {
  position: relative;
  z-index: 3;
  box-sizing: border-box;
  width: 100vw;
  min-height: calc(100vh - 340rpx);
  margin-top: -36rpx;
  padding: 28rpx 28rpx 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
}

.campaign-shell {
  position: relative;
  width: 100%;
  margin: 0 auto 24rpx;
  overflow: hidden;
  background: #f3f4f6;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  isolation: isolate;
  transform: translateZ(0);
}

.campaign-swiper {
  width: 100%;
  height: 304rpx;
  aspect-ratio: 16 / 7;
  overflow: hidden;
  border-radius: 24rpx;
  transform: translateZ(0);
}

.campaign-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #fff;
  border-radius: 24rpx;
  isolation: isolate;
  transform: translateZ(0);
  transition: opacity 80ms ease;
}

.campaign-card--pressed { opacity: 0.9; }

.campaign-card--sport {
  background: linear-gradient(135deg, #15865d 0%, #0f6d4a 48%, #08442f 100%);
}

.campaign-card--companion {
  background: linear-gradient(135deg, #1674bd 0%, #075aa7 52%, #123c71 100%);
}

.campaign-card--guide {
  color: #10233d;
  background: linear-gradient(135deg, #f7f5ef 0%, #e8f3ef 56%, #cde9df 100%);
}

.campaign-card::before,
.campaign-card::after {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  content: '';
  pointer-events: none;
}

.campaign-card::before {
  top: -112rpx;
  right: 114rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
}

.campaign-card::after {
  right: -68rpx;
  bottom: -128rpx;
  width: 340rpx;
  height: 340rpx;
  background: rgba(255, 255, 255, 0.12);
}

.campaign-copy {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 64%;
  height: 100%;
  padding: 32rpx 0 28rpx 32rpx;
}

.campaign-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 14rpx;
  color: inherit;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.2;
}

.campaign-card--guide .campaign-eyebrow {
  background: rgba(22, 163, 106, 0.1);
  border-color: rgba(22, 163, 106, 0.22);
}

.campaign-pin { color: #b8df4b; font-size: 14rpx; }

.campaign-title {
  max-width: 400rpx;
  margin-top: 18rpx;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campaign-subtitle {
  max-width: 400rpx;
  margin-top: 9rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campaign-card--guide .campaign-subtitle { color: rgba(16, 35, 61, 0.62); }

.campaign-action {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  color: #0f5137;
  background: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.campaign-card--guide .campaign-action { color: #fff; background: #16a36a; }

.campaign-art {
  position: absolute;
  z-index: 1;
  top: 8rpx;
  right: -12rpx;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 42%;
  pointer-events: none;
}

.campaign-image { display: block; width: 100%; height: 100%; }

.campaign-art-fallback {
  align-self: center;
  color: rgba(255, 255, 255, 0.66);
  font-size: 86rpx;
}

.campaign-card--guide .campaign-art-fallback { color: rgba(22, 163, 106, 0.45); }

.campaign-dots {
  position: absolute;
  z-index: 4;
  right: 18rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}

.campaign-dot {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.58);
  border-radius: 4rpx;
  transition: width 180ms ease, background-color 180ms ease;
}

.campaign-dot--active { width: 24rpx; background: #b8df4b; }

.directory-tools {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 14rpx;
  overflow: hidden;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 24rpx;
}

.search-row {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 8rpx 0 22rpx;
  color: #111827;
  background: #fff;
  border: 1rpx solid #e8edf2;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.035);
}

.search-symbol {
  display: flex;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  color: #6b7280;
}

.search-glyph {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.search-glyph-handle {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 999rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  color: #111827;
  font-size: 26rpx;
}

.search-placeholder { color: #9ca3af; }

.search-clear-button,
.search-submit-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.search-clear-button { min-width: 88rpx; margin-right: 12rpx; color: #6b7280; font-size: 36rpx; }
.search-clear--pressed { opacity: 0.6; }
.search-submit-button { min-width: 88rpx; color: #16a36a; font-size: 24rpx; font-weight: 700; }

.filter-scroll {
  width: 100%;
  margin-top: 8rpx;
  white-space: nowrap;
}

.filter-track {
  display: inline-flex;
  min-width: 100%;
  gap: 8rpx;
  padding-right: 0;
}

.filter-chip {
  position: relative;
  display: inline-flex;
  flex: 1 0 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 10rpx 8rpx;
  color: #4b5563;
  background: transparent;
  border: 0;
  box-shadow: none;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.filter-chip::before {
  position: absolute;
  z-index: 0;
  top: 12rpx;
  right: 0;
  bottom: 12rpx;
  left: 0;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.74);
  border: 1.5rpx solid transparent;
  border-radius: 16rpx;
  content: '';
  pointer-events: none;
}

.chip-icon-box {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 48rpx;
  height: 48rpx;
  margin-right: 8rpx;
  pointer-events: none;
}

.chip-icon-img { display: block; width: 100%; height: 100%; pointer-events: none; }
.chip-label { position: relative; z-index: 1; pointer-events: none; }

.filter-chip--active { color: #16a36a; font-weight: 700; }
.filter-chip--active::before { background: rgba(22, 163, 106, 0.1); border-color: rgba(22, 163, 106, 0.5); }

.search-clear-button::after,
.search-submit-button::after,
.filter-chip::after,
.clear-filter-button::after,
.footer-retry-button::after { display: none; }

.session-heading {
  position: relative;
  box-sizing: border-box;
  min-height: 98rpx;
  margin: 8rpx 0 18rpx;
  padding-top: 18rpx;
}

.session-heading-watermark {
  position: absolute;
  top: 0;
  left: 30rpx;
  color: rgba(148, 163, 184, 0.2);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 4rpx;
  pointer-events: none;
}

.list-heading {
  min-height: 72rpx;
  margin: 0;
  padding-top: 16rpx;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.list-heading-title { gap: 12rpx; }
.list-heading-mark { width: 8rpx; height: 34rpx; background: #16a36a; border-radius: 999rpx; }
.session-heading-title { color: #111827; font-size: 32rpx; font-weight: 760; }

.list-heading-meta {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  margin-left: auto;
}

.list-count { color: #9ca3af; font-size: 24rpx; font-weight: 500; }

.clear-filter-button {
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  color: #16a36a;
  background: rgba(22, 163, 106, 0.08);
  border: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.3;
}

.skeleton-card,
.empty-state-shell {
  box-sizing: border-box;
  background: #fff;
  border: 1.5rpx solid #f3f4f6;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 204rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
}

.skeleton-cover { flex: 0 0 160rpx; width: 160rpx; height: 160rpx; background: #f1f3f5; border-radius: 18rpx; }
.skeleton-copy { flex: 1; min-width: 0; }

.skeleton-line {
  height: 20rpx;
  margin-top: 16rpx;
  background: #eef0f2;
  border-radius: 10rpx;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.skeleton-line:first-child { margin-top: 0; }
.skeleton-line--short { width: 28%; }
.skeleton-line--title { width: 72%; height: 32rpx; }
.skeleton-line--medium { width: 52%; }

.empty-state-shell { overflow: hidden; border-radius: 24rpx; }

.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 0 8rpx;
}

.footer-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.footer-state--end { color: #c4c9d0; }

.page-end-marker { margin-top: 36rpx; }

.footer-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #dfe3e8;
  border-top-color: #16a36a;
  border-radius: 50%;
  animation: footer-spin 0.8s linear infinite;
}

.footer-retry-button {
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 32rpx;
  color: #16a36a;
  background: rgba(22, 163, 106, 0.08);
  border-radius: 44rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.memory-section {
  margin-top: 40rpx;
  animation: memory-fade-in 200ms ease-out both;
}

.memory-section-heading {
  position: relative;
  box-sizing: border-box;
  height: 100rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.memory-heading-watermark {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  color: rgba(203, 213, 225, 0.62);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 4rpx;
}

.memory-title {
  position: relative;
  z-index: 1;
  padding-top: 28rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 740;
  line-height: 1.25;
}

.memory-panel {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  min-height: 860rpx;
  aspect-ratio: 347 / 430;
  margin-bottom: 24rpx;
  overflow: hidden;
  padding: 24rpx;
  color: #fff;
  background: linear-gradient(180deg, #4fa4f8 0%, #207be5 100%);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(32, 123, 229, 0.25);
  isolation: isolate;
}

.memory-panel--teaser { pointer-events: none; }

.memory-panel-background,
.memory-panel-background-shade {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.memory-panel-background {
  opacity: 0.62;
}

.memory-panel-background-shade {
  background: linear-gradient(180deg, rgba(32, 123, 229, 0.04) 0%, rgba(32, 123, 229, 0.16) 42%, rgba(15, 91, 177, 0.36) 100%);
}

.memory-panel-glow {
  position: absolute;
  z-index: 0;
  top: -120rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.memory-panel-masthead {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 196rpx;
  padding: 0 14rpx 20rpx;
}

.memory-art-title {
  display: inline-block;
  width: auto;
  max-width: 100%;
  color: #fff;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(12, 60, 130, 0.45), 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  transform: rotate(-3deg);
  transform-origin: left center;
}

.memory-art-title-first {
  font-size: 42rpx;
  line-height: 1.15;
}

.memory-art-title-second {
  display: flex;
  align-items: center;
  margin-top: -2rpx;
  font-size: 52rpx;
  line-height: 1.08;
}

.memory-panel-masthead-accent { color: #ffe600; }

.memory-camera {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 36rpx;
  margin-left: 14rpx;
  border: 2rpx solid #fff;
  border-radius: 6rpx;
  transform: rotate(12deg) translateY(2rpx);
}

.memory-camera::before {
  position: absolute;
  top: -8rpx;
  left: 7rpx;
  width: 15rpx;
  height: 7rpx;
  background: #fff;
  border-radius: 3rpx 3rpx 0 0;
  content: '';
}

.memory-camera-lens {
  position: absolute;
  top: 8rpx;
  left: 15rpx;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
}

.memory-panel-masthead-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  line-height: 1.4;
  text-shadow: 0 2rpx 8rpx rgba(12, 60, 130, 0.35);
}

.memory-grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 16rpx;
}

.memory-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 286rpx 286rpx; }

.memory-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
  height: 286rpx;
  color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx dashed rgba(255, 255, 255, 0.35);
  border-radius: 22rpx;
  pointer-events: none;
}

.memory-placeholder--top { grid-column: 2; grid-row: 1; }
.memory-placeholder--bottom { grid-column: 2; grid-row: 2; }
.memory-placeholder--lead { grid-column: 1; grid-row: 1 / 3; height: 588rpx; }

.memory-placeholder-camera {
  position: relative;
  box-sizing: border-box;
  width: 36rpx;
  height: 29rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.62);
  border-radius: 6rpx;
  transform: rotate(-4deg);
}

.memory-placeholder-camera::before {
  position: absolute;
  top: -7rpx;
  left: 6rpx;
  width: 12rpx;
  height: 6rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.62);
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
  content: '';
}

.memory-placeholder-lens {
  position: absolute;
  top: 7rpx;
  left: 12rpx;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.62);
  border-radius: 50%;
}

.memory-placeholder-copy {
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.35;
  text-align: center;
}

.memory-placeholder-copy text { display: block; margin-top: 3rpx; }

@media (max-width: 340px) {
  .discover-hero { min-height: 300rpx; padding-right: 24rpx; padding-left: 24rpx; }
  .discover-header { min-height: 174rpx; }
  .discover-eyebrow { font-size: 18rpx; }
  .discover-art-title { font-size: 42rpx; }
  .discover-subtitle { margin-top: 10rpx; font-size: 20rpx; }
  .header-doodle { flex-basis: 68rpx; width: 68rpx; transform: scale(0.84) rotate(-8deg); }
  .discover-sheet { margin-top: -28rpx; padding-right: 20rpx; padding-left: 20rpx; border-radius: 28rpx 28rpx 0 0; }
  .campaign-shell,
  .campaign-swiper,
  .campaign-card { border-radius: 18rpx; }
  .campaign-swiper { height: 262rpx; }
  .campaign-copy { width: 67%; padding: 24rpx 0 22rpx 24rpx; }
  .campaign-title { margin-top: 12rpx; font-size: 29rpx; }
  .campaign-subtitle { margin-top: 6rpx; font-size: 20rpx; }
  .campaign-action { margin-top: 10rpx; }
  .campaign-art { right: -18rpx; width: 40%; }
  .directory-tools { padding: 12rpx; border-radius: 20rpx; }
  .search-row { padding-left: 14rpx; border-radius: 15rpx; }
  .search-submit-button { min-width: 88rpx; }
  .filter-track { gap: 4rpx; }
  .filter-chip { padding-right: 4rpx; padding-left: 4rpx; font-size: 20rpx; }
  .chip-icon-box { flex-basis: 42rpx; width: 42rpx; height: 42rpx; margin-right: 4rpx; }
  .session-heading { min-height: 90rpx; margin-bottom: 14rpx; }
  .session-heading-watermark { left: 26rpx; font-size: 21rpx; }
  .session-heading-title { font-size: 29rpx; }
  .skeleton-card { gap: 16rpx; padding: 16rpx; }
  .skeleton-cover { flex-basis: 140rpx; width: 140rpx; height: 140rpx; }
  .memory-section { margin-top: 32rpx; }
  .memory-section-heading { height: 88rpx; margin-bottom: 18rpx; }
  .memory-heading-watermark { font-size: 22rpx; }
  .memory-title { padding-top: 23rpx; font-size: 30rpx; }
  .memory-panel { min-height: 744rpx; padding: 18rpx; border-radius: 24rpx; }
  .memory-panel-masthead { min-height: 200rpx; padding: 0 10rpx 14rpx; }
  .memory-art-title-first { font-size: 36rpx; }
  .memory-art-title-second { font-size: 44rpx; }
  .memory-camera { flex-basis: 36rpx; width: 36rpx; height: 30rpx; }
  .memory-camera-lens { top: 6rpx; left: 12rpx; }
  .memory-panel-masthead-sub { font-size: 20rpx; }
  .memory-grid { gap: 12rpx; }
  .memory-grid--3 { grid-template-rows: 248rpx 248rpx; }
  .memory-placeholder--lead { height: 508rpx; }
  .memory-placeholder { height: 248rpx; border-radius: 18rpx; }
}

@keyframes footer-spin { to { transform: rotate(360deg); } }
@keyframes skeleton-pulse { to { opacity: 0.54; } }
@keyframes memory-fade-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
