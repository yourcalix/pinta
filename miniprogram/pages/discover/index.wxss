.discover-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  overflow-x: hidden;
  background: #075aa7;
}

.discover-hero {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  min-height: 304rpx;
  padding: 8rpx 32rpx 58rpx;
}

.discover-header,
.search-row,
.list-heading,
.list-heading-title,
.list-heading-meta,
.filter-track {
  display: flex;
  align-items: center;
}

.discover-header {
  position: relative;
  min-height: 146rpx;
  justify-content: space-between;
  gap: 24rpx;
}

.discover-header-copy { min-width: 0; }

.discover-eyebrow {
  color: rgba(255, 255, 255, 0.64);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.discover-title {
  margin-top: 8rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 760;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.discover-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.4;
}

.header-doodle {
  position: relative;
  flex: 0 0 86rpx;
  width: 86rpx;
  height: 70rpx;
  opacity: 0.72;
  transform: rotate(-8deg);
}

.header-doodle-line {
  position: absolute;
  right: 2rpx;
  bottom: 9rpx;
  width: 72rpx;
  height: 32rpx;
  border-top: 4rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 50%;
  transform: rotate(18deg);
}

.header-doodle-leaf {
  position: absolute;
  width: 22rpx;
  height: 10rpx;
  border: 4rpx solid #9ccc3b;
  border-radius: 70% 20% 70% 20%;
}

.header-doodle-leaf--left { top: 8rpx; left: 24rpx; transform: rotate(54deg); }
.header-doodle-leaf--right { top: 2rpx; right: 12rpx; transform: rotate(-18deg); }

.discover-sheet {
  position: relative;
  z-index: 3;
  box-sizing: border-box;
  width: 100vw;
  min-height: calc(100vh - 304rpx);
  margin-top: -36rpx;
  padding: 32rpx 28rpx 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
}

.campaign-shell {
  position: relative;
  width: 100%;
  margin: 0 auto 24rpx;
  overflow: hidden;
  background: #f3f4f6;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
  isolation: isolate;
  transform: translateZ(0);
}

.campaign-swiper {
  width: 100%;
  height: 304rpx;
  aspect-ratio: 16 / 7;
  overflow: hidden;
  border-radius: 24rpx;
  transform: translateZ(0);
}

.campaign-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #fff;
  border-radius: 24rpx;
  isolation: isolate;
  transform: translateZ(0);
  transition: opacity 80ms ease;
}

.campaign-card--pressed { opacity: 0.9; }

.campaign-card--sport {
  background: linear-gradient(135deg, #15865d 0%, #0f6d4a 48%, #08442f 100%);
}

.campaign-card--companion {
  background: linear-gradient(135deg, #1674bd 0%, #075aa7 52%, #123c71 100%);
}

.campaign-card--guide {
  color: #10233d;
  background: linear-gradient(135deg, #f7f5ef 0%, #e8f3ef 56%, #cde9df 100%);
}

.campaign-card::before,
.campaign-card::after {
  position: absolute;
  z-index: 0;
  border-radius: 50%;
  content: '';
  pointer-events: none;
}

.campaign-card::before {
  top: -112rpx;
  right: 114rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
}

.campaign-card::after {
  right: -68rpx;
  bottom: -128rpx;
  width: 340rpx;
  height: 340rpx;
  background: rgba(255, 255, 255, 0.12);
}

.campaign-copy {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 64%;
  height: 100%;
  padding: 32rpx 0 28rpx 32rpx;
}

.campaign-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 7rpx 14rpx;
  color: inherit;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.2;
}

.campaign-card--guide .campaign-eyebrow {
  background: rgba(22, 163, 106, 0.1);
  border-color: rgba(22, 163, 106, 0.22);
}

.campaign-pin { color: #b8df4b; font-size: 14rpx; }

.campaign-title {
  max-width: 400rpx;
  margin-top: 18rpx;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campaign-subtitle {
  max-width: 400rpx;
  margin-top: 9rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campaign-card--guide .campaign-subtitle { color: rgba(16, 35, 61, 0.62); }

.campaign-action {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-top: 16rpx;
  padding: 0 16rpx;
  color: #0f5137;
  background: #fff;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.campaign-card--guide .campaign-action { color: #fff; background: #16a36a; }

.campaign-art {
  position: absolute;
  z-index: 1;
  top: 8rpx;
  right: -12rpx;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 42%;
  pointer-events: none;
}

.campaign-image { display: block; width: 100%; height: 100%; }

.campaign-art-fallback {
  align-self: center;
  color: rgba(255, 255, 255, 0.66);
  font-size: 86rpx;
}

.campaign-card--guide .campaign-art-fallback { color: rgba(22, 163, 106, 0.45); }

.campaign-dots {
  position: absolute;
  z-index: 4;
  right: 18rpx;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  pointer-events: none;
}

.campaign-dot {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.58);
  border-radius: 4rpx;
  transition: width 180ms ease, background-color 180ms ease;
}

.campaign-dot--active { width: 24rpx; background: #b8df4b; }

.search-row {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 8rpx 0 22rpx;
  color: #111827;
  background: #f3f4f6;
  border-radius: 20rpx;
}

.search-symbol {
  display: flex;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  color: #6b7280;
}

.search-glyph {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.search-glyph-handle {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 14rpx;
  height: 4rpx;
  background: currentColor;
  border-radius: 999rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  color: #111827;
  font-size: 26rpx;
}

.search-placeholder { color: #9ca3af; }

.search-clear-button,
.search-submit-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.search-clear-button { min-width: 88rpx; margin-right: 12rpx; color: #6b7280; font-size: 36rpx; }
.search-submit-button { min-width: 88rpx; color: #16a36a; font-size: 24rpx; font-weight: 700; }

.filter-scroll {
  width: calc(100% + 28rpx);
  margin-top: 18rpx;
  white-space: nowrap;
}

.filter-track {
  display: inline-flex;
  min-width: 100%;
  gap: 12rpx;
  padding-right: 28rpx;
}

.filter-chip {
  position: relative;
  display: inline-flex;
  flex: 1 0 144rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 144rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 10rpx 16rpx 10rpx 12rpx;
  color: #4b5563;
  background: transparent;
  border: 0;
  box-shadow: none;
  font-size: 24rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.filter-chip::before {
  position: absolute;
  z-index: 0;
  top: 12rpx;
  right: 0;
  bottom: 12rpx;
  left: 0;
  box-sizing: border-box;
  background: #f6f7f9;
  border: 1.5rpx solid transparent;
  border-radius: 16rpx;
  content: '';
  pointer-events: none;
}

.chip-icon-box {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 48rpx;
  height: 48rpx;
  margin-right: 8rpx;
  pointer-events: none;
}

.chip-icon-img { display: block; width: 100%; height: 100%; pointer-events: none; }
.chip-label { position: relative; z-index: 1; pointer-events: none; }

.filter-chip--active { color: #16a36a; font-weight: 700; }
.filter-chip--active::before { background: rgba(22, 163, 106, 0.1); border-color: rgba(22, 163, 106, 0.5); }

.search-clear-button::after,
.search-submit-button::after,
.filter-chip::after,
.clear-filter-button::after,
.footer-retry-button::after { display: none; }

.list-heading {
  min-height: 72rpx;
  margin: 20rpx 0 14rpx;
  padding-top: 14rpx;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  color: #111827;
  border-top: 1rpx solid #f3f4f6;
  font-size: 30rpx;
  font-weight: 700;
}

.list-heading-title { gap: 12rpx; }
.list-heading-mark { width: 18rpx; height: 8rpx; background: #16a36a; border-radius: 999rpx; }

.list-heading-meta {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  margin-left: auto;
}

.list-count { color: #9ca3af; font-size: 24rpx; font-weight: 500; }

.clear-filter-button {
  min-height: 72rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  color: #16a36a;
  background: rgba(22, 163, 106, 0.08);
  border: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.3;
}

.skeleton-card,
.empty-state-shell {
  box-sizing: border-box;
  background: #fff;
  border: 1.5rpx solid #f3f4f6;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.skeleton-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 204rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
}

.skeleton-cover { flex: 0 0 160rpx; width: 160rpx; height: 160rpx; background: #f1f3f5; border-radius: 18rpx; }
.skeleton-copy { flex: 1; min-width: 0; }

.skeleton-line {
  height: 20rpx;
  margin-top: 16rpx;
  background: #eef0f2;
  border-radius: 10rpx;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.skeleton-line:first-child { margin-top: 0; }
.skeleton-line--short { width: 28%; }
.skeleton-line--title { width: 72%; height: 32rpx; }
.skeleton-line--medium { width: 52%; }

.empty-state-shell { overflow: hidden; border-radius: 24rpx; }

.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 0 8rpx;
}

.footer-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.footer-state--end { color: #c4c9d0; }

.footer-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #dfe3e8;
  border-top-color: #16a36a;
  border-radius: 50%;
  animation: footer-spin 0.8s linear infinite;
}

.footer-retry-button {
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 32rpx;
  color: #16a36a;
  background: rgba(22, 163, 106, 0.08);
  border-radius: 44rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.memory-section {
  margin-top: 40rpx;
  animation: memory-fade-in 200ms ease-out both;
}

.memory-section-heading {
  position: relative;
  box-sizing: border-box;
  height: 100rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.memory-heading-watermark {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  color: rgba(203, 213, 225, 0.62);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 4rpx;
}

.memory-title {
  position: relative;
  z-index: 1;
  padding-top: 28rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 740;
  line-height: 1.25;
}

.memory-panel {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  overflow: hidden;
  padding: 24rpx;
  color: #fff;
  background: linear-gradient(180deg, #4fa4f8 0%, #207be5 100%);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(32, 123, 229, 0.25);
  isolation: isolate;
}

.memory-panel-glow {
  position: absolute;
  z-index: 0;
  top: -120rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.memory-panel-masthead {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 122rpx;
  padding: 10rpx 14rpx 20rpx;
}

.memory-panel-masthead-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 38rpx;
  font-weight: 780;
  line-height: 1.22;
  letter-spacing: 1rpx;
  text-shadow: 0 3rpx 12rpx rgba(0, 68, 150, 0.2);
}

.memory-panel-masthead-accent { color: #fff279; }

.memory-camera {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 25rpx;
  margin-left: 4rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 5rpx;
  transform: rotate(7deg);
}

.memory-camera::before {
  position: absolute;
  top: -9rpx;
  left: 5rpx;
  width: 13rpx;
  height: 7rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 3rpx 3rpx 0 0;
  content: '';
}

.memory-camera-lens {
  position: absolute;
  top: 4rpx;
  left: 10rpx;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}

.memory-panel-masthead-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  line-height: 1.35;
}

.memory-grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 16rpx;
}

.memory-grid--1 { display: block; }
.memory-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.memory-grid--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 252rpx 252rpx; }

.memory-card {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  height: 360rpx;
  overflow: hidden;
  background: #174b7a;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(1, 20, 43, 0.22);
  isolation: isolate;
  transition: opacity 80ms ease, transform 80ms ease;
}

.memory-grid--1 .memory-card { width: 100%; height: 300rpx; }
.memory-grid--3 .memory-card--lead { grid-row: 1 / 3; height: 520rpx; }
.memory-grid--3 .memory-card--top,
.memory-grid--3 .memory-card--bottom { height: 252rpx; }

.memory-card--pressed { opacity: 0.9; transform: scale(0.99); }

.memory-card--companion { background: linear-gradient(150deg, #66c7e9, #2368b7); }
.memory-card--sport { background: linear-gradient(150deg, #66c9aa, #3572ba); }
.memory-card--food { background: linear-gradient(150deg, #efae6f, #a74d59); }

.memory-art {
  position: absolute;
  z-index: 0;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.memory-art::before {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 65% 40%, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 60%);
  content: '';
}

.memory-image,
.memory-art image { display: block; width: 112%; height: 100%; transform: scale(1.14); }

.memory-grid--1 .memory-card--lead .memory-image,
.memory-grid--3 .memory-card--lead .memory-image {
  position: absolute;
  top: 40rpx;
  right: 20rpx;
  width: 320rpx;
  height: 320rpx;
  transform: none;
}

.memory-art-fallback {
  margin-top: 50rpx;
  color: rgba(255, 255, 255, 0.35);
  font-size: 96rpx;
}

.memory-card::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 25%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0.85) 100%);
  content: '';
  pointer-events: none;
}

.memory-card-copy {
  position: absolute;
  z-index: 2;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 18rpx;
}

.memory-type {
  display: inline-flex;
  max-width: 100%;
  min-height: 34rpx;
  margin-top: 10rpx;
  padding: 0 10rpx;
  overflow: hidden;
  color: #fff;
  background: rgba(55, 179, 235, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-card-title {
  display: -webkit-box;
  overflow: hidden;
  color: #fff;
  font-size: 28rpx;
  font-weight: 720;
  line-height: 1.35;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.memory-card-footer {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 8rpx;
}

.memory-owner-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 12rpx;
}

.memory-owner-avatar,
.memory-owner-initial {
  flex: 0 0 34rpx;
  box-sizing: border-box;
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
  overflow: hidden;
  background: #f3f4f6;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.memory-owner-name {
  min-width: 0;
  overflow: hidden;
  color: #fff;
  font-size: 20rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-owner-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #075aa7;
  font-size: 18rpx;
  font-weight: 700;
}

.memory-fact {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.78);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-grid--3 .memory-card--top .memory-card-copy,
.memory-grid--3 .memory-card--bottom .memory-card-copy { padding: 14rpx; }

.memory-grid--3 .memory-card--top .memory-card-title,
.memory-grid--3 .memory-card--bottom .memory-card-title {
  display: block;
  overflow: hidden;
  font-size: 24rpx;
  max-width: 260rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-grid--3 .memory-card--top .memory-card-footer,
.memory-grid--3 .memory-card--bottom .memory-card-footer { margin-top: 7rpx; }

.memory-grid--3 .memory-card--top .memory-owner-avatar,
.memory-grid--3 .memory-card--top .memory-owner-initial,
.memory-grid--3 .memory-card--bottom .memory-owner-avatar,
.memory-grid--3 .memory-card--bottom .memory-owner-initial { flex-basis: 28rpx; width: 28rpx; height: 28rpx; }

.memory-extra-list {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.memory-extra-card {
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  height: 260rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  isolation: isolate;
}

.memory-extra-card::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 25%, rgba(0, 0, 0, 0.42) 58%, rgba(0, 0, 0, 0.84) 100%);
  content: '';
  pointer-events: none;
}

.memory-extra-copy { position: absolute; z-index: 2; right: 0; bottom: 0; left: 0; box-sizing: border-box; min-width: 0; padding: 16rpx; }
.memory-extra-title { overflow: hidden; color: #fff; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.memory-extra-fact { margin-top: 8rpx; overflow: hidden; color: rgba(255, 255, 255, 0.82); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }

.memory-more-button {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 320rpx;
  max-width: 100%;
  min-height: 88rpx;
  margin: 24rpx auto 0;
  padding: 8rpx 24rpx;
  color: #111827;
  background: #ffc72c;
  border: 0;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 16rpx rgba(130, 83, 0, 0.18);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.memory-more-button.button-hover { background: #e5b224; }
.memory-more-button::after { display: none; }

@media (max-width: 340px) {
  .discover-hero { min-height: 300rpx; padding-right: 24rpx; padding-left: 24rpx; }
  .discover-title { font-size: 36rpx; }
  .discover-subtitle { font-size: 22rpx; }
  .header-doodle { flex-basis: 68rpx; width: 68rpx; transform: scale(0.84) rotate(-8deg); }
  .discover-sheet { margin-top: -28rpx; padding-right: 20rpx; padding-left: 20rpx; border-radius: 28rpx 28rpx 0 0; }
  .campaign-shell,
  .campaign-swiper,
  .campaign-card { border-radius: 18rpx; }
  .campaign-swiper { height: 262rpx; }
  .campaign-copy { width: 67%; padding: 24rpx 0 22rpx 24rpx; }
  .campaign-title { margin-top: 12rpx; font-size: 29rpx; }
  .campaign-subtitle { margin-top: 6rpx; font-size: 20rpx; }
  .campaign-action { margin-top: 10rpx; }
  .campaign-art { right: -18rpx; width: 40%; }
  .search-row { padding-left: 16rpx; border-radius: 16rpx; }
  .search-submit-button { min-width: 76rpx; }
  .filter-scroll { width: calc(100% + 20rpx); }
  .filter-track { gap: 8rpx; padding-right: 20rpx; }
  .filter-chip { min-width: 128rpx; padding-right: 12rpx; padding-left: 10rpx; font-size: 22rpx; }
  .chip-icon-box { flex-basis: 42rpx; width: 42rpx; height: 42rpx; margin-right: 6rpx; }
  .skeleton-card { gap: 16rpx; padding: 16rpx; }
  .skeleton-cover { flex-basis: 140rpx; width: 140rpx; height: 140rpx; }
  .memory-section { margin-top: 32rpx; }
  .memory-section-heading { height: 88rpx; margin-bottom: 18rpx; }
  .memory-heading-watermark { font-size: 22rpx; }
  .memory-title { padding-top: 23rpx; font-size: 30rpx; }
  .memory-panel { padding: 18rpx; border-radius: 24rpx; }
  .memory-panel-masthead { min-height: 106rpx; padding: 8rpx 10rpx 16rpx; }
  .memory-panel-masthead-main { font-size: 31rpx; }
  .memory-panel-masthead-sub { font-size: 18rpx; }
  .memory-grid { gap: 12rpx; }
  .memory-grid--3 { grid-template-rows: 229rpx 229rpx; }
  .memory-grid--3 .memory-card--lead { height: 470rpx; }
  .memory-grid--3 .memory-card--top,
  .memory-grid--3 .memory-card--bottom { height: 229rpx; }
  .memory-card { height: 340rpx; border-radius: 18rpx; }
  .memory-grid--1 .memory-card { height: 280rpx; }
  .memory-card-copy { padding: 14rpx; }
  .memory-card-title { font-size: 24rpx; }
  .memory-grid--3 .memory-card--top .memory-card-title,
  .memory-grid--3 .memory-card--bottom .memory-card-title { font-size: 22rpx; }
  .memory-grid--3 .memory-card--top .memory-type,
  .memory-grid--3 .memory-card--bottom .memory-type { min-height: 30rpx; margin-top: 7rpx; font-size: 16rpx; }
  .memory-extra-list { gap: 12rpx; }
  .memory-extra-card { height: 238rpx; border-radius: 18rpx; }
  .memory-more-button { min-height: 88rpx; margin-top: 18rpx; font-size: 24rpx; }
  .memory-fact { font-size: 17rpx; }
}

@keyframes footer-spin { to { transform: rotate(360deg); } }
@keyframes skeleton-pulse { to { opacity: 0.54; } }
@keyframes memory-fade-in { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
