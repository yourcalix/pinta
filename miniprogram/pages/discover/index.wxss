page { color: #111827; background: #f9f7f2; }
.home-page { box-sizing: border-box; min-height: 100vh; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); overflow-x: hidden; background: #f9f7f2; }
.home-content { padding: 8rpx 28rpx 0; }
button { margin: 0; padding: 0; line-height: 1.25; }
button::after { display: none; }
.home-greeting { display: flex; min-height: 88rpx; align-items: center; }
.greeting-avatar { flex: 0 0 56rpx; box-sizing: border-box; width: 56rpx; height: 56rpx; margin-right: 14rpx; background: #f2eee6; border: 2rpx solid #fff; border-radius: 50%; }
.greeting-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.greeting-title { overflow: hidden; color: #111827; font-size: 28rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.greeting-subtitle { margin-top: 4rpx; color: #9a948b; font-size: 20rpx; }
.greeting-actions { display: flex; gap: 10rpx; }
.header-action { position: relative; display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; background: #fff; border: 1rpx solid #eee9df; }
.header-action--search { border-radius: 32rpx 10rpx 10rpx 32rpx; }
.header-action--message { border-radius: 10rpx 32rpx 32rpx 10rpx; }
.header-search-glyph { position: relative; width: 24rpx; height: 24rpx; border: 4rpx solid #111827; border-radius: 50%; }
.header-search-glyph::after { position: absolute; right: -9rpx; bottom: -7rpx; width: 12rpx; height: 4rpx; content: ''; background: #111827; border-radius: 4rpx; transform: rotate(45deg); }
.header-message-glyph { position: relative; width: 28rpx; height: 24rpx; border: 3rpx solid #111827; border-radius: 10rpx; }
.header-message-glyph::after { position: absolute; bottom: -7rpx; left: 5rpx; width: 8rpx; height: 8rpx; content: ''; border-left: 3rpx solid #111827; transform: skew(-28deg); }
.control--pressed { opacity: 0.7; transform: scale(0.96); }

.home-hero { width: 100%; height: 340rpx; margin-top: 12rpx; overflow: hidden; border-radius: 32rpx; }
.home-hero-card { position: relative; box-sizing: border-box; width: 100%; height: 340rpx; padding: 30rpx 28rpx; overflow: hidden; background: linear-gradient(145deg, #fffdf9 0%, #f4eee4 100%); border: 1.5rpx solid #efece6; border-radius: 32rpx; box-shadow: 0 8rpx 24rpx rgba(180, 160, 130, 0.06); transition: transform 120ms ease; }
.home-hero-card--sport { background: linear-gradient(145deg, #fffdf8 0%, #fff2d9 100%); }
.home-hero-card--companion { background: linear-gradient(145deg, #fffdf9 0%, #edf5ee 100%); }
.home-hero-card--guide { background: linear-gradient(145deg, #fffdf9 0%, #f2edfb 100%); }
.home-hero-card--pressed { transform: scale(0.992); }
.hero-copy { position: relative; z-index: 2; display: flex; width: 62%; height: 100%; flex-direction: column; align-items: flex-start; }
.hero-eyebrow { color: #aaa297; font-size: 17rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-title { display: flex; margin-top: 20rpx; color: #111827; font-size: 40rpx; font-weight: 900; line-height: 1.18; flex-direction: column; letter-spacing: -1rpx; }
.hero-title-accent::after { color: #f59e0b; content: '•'; margin-left: 5rpx; }
.hero-subtitle { margin-top: 15rpx; color: #78716c; font-size: 22rpx; }
.hero-bubble { margin-top: auto; max-width: 260rpx; padding: 10rpx 15rpx; overflow: hidden; color: #514b43; background: rgba(255, 255, 255, 0.86); border: 1rpx solid rgba(231, 224, 211, 0.9); border-radius: 18rpx; font-size: 20rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.hero-art { position: absolute; z-index: 1; right: 12rpx; bottom: 0; width: 270rpx; height: 290rpx; pointer-events: none; }
.hero-art-glow { position: absolute; inset: 20rpx 0 0; background: radial-gradient(circle at 55% 55%, rgba(255, 255, 255, 0.96) 0%, rgba(251, 210, 140, 0.25) 38%, transparent 70%); }
.hero-image { position: absolute; right: 0; bottom: 0; width: 258rpx; height: 258rpx; }
.hero-art-fallback { position: absolute; right: 70rpx; bottom: 85rpx; color: #d3a64d; font-size: 90rpx; }
.hero-dots { display: flex; height: 24rpx; align-items: center; justify-content: center; gap: 8rpx; }
.hero-dot { width: 8rpx; height: 8rpx; background: #d8d2c8; border-radius: 50%; }
.hero-dot--active { width: 24rpx; background: #111827; border-radius: 5rpx; }

.home-shortcuts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; margin-top: 10rpx; }
.home-shortcut { position: relative; min-width: 0; min-height: 180rpx; padding: 20rpx 16rpx; overflow: hidden; text-align: left; border: 1rpx solid transparent; border-radius: 24rpx; transition: transform 120ms ease, opacity 120ms ease; }
.home-shortcut--activities { background: linear-gradient(150deg, #fff8df, #ffedb6); border-color: #f7d98c; }
.home-shortcut--community { background: linear-gradient(150deg, #f2f8ff, #dcecff); border-color: #c8def8; }
.home-shortcut--publish { background: linear-gradient(150deg, #f8f5ff, #e9e0ff); border-color: #ddd0fb; }
.home-shortcut--pressed { opacity: 0.86; transform: scale(0.97); }
.shortcut-title { display: block; position: relative; z-index: 2; overflow: hidden; color: #25221e; font-size: 26rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.shortcut-subtitle { display: block; position: relative; z-index: 2; margin-top: 7rpx; overflow: hidden; color: #82796e; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.shortcut-arrow { position: absolute; z-index: 2; bottom: 14rpx; left: 14rpx; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; color: #4c473f; background: rgba(255, 255, 255, 0.88); border-radius: 50%; font-size: 28rpx; }
.shortcut-art { position: absolute; right: 4rpx; bottom: -5rpx; width: 94rpx; height: 94rpx; opacity: 0.9; }
.shortcut-art--target { border: 13rpx solid #efb942; border-radius: 50%; box-shadow: inset 0 0 0 10rpx #fff8df; }
.shortcut-art--target::after { position: absolute; top: 22rpx; left: 22rpx; width: 24rpx; height: 24rpx; content: ''; background: #efb942; border-radius: 50%; }
.shortcut-art--chat { right: 9rpx; bottom: 10rpx; width: 86rpx; height: 68rpx; background: #76aef2; border-radius: 28rpx; }
.shortcut-art--chat::after { position: absolute; bottom: -10rpx; left: 18rpx; width: 18rpx; height: 18rpx; content: ''; background: #76aef2; transform: rotate(30deg); }
.shortcut-art--chat view { position: absolute; top: 31rpx; left: 22rpx; width: 7rpx; height: 7rpx; background: #fff; border-radius: 50%; box-shadow: 17rpx 0 #fff, 34rpx 0 #fff; }
.shortcut-art--plus { right: 9rpx; bottom: 9rpx; width: 82rpx; height: 82rpx; background: #9d83dc; border-radius: 28rpx; transform: rotate(-7deg); }
.shortcut-art--plus::before, .shortcut-art--plus::after { position: absolute; top: 50%; left: 50%; width: 42rpx; height: 7rpx; content: ''; background: #fff; border-radius: 5rpx; transform: translate(-50%, -50%); }
.shortcut-art--plus::after { transform: translate(-50%, -50%) rotate(90deg); }

.directory-tools { margin-top: 24rpx; padding: 14rpx; background: #f2eee7; border: 1rpx solid #ebe5dc; border-radius: 24rpx; }
.search-row { display: flex; min-height: 88rpx; align-items: center; padding: 0 10rpx 0 18rpx; background: #fff; border-radius: 20rpx; }
.search-symbol { position: relative; flex: 0 0 25rpx; width: 25rpx; height: 25rpx; margin-right: 14rpx; border: 4rpx solid #49443e; border-radius: 50%; }
.search-symbol::after { position: absolute; right: -9rpx; bottom: -7rpx; width: 12rpx; height: 4rpx; content: ''; background: #49443e; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 88rpx; color: #111827; font-size: 26rpx; }
.search-placeholder { color: #aaa39a; }
.search-clear-button { width: 88rpx; height: 88rpx; color: #9a948b; background: transparent; border: 0; font-size: 36rpx; }
.search-submit-button { min-width: 88rpx; min-height: 88rpx; color: #fff; background: #111827; border: 0; border-radius: 44rpx; font-size: 23rpx; font-weight: 700; }
.filter-scroll { width: 100%; margin-top: 10rpx; white-space: nowrap; }
.filter-track { display: flex; gap: 8rpx; }
.filter-chip { display: inline-flex; flex: 1 0 0; min-width: 145rpx; min-height: 88rpx; align-items: center; justify-content: center; gap: 7rpx; color: #777168; background: transparent; border: 1rpx solid transparent; border-radius: 18rpx; font-size: 22rpx; font-weight: 650; }
.filter-chip--active { color: #111827; background: #fff; border-color: #e5ded4; box-shadow: 0 3rpx 10rpx rgba(70, 60, 45, 0.05); }
.filter-icon { width: 34rpx; height: 34rpx; filter: saturate(0.6); }

.home-activity-heading { display: flex; min-height: 112rpx; align-items: flex-end; justify-content: space-between; padding: 0 4rpx 18rpx; }
.section-kicker { display: block; color: #b4ada3; font-size: 16rpx; font-weight: 750; letter-spacing: 3rpx; }
.section-title { display: block; margin-top: 5rpx; color: #111827; font-size: 30rpx; font-weight: 850; }
.heading-meta { display: flex; align-items: center; gap: 8rpx; color: #999188; font-size: 20rpx; }
.clear-filter-button { min-width: 72rpx; min-height: 56rpx; color: #9b6c18; background: #fff3cf; border: 0; border-radius: 28rpx; font-size: 20rpx; }
.home-activity-list { padding: 18rpx; background: #f2eee7; border: 1rpx solid #eae4da; border-radius: 28rpx; }
.skeleton-card { display: flex; min-height: 390rpx; margin-bottom: 20rpx; overflow: hidden; background: #fff; border: 1.5rpx solid #efece6; border-radius: 24rpx; }
.skeleton-cover { flex: 0 0 46%; background: #ebe6de; }
.skeleton-copy { flex: 1; padding: 24rpx 20rpx; }
.skeleton-line { height: 20rpx; margin-top: 20rpx; background: #ece8e1; border-radius: 10rpx; animation: pulse 1s ease-in-out infinite alternate; }
.skeleton-line--short { width: 38%; margin-top: 0; }.skeleton-line--title { width: 82%; height: 30rpx; }.skeleton-line--medium { width: 62%; }
.empty-state-shell { padding: 16rpx; background: #fff; border-radius: 24rpx; }
.discover-pagination { display: flex; min-height: 100rpx; margin-top: 4rpx; align-items: center; justify-content: space-between; gap: 12rpx; }
.pagination-button { flex: 0 0 196rpx; min-height: 88rpx; color: #403b35; background: #fff; border: 1.5rpx solid #e2ddd5; border-radius: 44rpx; font-size: 23rpx; font-weight: 700; }
.pagination-button--pressed { opacity: 0.76; transform: scale(0.97); }
.pagination-button--disabled { color: #b3aca3; background: rgba(255, 255, 255, 0.5); }
.pagination-indicator { flex: 1; color: #948c82; font-size: 21rpx; text-align: center; white-space: nowrap; }.pagination-indicator text { color: #f59e0b; font-size: 27rpx; font-weight: 800; }

.page-end-marker { margin: 28rpx auto 16rpx; color: #aaa298; font-size: 21rpx; line-height: 1.4; text-align: center; }
@keyframes pulse { from { opacity: 0.55; } to { opacity: 1; } }

@media (max-width: 340px) {
  .home-content { padding-right: 20rpx; padding-left: 20rpx; }
  .home-greeting { min-height: 80rpx; }
  .home-hero, .home-hero-card { height: 300rpx; border-radius: 24rpx; }
  .home-hero-card { padding: 24rpx 22rpx; }
  .hero-title { margin-top: 15rpx; font-size: 34rpx; }
  .hero-subtitle { font-size: 20rpx; }.hero-art { width: 220rpx; height: 245rpx; }.hero-image { width: 205rpx; height: 205rpx; }
  .home-shortcuts { gap: 10rpx; }.home-shortcut { min-height: 164rpx; padding: 16rpx 12rpx; border-radius: 20rpx; }.shortcut-title { font-size: 23rpx; }.shortcut-subtitle { font-size: 17rpx; }.shortcut-art { transform: scale(0.84); transform-origin: right bottom; }
  .directory-tools { padding: 10rpx; }.filter-track { gap: 4rpx; }.filter-chip { min-width: 124rpx; min-height: 88rpx; font-size: 20rpx; }.filter-icon { width: 30rpx; height: 30rpx; }
  .home-activity-list { padding: 14rpx; border-radius: 24rpx; }.skeleton-card { min-height: 350rpx; }
  .pagination-button { flex-basis: 166rpx; min-height: 88rpx; font-size: 21rpx; }
}
@media (prefers-reduced-motion: reduce) { .home-hero-card, .home-shortcut, .pagination-button { transition: none; }.skeleton-line { animation: none; } }
