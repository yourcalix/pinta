page{background:#f9f7f2}
.messages-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); background: #f9f7f2; }
.messages-header { display: flex; min-height: 104rpx; align-items: center; justify-content: center; padding: 0 28rpx 12rpx; box-sizing: border-box; }
.messages-title{font-size:40rpx;font-weight:800}
.messages-content{padding:0 28rpx}
.message-entry-list, .conversation-list { display: grid; gap: 16rpx; }
.message-entry, .conversation-card, .message-empty-shell { width: 100%; margin: 0; box-sizing: border-box; border: 1.5rpx solid #efece6; background: #fff; }
.message-entry::after, .conversation-card::after, .footer-retry::after { display: none; }
.message-entry { display: flex; min-height: 140rpx; align-items: center; padding: 18rpx 24rpx; border-radius: 28rpx; text-align: left; }
.message-card--pressed { background: #f6f4ee; }
.message-entry-icon-wrap { position: relative; display: flex; flex: 0 0 96rpx; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; overflow: visible; }
.message-entry-icon { width: 96rpx; height: 96rpx; }
.message-entry-dot, .conversation-unread-dot { width: 16rpx; height: 16rpx; border: 3rpx solid #fff; border-radius: 50%; background: #ff5f55; }
.message-entry-dot { position: absolute; top: -2rpx; right: -2rpx; }
.message-entry-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; justify-content: center; margin-left: 18rpx; }
.message-entry-title { overflow: hidden; font-size: 30rpx; line-height: 1.35; font-weight: 750; white-space: nowrap; text-overflow: ellipsis; }
.message-entry-subtitle { margin-top: 5rpx; overflow: hidden; color: #8b8682; font-size: 24rpx; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.message-entry-chevron { flex: 0 0 auto; margin-left: 14rpx; color: #aaa4a1; font-size: 48rpx; line-height: 1; }
.direct-message-region { margin-top: 28rpx; }
.conversation-card { display: flex; min-height: 184rpx; align-items: flex-start; padding: 24rpx; border-radius: 28rpx; text-align: left; }
.conversation-avatar-wrap { position: relative; flex: 0 0 88rpx; width: 88rpx; height: 88rpx; overflow: visible; }
.conversation-avatar-image, .conversation-avatar-fallback, .skeleton-avatar { width: 88rpx; height: 88rpx; box-sizing: border-box; overflow: hidden; border: 2rpx solid #f3f0e6; border-radius: 50%; background: #f3f0e6; }
.conversation-avatar-fallback { color: #9a3412; background: #fcebdc; font-size: 34rpx; line-height: 84rpx; font-weight: 700; text-align: center; }
.conversation-type-badge { position: absolute; right: -10rpx; bottom: -5rpx; display: flex; width: 42rpx; height: 34rpx; align-items: center; justify-content: center; border: 3rpx solid #fff; border-radius: 17rpx 17rpx 17rpx 7rpx; color: #fffaf5; background: #f58a32; font-size: 18rpx; line-height: 1; }
.conversation-copy { flex: 1; min-width: 0; margin-left: 22rpx; }
.conversation-top { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.conversation-name { flex: 1; min-width: 0; max-width: 300rpx; overflow: hidden; color: #111827; font-size: 28rpx; line-height: 1.4; font-weight: 750; white-space: nowrap; text-overflow: ellipsis; }
.conversation-time { flex: 0 0 auto; color: #96908c; font-size: 24rpx; line-height: 1.4; white-space: nowrap; }
.conversation-preview { display: -webkit-box; margin-top: 7rpx; overflow: hidden; color: #4b4642; font-size: 28rpx; line-height: 1.45; word-break: break-all; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.message-source-panel { display: flex; min-width: 0; align-items: center; margin-top: 14rpx; padding: 12rpx 18rpx; overflow: hidden; border: 1rpx solid #efece6; border-radius: 16rpx; background: #faf8f4; color: #78716c; font-size: 24rpx; line-height: 1.4; }
.message-source-title { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.message-empty-shell { overflow: hidden; border-radius: 28rpx; }
.footer-retry { min-height: max(88rpx,44px); margin-top: 20rpx; padding: 12rpx 30rpx; border: 0; border-radius: 44rpx; color: #78350f; background: #fcd15b; font-size: 28rpx; font-weight: 700; }
.list-footer { display: flex; min-height: 88rpx; align-items: center; justify-content: center; color: #9a948f; font-size: 24rpx; }
.footer-retry { margin: 0; }
.skeleton-card { align-items: center; }
.skeleton-avatar, .skeleton-lines view { background: #ece8e1; }
.skeleton-lines { flex: 1; margin-left: 22rpx; }
.skeleton-lines view { width: 70%; height: 24rpx; border-radius: 12rpx; }
.skeleton-lines view + view { width: 95%; margin-top: 14rpx; }
@media (max-width: 340px) {
  .messages-header { min-height: 92rpx; }
  .messages-title { font-size: 36rpx; }
  .messages-content { padding-right: 20rpx; padding-left: 20rpx; }
  .message-entry { min-height: 132rpx; padding: 16rpx 18rpx; border-radius: 24rpx; }
  .message-entry-icon-wrap, .message-entry-icon { flex-basis: 80rpx; width: 80rpx; height: 80rpx; }
  .message-entry-copy { margin-left: 14rpx; }
  .message-entry-chevron { margin-left: 8rpx; }
  .direct-message-region { margin-top: 22rpx; }
  .conversation-card { padding: 20rpx 18rpx; border-radius: 24rpx; }
  .conversation-avatar-wrap, .conversation-avatar-image, .conversation-avatar-fallback, .skeleton-avatar { flex-basis: 80rpx; width: 80rpx; height: 80rpx; }
  .conversation-copy { margin-left: 18rpx; }
  .conversation-name { max-width: 190rpx; }
}
