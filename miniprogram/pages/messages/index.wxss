page { min-height: 100%; background: #075aa7; }

.messages-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(rgba(7, 90, 167, 0.94), rgba(7, 90, 167, 0.97));
}

.messages-header, .messages-content { position: relative; z-index: 1; }
.messages-header { min-height: 112rpx; padding: 20rpx 36rpx 14rpx; color: #fff8ee; box-sizing: border-box; }
.eyebrow, .title, .subtitle { display: block; }
.eyebrow { font-size: 18rpx; letter-spacing: 4rpx; opacity: 0.72; }
.title { margin-top: 4rpx; font-size: 38rpx; line-height: 48rpx; font-weight: 800; }
.subtitle { margin-top: 2rpx; font-size: 24rpx; opacity: 0.84; }
.header-doodle { position: absolute; right: 72rpx; bottom: 24rpx; width: 70rpx; height: 44rpx; transform: rotate(-8deg); }
.header-doodle view { position: absolute; width: 28rpx; height: 13rpx; border: 4rpx solid #9bc858; border-left: 0; border-bottom: 0; border-radius: 50%; }
.header-doodle view:nth-child(1) { left: 0; top: 20rpx; transform: rotate(-28deg); }
.header-doodle view:nth-child(2) { left: 23rpx; top: 5rpx; transform: rotate(8deg); }
.header-doodle view:nth-child(3) { right: 0; top: 19rpx; transform: rotate(36deg); }
.messages-content { padding: 12rpx 28rpx 0; }

.system-card, .conversation-card, .state-paper {
  background: #fff8ee;
  border: 3rpx solid rgba(234, 219, 199, 0.96);
  border-radius: 24rpx 21rpx 25rpx 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(5, 39, 85, 0.17);
}
.paper-card--pressed { opacity: 0.88; transform: scale(0.985); }
.system-card { min-height: 96rpx; padding: 18rpx 20rpx; display: flex; align-items: center; box-sizing: border-box; }
.system-icon { width: 56rpx; height: 56rpx; border-radius: 18rpx 15rpx 19rpx 16rpx; background: #f6b94b; color: #fff8ee; font-size: 34rpx; line-height: 56rpx; font-weight: 900; text-align: center; transform: rotate(-2deg); }
.system-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.system-title-row { display: flex; align-items: center; gap: 10rpx; }
.system-title { color: #102a43; font-size: 28rpx; font-weight: 800; }
.system-count { min-width: 30rpx; height: 30rpx; padding: 0 7rpx; border-radius: 16rpx; background: #e84a36; color: #fff; font-size: 18rpx; line-height: 30rpx; text-align: center; box-sizing: border-box; }
.system-preview { display: block; margin-top: 5rpx; color: #627d78; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chevron { margin-left: 12rpx; color: #11784f; font-size: 42rpx; }

.section-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 28rpx 6rpx 14rpx; color: #fff8ee; font-size: 30rpx; font-weight: 800; }
.section-count { font-size: 22rpx; font-weight: 600; opacity: 0.7; }
.conversation-list { display: grid; gap: 16rpx; }
.conversation-card { min-height: 118rpx; padding: 20rpx; display: flex; align-items: flex-start; box-sizing: border-box; }
.conversation-avatar, .skeleton-avatar { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; border-radius: 22rpx 19rpx 23rpx 18rpx; color: #fff; font-size: 30rpx; line-height: 64rpx; font-weight: 700; text-align: center; transform: rotate(-2deg); }
.avatar--blue { background: #4b83c4; } .avatar--purple { background: #7664b8; } .avatar--orange { background: #df8541; } .avatar--green { background: #5a9a65; } .avatar--teal { background: #2c8d8c; }
.conversation-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.conversation-top, .conversation-bottom { display: flex; align-items: center; min-width: 0; }
.conversation-name { flex: 1; min-width: 0; color: #102a43; font-size: 29rpx; line-height: 38rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.conversation-time { flex: 0 0 auto; margin-left: 14rpx; color: #8a968f; font-size: 21rpx; }
.conversation-bottom { margin-top: 3rpx; }
.conversation-preview { flex: 1; min-width: 0; color: #52645e; font-size: 24rpx; line-height: 34rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.conversation-unread { flex: 0 0 auto; min-width: 32rpx; height: 32rpx; margin-left: 12rpx; padding: 0 7rpx; border-radius: 18rpx; background: #e84a36; color: #fff; font-size: 18rpx; line-height: 32rpx; font-weight: 700; text-align: center; box-sizing: border-box; }
.source-label { display: block; margin-top: 7rpx; color: #2c7e67; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.state-paper { min-height: 320rpx; padding: 44rpx 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; }
.state-bubble { width: 76rpx; height: 60rpx; border: 5rpx solid #16a36a; border-radius: 26rpx; color: #16a36a; font-size: 38rpx; line-height: 48rpx; font-weight: 800; transform: rotate(-3deg); }
.state-title { margin-top: 24rpx; color: #102a43; font-size: 31rpx; font-weight: 800; }
.state-desc { max-width: 500rpx; margin-top: 12rpx; color: #627d78; font-size: 24rpx; line-height: 36rpx; }
.state-action, .footer-retry { min-height: 88rpx; margin-top: 24rpx; padding: 0 36rpx; border: 0; border-radius: 44rpx; background: #dff2e7; color: #11784f; font-size: 26rpx; line-height: 88rpx; font-weight: 700; }
.state-action::after, .footer-retry::after { display: none; }
.list-footer { min-height: 92rpx; color: rgba(255,248,238,0.78); font-size: 23rpx; line-height: 92rpx; text-align: center; }
.footer-retry { margin: 8rpx auto; background: #fff8ee; line-height: 72rpx; min-height: 72rpx; }

.skeleton-card { align-items: center; margin-bottom: 16rpx; }
.skeleton-avatar, .skeleton-lines view { background: #e5dfd3; animation: pulse 1.4s ease-in-out infinite; }
.skeleton-lines { flex: 1; margin-left: 18rpx; }
.skeleton-lines view { width: 58%; height: 22rpx; border-radius: 12rpx; }
.skeleton-lines view + view { width: 88%; margin-top: 15rpx; }
@keyframes pulse { 50% { opacity: 0.48; } }

@media (max-width: 320px) { .messages-content { padding-left: 20rpx; padding-right: 20rpx; } .messages-header { padding-left: 28rpx; } }
@media (prefers-reduced-motion: reduce) { .skeleton-avatar, .skeleton-lines view { animation: none; } }
