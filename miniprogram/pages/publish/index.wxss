.publish-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.publish-content {
  position: relative;
  z-index: 2;
}

.publish-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 168rpx;
  padding: 24rpx 306rpx 24rpx 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ffffff 0%, #f4faf7 100%);
}

.hero-copy-group {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  width: 344rpx;
  max-width: 60%;
  min-width: 0;
}

.hero-puzzle {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
}

.hero-copy {
  flex: 0 1 250rpx;
  min-width: 0;
  max-width: 250rpx;
  margin-left: 18rpx;
  word-break: break-all;
}

.hero-eyebrow {
  color: #16895d;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.3;
}

.hero-title {
  margin-top: 7rpx;
  color: #19231e;
  font-size: 31rpx;
  font-weight: 720;
  line-height: 1.28;
}

.hero-description {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #66756d;
  font-size: 23rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-scene {
  position: absolute;
  z-index: 1;
  right: 12rpx;
  bottom: 8rpx;
  width: 300rpx;
  height: 150rpx;
}

.hero-start {
  position: absolute;
  left: 2rpx;
  bottom: 5rpx;
  width: 62rpx;
  height: 62rpx;
}

.hero-route-dots {
  position: absolute;
  left: 52rpx;
  right: 98rpx;
  bottom: 34rpx;
  height: 5rpx;
  opacity: 0.58;
  background: repeating-linear-gradient(90deg, #16895d 0 9rpx, transparent 9rpx 18rpx);
  border-radius: 999rpx;
  transform: rotate(-5deg);
}

.hero-car {
  position: absolute;
  z-index: 2;
  left: 88rpx;
  bottom: 15rpx;
  width: 116rpx;
  height: 92rpx;
}

.hero-campus {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 128rpx;
  height: 128rpx;
}

.type-card {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 250rpx;
  margin: 30rpx 0 0;
  padding: 30rpx 72rpx 30rpx 64rpx;
  overflow: hidden;
  color: #19231e;
  text-align: left;
  background: #ffffff;
  line-height: 1.4;
}

.type-card[disabled] {
  opacity: 0.68;
}

.type-card::after {
  display: none;
}

.type-accent {
  position: absolute;
  top: 50%;
  left: 20rpx;
  width: 6rpx;
  height: 120rpx;
  background: #16a36a;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(22, 163, 106, 0.12);
  transform: translateY(-50%);
}

.type-icon {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  width: 92rpx;
  height: 92rpx;
}

.type-content {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.type-title {
  color: #1d2922;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.35;
}

.type-description {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #6c7771;
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.arrow {
  position: absolute;
  z-index: 3;
  top: 50%;
  right: 30rpx;
  color: #16a36a;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  transform: translateY(-50%);
}

.safety-note {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 146rpx;
  box-sizing: border-box;
  margin: 36rpx 0 0 !important;
  padding: 22rpx 26rpx !important;
  color: #52645a;
  text-align: left;
  background: rgba(255, 255, 255, 0.34) !important;
  border: 1rpx dashed #cde8db !important;
  border-radius: 22rpx;
  box-shadow: none !important;
  line-height: normal;
}

.safety-note::after {
  display: none;
  border: none !important;
}

.safety-note-hover {
  background: rgba(22, 163, 106, 0.05) !important;
  opacity: 0.88;
}

.safety-icon {
  position: relative;
  flex: 0 0 auto;
  width: 66rpx;
  height: 66rpx;
}

.safety-icon-voxel {
  position: absolute;
  inset: 0;
  width: 66rpx;
  height: 66rpx;
  opacity: 0.82;
}

.safety-lock-shackle {
  position: absolute;
  z-index: 2;
  top: 17rpx;
  left: 22rpx;
  width: 22rpx;
  height: 20rpx;
  border: 5rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 12rpx 12rpx 0 0;
}

.safety-lock-body {
  position: absolute;
  z-index: 2;
  left: 18rpx;
  bottom: 15rpx;
  width: 30rpx;
  height: 25rpx;
  background: #ffffff;
  border-radius: 5rpx;
}

.safety-lock-keyhole {
  position: absolute;
  top: 7rpx;
  left: 12rpx;
  width: 6rpx;
  height: 11rpx;
  background: #118557;
  border-radius: 999rpx;
}

.safety-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.safety-title {
  color: #43544b;
  font-size: 26rpx;
  font-weight: 680;
  line-height: 1.35;
}

.safety-description {
  margin-top: 8rpx;
  color: #758079;
  font-size: 24rpx;
  line-height: 1.52;
}

.page-watermark {
  position: absolute;
  z-index: 1;
  right: 42rpx;
  bottom: calc(300rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  opacity: 0.03;
}

@media (max-width: 340px) {
  .publish-hero {
    min-height: 160rpx;
    padding: 20rpx 226rpx 20rpx 20rpx;
  }

  .hero-puzzle {
    width: 66rpx;
    height: 66rpx;
  }

  .hero-copy {
    flex-basis: 190rpx;
    max-width: 190rpx;
    margin-left: 12rpx;
  }

  .hero-copy-group {
    width: 268rpx;
    max-width: 60%;
  }

  .hero-title {
    font-size: 28rpx;
  }

  .hero-description {
    font-size: 21rpx;
  }

  .hero-scene {
    width: 220rpx;
    height: 128rpx;
  }

  .hero-start {
    width: 50rpx;
    height: 50rpx;
  }

  .hero-route-dots {
    left: 42rpx;
    right: 78rpx;
    bottom: 28rpx;
  }

  .hero-car {
    left: 66rpx;
    width: 92rpx;
    height: 74rpx;
  }

  .hero-campus {
    width: 104rpx;
    height: 104rpx;
  }

  .type-card {
    min-height: 240rpx;
    padding-right: 58rpx;
    padding-left: 52rpx;
  }

  .type-accent {
    left: 16rpx;
    height: 112rpx;
  }

  .type-icon {
    width: 76rpx;
    height: 76rpx;
  }

  .type-content {
    margin-left: 18rpx;
  }

  .type-title {
    font-size: 30rpx;
  }

  .type-description {
    font-size: 23rpx;
  }

  .arrow {
    right: 22rpx;
  }

  .safety-note {
    align-items: flex-start;
    min-height: 140rpx;
    padding: 22rpx 20rpx;
  }

  .safety-icon {
    width: 60rpx;
    height: 60rpx;
  }

  .safety-icon-voxel {
    width: 60rpx;
    height: 60rpx;
  }

  .safety-lock-shackle {
    top: 15rpx;
    left: 20rpx;
  }

  .safety-lock-body {
    left: 16rpx;
    bottom: 13rpx;
  }

  .safety-copy {
    margin-left: 18rpx;
  }
}
