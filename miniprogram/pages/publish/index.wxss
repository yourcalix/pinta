.publish-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #075aa7;
}
.paper-background {
  position: fixed;
  z-index: 0;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}
.paper-tint {
  position: fixed;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: rgba(0, 58, 134, .12);
}
.publish-content {
  position: relative;
  z-index: 2;
  padding: 8rpx 0 34rpx;
}
.publish-hero {
  position: relative;
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 20rpx 44rpx 24rpx;
  color: #fff5df;
}
.hero-brand {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 2rpx;
  opacity: .88;
}
.hero-title {
  margin-top: 9rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: 1rpx;
}
.hero-description {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.45;
  opacity: .82;
}
.hero-scribble {
  position: absolute;
  top: 32rpx;
  right: 44rpx;
  width: 74rpx;
  height: 66rpx;
  transform: rotate(-8deg);
}
.hero-scribble view {
  position: absolute;
  right: 0;
  width: 58rpx;
  height: 7rpx;
  background: #9fd650;
  border-radius: 50%;
  transform: rotate(32deg);
}
.hero-scribble view:last-child {
  top: 31rpx;
  right: 18rpx;
  width: 44rpx;
  background: #ffd058;
  transform: rotate(-24deg);
}
.type-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 20rpx;
  box-sizing: border-box;
  margin: 28rpx 36rpx 24rpx;
  padding-top: 6rpx;
}
.type-card {
  position: relative;
  flex: 0 0 calc((100% - 20rpx) / 2);
  width: calc((100% - 20rpx) / 2);
  min-width: 0;
  min-height: 430rpx;
  aspect-ratio: 304 / 430;
  box-sizing: border-box;
  overflow: hidden;
  margin: 0 !important;
  padding: 25rpx 22rpx !important;
  color: #fff9eb;
  text-align: left;
  border: 3rpx solid rgba(255, 245, 222, .58) !important;
  border-radius: 28rpx;
  box-shadow: inset 0 0 0 3rpx rgba(20, 32, 43, .08), 0 12rpx 24rpx rgba(1, 34, 78, .2);
  line-height: normal;
  transform: translateZ(0);
  transition: transform 120ms ease, filter 120ms ease;
}
.type-card::after { display: none; }
.type-card[disabled] { opacity: .68; }
.type-card--companion { background: #0d8f93 !important; }
.type-card--sport { background: #4c3b9b !important; }
.type-card--food { background: #e65d16 !important; }
.type-card--pressed { transform: scale(.975); filter: brightness(.96); }
.type-card-kicker {
  position: relative;
  z-index: 3;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.3;
  letter-spacing: 1rpx;
  opacity: .78;
}
.type-card-title {
  position: relative;
  z-index: 3;
  margin-top: 5rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}
.type-card-description {
  position: relative;
  z-index: 3;
  max-width: 244rpx;
  margin-top: 8rpx;
  white-space: normal;
  font-size: 24rpx;
  line-height: 1.4;
  opacity: .86;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, .18);
}
.type-card-art {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  transform: translateZ(0);
}
.type-card-art--food {
  left: 7%;
  bottom: 2%;
  width: 86%;
  height: 86%;
}
.type-card-action {
  position: absolute;
  z-index: 4;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 86rpx;
  height: 58rpx;
  padding: 0 13rpx;
  color: #17342a;
  background: rgba(255, 248, 231, .94);
  border-radius: 30rpx;
  box-shadow: 0 5rpx 10rpx rgba(19, 42, 34, .15);
  font-size: 24rpx;
  font-weight: 750;
  pointer-events: none;
}
.type-card-plus { font-size: 31rpx; font-weight: 500; line-height: 1; }
.draft-strip,
.safety-note {
  display: flex;
  align-items: center;
  width: auto;
  box-sizing: border-box;
  margin-right: 44rpx !important;
  margin-left: 44rpx !important;
  color: #18342a;
  background: #fff4df !important;
  border: 3rpx solid rgba(255, 255, 255, .48) !important;
  box-shadow: 0 10rpx 22rpx rgba(1, 34, 78, .18);
}
.draft-strip::after,
.safety-note::after { display: none; }
.draft-strip {
  position: relative;
  min-height: 126rpx;
  overflow: hidden;
  padding: 12rpx 20rpx 12rpx 134rpx !important;
  text-align: left;
  border-radius: 24rpx;
  line-height: normal;
  transition: transform 120ms ease;
}
.draft-strip[disabled] { opacity: .68; }
.draft-strip--pressed { transform: scale(.985); }
.draft-art {
  position: absolute;
  left: 4rpx;
  bottom: -1rpx;
  width: 132rpx;
  height: 116rpx;
  pointer-events: none;
}
.draft-copy { flex: 1; min-width: 0; }
.draft-heading { display: flex; align-items: center; gap: 8rpx; }
.draft-badge {
  padding: 4rpx 10rpx;
  color: #fff8e7;
  background: #e65d16;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.25;
}
.draft-type { color: #567269; font-size: 24rpx; font-weight: 650; }
.draft-title {
  max-width: 320rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #18342a;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.draft-action {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 5rpx;
  margin-left: 12rpx;
  color: #087d5a;
  font-size: 24rpx;
  font-weight: 750;
}
.safety-note {
  min-height: 92rpx;
  margin-top: 8rpx !important;
  padding: 15rpx 18rpx !important;
  text-align: left;
  border-radius: 22rpx;
  line-height: normal;
  opacity: .94;
}
.safety-note--pressed { opacity: .78; }
.safety-shield {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 52rpx;
  margin-right: 13rpx;
  color: #fff4df;
  background: #087d5a;
  border-radius: 14rpx 14rpx 20rpx 20rpx;
}
.safety-check { font-size: 25rpx; font-weight: 800; }
.safety-copy {
  flex: 1;
  min-width: 0;
  color: #526c63;
  white-space: normal;
  font-size: 24rpx;
  line-height: 1.42;
}
.safety-more { flex-shrink: 0; margin-left: 8rpx; color: #087d5a; font-size: 30rpx; }
@media (max-width: 340px) {
  .publish-hero { padding-right: 34rpx; padding-left: 34rpx; }
  .hero-title { font-size: 38rpx; }
  .hero-scribble { right: 32rpx; transform: scale(.84) rotate(-8deg); transform-origin: right top; }
  .type-grid { gap: 14rpx; margin-right: 28rpx; margin-left: 28rpx; }
  .type-card { flex-basis: calc((100% - 14rpx) / 2); width: calc((100% - 14rpx) / 2); min-height: 404rpx; padding-right: 19rpx !important; padding-left: 19rpx !important; }
  .type-card-title { font-size: 31rpx; }
  .type-card-description { max-width: 226rpx; font-size: 24rpx; }
  .draft-strip,
  .safety-note { margin-right: 34rpx !important; margin-left: 34rpx !important; }
  .draft-strip { padding-left: 116rpx !important; }
  .draft-art { width: 116rpx; }
  .draft-action-label { display: none; }
}
@media (max-height: 700px) {
  .publish-hero { min-height: 144rpx; padding-top: 12rpx; padding-bottom: 16rpx; }
  .type-grid { margin-top: 18rpx; margin-bottom: 18rpx; }
  .draft-strip { min-height: 116rpx; }
  .safety-note { margin-top: 6rpx !important; }
}
