.publish-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.publish-content {
  position: relative;
  z-index: 2;
}

.publish-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 170rpx;
  padding: 24rpx 306rpx 24rpx 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ffffff 0%, #f4faf7 100%);
}

.hero-puzzle {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
}

.hero-copy {
  position: relative;
  z-index: 3;
  flex: 0 1 250rpx;
  min-width: 220rpx;
  max-width: 250rpx;
  margin-left: 18rpx;
  word-break: break-all;
}

.hero-eyebrow {
  color: #16895d;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.3;
}

.hero-title {
  margin-top: 7rpx;
  color: #19231e;
  font-size: 31rpx;
  font-weight: 720;
  line-height: 1.28;
}

.hero-description {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #66756d;
  font-size: 23rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-scene {
  position: absolute;
  z-index: 1;
  right: 12rpx;
  bottom: 8rpx;
  width: 300rpx;
  height: 150rpx;
}

.hero-start {
  position: absolute;
  left: 2rpx;
  bottom: 5rpx;
  width: 62rpx;
  height: 62rpx;
}

.hero-route-dots {
  position: absolute;
  left: 52rpx;
  right: 98rpx;
  bottom: 34rpx;
  height: 5rpx;
  opacity: 0.58;
  background: repeating-linear-gradient(90deg, #16895d 0 9rpx, transparent 9rpx 18rpx);
  border-radius: 999rpx;
  transform: rotate(-5deg);
}

.hero-car {
  position: absolute;
  z-index: 2;
  left: 88rpx;
  bottom: 15rpx;
  width: 116rpx;
  height: 92rpx;
}

.hero-campus {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 128rpx;
  height: 128rpx;
}

.type-card {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 250rpx;
  margin: 28rpx 0 0;
  padding: 30rpx 72rpx 30rpx 34rpx;
  overflow: hidden;
  color: #19231e;
  text-align: left;
  background: #ffffff;
  border-left: 4rpx solid #16a36a;
  line-height: 1.4;
}

.type-card[disabled] {
  opacity: 0.68;
}

.type-card::after {
  display: none;
}

.type-icon {
  position: relative;
  z-index: 2;
  flex: 0 0 auto;
  width: 90rpx;
  height: 90rpx;
}

.type-content {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.type-title {
  color: #1d2922;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.35;
}

.type-description {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #6c7771;
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.arrow {
  position: absolute;
  z-index: 3;
  top: 50%;
  right: 30rpx;
  color: #16a36a;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  transform: translateY(-50%);
}

.type-watermark {
  position: absolute;
  right: -18rpx;
  bottom: -24rpx;
  width: 154rpx;
  height: 154rpx;
  opacity: 0.02;
}

.safety-note {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 176rpx;
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  color: #52645a;
  background: #f3faf6;
  border-color: #cde8db;
  box-shadow: 0 7rpx 22rpx rgba(25, 84, 56, 0.035);
}

.safety-icon {
  position: relative;
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
  background: linear-gradient(145deg, #1ab270 0%, #118557 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 18rpx rgba(22, 163, 106, 0.15);
}

.safety-lock-shackle {
  position: absolute;
  top: 17rpx;
  left: 26rpx;
  width: 32rpx;
  height: 30rpx;
  border: 6rpx solid #ffffff;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.safety-lock-body {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  width: 44rpx;
  height: 36rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.safety-lock-keyhole {
  position: absolute;
  top: 11rpx;
  left: 19rpx;
  width: 7rpx;
  height: 14rpx;
  background: #118557;
  border-radius: 999rpx;
}

.safety-copy {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.safety-title {
  color: #274337;
  font-size: 28rpx;
  font-weight: 680;
  line-height: 1.35;
}

.safety-description {
  margin-top: 8rpx;
  color: #66756d;
  font-size: 24rpx;
  line-height: 1.52;
}

.page-watermark {
  position: absolute;
  z-index: 1;
  right: 44rpx;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  width: 116rpx;
  height: 116rpx;
  opacity: 0.02;
}

@media (max-width: 340px) {
  .publish-hero {
    min-height: 160rpx;
    padding: 20rpx 226rpx 20rpx 20rpx;
  }

  .hero-puzzle {
    width: 66rpx;
    height: 66rpx;
  }

  .hero-copy {
    flex-basis: 190rpx;
    min-width: 190rpx;
    max-width: 190rpx;
    margin-left: 12rpx;
  }

  .hero-title {
    font-size: 28rpx;
  }

  .hero-description {
    font-size: 21rpx;
  }

  .hero-scene {
    width: 220rpx;
    height: 128rpx;
  }

  .hero-start {
    width: 50rpx;
    height: 50rpx;
  }

  .hero-route-dots {
    left: 42rpx;
    right: 78rpx;
    bottom: 28rpx;
  }

  .hero-car {
    left: 66rpx;
    width: 92rpx;
    height: 74rpx;
  }

  .hero-campus {
    width: 104rpx;
    height: 104rpx;
  }

  .type-card {
    min-height: 240rpx;
    padding-right: 58rpx;
    padding-left: 24rpx;
  }

  .type-icon {
    width: 76rpx;
    height: 76rpx;
  }

  .type-content {
    margin-left: 18rpx;
  }

  .type-title {
    font-size: 30rpx;
  }

  .type-description {
    font-size: 23rpx;
  }

  .arrow {
    right: 22rpx;
  }

  .safety-note {
    align-items: flex-start;
    padding: 24rpx 22rpx;
  }

  .safety-icon {
    width: 72rpx;
    height: 72rpx;
  }

  .safety-lock-shackle {
    top: 14rpx;
    left: 22rpx;
    width: 28rpx;
    height: 27rpx;
  }

  .safety-lock-body {
    left: 17rpx;
    bottom: 13rpx;
    width: 38rpx;
    height: 32rpx;
  }

  .safety-lock-keyhole {
    left: 16rpx;
  }

  .safety-copy {
    margin-left: 18rpx;
  }
}
