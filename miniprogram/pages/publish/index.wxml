<view class="page publish-page" style="padding-top: {{contentTopInset}}px;">
  <image class="paper-background" src="../../assets/images/publish/publish-paper-texture.webp" mode="aspectFill" aria-hidden="true" />
  <view class="paper-tint" aria-hidden="true"></view>

  <view class="publish-content">
    <view class="publish-hero">
      <view class="hero-brand">拼吧 · 发起拼单</view>
      <view class="hero-title">今天准备拼什么？</view>
      <view class="hero-description">选个搭子类型，马上摇人</view>
      <view class="hero-scribble" aria-hidden="true"><view></view><view></view></view>
    </view>

    <view class="type-grid" role="list" aria-label="选择要发布的拼单类型">
      <button wx:for="{{types}}" wx:key="value" class="type-card type-card--{{item.tone}}" hover-class="type-card--pressed" hover-stay-time="120" data-type="{{item.value}}" bindtap="handleSelect" disabled="{{pending}}" role="button" aria-label="{{item.ariaLabel}}">
        <view class="type-card-kicker">发起拼单</view>
        <view class="type-card-title">{{item.title}}</view>
        <view class="type-card-description">{{item.description}}</view>
        <image class="type-card-art type-card-art--{{item.tone}}" src="{{item.image}}" mode="aspectFit" aria-hidden="true" />
        <view class="type-card-action" aria-hidden="true"><text>发起</text><text class="type-card-plus">＋</text></view>
      </button>
    </view>

    <button wx:if="{{draft}}" class="draft-strip" hover-class="draft-strip--pressed" bindtap="handleContinueDraft" disabled="{{pending}}" role="button" aria-label="继续填写{{draft.typeTitle}}草稿，{{draft.title}}">
      <image class="draft-art" src="../../assets/images/publish/publish-draft-avatar.webp" mode="aspectFit" aria-hidden="true" />
      <view class="draft-copy">
        <view class="draft-heading"><text class="draft-badge">草稿</text><text class="draft-type">{{draft.typeTitle}}</text></view>
        <view class="draft-title">{{draft.title}}</view>
      </view>
      <view class="draft-action"><text class="draft-action-label">继续填写</text><text aria-hidden="true">›</text></view>
    </button>

    <button class="safety-note" role="button" bindtap="handleSafetyNotice" hover-class="safety-note--pressed" aria-label="安全边界，点击查看拼单安全说明">
      <view class="safety-shield" aria-hidden="true"><view class="safety-check">✓</view></view>
      <text class="safety-copy">平台仅提供信息发布，不提供运输、配送、资金担保或场地预订服务</text>
      <text class="safety-more" aria-hidden="true">›</text>
    </button>
  </view>
</view>
