<view class="page publish-page" style="padding-top: {{contentTopInset}}px;">
  <view class="publish-heading">
    <view class="eyebrow">两步即可发布</view>
    <view class="title">选择你想发起的类型</view>
    <view class="description">公开页面只展示商圈和必要条件，联系方式会在成团后解锁。</view>
  </view>

  <button
    wx:for="{{types}}"
    wx:key="value"
    class="type-card surface"
    data-type="{{item.value}}"
    bindtap="handleSelect"
    disabled="{{pending}}"
  >
    <view class="type-icon" style="color: {{item.color}}; border-color: {{item.color}}">{{item.icon}}</view>
    <view class="type-content">
      <view class="type-title">{{item.title}}</view>
      <view class="type-description">{{item.description}}</view>
    </view>
    <text class="arrow">›</text>
  </button>

  <view class="safety-note">
    <view class="safety-title">安全边界</view>
    <view>拼吧只提供信息撮合，不提供车辆、在线收款、商品担保或婚恋服务。</view>
  </view>
</view>
