<view class="page community-page" style="padding-top: {{contentTopInset}}px;">
  <view class="community-content">
    <view class="community-reference-header">
      <button class="activity-search-entry" bindtap="handleSearchActivities" hover-class="community-control--pressed" hover-stay-time="80" aria-label="搜索同行与组队活动，进入全城活动列表">
        <view class="search-symbol" aria-hidden="true"></view>
        <text class="activity-search-placeholder">搜索同行与组队活动…</text>
        <text class="activity-search-scope">找活动<text class="activity-search-chevron" aria-hidden="true">›</text></text>
      </button>
      <button class="community-notification" bindtap="handleMessages" hover-class="community-control--pressed" hover-stay-time="80" aria-label="打开消息">
        <image class="community-notification-image" src="/assets/images/community/community-notification-bell.png" mode="aspectFit" aria-hidden="true"></image>
      </button>
    </view>

    <scroll-view class="community-topic-rail" scroll-x="true" enhanced="true" enable-flex="true" show-scrollbar="false" aria-label="发现快捷入口">
      <view class="topic-card-track">
        <button class="topic-card topic-card--companion" data-action="activities" bindtap="handleTopicAction" hover-class="topic-card--pressed" hover-stay-time="80" aria-label="寻找搭子，发现正在组队的活动">
          <image class="topic-card-art" src="/assets/images/community/community-topic-companion.png" mode="aspectFit" aria-hidden="true"></image>
          <view class="topic-card-copy"><text class="topic-card-label">#寻找搭子</text><text class="topic-card-description">发现正在组队</text></view>
          <text class="topic-card-arrow" aria-hidden="true">›</text>
        </button>
        <button class="topic-card topic-card--guidelines" data-action="guidelines" bindtap="handleTopicAction" hover-class="topic-card--pressed" hover-stay-time="80" aria-label="社区守则，查看友善交流与隐私安全规则">
          <image class="topic-card-art" src="/assets/images/community/community-topic-guidelines.png" mode="aspectFit" aria-hidden="true"></image>
          <view class="topic-card-copy"><text class="topic-card-label">#社区守则</text><text class="topic-card-description">友善安心交流</text></view>
          <text class="topic-card-arrow" aria-hidden="true">›</text>
        </button>
        <button class="topic-card topic-card--compose" data-action="compose" bindtap="handleTopicAction" hover-class="topic-card--pressed" hover-stay-time="80" aria-label="发布讨论，写下此刻想法">
          <image class="topic-card-art" src="/assets/images/community/community-topic-compose.png" mode="aspectFit" aria-hidden="true"></image>
          <view class="topic-card-copy"><text class="topic-card-label">#发布讨论</text><text class="topic-card-description">写下此刻想法</text></view>
          <text class="topic-card-arrow" aria-hidden="true">›</text>
        </button>
      </view>
    </scroll-view>

    <view wx:if="{{loading}}" class="skeleton-list" role="status" aria-label="正在加载发现内容">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card" aria-hidden="true">
        <view class="skeleton-head"><view class="skeleton-avatar"></view><view class="skeleton-author"><view class="skeleton-line skeleton-line--name"></view><view class="skeleton-line skeleton-line--time"></view></view></view>
        <view class="skeleton-content"><view class="skeleton-line skeleton-line--body"></view><view class="skeleton-line skeleton-line--body"></view><view class="skeleton-line skeleton-line--short"></view></view>
        <view class="skeleton-footer"><view class="skeleton-line skeleton-line--metric"></view><view class="skeleton-line skeleton-line--metric"></view></view>
      </view>
    </view>

    <view wx:elif="{{posts.length}}" class="post-list">
      <view wx:for="{{posts}}" wx:key="id" class="post-card post-card--{{item.avatarTone}}" hover-class="post-card-hover" hover-start-time="60" hover-stay-time="70" role="button" aria-label="{{item.accessibilityLabel}}" data-id="{{item.id}}" bindtap="handlePost">
        <view class="post-author-row" aria-hidden="true">
          <view class="post-avatar post-avatar--{{item.avatarTone}}">{{item.avatarInitial}}</view>
          <view class="post-author-copy"><text class="post-author">{{item.authorNickname}}</text><text class="post-time">{{item.timeLabel}}</text></view>
          <view class="post-more">•••</view>
        </view>
        <view class="post-content-panel" aria-hidden="true"><text class="post-preview">{{item.content}}</text></view>
        <view class="post-footer" aria-hidden="true">
          <view class="post-metrics">
            <view class="like-count"><text class="like-symbol">♡</text><text>{{item.likeCount}} 赞</text></view>
            <view class="reply-count"><view class="reply-bubble"></view><text>{{item.replyCount}} 回复</text></view>
          </view>
          <text class="post-detail-link">查看详情 ›</text>
        </view>
      </view>
      <view wx:if="{{loadingMore || loadMoreError || !hasMore}}" class="list-footer" role="status">
        <view wx:if="{{loadingMore}}" class="footer-state"><view class="footer-spinner" aria-hidden="true"></view><text>正在加载更多讨论…</text></view>
        <button wx:elif="{{loadMoreError}}" class="footer-retry-button" bindtap="handleRetryLoadMore">加载失败，点击重试</button>
        <view wx:elif="{{!hasMore}}" class="footer-state footer-state--end">— 已经到底啦 · 拼吧发现 —</view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <image class="empty-bubble" src="/assets/images/community/community-empty-discussion.png" mode="aspectFit" aria-hidden="true"></image>
      <text class="empty-title">{{error ? '发现内容加载失败' : '这里还很安静'}}</text>
      <text class="empty-description">{{error || '来写下第一个问题或结伴经验吧。'}}</text>
      <button wx:if="{{!error}}" class="empty-action" hover-class="community-control--pressed" bindtap="handleCompose">发起讨论</button>
      <button wx:else class="empty-action" hover-class="community-control--pressed" bindtap="handleRetry">点击重试</button>
    </view>
  </view>
</view>
