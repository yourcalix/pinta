<view class="page community-page" style="padding-top: {{contentTopInset}}px;">
<view class="community-content">
<view class="community-reference-header">
<view class="discussion-search-entry" role="search">
<view class="search-symbol" aria-hidden="true"></view>
<input class="discussion-search-input" value="{{keyword}}" maxlength="30" placeholder="搜索讨论内容…" placeholder-class="discussion-search-placeholder" confirm-type="search" adjust-position="false" cursor-spacing="12" bindinput="handleKeywordInput" bindconfirm="handleSearchSubmit" aria-label="搜索讨论内容"></input>
<button wx:if="{{keyword}}" class="discussion-search-clear" bindtap="handleClearKeyword" hover-class="community-control--pressed" hover-stay-time="70" role="button" aria-label="清空输入框文字">×</button>
<button class="discussion-search-action" bindtap="handleSearchSubmit" hover-class="community-control--pressed" hover-stay-time="70" role="button" aria-label="搜索讨论帖子">搜索</button>
</view>
<button class="community-notification" bindtap="handleMessages" hover-class="community-control--pressed" hover-stay-time="80" aria-label="打开讨论动态">
<image class="community-notification-image" src="/assets/images/community/community-notification-bell.png" mode="aspectFit" aria-hidden="true"></image>
</button>
</view>
<scroll-view class="community-topic-rail" scroll-x="true" enhanced="true" enable-flex="true" show-scrollbar="false" aria-label="发现快捷入口">
<view class="topic-card-track">
<button class="topic-card topic-card--companion" data-action="companion" bindtap="handleTopicAction" hover-class="topic-card--pressed" hover-stay-time="80" aria-label="寻找搭子，进入在线搭子星球">
<image class="topic-card-art" src="/assets/images/community/community-topic-companion.png" mode="aspectFit" aria-hidden="true"></image>
<view class="topic-card-copy"><text class="topic-card-label">#寻找搭子</text><text class="topic-card-description">在线搭子星球</text></view>
<text class="topic-card-arrow" aria-hidden="true">›</text>
</button>
<button class="topic-card topic-card--guidelines" data-action="guidelines" bindtap="handleTopicAction" hover-class="topic-card--pressed" hover-stay-time="80" aria-label="社区守则，查看友善交流与隐私安全规则">
<image class="topic-card-art" src="/assets/images/community/community-topic-guidelines.png" mode="aspectFit" aria-hidden="true"></image>
<view class="topic-card-copy"><text class="topic-card-label">#社区守则</text><text class="topic-card-description">友善安心交流</text></view>
<text class="topic-card-arrow" aria-hidden="true">›</text>
</button>
<button class="topic-card topic-card--compose" data-action="compose" bindtap="handleTopicAction" hover-class="topic-card--pressed" hover-stay-time="80" aria-label="发布讨论，写下此刻想法">
<image class="topic-card-art" src="/assets/images/community/community-topic-compose.png" mode="aspectFit" aria-hidden="true"></image>
<view class="topic-card-copy"><text class="topic-card-label">#发布讨论</text><text class="topic-card-description">写下此刻想法</text></view>
<text class="topic-card-arrow" aria-hidden="true">›</text>
</button>
</view>
</scroll-view>
<view wx:if="{{appliedKeyword}}" class="search-result-bar" role="status" aria-label="当前展示关于{{appliedKeyword}}的讨论，点击清除恢复全部">
<text class="search-result-text">关于「{{appliedKeyword}}」的讨论</text>
<button class="search-reset-link" bindtap="handleResetSearch" hover-class="community-control--pressed" hover-stay-time="70" aria-label="清除搜索，查看全部讨论">清除</button>
</view>
<view wx:if="{{loading}}" class="skeleton-list" role="status" aria-label="正在加载发现内容">
<view wx:for="{{[1,2,3]}}" wx:key="*this" class="skeleton-card" aria-hidden="true">
<view class="skeleton-head"><view class="skeleton-avatar"></view><view class="skeleton-author"><view class="skeleton-line skeleton-line--name"></view><view class="skeleton-line skeleton-line--time"></view></view></view>
<view class="skeleton-content"><view class="skeleton-line skeleton-line--body"></view><view class="skeleton-line skeleton-line--body"></view><view class="skeleton-line skeleton-line--short"></view></view>
<view class="skeleton-footer"><view class="skeleton-line skeleton-line--metric"></view><view class="skeleton-line skeleton-line--metric"></view></view>
</view>
</view>
<view wx:elif="{{posts.length}}" class="post-list">
<view wx:for="{{posts}}" wx:key="id" class="post-card post-card--{{item.avatarTone}}" hover-class="post-card-hover" hover-start-time="60" hover-stay-time="70" role="button" aria-label="{{item.accessibilityLabel}}" data-id="{{item.id}}" bindtap="handlePost">
<view class="post-author-row" aria-hidden="true">
<image wx:if="{{!item.avatarSlot.empty}}" class="post-avatar post-avatar-image" src="{{item.avatarSlot.src}}" mode="{{item.avatarSlot.mode}}" lazy-load="true" data-id="{{item.id}}" binderror="handlePostAvatarError" aria-hidden="true"></image>
<view wx:else class="post-avatar post-avatar--{{item.avatarTone}}">{{item.avatarInitial}}</view>
<view class="post-author-copy"><text class="post-author">{{item.authorNickname}}</text><text class="post-time">{{item.timeLabel}}</text></view>
<button class="post-more" data-id="{{item.id}}" catchtap="handlePostAction" hover-class="post-more--pressed" hover-stay-time="70" aria-label="帖子操作菜单，点击可{{item.viewerIsAuthor ? '删除或举报内容' : '举报内容'}}"><text class="post-more-dots" aria-hidden="true">•••</text></button>
</view>
<view class="post-content-panel" aria-hidden="true"><text class="post-preview">{{item.content}}</text></view>
<view class="post-footer">
<view class="post-metrics">
<button class="like-count {{item.viewerHasLiked ? 'like-count--active' : ''}}" data-id="{{item.id}}" catchtap="handlePostLike" hover-class="like-count--pressed" hover-stop-propagation="true" hover-stay-time="70" aria-label="{{item.viewerHasLiked ? '已点赞，双击取消点赞' : '未点赞，双击点赞'}}，当前{{item.likeCount}}个赞">
<text class="like-symbol" aria-hidden="true">{{item.viewerHasLiked ? '♥' : '♡'}}</text><text aria-hidden="true">{{item.likeCount}} 赞</text>
</button>
<button class="like-count reply-count" data-id="{{item.id}}" data-r="1" catchtap="handlePost" aria-label="评论，{{item.replyCount}}条回复"><view class="reply-bubble" aria-hidden="true"></view><text aria-hidden="true">{{item.replyCount}} 回复</text></button>
</view>
</view>
</view>
<view wx:if="{{loadingMore || loadMoreError || !hasMore}}" class="list-footer" role="status">
<view wx:if="{{loadingMore}}" class="footer-state"><view class="footer-spinner" aria-hidden="true"></view><text>正在加载更多讨论…</text></view>
<button wx:elif="{{loadMoreError}}" class="footer-retry-button" bindtap="handleRetryLoadMore">加载失败，点击重试</button>
<view wx:elif="{{!hasMore}}" class="footer-state footer-state--end">{{appliedKeyword ? '— 已显示全部相关讨论 —' : '— 已经到底啦 · 拼吧发现 —'}}</view>
</view>
</view>
<view wx:else class="empty-card">
<image class="empty-bubble" src="/assets/images/community/community-empty-discussion.png" mode="aspectFit" aria-hidden="true"></image>
<text class="empty-title">{{error ? (appliedKeyword ? '搜索暂时走丢了' : '发现内容加载失败') : (appliedKeyword ? (hasMore ? '还在查找更多讨论' : '没有找到相关讨论') : '这里还很安静')}}</text>
<text class="empty-description">{{error || (appliedKeyword ? (hasMore ? '暂未找到匹配内容，可以继续向后查找' : '没有找到包含“' + appliedKeyword + '”的内容，换个词试试吧') : '来写下第一个问题或结伴经验吧。')}}</text>
<button wx:if="{{error}}" class="empty-action" hover-class="community-control--pressed" bindtap="handleRetry">{{appliedKeyword ? '重新搜索' : '点击重试'}}</button>
<button wx:elif="{{appliedKeyword && hasMore}}" class="empty-action" hover-class="community-control--pressed" bindtap="handleRetryLoadMore">继续查找</button>
<button wx:elif="{{appliedKeyword}}" class="empty-action" hover-class="community-control--pressed" bindtap="handleResetSearch">清除搜索</button>
<button wx:else class="empty-action" hover-class="community-control--pressed" bindtap="handleCompose">发起讨论</button>
</view>
</view>
</view>
