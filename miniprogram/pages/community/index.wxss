.community-page,
page {
  color: #0f172a;
  background: #eff4fa;
}

.community-page {
  position: relative;
  z-index: 0;
  isolation: isolate;
  box-sizing: border-box;
  min-height: 100vh;
  padding-right: 0;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  padding-left: 0;
  overflow-x: hidden;
  background: #eff4fa;
}

.community-fixed-background {
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  transform: translateZ(0);
}

.community-navigation {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 3;
  box-sizing: border-box;
  color: #0f172a;
}

.community-nav-inner {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 190rpx 0 32rpx;
}

.community-nav-title {
  position: absolute;
  left: 50%;
  overflow: hidden;
  max-width: 300rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  transform: translateX(-50%);
  white-space: nowrap;
}

.community-content {
  position: relative;
  z-index: 2;
  padding: 12rpx 28rpx 0;
}

.community-notice,
.community-shortcuts,
.shortcut-card,
.discussion-tabs,
.post-author-row,
.post-footer,
.post-metrics,
.reply-count,
.like-count,
.footer-state,
.skeleton-head {
  display: flex;
  align-items: center;
}

.community-notice,
.shortcut-card,
.empty-action,
.footer-retry-button {
  box-sizing: border-box;
  margin: 0;
  line-height: 1.25;
  text-align: left;
}

.community-notice::after,
.shortcut-card::after,
.empty-action::after,
.footer-retry-button::after { display: none; }

.community-notice {
  position: relative;
  width: 100%;
  min-height: 100rpx;
  padding: 0 18rpx 0 20rpx;
  overflow: hidden;
  color: #0f172a;
  background: #fff;
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(148, 163, 184, 0.08);
  transition: opacity 120ms ease, transform 120ms ease;
}

.notice-symbol {
  position: relative;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  background: #e8f7ef;
  border-radius: 50%;
}

.notice-symbol::before {
  position: absolute;
  top: 16rpx;
  left: 13rpx;
  width: 22rpx;
  height: 17rpx;
  content: '';
  background: #16a36a;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  transform: rotate(-8deg);
}

.notice-symbol-mouth {
  position: absolute;
  top: 12rpx;
  left: 29rpx;
  width: 0;
  height: 0;
  border-top: 13rpx solid transparent;
  border-bottom: 13rpx solid transparent;
  border-left: 15rpx solid #16a36a;
  transform: rotate(-8deg);
}

.notice-copy { display: flex; flex: 1; min-width: 0; align-items: center; }
.notice-label { flex-shrink: 0; margin-right: 12rpx; color: #16a36a; font-size: 24rpx; font-weight: 700; }
.notice-title { overflow: hidden; color: #334155; font-size: 24rpx; font-weight: 520; text-overflow: ellipsis; white-space: nowrap; }
.notice-badge { flex-shrink: 0; margin-left: 12rpx; padding: 6rpx 10rpx; color: #8a5b00; background: #fff1ba; border-radius: 8rpx; font-size: 20rpx; font-weight: 700; }
.notice-chevron { flex-shrink: 0; margin-left: 10rpx; color: #94a3b8; font-size: 42rpx; font-weight: 300; line-height: 1; }

.community-shortcuts { width: 100%; margin-top: 16rpx; gap: 16rpx; }

.shortcut-card {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 112rpx;
  padding: 16rpx 16rpx 16rpx 18rpx;
  overflow: hidden;
  border: 0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(148, 163, 184, 0.08);
  transition: opacity 120ms ease, transform 120ms ease;
}

.shortcut-card--compose { color: #be4a72; background: rgba(255, 241, 245, 0.96); }
.shortcut-card--rules { color: #176a9b; background: rgba(234, 244, 255, 0.96); }
.shortcut-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.shortcut-title { overflow: hidden; color: #0f172a; font-size: 28rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.shortcut-subtitle { margin-top: 8rpx; overflow: hidden; color: #64748b; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }

.shortcut-icon { position: relative; flex: 0 0 58rpx; width: 58rpx; height: 58rpx; margin-left: 8rpx; border-radius: 18rpx; }
.shortcut-icon--compose { background: #ffdbe7; }
.shortcut-icon--rules { background: #d9effc; }
.shortcut-pencil { position: absolute; top: 25rpx; left: 13rpx; width: 34rpx; height: 8rpx; background: #e35f8d; border-radius: 4rpx; transform: rotate(-42deg); }
.shortcut-pencil::after { position: absolute; right: -9rpx; top: 0; width: 0; height: 0; content: ''; border-top: 4rpx solid transparent; border-bottom: 4rpx solid transparent; border-left: 10rpx solid #b8753a; }
.shortcut-shield { position: absolute; top: 10rpx; left: 13rpx; width: 32rpx; height: 36rpx; border: 4rpx solid #1686c5; border-radius: 15rpx 15rpx 18rpx 18rpx; }
.shortcut-shield-check { position: absolute; top: 11rpx; left: 7rpx; width: 13rpx; height: 7rpx; border-bottom: 4rpx solid #1686c5; border-left: 4rpx solid #1686c5; transform: rotate(-45deg); }
.community-control--pressed { opacity: 0.84; transform: scale(0.985); }

.discussion-tabs { min-height: 72rpx; justify-content: space-between; margin: 24rpx 4rpx 16rpx; border-bottom: 1rpx solid rgba(148, 163, 184, 0.18); }
.discussion-tab { position: relative; align-self: stretch; display: flex; align-items: center; color: #0f172a; font-size: 32rpx; font-weight: 800; }
.discussion-tab--active::after { position: absolute; bottom: -1rpx; left: 0; width: 48rpx; height: 6rpx; content: ''; background: #9ccc3b; border-radius: 3rpx; }
.discussion-sort { flex-shrink: 0; color: #7b8798; font-size: 22rpx; }

.post-list,
.skeleton-list { display: flex; flex-direction: column; gap: 18rpx; }
.post-card,
.skeleton-card,
.empty-card { border: 0; box-shadow: 0 4rpx 16rpx rgba(148, 163, 184, 0.08); }

.post-card {
  box-sizing: border-box;
  min-height: 220rpx;
  padding: 22rpx 20rpx 18rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(148, 163, 184, 0.08);
  transition: opacity 120ms ease, transform 120ms ease;
}

.post-card--pressed { opacity: 0.92; transform: scale(0.988); }
.post-author-row { min-width: 0; }

.post-avatar {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 14rpx;
  color: #fff;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 750;
}

.post-avatar--blue { background: #5a8bc7; }
.post-avatar--purple { background: #7a70ba; }
.post-avatar--orange { background: #d99054; }
.post-avatar--green { background: #4f9d74; }
.post-avatar--teal { background: #4b9090; }
.post-author-copy { flex: 1; min-width: 0; }
.post-author { display: block; overflow: hidden; color: #0f172a; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; word-break: break-word; overflow-wrap: anywhere; }
.post-time { flex-shrink: 0; margin-left: 14rpx; color: #94a3b8; font-size: 24rpx; white-space: nowrap; }

.post-preview {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #334155;
  font-size: 30rpx;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.post-footer { justify-content: flex-end; min-height: 48rpx; margin-top: 14rpx; padding-top: 12rpx; color: #64748b; border-top: 1rpx solid #f1f5f9; pointer-events: none; }
.post-metrics { flex: 1; min-width: 0; justify-content: flex-end; gap: 32rpx; font-size: 24rpx; font-weight: 600; }
.like-count,
.reply-count { gap: 8rpx; }
.like-symbol { color: #16a36a; font-size: 30rpx; line-height: 1; }
.reply-bubble { position: relative; width: 25rpx; height: 18rpx; border: 3rpx solid #64748b; border-radius: 9rpx; }
.reply-bubble::after { position: absolute; bottom: -7rpx; left: 4rpx; width: 7rpx; height: 7rpx; content: ''; border-left: 3rpx solid #64748b; transform: skew(-24deg); }

.skeleton-card { box-sizing: border-box; min-height: 220rpx; padding: 22rpx 20rpx 18rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 4rpx 16rpx rgba(148, 163, 184, 0.08); }
.skeleton-avatar { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; margin-right: 14rpx; background: #e2e8f0; border-radius: 50%; }
.skeleton-author { flex: 1; }
.skeleton-line { height: 20rpx; margin-top: 14rpx; background: #e8edf2; border-radius: 10rpx; animation: skeleton-pulse 1.2s ease-in-out infinite alternate; }
.skeleton-author .skeleton-line:first-child { margin-top: 0; }
.skeleton-line--name { width: 34%; }
.skeleton-line--time { width: 20%; height: 15rpx; }
.skeleton-line--body { width: 100%; }
.skeleton-line--short { width: 62%; }

.empty-card { display: flex; align-items: center; min-height: 340rpx; padding: 38rpx 30rpx 42rpx; flex-direction: column; background: #fff; border-radius: 24rpx; text-align: center; }
.empty-bubble { position: relative; display: flex; align-items: center; justify-content: center; gap: 8rpx; width: 92rpx; height: 70rpx; border: 6rpx solid #6c88a2; border-radius: 36rpx; transform: rotate(-3deg); }
.empty-bubble::after { position: absolute; bottom: -16rpx; left: 17rpx; width: 19rpx; height: 19rpx; content: ''; border-left: 6rpx solid #6c88a2; transform: skew(-30deg); }
.empty-bubble-dot { width: 8rpx; height: 8rpx; background: #6c88a2; border-radius: 50%; }
.empty-title { margin-top: 25rpx; color: #0f172a; font-size: 30rpx; font-weight: 700; }
.empty-description { max-width: 520rpx; margin-top: 12rpx; color: #64748b; font-size: 24rpx; line-height: 1.55; }
.empty-action { min-height: 88rpx; margin-top: 24rpx; padding: 14rpx 30rpx; color: #11784f; background: #e8f5ee; border: 1.5rpx solid #cde8db; border-radius: 44rpx; font-size: 26rpx; font-weight: 650; text-align: center; }
.empty-action--retry { color: #405b73; background: #fff; border-color: #d7dee5; }
.empty-action--pressed { opacity: 0.82; transform: scale(0.985); }

.list-footer { display: flex; align-items: center; justify-content: center; min-height: 104rpx; padding: 8rpx 0; }
.footer-state { justify-content: center; gap: 12rpx; color: #64748b; font-size: 22rpx; }
.footer-state--end { color: #94a3b8; }
.footer-spinner { width: 23rpx; height: 23rpx; border: 3rpx solid rgba(100, 116, 139, 0.24); border-top-color: #64748b; border-radius: 50%; animation: footer-spin 0.8s linear infinite; }
.footer-retry-button { min-height: 88rpx; padding: 16rpx 28rpx; color: #11784f; background: #fff; border-radius: 44rpx; font-size: 24rpx; text-align: center; }

@media (max-width: 340px) {
  .community-nav-title { font-size: 30rpx; }
  .community-content { padding: 10rpx 20rpx 0; }
  .community-notice { min-height: 92rpx; padding-right: 14rpx; padding-left: 16rpx; }
  .notice-symbol { flex-basis: 46rpx; width: 46rpx; height: 46rpx; margin-right: 10rpx; transform: scale(0.9); }
  .notice-title { font-size: 24rpx; }
  .notice-badge { margin-left: 7rpx; padding-right: 7rpx; padding-left: 7rpx; font-size: 18rpx; }
  .notice-chevron { margin-left: 6rpx; }
  .community-shortcuts { gap: 14rpx; }
  .shortcut-card { min-height: 104rpx; padding: 14rpx; }
  .shortcut-title { font-size: 26rpx; }
  .shortcut-subtitle { font-size: 20rpx; }
  .shortcut-icon { flex-basis: 48rpx; width: 48rpx; height: 48rpx; margin-left: 4rpx; transform: scale(0.86); }
  .discussion-tabs { min-height: 64rpx; margin-top: 18rpx; margin-bottom: 12rpx; }
  .discussion-tab { font-size: 28rpx; }
  .discussion-sort { font-size: 20rpx; }
  .post-card,
  .skeleton-card { min-height: 200rpx; padding: 18rpx 16rpx 14rpx; }
  .post-avatar,
  .skeleton-avatar { flex-basis: 56rpx; width: 56rpx; height: 56rpx; font-size: 22rpx; }
  .post-author { font-size: 26rpx; }
  .post-time { margin-left: 10rpx; font-size: 22rpx; }
  .post-preview { font-size: 28rpx; line-height: 1.42; }
  .post-metrics { gap: 24rpx; font-size: 22rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton-line,
  .skeleton-avatar,
  .footer-spinner { animation: none; }
}

@keyframes skeleton-pulse { to { opacity: 0.54; } }
@keyframes footer-spin { to { transform: rotate(360deg); } }
