page { color: #111827; background: #f9f7f2; }
.community-page { box-sizing: border-box; min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); overflow-x: hidden; background: #f9f7f2; }
.community-content { padding: 8rpx 28rpx 0; }
button { margin: 0; padding: 0; line-height: 1.25; }button::after { display: none; }
.discover-square-header { display: flex; min-height: 150rpx; align-items: center; justify-content: space-between; }
.discover-square-copy { display: flex; min-width: 0; flex-direction: column; }.discover-square-eyebrow { color: #b1aaa0; font-size: 16rpx; font-weight: 750; letter-spacing: 3rpx; }.discover-square-title { margin-top: 3rpx; color: #111827; font-size: 44rpx; font-weight: 900; line-height: 1.05; }.discover-square-subtitle { margin-top: 8rpx; color: #888078; font-size: 21rpx; }
.discover-compose-button { display: flex; min-width: 120rpx; min-height: 88rpx; align-items: center; justify-content: center; gap: 8rpx; color: #fff; background: #111827; border: 0; border-radius: 44rpx; font-size: 22rpx; font-weight: 700; box-shadow: 0 7rpx 18rpx rgba(17,24,39,.15); }
.compose-pencil { position: relative; width: 25rpx; height: 7rpx; background: #fff; border-radius: 4rpx; transform: rotate(-42deg); }.compose-pencil::after { position: absolute; margin-left: 21rpx; width: 0; height: 0; content: ''; border-top: 4rpx solid transparent; border-bottom: 4rpx solid transparent; border-left: 8rpx solid #fff; }
.community-notice { display: flex; width: 100%; min-height: 100rpx; align-items: center; box-sizing: border-box; padding: 0 18rpx; color: #111827; background: #fff; border: 1rpx solid #eee9df; border-radius: 24rpx; box-shadow: 0 5rpx 16rpx rgba(83,69,50,.05); transition: transform 120ms ease, opacity 120ms ease; }
.notice-symbol { position: relative; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; margin-right: 13rpx; background: #fff2c9; border-radius: 50%; }.notice-symbol::before { position: absolute; top: 15rpx; left: 11rpx; width: 21rpx; height: 16rpx; content: ''; background: #e4a72b; border-radius: 4rpx 9rpx 9rpx 4rpx; }.notice-symbol-mouth { position: absolute; top: 11rpx; left: 27rpx; border-top: 13rpx solid transparent; border-bottom: 13rpx solid transparent; border-left: 14rpx solid #e4a72b; }
.notice-copy { display: flex; flex: 1; min-width: 0; align-items: center; }.notice-label { flex-shrink: 0; margin-right: 11rpx; color: #a16b08; font-size: 23rpx; font-weight: 750; }.notice-title { overflow: hidden; color: #5f5951; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }.notice-badge { flex-shrink: 0; margin-left: 10rpx; padding: 6rpx 10rpx; color: #8a5b00; background: #fff1ba; border-radius: 9rpx; font-size: 19rpx; font-weight: 700; }.notice-chevron { margin-left: 8rpx; color: #a8a096; font-size: 38rpx; }
.community-control--pressed { opacity: .78; transform: scale(.975); }
.discussion-tabs { display: flex; min-height: 112rpx; align-items: flex-end; justify-content: space-between; padding: 0 4rpx 18rpx; }.discussion-eyebrow { display: block; color: #b4ada3; font-size: 15rpx; font-weight: 750; letter-spacing: 3rpx; }.discussion-tab { display: block; position: relative; margin-top: 5rpx; color: #111827; font-size: 31rpx; font-weight: 850; }.discussion-tab--active::after { position: absolute; bottom: -9rpx; left: 0; width: 44rpx; height: 5rpx; content: ''; background: #f59e0b; border-radius: 3rpx; }.discussion-sort { display: flex; align-items: center; gap: 7rpx; color: #8f877e; font-size: 20rpx; }.discussion-live-dot { width: 8rpx; height: 8rpx; background: #16a36a; border-radius: 50%; }
.post-list,.skeleton-list { display: flex; flex-direction: column; gap: 18rpx; }.post-card,.skeleton-card,.empty-card { box-sizing: border-box; background: #fff; border: 1rpx solid #eee9df; border-radius: 24rpx; box-shadow: 0 6rpx 18rpx rgba(83,69,50,.055); }
.post-card { position: relative; min-height: 230rpx; padding: 22rpx 20rpx 17rpx; overflow: hidden; transition: transform 120ms ease, opacity 120ms ease; }.post-card::before { position: absolute; top: 0; right: 0; left: 0; height: 5rpx; content: ''; background: #e9c46a; }.post-card--blue::before { background: #9bc4e7; }.post-card--purple::before { background: #b5a2da; }.post-card--orange::before { background: #e6ad79; }.post-card--green::before { background: #9fc6a9; }.post-card--teal::before { background: #91c3bd; }.post-card--pressed { opacity: .86; transform: scale(.985); }
.post-author-row,.post-footer,.post-metrics,.like-count,.reply-count,.skeleton-head,.footer-state { display: flex; align-items: center; }.post-avatar { display: flex; flex: 0 0 58rpx; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; margin-right: 13rpx; color: #fff; border-radius: 50%; font-size: 24rpx; font-weight: 750; }.post-avatar--blue { background:#7fa6ce; }.post-avatar--purple { background:#9a8bc7; }.post-avatar--orange { background:#d59b68; }.post-avatar--green { background:#76a986; }.post-avatar--teal { background:#6ca5a0; }.post-author-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }.post-author { overflow: hidden; color: #28241f; font-size: 26rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }.post-time { margin-top: 3rpx; color: #aaa299; font-size: 19rpx; }.post-more { color: #aaa299; font-size: 26rpx; letter-spacing: 2rpx; }
.post-preview { display: -webkit-box; margin-top: 15rpx; overflow: hidden; color: #3d3934; font-size: 29rpx; line-height: 1.48; word-break: break-word; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.post-footer { min-height: 46rpx; margin-top: 14rpx; padding-top: 12rpx; justify-content: flex-end; border-top: 1rpx solid #f2eee8; pointer-events: none; }.post-metrics { gap: 26rpx; color: #817a72; font-size: 22rpx; }.like-count,.reply-count { gap: 7rpx; }.like-symbol { color: #d79a2d; font-size: 28rpx; }.reply-bubble { position: relative; width: 23rpx; height: 17rpx; border: 3rpx solid #817a72; border-radius: 8rpx; }.reply-bubble::after { position: absolute; bottom: -7rpx; left: 4rpx; width: 7rpx; height: 7rpx; content: ''; border-left: 3rpx solid #817a72; transform: skew(-24deg); }
.skeleton-card { min-height: 230rpx; padding: 22rpx 20rpx; }.skeleton-avatar { flex: 0 0 58rpx; width: 58rpx; height: 58rpx; margin-right: 13rpx; background:#e9e4dc; border-radius:50%; }.skeleton-author { flex:1; }.skeleton-line { height:19rpx; margin-top:14rpx; background:#ece8e1; border-radius:10rpx; animation:pulse 1s ease-in-out infinite alternate; }.skeleton-line--name{width:34%;margin-top:0}.skeleton-line--time{width:20%;height:14rpx}.skeleton-line--body{width:100%}.skeleton-line--short{width:58%}
.list-footer { min-height: 100rpx; }.footer-state { min-height: 100rpx; justify-content: center; gap: 10rpx; color: #aaa299; font-size: 21rpx; }.footer-spinner { width: 22rpx; height: 22rpx; border: 3rpx solid #ded8cf; border-top-color:#f59e0b; border-radius:50%; animation:spin .7s linear infinite; }.footer-retry-button { width:100%; min-height:88rpx; color:#8a5b00; background:#fff5d8; border:1rpx solid #f2d28b; border-radius:44rpx; font-size:22rpx; }
.empty-card { display:flex; min-height:360rpx; padding:40rpx 28rpx; align-items:center; justify-content:center; flex-direction:column; }.empty-bubble { display:flex; width:88rpx; height:68rpx; align-items:center; justify-content:center; gap:7rpx; background:#fff1c9; border-radius:30rpx; }.empty-bubble-dot { width:8rpx; height:8rpx; background:#d79a2d; border-radius:50%; }.empty-title { margin-top:22rpx; color:#28241f; font-size:30rpx; font-weight:800; }.empty-description { margin-top:10rpx; color:#8f877e; font-size:22rpx; text-align:center; }.empty-action { min-width:200rpx; min-height:88rpx; margin-top:24rpx; color:#fff; background:#111827; border:0; border-radius:44rpx; font-size:23rpx; font-weight:700; }
@keyframes pulse{from{opacity:.55}to{opacity:1}}@keyframes spin{to{transform:rotate(360deg)}}
@media (max-width:340px){.community-content{padding-right:20rpx;padding-left:20rpx}.discover-square-header{min-height:136rpx}.discover-square-title{font-size:39rpx}.discover-square-subtitle{font-size:19rpx}.community-notice{min-height:92rpx;padding:0 14rpx}.notice-title{font-size:20rpx}.discussion-tabs{min-height:100rpx}.post-list,.skeleton-list{gap:14rpx}.post-card{min-height:210rpx;padding:19rpx 17rpx 15rpx}.post-preview{font-size:27rpx}}
@media (prefers-reduced-motion:reduce){.post-card,.community-notice,.discover-compose-button{transition:none}.skeleton-line,.footer-spinner{animation:none}}
