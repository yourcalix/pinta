page{color:#111827;background:#f9f7f2}
.community-page{box-sizing:border-box;min-height:100vh;padding-bottom:calc(190rpx + env(safe-area-inset-bottom));overflow-x:hidden;background:#f9f7f2;}
.community-content{padding-top:12rpx}
button{margin:0;padding:0;line-height:1.25}
button::after{display:none}
.community-reference-header{display:flex;align-items:center;gap:14rpx;padding:0 28rpx}
.discussion-search-entry{display:flex;flex:1;min-width:0;min-height:88rpx;align-items:center;box-sizing:border-box;padding:0 24rpx;color:#111827;background:#fff;border:1rpx solid rgba(221,215,205,.82);border-radius:44rpx;box-shadow:0 8rpx 24rpx rgba(83,69,50,.09);text-align:left}
.search-symbol{position:relative;flex:0 0 30rpx;width:30rpx;height:30rpx;margin-right:14rpx;box-sizing:border-box;border:5rpx solid #777b80;border-radius:50%}
.search-symbol::after{position:absolute;right:-11rpx;bottom:-8rpx;width:14rpx;height:5rpx;content:'';background:#777b80;border-radius:3rpx;transform:rotate(45deg)}
.discussion-search-input{flex:1;min-width:0;height:72rpx;color:#111827;font-size:28rpx}
.discussion-search-placeholder{color:#9ca3af}
.discussion-search-clear{flex:0 0 56rpx;min-width:56rpx;min-height:88rpx;color:#8b8d90;background:transparent;border:0;font-size:32rpx}
.discussion-search-action{flex:0 0 88rpx;min-width:88rpx;min-height:88rpx;color:#8a6500;background:transparent;border:0;font-size:24rpx;font-weight:750}
.community-notification{display:flex;flex:0 0 88rpx;min-width:88rpx;min-height:88rpx;align-items:center;justify-content:center;background:transparent;border:0;transition:opacity 120ms ease,transform 120ms ease}
.community-notification-image{width:78rpx;height:78rpx}
.community-control--pressed{opacity:.76;transform:scale(.97)}
.search-result-bar{display:flex;min-height:64rpx;align-items:center;justify-content:space-between;margin:2rpx 28rpx 0;color:#78716c;font-size:24rpx}
.search-result-text{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.search-reset-link{flex:0 0 88rpx;min-width:88rpx;min-height:64rpx;color:#8a6500;background:transparent;border:0;font-size:24rpx;font-weight:750}
.community-topic-rail{width:100%;margin-top:22rpx;padding:12rpx 0 20rpx;box-sizing:border-box;white-space:nowrap}
.topic-card-track{display:inline-flex;gap:16rpx;padding:0 28rpx 10rpx}
.topic-card{display:inline-flex;position:relative;flex-shrink:0;width:210rpx;min-height:202rpx;box-sizing:border-box;padding:8rpx 14rpx 14rpx;overflow:hidden;flex-direction:column;color:#111827;background:#fff;border:1rpx solid rgba(232,226,216,.92);border-radius:26rpx;box-shadow:0 8rpx 22rpx rgba(83,69,50,.07);text-align:left;vertical-align:top;transition:opacity 120ms ease,transform 120ms ease}
.topic-card--pressed{opacity:.82;transform:scale(.975)}
.topic-card--companion{background:linear-gradient(155deg,#fff 40%,#f1f7e7 100%)}
.topic-card--guidelines{background:linear-gradient(155deg,#fff 42%,#fff1e4 100%)}
.topic-card--compose{background:linear-gradient(155deg,#fff 42%,#fff7da 100%)}
.topic-card-art{width:100%;height:112rpx;pointer-events:none;user-select:none}
.topic-card-copy{display:flex;min-width:0;flex-direction:column}
.topic-card-label{overflow:hidden;font-size:28rpx;font-weight:850;text-overflow:ellipsis;white-space:nowrap}
.topic-card-description{margin-top:4rpx;color:#817b73;font-size:24rpx;line-height:1.35}
.topic-card-arrow{position:absolute;right:12rpx;bottom:9rpx;color:#a39c93;font-size:30rpx}
.post-list,.skeleton-list{display:flex;padding:20rpx 28rpx 0;flex-direction:column;gap:22rpx}
.post-card,.skeleton-card,.empty-card{box-sizing:border-box;background:#fff;border:1rpx solid rgba(232,226,216,.92);border-radius:28rpx;box-shadow:0 9rpx 26rpx rgba(83,69,50,.065)}
.post-card{min-height:300rpx;padding:24rpx;overflow:hidden;border-radius:28rpx;transition:opacity 120ms ease,transform 120ms ease}
.post-card-hover{background:#f6f4ee}
.post-author-row,.post-footer,.post-metrics,.like-count,.reply-count,.skeleton-head,.skeleton-footer,.footer-state{display:flex;align-items:center}
.post-avatar{display:flex;flex:0 0 72rpx;width:72rpx;height:72rpx;align-items:center;justify-content:center;margin-right:16rpx;color:#fff;border-radius:50%;font-size:28rpx;font-weight:800;box-shadow:inset 0 -4rpx 9rpx rgba(17,24,39,.08)}
.post-avatar--blue{background:#7fa6ce}
.post-avatar--purple{background:#9a8bc7}
.post-avatar--orange{background:#d59b68}
.post-avatar--green{background:#76a986}
.post-avatar--teal{background:#6ca5a0}
.post-author-copy{display:flex;flex:1;min-width:0;flex-direction:column}
.post-author{overflow:hidden;color:#201f1d;font-size:28rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}
.post-time{margin-top:5rpx;color:#96918b;font-size:24rpx}
.post-more{flex-shrink:0;margin-left:10rpx;color:#989898;font-size:28rpx;font-weight:800;letter-spacing:3rpx}
.post-content-panel{min-height:112rpx;margin-top:20rpx;padding:18rpx 20rpx;box-sizing:border-box;background:#faf8f4;border-radius:18rpx}
.post-preview{display:-webkit-box;overflow:hidden;color:#32302d;font-size:28rpx;line-height:46rpx;white-space:normal;word-break:break-all;word-wrap:break-word;overflow-wrap:anywhere;-webkit-box-orient:vertical;-webkit-line-clamp:4}
.post-footer{min-height:54rpx;margin-top:14rpx;justify-content:space-between}
.post-metrics{gap:12rpx;color:#797774;font-size:24rpx}
.like-count{min-width:88rpx;min-height:88rpx;padding:0 8rpx;gap:8rpx;color:#797774;background:transparent;border:0;border-radius:44rpx;font-size:24rpx}
.like-symbol{color:#a19b94;font-size:31rpx;line-height:1}
.like-count--active .like-symbol{color:#e2554f;transform:scale(1.1)}
.reply-bubble{position:relative;width:24rpx;height:18rpx;box-sizing:border-box;border:3rpx solid #858585;border-radius:9rpx}
.reply-bubble::after{position:absolute;bottom:-7rpx;left:4rpx;width:7rpx;height:7rpx;content:'';border-left:3rpx solid #858585;transform:skew(-24deg)}
.skeleton-card{min-height:300rpx;padding:24rpx}
.skeleton-avatar{flex:0 0 72rpx;width:72rpx;height:72rpx;margin-right:16rpx;background:#e8e3dc;border-radius:50%}
.skeleton-author{flex:1}
.skeleton-content{margin-top:20rpx;padding:18rpx 20rpx;background:#faf8f4;border-radius:18rpx}
.skeleton-line{height:20rpx;margin-top:14rpx;background:#ebe6df;border-radius:10rpx;animation:pulse 1s ease-in-out infinite alternate}
.skeleton-line--name{width:34%;margin-top:0}
.skeleton-line--time{width:22%;height:16rpx}
.skeleton-line--body{width:100%}
.skeleton-line--short{width:58%}
.skeleton-footer{min-height:54rpx;gap:28rpx}
.skeleton-line--metric{width:90rpx;height:17rpx;margin-top:0}
.list-footer{min-height:100rpx}
.footer-state{min-height:100rpx;justify-content:center;gap:10rpx;color:#aaa299;font-size:24rpx}
.footer-spinner{width:22rpx;height:22rpx;border:3rpx solid #ded8cf;border-top-color:#f2b93b;border-radius:50%;animation:spin .7s linear infinite}
.footer-retry-button{width:100%;min-height:88rpx;color:#8a6500;background:#fff5d8;border:1rpx solid #f2d28b;border-radius:44rpx;font-size:24rpx}
.empty-card{display:flex;min-height:440rpx;margin:20rpx 28rpx 0;padding:34rpx 28rpx 40rpx;align-items:center;justify-content:center;flex-direction:column}
.empty-bubble{width:240rpx;height:200rpx;pointer-events:none;user-select:none}
.empty-title{margin-top:12rpx;color:#28241f;font-size:30rpx;font-weight:850}
.empty-description{margin-top:10rpx;color:#817b73;font-size:24rpx;line-height:38rpx;text-align:center}
.empty-action{min-width:220rpx;min-height:88rpx;margin-top:24rpx;color:#111827;background:#ffd45c;border:0;border-radius:44rpx;font-size:28rpx;font-weight:800;box-shadow:0 7rpx 16rpx rgba(190,139,18,.16)}
@keyframes pulse{from{opacity:.55}
to{opacity:1}
}
@keyframes spin{to{transform:rotate(360deg)}
}
@media (max-width:340px){.community-reference-header{gap:8rpx;padding:0 20rpx}
.discussion-search-entry{padding:0 16rpx}
.discussion-search-input{font-size:26rpx}
.discussion-search-placeholder{font-size:24rpx}
.discussion-search-clear{flex-basis:48rpx;min-width:48rpx}
.discussion-search-action{flex-basis:80rpx;min-width:80rpx;font-size:26rpx}
.search-symbol{margin-right:12rpx}
.search-result-bar{margin-right:20rpx;margin-left:20rpx}
.community-notification{flex-basis:82rpx;min-width:82rpx}
.community-notification-image{width:72rpx;height:72rpx}
.topic-card-track{padding-right:20rpx;padding-left:20rpx}
.post-list,.skeleton-list{padding-right:20rpx;padding-left:20rpx;gap:18rpx}
.post-card{padding:21rpx}
.post-content-panel{padding-right:17rpx;padding-left:17rpx}
.post-metrics{gap:4rpx}
.like-count{padding-right:4rpx;padding-left:4rpx}
.empty-card{margin-right:20rpx;margin-left:20rpx}
}
@media (prefers-reduced-motion:reduce){.community-notification,.topic-card,.post-card{transition:none}
.skeleton-line,.footer-spinner{animation:none}
}
