page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  color: #27312c;
  background: #f6f2ea;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
}

button::after {
  display: none;
  border: 0;
}

.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f6f2ea;
}

.map-stage,
.map-hotspots {
  position: absolute;
  z-index: 1;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: none;
}

.map-hotspots {
  z-index: 20;
  overflow: visible;
}

.map-canvas,
.map-hotspot-canvas {
  position: relative;
  width: 100vw;
  height: 177.73vw;
  flex: 0 0 auto;
}

.map-hotspot-canvas {
  pointer-events: none;
}

.map-image {
  display: block;
  width: 100%;
  pointer-events: none;
  user-select: none;
}

.map-navigation {
  position: absolute;
  z-index: 100;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 0 24rpx 10rpx;
  background: transparent;
  box-shadow: none;
  pointer-events: none;
}

.map-back {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  color: #27312c;
  background: transparent;
  pointer-events: auto;
  transition: opacity 120ms ease, transform 120ms ease;
}

.map-back-surface {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  padding-bottom: 4rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(58, 43, 25, 0.12);
  font-size: 56rpx;
  font-weight: 400;
  line-height: 1;
  backdrop-filter: blur(10rpx);
}

.map-back--pressed {
  opacity: 0.72;
  transform: scale(0.94);
}

.map-navigation-title {
  position: absolute;
  right: 180rpx;
  bottom: 34rpx;
  left: 180rpx;
  overflow: hidden;
  color: #27312c;
  font-size: 32rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  text-align: center;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.88);
  white-space: nowrap;
}

.map-marker {
  position: absolute;
  display: flex;
  width: 108rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  overflow: visible;
  color: #3b2211;
  background: transparent;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  text-align: center;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.45), 0 2rpx 3rpx rgba(79, 47, 21, 0.16);
  transform: translate(-50%, -50%);
  white-space: nowrap;
  pointer-events: auto;
  transition: opacity 100ms ease, transform 120ms ease;
}

.map-marker--companion {
  left: 42%;
  top: 8.4%;
}

.map-marker--sport {
  left: 83.2%;
  top: 28.8%;
}

.map-marker--food {
  left: 37%;
  top: 34.2%;
}

.map-marker--benefit {
  left: 84.8%;
  top: 79.6%;
}

.map-marker--pressed {
  opacity: 0.74;
  transform: translate(-50%, -50%) scale(0.94);
}

.map-hint {
  position: absolute;
  z-index: 15;
  right: 50%;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  min-height: 64rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  color: #5e4327;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(58, 43, 25, 0.1);
  font-size: 24rpx;
  font-weight: 650;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.7);
  transform: translateX(50%);
  white-space: nowrap;
  pointer-events: none;
  backdrop-filter: blur(8rpx);
}

@media (max-width: 340px) {
  .map-navigation { padding-right: 16rpx; padding-left: 16rpx; }
  .map-navigation-title { right: 150rpx; left: 150rpx; font-size: 30rpx; }
  .map-marker { width: 100rpx; height: 88rpx; font-size: 24rpx; }
  .map-hint { bottom: calc(18rpx + env(safe-area-inset-bottom)); font-size: 22rpx; }
}

@media (max-height: 680px) {
  .map-navigation-title { display: none; }
  .map-hint { min-height: 48rpx; padding: 0; background: transparent; border: 0; box-shadow: none; }
}

@media (prefers-reduced-motion: reduce) {
  .map-back,
  .map-marker { transition: none; }
}
