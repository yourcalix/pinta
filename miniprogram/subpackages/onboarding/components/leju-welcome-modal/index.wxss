.welcome-modal {
  position: fixed;
  inset: 0;
  z-index: 1080;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 32rpx 30rpx calc(32rpx + env(safe-area-inset-bottom));
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 220ms ease, visibility 0s linear 220ms;
}

.welcome-modal--opened {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity 220ms ease, visibility 0s linear 0s;
}

.welcome-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 20, 17, 0.76);
}

.welcome-modal__stage {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  transform: translateY(-2vh) scale(0.94);
  opacity: 0;
  transition: transform 420ms cubic-bezier(0.2, 0.9, 0.24, 1.08), opacity 220ms ease;
}

.welcome-modal--opened .welcome-modal__stage {
  transform: translateY(-2vh) scale(1);
  opacity: 1;
}

.welcome-modal__poster-wrap {
  position: relative;
  width: 72vw;
  max-width: 540rpx;
  flex: none;
  filter: drop-shadow(0 22rpx 42rpx rgba(8, 14, 10, 0.34));
}

.welcome-modal__poster {
  display: block;
  width: 100%;
  height: auto;
  pointer-events: none;
}

.welcome-modal__close {
  position: absolute;
  top: -34rpx;
  right: -34rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 0 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: rgba(39, 45, 41, 0.78);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.24);
  color: #FFFFFF;
  font-size: 60rpx;
  font-weight: 300;
  line-height: 1;
  box-sizing: border-box;
}

.welcome-modal__close::after,
.welcome-modal__start::after {
  border: none !important;
}

.welcome-modal__close--pressed {
  transform: scale(0.94);
  opacity: 0.9;
}

.welcome-modal__start {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 460rpx;
  max-width: calc(100vw - 96rpx);
  min-height: 92rpx;
  margin: 28rpx 0 0;
  padding: 0 42rpx;
  border: 2rpx solid rgba(255, 247, 194, 0.92);
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFE58A 0%, #FFC84D 100%);
  box-shadow: 0 14rpx 34rpx rgba(255, 185, 48, 0.34), inset 0 4rpx 0 rgba(255, 255, 255, 0.72);
  color: #0D5A3B;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.welcome-modal__start--pressed {
  transform: scale(0.97);
  filter: brightness(0.97);
}

@media (max-height: 680px) {
  .welcome-modal {
    padding-top: 20rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  }

  .welcome-modal__stage,
  .welcome-modal--opened .welcome-modal__stage {
    transform: translateY(-1vh) scale(1);
  }

  .welcome-modal__poster-wrap {
    width: 58vw;
    max-width: 370rpx;
  }

  .welcome-modal__close {
    top: -28rpx;
    right: -28rpx;
    width: 88rpx;
    min-width: 88rpx;
    height: 88rpx;
    min-height: 88rpx;
    font-size: 52rpx;
  }

  .welcome-modal__start {
    width: 370rpx;
    min-height: 88rpx;
    margin-top: 20rpx;
    font-size: 27rpx;
  }
}
