.detail-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.state-card, .post-detail { padding: 28rpx; }
.state-card { display: flex; min-height: 240rpx; align-items: center; justify-content: center; flex-direction: column; color: #6d7872; }
.retry-button { margin-top: 20rpx; }
.author-row, .reply-card { display: flex; align-items: flex-start; }
.avatar, .reply-avatar { display: flex; align-items: center; justify-content: center; color: #fff8ee; font-weight: 700; box-shadow: inset 0 -4rpx 0 rgba(7,35,70,.12), 0 4rpx 10rpx rgba(7,35,70,.12); }
.avatar { flex: 0 0 80rpx; width: 80rpx; height: 80rpx; margin-right: 16rpx; border: 3rpx solid rgba(255,248,238,.86); border-radius: 24rpx; font-size: 34rpx; }
.avatar--blue { background: #2f6fbd; }
.avatar--purple { background: #6b46c1; }
.avatar--orange { background: #dd6b20; }
.avatar--green { background: #16a36a; }
.avatar--teal { background: #168f8d; }
.author-meta { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.author-name, .reply-author { font-weight: 680; }
.post-time { margin-top: 5rpx; color: #828c87; font-size: 22rpx; }
.more-button { flex: 0 0 72rpx; min-height: 64rpx; margin: 0; padding: 0; color: #69756f; background: transparent; font-size: 34rpx; line-height: 1; }
.post-content { display: block; margin-top: 26rpx; font-size: 30rpx; line-height: 1.8; word-break: break-word; }
.post-actions, .reply-actions { display: flex; align-items: center; }
.post-actions { justify-content: space-between; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx dashed #eadbce; }
.reply-total { color: #69756f; font-size: 24rpx; }
.like-button { min-height: 56rpx; margin: 0; padding: 0 20rpx; border: 2rpx solid #dce9e3; border-radius: 999rpx; background: #f5fbf8; color: #597169; font-size: 23rpx; font-weight: 650; line-height: 56rpx; }
.like-button--active { border-color: rgba(22,163,106,.38); background: rgba(22,163,106,.14); color: #11784f; }
.like-button--pending { opacity: .7; }
.like-button--pressed { transform: scale(.96); opacity: .9; }
.reply-heading { display: flex; align-items: center; gap: 10rpx; margin: 34rpx 4rpx 18rpx; color: #fff8ee; font-size: 31rpx; font-weight: 700; text-shadow: 0 2rpx 4rpx rgba(7,35,70,.24); }
.reply-count { color: #16a36a; }
.reply-list { display: flex; flex-direction: column; gap: 16rpx; }
.reply-card { padding: 22rpx; }
.reply-avatar { flex: 0 0 62rpx; width: 62rpx; height: 62rpx; margin-right: 14rpx; border: 2rpx solid rgba(255,248,238,.78); border-radius: 18rpx; font-size: 27rpx; }
.reply-body { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.reply-meta { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-width: 0; }
.reply-author { font-size: 25rpx; }
.reply-time { flex: 0 0 auto; color: #8a958f; font-size: 21rpx; }
.reply-content { margin-top: 8rpx; color: #354139; line-height: 1.65; word-break: break-word; }
.reply-actions { margin-top: 14rpx; }
.reply-like { min-height: 48rpx; padding: 0 16rpx; font-size: 21rpx; line-height: 48rpx; }
.reply-more { flex-basis: 60rpx; min-height: 54rpx; font-size: 29rpx; }
.empty-replies { padding: 50rpx 24rpx; color: #7b8580; text-align: center; }
.load-more-button { min-height: 72rpx; margin: 4rpx 12rpx 0; color: #11784f; background: rgba(255,248,238,.92); border: 2rpx solid rgba(22,163,106,.18); border-radius: 18rpx; font-size: 25rpx; font-weight: 650; line-height: 72rpx; }
.load-more-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 4rpx 12rpx 0; padding: 18rpx 20rpx; color: #7b8580; background: rgba(255,248,238,.92); border-radius: 18rpx; font-size: 24rpx; }
.reply-composer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 14rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); border-top: 1rpx solid #e5ebe8; }
.reply-input { flex: 1; min-width: 0; min-height: 82rpx; padding: 18rpx 22rpx; background: #f3f7f5; border: 1rpx solid #e1e8e4; border-radius: 18rpx; }
.send-button { flex: 0 0 116rpx; min-height: 82rpx; margin: 0; padding: 14rpx; color: #fff; background: #16a36a; border-radius: 18rpx; font-size: 26rpx; line-height: 1.2; }
.send-button[disabled] { color: #eef6f2; background: #a9cdbb; }
