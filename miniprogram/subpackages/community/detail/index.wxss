.detail-page { min-height: 100vh; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.state-card, .post-detail { padding: 28rpx; }
.state-card { display: flex; min-height: 240rpx; align-items: center; justify-content: center; flex-direction: column; color: #6d7872; }
.retry-button { margin-top: 20rpx; }
.author-row, .reply-card { display: flex; align-items: flex-start; }
.avatar { flex: 0 0 80rpx; width: 80rpx; height: 80rpx; margin-right: 16rpx; background: #eaf6ef; border-radius: 20rpx; }
.author-meta { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.author-name, .reply-author { font-weight: 680; }
.post-time { margin-top: 5rpx; color: #828c87; font-size: 22rpx; }
.more-button { flex: 0 0 72rpx; min-height: 64rpx; margin: 0; padding: 0; color: #69756f; background: transparent; font-size: 34rpx; line-height: 1; }
.post-content { display: block; margin-top: 26rpx; font-size: 30rpx; line-height: 1.8; word-break: break-word; }
.reply-heading { display: flex; align-items: center; gap: 10rpx; margin: 34rpx 4rpx 18rpx; color: #fff8ee; font-size: 31rpx; font-weight: 700; text-shadow: 0 2rpx 4rpx rgba(7,35,70,.24); }
.reply-count { color: #16a36a; }
.reply-list { display: flex; flex-direction: column; gap: 16rpx; }
.reply-card { padding: 22rpx; }
.reply-avatar { flex: 0 0 62rpx; width: 62rpx; height: 62rpx; margin-right: 14rpx; background: #eef7f2; border-radius: 16rpx; }
.reply-body { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.reply-author { font-size: 25rpx; }
.reply-content { margin-top: 8rpx; color: #354139; line-height: 1.65; word-break: break-word; }
.reply-more { flex-basis: 60rpx; min-height: 54rpx; font-size: 29rpx; }
.empty-replies { padding: 50rpx 24rpx; color: #7b8580; text-align: center; }
.reply-composer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 14rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); border-top: 1rpx solid #e5ebe8; }
.reply-input { flex: 1; min-width: 0; min-height: 82rpx; padding: 18rpx 22rpx; background: #f3f7f5; border: 1rpx solid #e1e8e4; border-radius: 18rpx; }
.send-button { flex: 0 0 116rpx; min-height: 82rpx; margin: 0; padding: 14rpx; color: #fff; background: #16a36a; border-radius: 18rpx; font-size: 26rpx; line-height: 1.2; }
.send-button[disabled] { color: #eef6f2; background: #a9cdbb; }
