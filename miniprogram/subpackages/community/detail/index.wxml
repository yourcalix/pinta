<view class="detail-page" style="padding-top: {{contentTopInset}}px;">
  <view class="detail-navigation" style="height: {{contentTopInset}}px;">
    <view class="detail-nav-inner">
      <button class="detail-back" bindtap="handleBack" hover-class="detail-control--pressed" hover-stay-time="70" aria-label="返回上一页"><text aria-hidden="true">‹</text></button>
      <text class="detail-nav-title" role="heading" aria-level="1">讨论详情</text>
      <view class="detail-nav-spacer" aria-hidden="true"></view>
    </view>
  </view>

  <view class="detail-content">
    <view wx:if="{{loading}}" class="state-card surface" role="status">正在加载讨论…</view>
    <view wx:elif="{{error}}" class="state-card surface" role="alert">
      <text>{{error}}</text>
      <button class="secondary-button retry-button" bindtap="handleRetryDetail">重新加载</button>
    </view>

    <block wx:else>
      <view class="post-detail surface" role="article" aria-label="{{post.authorNickname}}发布的讨论，{{post.content}}">
        <view class="author-row">
          <image wx:if="{{!post.avatarSlot.empty}}" class="avatar avatar-image" src="{{post.avatarSlot.src}}" mode="{{post.avatarSlot.mode}}" binderror="handlePostAvatarError" aria-hidden="true"></image>
          <view wx:else class="avatar avatar--{{post.avatarTone}}" aria-hidden="true">{{post.avatarInitial}}</view>
          <view class="author-meta">
            <text class="author-name">{{post.authorNickname}}</text>
            <text class="post-time">{{post.displayTime}}</text>
          </view>
          <button class="more-button" bindtap="handlePostMore" hover-class="detail-control--pressed" aria-label="更多帖子操作">···</button>
        </view>

        <view class="post-content" user-select="true">
          <text wx:for="{{post.contentSegments}}" wx:key="index" class="post-content-segment {{item.type === 'tag' ? 'topic-pill' : ''}}">{{item.text}}</text>
        </view>

        <view class="post-actions">
          <button
            class="post-action-button post-like {{post.viewerHasLiked ? 'like-button--active' : ''}} {{post.likePending ? 'like-button--pending' : ''}}"
            data-target-type="post"
            data-target-id="{{post.id}}"
            bindtap="handleLike"
            hover-class="like-button--pressed"
            aria-label="{{post.viewerHasLiked ? '取消点赞' : '点赞'}}这条讨论，当前{{post.likeCount}}个赞"
          ><text class="heart-icon" aria-hidden="true">{{post.viewerHasLiked ? '♥' : '♡'}}</text><text class="like-count-value" aria-hidden="true">{{post.likeCount}}</text></button>
          <view class="post-action-button post-reply-total" aria-label="共{{post.replyCount}}条回复">
            <view class="comment-bubble-icon" aria-hidden="true"></view><text aria-hidden="true">{{post.replyCount}}</text>
          </view>
        </view>
      </view>

      <view class="reply-heading"><text>全部回复</text><text class="reply-count">{{post.replyCount}}</text></view>
      <view wx:if="{{replies.length}}" class="reply-list">
        <view wx:for="{{replies}}" wx:key="id" class="reply-card surface" role="article" aria-label="{{item.authorNickname}}回复：{{item.content}}，{{item.displayTime}}">
          <image wx:if="{{!item.avatarSlot.empty}}" class="reply-avatar reply-avatar-image" src="{{item.avatarSlot.src}}" mode="{{item.avatarSlot.mode}}" lazy-load="true" data-id="{{item.id}}" binderror="handleReplyAvatarError" aria-hidden="true"></image>
          <view wx:else class="reply-avatar avatar--{{item.avatarTone}}" aria-hidden="true">{{item.avatarInitial}}</view>
          <view class="reply-body">
            <view class="reply-meta">
              <view class="reply-author-line"><text class="reply-author">{{item.authorNickname}}</text><text class="reply-time">{{item.displayTime}}</text></view>
              <view class="reply-operations">
                <button
                  class="reply-like {{item.viewerHasLiked ? 'like-button--active' : ''}} {{item.likePending ? 'like-button--pending' : ''}}"
                  data-target-type="reply"
                  data-target-id="{{item.id}}"
                  bindtap="handleLike"
                  hover-class="like-button--pressed"
                  aria-label="{{item.viewerHasLiked ? '取消点赞' : '点赞'}}这条回复，当前{{item.likeCount}}个赞"
                ><text class="reply-heart" aria-hidden="true">{{item.viewerHasLiked ? '♥' : '♡'}}</text><text class="like-count-value" aria-hidden="true">{{item.likeCount}}</text></button>
                <button class="more-button reply-more" data-id="{{item.id}}" bindtap="handleReplyMore" hover-class="detail-control--pressed" aria-label="更多回复操作">···</button>
              </view>
            </view>
            <text class="reply-content" user-select="true">{{item.content}}</text>
          </view>
        </view>
        <button wx:if="{{hasMore}}" class="load-more-button" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="handleLoadMore" aria-label="加载更多回复">加载更多回复</button>
        <view wx:if="{{loadMoreError}}" class="load-more-error">
          <text>{{loadMoreError}}</text>
          <button class="secondary-button retry-button" bindtap="handleRetryLoadMore">重试</button>
        </view>
      </view>
      <view wx:else class="empty-replies surface" role="status" aria-label="暂时没有回复，来聊聊你的想法">暂时没有回复，来聊聊你的想法。</view>
    </block>
  </view>

  <view wx:if="{{post && !error}}" class="reply-composer">
    <input
      class="reply-input"
      value="{{replyContent}}"
      maxlength="300"
      placeholder="写下你的回复…"
      placeholder-class="reply-placeholder"
      confirm-type="send"
      cursor-spacing="120"
      adjust-position="true"
      focus="{{replyInputFocus}}"
      aria-label="回复内容，最多300字"
      bindinput="handleReplyInput"
      bindfocus="handleReplyFocus"
      bindblur="handleReplyBlur"
      bindconfirm="handleSendReply"
    />
    <button class="send-button" disabled="{{!replyContent || submitting}}" loading="{{submitting}}" bindtap="handleSendReply">发送</button>
  </view>
</view>
