<view class="activity-page" style="padding-top: {{contentTopInset}}px;">
  <view class="activity-navigation" style="height: {{contentTopInset}}px;">
    <view class="activity-nav-inner">
      <button class="activity-back" bindtap="handleBack" hover-class="activity-control--pressed" hover-stay-time="70" aria-label="返回发现页"><text aria-hidden="true">‹</text></button>
      <text class="activity-nav-title" role="heading" aria-level="1">讨论动态</text>
      <view class="activity-nav-spacer" aria-hidden="true"></view>
    </view>
  </view>

  <view class="activity-content">
    <view class="activity-tabs" role="tablist" aria-label="讨论动态筛选">
      <button wx:for="{{tabs}}" wx:key="value" class="activity-tab {{currentTab === item.value ? 'activity-tab--active' : ''}}" data-tab="{{item.value}}" bindtap="handleTab" hover-class="activity-control--pressed" role="tab" aria-selected="{{currentTab === item.value}}">{{item.label}}</button>
    </view>

    <view wx:if="{{loading}}" class="activity-list activity-skeleton-list" role="status" aria-label="正在加载讨论动态">
      <view wx:for="{{[1,2,3]}}" wx:key="*this" class="activity-card activity-skeleton" aria-hidden="true">
        <view class="skeleton-avatar"></view><view class="skeleton-body"><view class="skeleton-line skeleton-line--title"></view><view class="skeleton-line"></view><view class="skeleton-panel"></view></view>
      </view>
    </view>

    <view wx:elif="{{error}}" class="activity-state-card" role="alert">
      <view class="state-bubble" aria-hidden="true"><text>···</text></view>
      <text class="state-title">动态暂时走丢了</text>
      <text class="state-description">{{error}}</text>
      <button class="state-action" bindtap="handleRetry" hover-class="activity-control--pressed">重新加载</button>
    </view>

    <view wx:elif="{{items.length}}" class="activity-list">
      <button wx:for="{{items}}" wx:key="id" class="activity-card {{item.read ? 'activity-card--read' : ''}}" data-id="{{item.id}}" bindtap="handleActivity" hover-class="activity-card--pressed" hover-start-time="60" hover-stay-time="70" aria-label="{{item.accessibilityLabel}}">
        <view class="activity-avatar-wrap" aria-hidden="true">
          <image wx:if="{{item.isSystem}}" class="activity-system-avatar" src="/subpackages/community/compose/assets/community-compose-rules-shield.png" mode="aspectFit"></image>
          <image wx:elif="{{!item.avatarSlot.empty}}" class="activity-avatar activity-avatar-image" src="{{item.avatarSlot.src}}" mode="{{item.avatarSlot.mode}}" data-id="{{item.id}}" binderror="handleAvatarError"></image>
          <view wx:else class="activity-avatar activity-avatar--{{item.avatarTone}}">{{item.avatarInitial}}</view>
          <view wx:if="{{item.isReply}}" class="activity-type-badge activity-type-badge--reply">•••</view>
          <view wx:elif="{{item.isLike}}" class="activity-type-badge activity-type-badge--like">♥</view>
        </view>

        <view class="activity-card-body">
          <view class="activity-card-heading">
            <view class="activity-heading-copy">
              <text class="activity-actor">{{item.actorName}}{{item.countText}}</text>
              <text class="activity-action">{{item.actionText}}</text>
              <text class="activity-time"> · {{item.displayTime}}</text>
            </view>
            <view wx:if="{{!item.read}}" class="activity-unread-dot" aria-hidden="true"></view>
          </view>

          <text wx:if="{{item.isReply && item.contentPreview}}" class="activity-reply-preview">“{{item.contentPreview}}”</text>
          <text wx:if="{{item.isSystem && item.message}}" class="activity-system-message">{{item.message}}</text>
          <view wx:if="{{!item.isSystem || item.postPreview}}" class="activity-post-panel {{item.removed ? 'activity-post-panel--removed' : ''}}">
            <text wx:if="{{!item.removed}}" class="activity-post-label">我的讨论：</text>
            <text wx:if="{{item.removed}}" class="activity-post-preview">该讨论已被删除或下架</text>
            <text wx:else class="activity-post-preview">{{item.postPreview}}</text>
          </view>
        </view>
      </button>

      <view class="activity-list-footer" role="status">
        <view wx:if="{{loadingMore}}" class="activity-footer-text">正在加载更多动态…</view>
        <button wx:elif="{{loadMoreError}}" class="activity-footer-retry" bindtap="handleRetryMore">{{loadMoreError}}</button>
        <view wx:elif="{{!hasMore}}" class="activity-footer-text">— 已经到底啦，仅展示近 30 天动态 —</view>
      </view>
    </view>

    <view wx:else class="activity-state-card" role="status" aria-label="当前分类暂无讨论动态">
      <view class="state-bubble" aria-hidden="true"><text>···</text></view>
      <text class="state-title">{{currentTab === 'REPLIES' ? '还没有人回复你' : (currentTab === 'LIKES' ? '还没有收到新的赞' : '这里暂时没有动态')}}</text>
      <text class="state-description">{{currentTab === 'REPLIES' ? '发布一条讨论，和身边同频的人聊起来吧' : (currentTab === 'LIKES' ? '有新的认可时，会第一时间出现在这里' : '近 30 天的回复与点赞会显示在这里')}}</text>
      <button class="state-action" bindtap="handleEmptyAction" hover-class="activity-control--pressed">{{currentTab === 'REPLIES' ? '发布讨论' : '返回发现'}}</button>
    </view>
  </view>
</view>
