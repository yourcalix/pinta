<view class="orbit-page" style="padding-top: {{contentTopInset}}px;" role="region" aria-label="{{accessibilityLabel}}">
  <view class="orbit-navigation" style="height: {{contentTopInset}}px;">
    <view class="orbit-nav-inner">
      <button class="orbit-back" bindtap="handleBack" hover-class="orbit-control--pressed" hover-stay-time="70" aria-label="返回上一页"><text aria-hidden="true">‹</text></button>
      <text class="orbit-title" role="heading" aria-level="1">寻找搭子</text>
      <view class="orbit-nav-spacer" aria-hidden="true"></view>
    </view>
  </view>

  <view class="orbit-stage">
    <canvas id="companion-canvas" class="orbit-canvas" type="2d" bindtouchstart="handleCanvasTouchStart" bindtouchmove="handleCanvasTouchMove" bindtouchend="handleCanvasTouchEnd" bindtouchcancel="handleCanvasTouchCancel" aria-hidden="true"></canvas>
    <view wx:if="{{status === 'loading'}}" class="orbit-overlay" role="status"><text>正在连接搭子星球…</text></view>
    <view wx:elif="{{status === 'error'}}" class="orbit-overlay orbit-overlay--error" role="alert">
      <text class="orbit-overlay-title">搭子星球暂时失联了</text>
      <text class="orbit-overlay-copy">网络连接较慢，请稍后重试</text>
      <button class="orbit-retry" bindtap="handleRetry" hover-class="orbit-control--pressed">重新连接</button>
    </view>
    <view wx:elif="{{status === 'ready'}}" class="orbit-stage-guidance" role="status">
      <text wx:if="{{users.length}}">左右滑动旋转，双指捏合缩放 · 点击搭子查看主页</text>
      <text wx:else>星球上暂时还没有可展示的用户</text>
    </view>
  </view>

  <view class="orbit-bottom">
    <view wx:if="{{status === 'ready'}}" class="orbit-count" role="status">
      <text>当前 </text><text class="orbit-count-number">{{onlineTotal}}</text><text> 人在线</text>
    </view>
    <view wx:else class="orbit-count orbit-count--muted">{{status === 'loading' ? '正在同步搭子星球' : '暂时无法读取在线状态'}}</view>
    <text wx:if="{{status === 'ready'}}" class="orbit-disclosure">球面展示已加入拼吧的真实用户，在线人数随进入或离开小程序自动更新。</text>
  </view>
</view>
