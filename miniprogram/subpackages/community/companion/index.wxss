page { width: 100%; height: 100%; color: #fff; background: #0d0c1b; }

.orbit-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: radial-gradient(circle at 50% 40%, #1b1934 0%, #111021 42%, #0d0c1b 100%);
}

button { margin: 0; padding: 0; line-height: 1.2; }
button::after { display: none; }

.orbit-navigation {
  position: fixed;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(13, 12, 27, .92), rgba(13, 12, 27, 0));
}

.orbit-nav-inner {
  display: flex;
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.orbit-back,
.orbit-nav-spacer { width: 112rpx; min-width: 112rpx; height: 88rpx; }
.orbit-back { display: flex; align-items: center; color: #fff; background: transparent; border: 0; font-size: 64rpx; font-weight: 300; }
.orbit-title { position: absolute; left: 50%; color: rgba(255,255,255,.94); font-size: 32rpx; font-weight: 650; transform: translateX(-50%); }
.orbit-control--pressed { opacity: .5; }

.orbit-stage {
  display: flex;
  position: relative;
  width: 100%;
  height: calc(100vh - 350rpx - env(safe-area-inset-bottom));
  min-height: 600rpx;
  max-height: 860rpx;
  align-items: center;
  justify-content: center;
}

.orbit-canvas {
  display: block;
  width: 700rpx;
  height: 700rpx;
  max-width: 100vw;
  max-height: 100%;
  pointer-events: none;
}

.orbit-overlay {
  display: flex;
  position: absolute;
  inset: 0;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,.62);
  font-size: 26rpx;
}

.orbit-overlay--error { flex-direction: column; gap: 14rpx; }
.orbit-overlay-title { color: rgba(255,255,255,.94); font-size: 30rpx; font-weight: 700; }
.orbit-overlay-copy { color: rgba(255,255,255,.5); font-size: 24rpx; }
.orbit-retry { display: flex; min-width: 190rpx; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 12rpx; color: #09151a; background: #8ae8de; border: 0; border-radius: 44rpx; font-size: 28rpx; font-weight: 700; }

.orbit-bottom {
  display: flex;
  position: absolute;
  right: 28rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  z-index: 5;
  align-items: center;
  flex-direction: column;
}

.orbit-count { display: flex; min-height: 64rpx; align-items: center; justify-content: center; padding: 0 28rpx; color: rgba(255,255,255,.9); background: rgba(255,255,255,.07); border: 1rpx solid rgba(255,255,255,.12); border-radius: 32rpx; font-size: 26rpx; box-sizing: border-box; }
.orbit-count-number { color: #6ee7d8; font-size: 32rpx; font-weight: 800; }
.orbit-count--muted { color: rgba(255,255,255,.48); }
.orbit-disclosure { min-height: 64rpx; padding: 16rpx 22rpx 10rpx; color: rgba(255,255,255,.5); font-size: 24rpx; line-height: 1.5; text-align: center; box-sizing: border-box; }
.orbit-disclosure--joined { color: rgba(110,231,216,.72); }

.orbit-action { display: flex; width: 100%; min-height: 96rpx; align-items: center; justify-content: center; color: #06231f; background: linear-gradient(135deg, #79eadc 0%, #4fd4dc 46%, #54b7ee 100%); border: 1rpx solid rgba(255,255,255,.3); border-radius: 48rpx; box-shadow: 0 12rpx 34rpx rgba(62,207,204,.22); font-size: 30rpx; font-weight: 800; }
.orbit-action--joined { color: rgba(255,255,255,.92); background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.18); box-shadow: none; }
.orbit-action--pressed { transform: scale(.985); opacity: .78; }

@media (max-width: 340px) {
  .orbit-stage { height: calc(100vh - 326rpx - env(safe-area-inset-bottom)); min-height: 520rpx; }
  .orbit-canvas { width: 600rpx; height: 600rpx; }
  .orbit-bottom { right: 20rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 20rpx; }
  .orbit-count { min-height: 56rpx; padding: 0 20rpx; font-size: 24rpx; }
  .orbit-count-number { font-size: 28rpx; }
  .orbit-action { min-height: 88rpx; border-radius: 44rpx; font-size: 28rpx; }
}
