page { min-height: 100%; background: #f9f7f2; color: #27312c; }

.follow-page { min-height: 100vh; padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f9f7f2; }
.follow-tabs { display: flex; position: sticky; top: 0; z-index: 4; min-height: 96rpx; padding: 8rpx; gap: 8rpx; border: 1rpx solid #eee8de; border-radius: 28rpx; background: rgba(255, 255, 255, .94); box-shadow: 0 12rpx 34rpx rgba(83, 70, 48, .07); }
.follow-tab { display: flex; flex: 1; min-width: 0; min-height: 80rpx; margin: 0; padding: 0 20rpx; align-items: center; justify-content: center; gap: 10rpx; border: 0; border-radius: 22rpx; color: #746f67; background: transparent; font-size: 26rpx; font-weight: 650; line-height: 1; }
.follow-tab::after, .follow-card::after { border: 0; }
.follow-tab--active { color: #1c714f; background: #e8f4ec; }
.follow-tab-count { min-width: 34rpx; font-size: 22rpx; font-weight: 760; font-variant-numeric: tabular-nums; text-align: center; }
.follow-list { display: flex; margin-top: 20rpx; flex-direction: column; gap: 16rpx; }
.follow-card { display: flex; position: relative; width: 100%; min-height: 136rpx; margin: 0; padding: 20rpx 24rpx; align-items: center; gap: 20rpx; border: 1rpx solid #eee9df; border-radius: 28rpx; box-sizing: border-box; color: #27312c; background: #fff; box-shadow: 0 10rpx 28rpx rgba(78, 65, 44, .055); text-align: left; line-height: 1.2; transition: transform 120ms ease, background-color 120ms ease; }
.follow-card--pressed { transform: scale(.985); background: #fbf8f2; }
.follow-avatar-shell { display: flex; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; align-items: center; justify-content: center; overflow: hidden; border: 4rpx solid #fff9ee; border-radius: 50%; box-sizing: border-box; background: #f1eadf; }
.follow-avatar { width: 100%; height: 100%; display: block; pointer-events: none; }
.follow-avatar-empty { color: #9a8e7c; font-size: 30rpx; font-weight: 760; }
.follow-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8rpx; pointer-events: none; }
.follow-name-row { display: flex; min-width: 0; align-items: center; gap: 12rpx; }
.follow-name { min-width: 0; max-width: 52%; overflow: hidden; color: #25312b; font-size: 28rpx; font-weight: 760; text-overflow: ellipsis; white-space: nowrap; }
.follow-relation { flex: 0 0 auto; padding: 7rpx 14rpx; border-radius: 999rpx; color: #746d62; background: #f3efe8; font-size: 20rpx; line-height: 1; }
.follow-relation--mutual { color: #257353; background: #e8f4ec; }
.follow-facts, .follow-interests { max-width: 100%; overflow: hidden; color: #777b75; font-size: 22rpx; line-height: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.follow-interests { color: #9a866a; }
.follow-arrow { flex: 0 0 auto; color: #b4ada3; font-size: 42rpx; pointer-events: none; }
.follow-more { min-height: 72rpx; display: flex; align-items: center; justify-content: center; color: #9a958d; font-size: 22rpx; }
.follow-empty { margin-top: 80rpx; }
.follow-refreshing { position: fixed; top: 150rpx; right: 34rpx; z-index: 6; display: flex; width: 42rpx; height: 42rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, .92); box-shadow: 0 6rpx 22rpx rgba(72, 60, 42, .12); pointer-events: none; }
.follow-refreshing-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #21a66f; animation: follow-pulse 800ms ease-in-out infinite alternate; }
.follow-card--skeleton { pointer-events: none; }
.follow-skeleton-avatar { width: 88rpx; height: 88rpx; flex: 0 0 88rpx; border-radius: 50%; }
.follow-skeleton-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 16rpx; }
.follow-skeleton-title { width: 42%; height: 26rpx; border-radius: 13rpx; }
.follow-skeleton-line { width: 72%; height: 20rpx; border-radius: 10rpx; }
.skeleton-shimmer { background: linear-gradient(100deg, #f0ece5 20%, #faf8f4 40%, #f0ece5 60%); background-size: 200% 100%; animation: follow-shimmer 1.2s linear infinite; }
@keyframes follow-pulse { from { opacity: .45; transform: scale(.8); } to { opacity: 1; transform: scale(1); } }
@keyframes follow-shimmer { to { background-position-x: -200%; } }

@media (max-width: 340px) {
  .follow-page { padding-right: 16rpx; padding-left: 16rpx; }
  .follow-card { min-height: 136rpx; padding: 18rpx; gap: 14rpx; }
  .follow-avatar-shell, .follow-skeleton-avatar { width: 80rpx; height: 80rpx; flex-basis: 80rpx; }
  .follow-name { max-width: 46%; font-size: 26rpx; }
  .follow-relation { padding-right: 10rpx; padding-left: 10rpx; font-size: 19rpx; }
  .follow-interests { display: none; }
}
