.driver-page { padding: 28rpx; background: #f5f7f6; box-sizing: border-box; min-height: 100vh; }
.intro { margin-bottom: 24rpx; }.intro-title { font-size: 40rpx; font-weight: 800; color: #17211b; }.intro-copy { margin-top: 12rpx; color: #5f6c65; font-size: 27rpx; line-height: 1.6; }
.steps { display: flex; gap: 12rpx; margin-bottom: 22rpx; }.step { flex: 1; min-height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #e7ece9; color: #77817c; font-size: 24rpx; }.step--active { color: #1f61c2; background: #e8f1ff; font-weight: 700; }
.form-card,.status-card { padding: 28rpx; border-radius: 26rpx; }.field { margin-bottom: 26rpx; }.field-label { display: block; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 700; }.required::after { content: ' *'; color: #d74646; }.input,.picker-field { width: 100%; min-height: 88rpx; padding: 0 22rpx; box-sizing: border-box; border: 2rpx solid #dfe5e1; border-radius: 16rpx; background: #fff; font-size: 28rpx; }.picker-field { display: flex; align-items: center; justify-content: space-between; }.field-hint { margin-top: 10rpx; font-size: 24rpx; line-height: 1.5; color: #77817c; }
.primary-button,.secondary-button,.upload-button { min-height: 88rpx; border-radius: 44rpx; font-size: 28rpx; }.primary-button { background: #3478f6; color: #fff; }.secondary-button { background: #eef1ef; color: #26322b; }.button-row { display: grid; grid-template-columns: 1fr 1.4fr; gap: 16rpx; margin-top: 28rpx; }.number-stepper { display: flex; align-items: center; justify-content: space-between; }.number-stepper button { min-width: 88rpx; min-height: 88rpx; }.upload-button { width: 100%; margin-bottom: 18rpx; background: #eef4ff; color: #245fb7; }.upload-button--done { background: #eaf8f0; color: #167b50; }
.privacy-note { padding: 22rpx; margin-bottom: 22rpx; border-radius: 18rpx; background: #fff7e6; color: #6c521b; font-size: 25rpx; line-height: 1.6; }.privacy-title { margin-bottom: 8rpx; font-weight: 800; }.agreement { display: flex; align-items: flex-start; gap: 12rpx; min-height: 88rpx; padding: 14rpx 0; font-size: 26rpx; line-height: 1.55; }.status-card { text-align: center; }.status-mark { width: 96rpx; height: 96rpx; margin: 20rpx auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #e8f1ff; color: #3478f6; font-size: 48rpx; }.status-title { font-size: 36rpx; font-weight: 800; }.status-copy { margin-top: 14rpx; color: #657069; line-height: 1.6; }.summary { margin-top: 26rpx; padding: 20rpx; border-radius: 16rpx; background: #f5f7f6; text-align: left; color: #59655e; line-height: 1.8; }.error-banner { margin-bottom: 20rpx; }
