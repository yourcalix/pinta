<view class="public-profile-page">
  <view class="public-profile-nav" style="height: {{contentTopInset}}px;">
    <view class="public-profile-nav-inner">
      <button class="public-profile-back" bindtap="handleBack" hover-class="public-control--pressed" aria-label="返回搭子星球"><text aria-hidden="true">‹</text></button>
      <text class="public-profile-title" role="heading" aria-level="1">搭子主页</text>
      <view class="public-profile-nav-spacer" aria-hidden="true"></view>
    </view>
  </view>

  <view wx:if="{{status === 'loading'}}" class="public-state public-state--dark" style="padding-top: {{contentTopInset}}px;" role="status" aria-label="正在读取搭子公开资料">
    <view class="public-avatar-skeleton public-shimmer"></view>
    <view class="public-line-skeleton public-shimmer"></view>
    <text>正在确认这位搭子的在线状态…</text>
  </view>

  <block wx:elif="{{status === 'ready'}}">
    <view class="public-stage" style="padding-top: {{contentTopInset}}px;" role="region" aria-label="{{profile.accessibilityLabel}}">
      <view class="public-stage-glow" aria-hidden="true"></view>
      <view class="public-avatar-shell"><image class="public-avatar" src="{{profile.avatarPath}}" mode="aspectFit" aria-hidden="true" /></view>
      <view class="public-name-row"><text class="public-name">{{profile.nickname}}</text><text wx:if="{{profile.viewerIsSelf}}" class="public-self">这是你</text></view>
      <view class="public-online"><text class="public-online-dot" aria-hidden="true"></text><text>正在找搭子 · 刚刚在线</text></view>
    </view>

    <view class="public-sheet">
      <view class="public-section">
        <text class="public-section-title">公开资料</text>
        <view wx:if="{{profile.facts.length}}" class="public-facts" aria-label="{{profile.factsLabel}}">
          <text wx:for="{{profile.facts}}" wx:key="*this" class="public-fact">{{item}}</text>
        </view>
        <text wx:else class="public-empty-copy">这位搭子暂时没有填写更多公开资料</text>
      </view>

      <view wx:if="{{profile.interests.length}}" class="public-section">
        <text class="public-section-title">兴趣爱好</text>
        <view class="public-interests" aria-label="兴趣爱好，{{profile.interestsLabel}}">
          <text wx:for="{{profile.interests}}" wx:key="*this" class="public-interest">{{item}}</text>
        </view>
      </view>

      <view class="public-privacy"><text class="public-privacy-icon" aria-hidden="true">⌁</text><text>仅展示搭子主动公开的资料，不提供私信、联系方式或实时位置。</text></view>
    </view>
  </block>

  <view wx:elif="{{status === 'not-found'}}" class="public-state public-state--dark" style="padding-top: {{contentTopInset}}px;" role="alert">
    <view class="public-state-orbit" aria-hidden="true"><view class="public-state-dot"></view></view>
    <text class="public-state-title">这位搭子已经离开星球</text>
    <text class="public-state-copy">在线状态已失效，去星球看看其他搭子吧</text>
    <button class="public-state-action" bindtap="handleBack" hover-class="public-control--pressed">返回搭子星球</button>
  </view>

  <view wx:else class="public-state public-state--dark" style="padding-top: {{contentTopInset}}px;" role="alert">
    <view class="public-state-symbol" aria-hidden="true">!</view>
    <text class="public-state-title">个人资料加载失败</text>
    <text class="public-state-copy">{{errorCopy}}</text>
    <button class="public-state-action" bindtap="handleRetry" hover-class="public-control--pressed">重新加载</button>
  </view>
</view>
