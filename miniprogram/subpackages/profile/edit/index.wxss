page {
  background: #f6f7f9;
}

.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  color: #17191c;
  background: #f6f7f9;
}

.profile-navigation {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid rgba(25, 31, 38, 0.05);
}

.profile-nav-inner {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.profile-nav-back,
.profile-nav-spacer {
  box-sizing: border-box;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
}

.profile-nav-back {
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: #111315;
  font-size: 68rpx;
  font-weight: 300;
  line-height: 1;
  background: transparent;
}

.profile-nav-back::after,
.avatar-section::after,
.restore-avatar-button::after,
.nickname-row::after,
.birthday-row::after,
.adult-row::after,
.cover-row::after,
.nickname-sheet-action::after,
.save-button::after {
  display: none;
}

.profile-nav-back--pressed {
  opacity: 0.42;
}

.profile-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #111315;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.profile-content,
.profile-loading {
  padding: 34rpx 24rpx 28rpx;
}

.section-heading {
  padding: 0 8rpx 18rpx;
  color: #9a9da2;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
}

.section-heading--spaced {
  padding-top: 40rpx;
}

.profile-card {
  box-sizing: border-box;
  padding: 0 28rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 38, 45, 0.025);
}

.avatar-section {
  box-sizing: border-box;
  width: 100%;
  min-height: 208rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #17191c;
  line-height: normal;
  text-align: left;
  background: #ffffff;
  border: 0;
  border-radius: 0;
}

.controlled-avatar-shell {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.controlled-avatar {
  display: block;
  width: 120rpx;
  height: 120rpx;
  box-sizing: border-box;
  border: 2rpx solid #eef0f2;
  border-radius: 20rpx;
  background: #f4f5f6;
}

.avatar-copy {
  flex: 1;
  min-width: 0;
}

.avatar-title {
  color: #17191c;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
}

.avatar-description {
  margin-top: 10rpx;
  color: #a0a3a8;
  font-size: 22rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-description--error {
  color: #dc2626;
}

.avatar-chevron {
  flex: 0 0 auto;
}

.avatar-upload-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.avatar-spinner {
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.38);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: avatar-spin 700ms linear infinite;
}

.restore-avatar-button {
  min-height: 72rpx;
  margin: -20rpx 0 12rpx 144rpx;
  padding: 0;
  color: #16a36a;
  font-size: 23rpx;
  line-height: 72rpx;
  text-align: left;
  background: transparent;
  border: 0;
}

.restore-avatar-button--pressed {
  opacity: 0.48;
}

@keyframes avatar-spin {
  to { transform: rotate(360deg); }
}

.profile-divider {
  height: 1rpx;
  background: #eff0f2;
}

.profile-row {
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #17191c;
  background: #ffffff;
  text-align: left;
}

.profile-row--error {
  box-shadow: inset 0 -3rpx 0 #e45858;
}

.profile-row--pressed {
  background: #f3f4f6;
}

.row-label {
  flex: 0 0 auto;
  color: #17191c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.row-control {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #5e6268;
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: right;
}

.row-value-group {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.row-value,
.adult-status {
  min-width: 0;
  overflow: hidden;
  color: #7d8187;
  font-size: 28rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-placeholder {
  color: #b2b5ba;
}

.row-chevron {
  color: #d2d4d7;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
}

.adult-row {
  border-radius: 0;
}

.adult-status {
  color: #9a9da2;
  font-size: 25rpx;
}

.adult-checkmark {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  background: #c8cbd0;
  border-radius: 50%;
}

.adult-row--confirmed .adult-status {
  color: #15955f;
}

.adult-row--confirmed .adult-checkmark {
  background: #16a36a;
}

.cover-row {
  min-height: 104rpx;
  border-radius: 0;
}

.cover-thumbnail {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.cover-thumbnail--avatar {
  filter: blur(2px);
}

.cover-label {
  flex: 0 1 auto;
}

.nickname-row {
  border-radius: 0;
}

.birthday-row {
  border-radius: 0;
}

.nickname-dialog,
.nickname-backdrop,
.nickname-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
}

.nickname-dialog {
  top: 0;
  z-index: 100;
}

.nickname-backdrop {
  top: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 200ms ease-out;
}

.nickname-backdrop--open {
  opacity: 1;
}

.nickname-sheet {
  z-index: 101;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  transform: translateY(100%);
  transition: transform 240ms cubic-bezier(0.25, 1, 0.5, 1);
}

.nickname-sheet--open {
  transform: translateY(0);
}

.nickname-sheet-header {
  position: relative;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.nickname-sheet-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.nickname-sheet-action {
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  color: #6b7280;
  font-size: 28rpx;
  line-height: 1;
  background: transparent;
}

.nickname-sheet-cancel {
  justify-content: flex-start;
}

.nickname-sheet-confirm {
  justify-content: flex-end;
  color: #16a36a;
  font-weight: 600;
}

.nickname-sheet-confirm[disabled] {
  color: #16a36a;
  opacity: 0.35;
}

.nickname-sheet-action--pressed {
  opacity: 0.5;
}

.nickname-sheet-body {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.nickname-input-shell {
  box-sizing: border-box;
  height: 92rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #f3f4f6;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
}

.nickname-input-shell--error {
  border-color: #dc2626;
}

.nickname-input {
  width: 100%;
  height: 72rpx;
  color: #111827;
  font-size: 30rpx;
  line-height: 72rpx;
}

.nickname-hint {
  min-height: 36rpx;
  margin-top: 10rpx;
  color: #9a9da2;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: right;
}

.nickname-hint--error {
  color: #dc2626;
  text-align: left;
}

.birthday-picker {
  box-sizing: border-box;
  width: 100%;
  height: 400rpx;
  padding: 28rpx 24rpx 10rpx;
  background: #ffffff;
}

.birthday-picker-column {
  flex: 1;
}

.birthday-picker-item {
  height: 88rpx;
  color: #17191c;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
}

.birthday-privacy {
  margin: 4rpx 32rpx 18rpx;
  padding: 18rpx 22rpx;
  color: #7d8187;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
  background: #f6f7f9;
  border-radius: 18rpx;
}

.birthday-safe-area {
  height: env(safe-area-inset-bottom);
}

.preference-card {
  padding-bottom: 22rpx;
}

.preference-row {
  min-height: 112rpx;
}

.field-hint {
  padding: 0 0 4rpx;
  color: #aaaeb3;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

.privacy-note {
  padding: 28rpx 20rpx 0;
  color: #aaadb1;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.error-banner {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  color: #a72a30;
  font-size: 24rpx;
  line-height: 1.5;
  background: #fff0f0;
  border: 1rpx solid #ffdada;
  border-radius: 18rpx;
}

.fixed-save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  box-sizing: border-box;
  padding-top: 14rpx;
  padding-right: 32rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid rgba(25, 31, 38, 0.06);
}

.save-button {
  min-height: 92rpx;
  margin: 0;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1;
  background: #16a36a;
  border-radius: 46rpx;
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 106, 0.18);
}

.save-button--pressed {
  transform: scale(0.985);
  opacity: 0.88;
}

.save-button[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #79c6a4;
  box-shadow: none;
}

.profile-loading {
  animation: loading-pulse 1.15s ease-in-out infinite alternate;
}

.loading-line,
.loading-card {
  background: #e8eaed;
  border-radius: 18rpx;
}

.loading-line {
  width: 100%;
  height: 28rpx;
  margin-bottom: 22rpx;
}

.loading-line--short {
  width: 160rpx;
}

.loading-card {
  height: 520rpx;
  margin-bottom: 38rpx;
  border-radius: 28rpx;
}

@keyframes loading-pulse {
  from { opacity: 0.56; }
  to { opacity: 1; }
}

@media (max-width: 340px) {
  .profile-content,
  .profile-loading {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .profile-card {
    padding-right: 22rpx;
    padding-left: 22rpx;
    border-radius: 24rpx;
  }

  .avatar-section {
    min-height: 184rpx;
    gap: 18rpx;
  }

  .controlled-avatar {
    width: 104rpx;
    height: 104rpx;
    flex-basis: 104rpx;
  }

  .profile-row {
    min-height: 96rpx;
    gap: 16rpx;
  }

  .cover-thumbnail {
    width: 46rpx;
    height: 46rpx;
    flex-basis: 46rpx;
    border-radius: 10rpx;
  }

  .nickname-sheet {
    border-radius: 28rpx 28rpx 0 0;
  }

  .nickname-sheet-header {
    height: 92rpx;
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .nickname-sheet-title {
    font-size: 30rpx;
  }

  .nickname-sheet-action {
    font-size: 26rpx;
  }

  .nickname-sheet-body {
    padding: 24rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  }

  .nickname-input-shell {
    height: 84rpx;
    border-radius: 16rpx;
  }

  .birthday-picker {
    height: 360rpx;
    padding-top: 20rpx;
  }

  .birthday-picker-item {
    height: 80rpx;
    font-size: 28rpx;
    line-height: 80rpx;
  }

  .row-label {
    font-size: 28rpx;
  }

  .row-control,
  .row-value {
    font-size: 25rpx;
  }

  .fixed-save-bar {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .nickname-backdrop,
  .nickname-sheet {
    transition-duration: 0ms;
  }
}
