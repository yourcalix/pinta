.profile-page {
  padding-top: 42rpx;
}

.role-options { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.gender-options { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.gender-option { min-height: 152rpx; margin: 0; padding: 18rpx; display: flex; align-items: center; justify-content: center; gap: 18rpx; border: 2rpx solid #dfe5e1; border-radius: 20rpx; background: #fff; font-size: 30rpx; font-weight: 650; }
.gender-option::after { display: none; }
.gender-option--active { border-color: #16a36a; background: #eef9f3; box-shadow: 0 4rpx 12rpx rgba(22, 163, 106, 0.14); }
.gender-options--error .gender-option { border-color: #e53935; background: #fff1f2; }
.gender-error-tip { margin-top: 10rpx; color: #c92d36; font-size: 24rpx; line-height: 1.4; }
.gender-avatar { width: 88rpx; height: 88rpx; flex: 0 0 auto; }
.role-option { min-height: 132rpx; padding: 20rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; border: 2rpx solid #dfe5e1; border-radius: 20rpx; background: #fff; text-align: left; }
.role-option--active { border-color: #16a36a; background: #eef9f3; }
.role-option--active-driver { border-color: #3478f6; background: #eef4ff; }
.role-title { font-size: 30rpx; font-weight: 700; }
.role-copy { margin-top: 8rpx; font-size: 24rpx; color: #6b756f; line-height: 1.45; }
@media (max-width: 340px) { .role-options { grid-template-columns: 1fr; } .gender-option { padding: 12rpx; gap: 8rpx; } .gender-avatar { width: 72rpx; height: 72rpx; } }

.intro-title {
  font-size: 40rpx;
  font-weight: 720;
}

.intro-description {
  margin-top: 12rpx;
  color: #68746d;
  font-size: 25rpx;
  line-height: 1.55;
}

.error-banner {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  color: #a72a30;
  background: #fff0f0;
  border-radius: 16rpx;
}

.form-card {
  margin-top: 28rpx;
  padding: 30rpx 26rpx;
}

.adult-check {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: #57635c;
  font-size: 25rpx;
  line-height: 1.5;
}

.save-button {
  margin-top: 34rpx;
}
