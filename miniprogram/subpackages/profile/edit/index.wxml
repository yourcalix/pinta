<view class="page profile-page">
  <view class="surface profile-form-card">
    <view class="profile-hero">
      <view class="profile-hero-copy">
        <view class="profile-hero-title">完成最小资料</view>
        <view class="profile-hero-description">资料只用于活动匹配，无需授权精确位置或绑定手机号。</view>
      </view>
      <image class="profile-hero-art" src="../../../assets/images/discover/hero-campus.png" mode="aspectFit" aria-hidden="true" />
    </view>

    <view wx:if="{{errorMessage}}" class="error-banner" role="alert">{{errorMessage}}</view>

    <view class="form-section">
      <view class="section-title-row">
        <image class="section-title-icon" src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" aria-hidden="true" />
        <text class="section-title">昵称</text>
        <text class="required-mark">*</text>
      </view>
      <input class="form-input" maxlength="20" cursor-spacing="100" adjust-position="true" placeholder="请输入 2—20 个字" value="{{form.nickname}}" data-field="nickname" bindinput="handleInput" aria-label="昵称，必填" />
    </view>

    <view class="form-section">
      <view class="section-title-row">
        <image class="section-title-icon" src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" aria-hidden="true" />
        <text class="section-title">性别</text>
        <text class="required-mark">*</text>
      </view>
      <view class="gender-options {{genderError ? 'gender-options--error' : ''}}" role="radiogroup" aria-label="选择性别">
        <button class="gender-option {{form.gender === 'MALE' ? 'gender-option--active' : ''}}" data-gender="MALE" bindtap="handleGender" role="radio" aria-checked="{{form.gender === 'MALE'}}" aria-label="男，使用乘客头像 A">
          <view wx:if="{{form.gender === 'MALE'}}" class="selection-check" aria-hidden="true">✓</view>
          <image class="gender-avatar" src="../../../assets/images/discover/avatar-passenger-a.png" mode="aspectFit" aria-hidden="true" />
          <text class="gender-label">男</text>
        </button>
        <button class="gender-option {{form.gender === 'FEMALE' ? 'gender-option--active' : ''}}" data-gender="FEMALE" bindtap="handleGender" role="radio" aria-checked="{{form.gender === 'FEMALE'}}" aria-label="女，使用乘客头像 B">
          <view wx:if="{{form.gender === 'FEMALE'}}" class="selection-check" aria-hidden="true">✓</view>
          <image class="gender-avatar" src="../../../assets/images/discover/avatar-passenger-b.png" mode="aspectFit" aria-hidden="true" />
          <text class="gender-label">女</text>
        </button>
      </view>
      <view wx:if="{{genderError}}" class="gender-error-tip" role="alert">请选择性别</view>
      <view class="field-hint">头像会自动用于“我的”和活动成员列表；不对其他成员公开性别字段。</view>
    </view>

    <view class="form-section">
      <view class="section-title-row">
        <image class="section-title-icon" src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" aria-hidden="true" />
        <text class="section-title">兴趣标签</text>
        <text class="optional-label">（选填）</text>
      </view>
      <input class="form-input" maxlength="80" cursor-spacing="100" adjust-position="true" placeholder="例如：结伴出行、羽毛球、美食等" value="{{form.interestsText}}" data-field="interestsText" bindinput="handleInput" aria-label="兴趣标签，选填" />
    </view>

    <checkbox-group bindchange="handleAdult">
      <label class="adult-check">
        <checkbox value="adult" checked="{{form.adultConfirmed}}" color="#16A36A" />
        <text>我确认已年满18岁，并同意遵守<text class="agreement-link">平台安全规则</text>。</text>
      </label>
    </checkbox-group>

    <button class="primary-button save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSave">{{saving ? '正在保存…' : '保存资料'}}</button>

    <view class="profile-decoration" aria-hidden="true">
      <view class="decoration-line"></view>
      <image src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" />
      <image src="../../../assets/images/discover/node-start-blue.png" mode="aspectFit" />
      <image class="decoration-car" src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" />
      <image src="../../../assets/images/discover/node-start-green.png" mode="aspectFit" />
      <image src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" />
    </view>
  </view>
</view>
