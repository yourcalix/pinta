<view class="profile-page" style="padding-top: {{contentTopInset}}px;">
  <view class="profile-navigation" style="height: {{contentTopInset}}px;">
    <view class="profile-nav-inner">
      <button class="profile-nav-back" bindtap="handleBack" aria-label="返回上一页" hover-class="profile-nav-back--pressed">
        <text aria-hidden="true">‹</text>
      </button>
      <view class="profile-nav-title">个人资料</view>
      <view class="profile-nav-spacer" aria-hidden="true"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="profile-loading" role="status" aria-label="个人资料加载中">
    <view class="loading-line loading-line--short"></view>
    <view class="loading-card"></view>
    <view class="loading-line"></view>
  </view>

  <view wx:else class="profile-content">
    <view wx:if="{{errorMessage}}" class="error-banner" role="alert">{{errorMessage}}</view>

    <view class="section-heading">基本信息</view>
    <view class="profile-card">
      <button class="avatar-section" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" disabled="{{saving}}" hover-class="profile-row--pressed" hover-stay-time="70" aria-label="个人头像，当前为{{hasCustomAvatar ? '自定义头像' : '默认手绘头像'}}，点击更换头像">
        <view class="controlled-avatar-shell">
          <image class="controlled-avatar" src="{{profileAvatarPath}}" mode="aspectFill" binderror="handleAvatarImageError" aria-hidden="true" />
          <view wx:if="{{avatarUploading}}" class="avatar-upload-mask" aria-hidden="true"><view class="avatar-spinner"></view></view>
        </view>
        <view class="avatar-copy">
          <view class="avatar-title">个人头像</view>
          <view class="avatar-description {{avatarUploadError ? 'avatar-description--error' : ''}}" aria-live="polite">{{avatarUploading ? '正在保存新头像…' : avatarUploadError || (avatarDraftAction ? '已选择 · 保存资料后生效' : '点击更换 · 仅主页展示')}}</view>
        </view>
        <text wx:if="{{!avatarUploading}}" class="row-chevron avatar-chevron" aria-hidden="true">›</text>
      </button>
      <button wx:if="{{hasCustomAvatar}}" class="restore-avatar-button" bindtap="handleRestoreAvatar" disabled="{{saving}}" hover-class="restore-avatar-button--pressed">恢复默认手绘头像</button>

      <view class="profile-divider"></view>
      <button class="profile-row nickname-row" bindtap="handleNicknameOpen" hover-class="profile-row--pressed" hover-stay-time="70" aria-label="修改昵称，当前为{{form.nickname || '未填写'}}">
        <text class="row-label">昵称</text>
        <view class="row-value-group">
          <text class="row-value {{form.nickname ? '' : 'row-placeholder'}}">{{form.nickname || '未填写'}}</text>
          <text class="row-chevron" aria-hidden="true">›</text>
        </view>
      </button>

      <view class="profile-divider"></view>
      <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="handleGenderPick">
        <view class="profile-row {{genderError ? 'profile-row--error' : ''}}" role="button" aria-label="性别，当前{{genderLabel}}">
          <text class="row-label">性别</text>
          <view class="row-value-group">
            <text class="row-value {{form.gender ? '' : 'row-placeholder'}}">{{genderLabel}}</text>
            <text class="row-chevron" aria-hidden="true">›</text>
          </view>
        </view>
      </picker>

      <view class="profile-divider"></view>
      <button class="profile-row birthday-row" bindtap="handleBirthdayOpen" hover-class="profile-row--pressed" hover-stay-time="70" aria-label="修改生日，当前为{{form.birthDate || '未填写'}}">
        <text class="row-label">生日</text>
        <view class="row-value-group">
          <text class="row-value {{form.birthDate ? '' : 'row-placeholder'}}">{{form.birthDate || '未填写'}}</text>
          <text class="row-chevron" aria-hidden="true">›</text>
        </view>
      </button>

      <view class="profile-divider"></view>
      <button class="profile-row mbti-row" bindtap="handleMbtiOpen" hover-class="profile-row--pressed" hover-stay-time="70" aria-label="选择 MBTI，当前为{{form.mbti || '暂未设置'}}">
        <text class="row-label">MBTI</text>
        <view class="row-value-group">
          <text class="row-value {{form.mbti ? '' : 'row-placeholder'}}">{{form.mbti || '暂未设置'}}</text>
          <text class="row-chevron" aria-hidden="true">›</text>
        </view>
      </button>

      <view class="profile-divider"></view>
      <button class="profile-row cover-row" bindtap="handleSelectCover" hover-class="profile-row--pressed" hover-stay-time="70" aria-label="更换内置背景，当前为{{currentCoverLabel}}">
        <text class="row-label">更换背景</text>
        <view class="row-value-group">
          <image class="cover-thumbnail {{currentCoverType === 'avatar_ambient' ? 'cover-thumbnail--avatar' : ''}}" src="{{currentCoverPath}}" mode="aspectFill" aria-hidden="true" />
          <text class="row-value cover-label">{{currentCoverLabel}}</text>
          <text class="row-chevron" aria-hidden="true">›</text>
        </view>
      </button>
    </view>

    <view class="section-heading section-heading--spaced">搭子偏好</view>
    <view class="profile-card preference-card">
      <label class="profile-row preference-row">
        <text class="row-label">个性签名</text>
        <input class="row-control" maxlength="80" cursor-spacing="140" adjust-position="{{true}}" placeholder="如羽毛球、美食、结伴出行" value="{{form.interestsText}}" data-field="interestsText" bindinput="handleInput" aria-label="个性签名，选填" />
      </label>
    </view>

    <view class="privacy-note">自定义头像仅在你的个人主页展示，不进入活动、社区或群聊头像。</view>
  </view>

  <view class="fixed-save-bar">
    <button class="save-button" loading="{{saving}}" disabled="{{saving || loading}}" bindtap="handleSave" hover-class="save-button--pressed">{{saving ? '正在保存…' : '保存资料'}}</button>
  </view>

  <view wx:if="{{nicknameSheetMounted}}" class="nickname-dialog" catchtouchmove="preventScroll" role="dialog" aria-modal="true" aria-label="修改昵称">
    <view class="nickname-backdrop {{nicknameSheetOpen ? 'nickname-backdrop--open' : ''}}" bindtap="handleNicknameClose" catchtouchmove="preventScroll"></view>
    <view class="nickname-sheet {{nicknameSheetOpen ? 'nickname-sheet--open' : ''}}" catchtouchmove="preventScroll">
      <view class="nickname-sheet-header">
        <button class="nickname-sheet-action nickname-sheet-cancel" bindtap="handleNicknameClose" hover-class="nickname-sheet-action--pressed">取消</button>
        <view class="nickname-sheet-title">修改昵称</view>
        <button class="nickname-sheet-action nickname-sheet-confirm" disabled="{{!nicknameCanConfirm}}" bindtap="handleNicknameConfirm" hover-class="nickname-sheet-action--pressed">确定</button>
      </view>
      <view class="nickname-sheet-body">
        <view class="nickname-input-shell {{nicknameError ? 'nickname-input-shell--error' : ''}}">
          <input class="nickname-input" maxlength="20" value="{{nicknameDraft}}" focus="{{nicknameInputFocus}}" adjust-position="{{true}}" cursor-spacing="48" confirm-type="done" bindinput="handleNicknameDraftInput" bindconfirm="handleNicknameConfirm" aria-label="输入新昵称，最多20字" />
        </view>
        <view class="nickname-hint {{nicknameError ? 'nickname-hint--error' : ''}}" role="{{nicknameError ? 'alert' : 'note'}}">{{nicknameHint}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{birthdaySheetMounted}}" class="nickname-dialog" catchtouchmove="preventScroll" role="dialog" aria-modal="true" aria-label="修改生日">
    <view class="nickname-backdrop {{birthdaySheetOpen ? 'nickname-backdrop--open' : ''}}" bindtap="handleBirthdayClose" catchtouchmove="preventScroll"></view>
    <view class="nickname-sheet birthday-sheet {{birthdaySheetOpen ? 'nickname-sheet--open' : ''}}" catchtouchmove="preventScroll">
      <view class="nickname-sheet-header">
        <button class="nickname-sheet-action nickname-sheet-cancel" bindtap="handleBirthdayClose" hover-class="nickname-sheet-action--pressed">取消</button>
        <view class="nickname-sheet-title">修改生日</view>
        <button class="nickname-sheet-action nickname-sheet-confirm" disabled="{{birthdayPicking}}" bindtap="handleBirthdayConfirm" hover-class="nickname-sheet-action--pressed">确定</button>
      </view>
      <picker-view class="birthday-picker" value="{{birthdayPickerValue}}" indicator-style="{{birthdayIndicatorStyle}}" bindchange="handleBirthdayChange" bindpickstart="handleBirthdayPickStart" bindpickend="handleBirthdayPickEnd">
        <picker-view-column class="birthday-picker-column">
          <view wx:for="{{birthdayYears}}" wx:key="*this" class="birthday-picker-item">{{item}}年</view>
        </picker-view-column>
        <picker-view-column class="birthday-picker-column">
          <view wx:for="{{birthdayMonths}}" wx:key="*this" class="birthday-picker-item">{{item}}月</view>
        </picker-view-column>
        <picker-view-column class="birthday-picker-column">
          <view wx:for="{{birthdayDays}}" wx:key="*this" class="birthday-picker-item">{{item}}日</view>
        </picker-view-column>
      </picker-view>
      <view class="birthday-safe-area" aria-hidden="true"></view>
    </view>
  </view>

  <view wx:if="{{mbtiSheetMounted}}" class="nickname-dialog" catchtouchmove="preventScroll" role="dialog" aria-modal="true" aria-label="选择 MBTI">
    <view class="nickname-backdrop {{mbtiSheetOpen ? 'nickname-backdrop--open' : ''}}" bindtap="handleMbtiClose" catchtouchmove="preventScroll"></view>
    <view class="nickname-sheet mbti-sheet {{mbtiSheetOpen ? 'nickname-sheet--open' : ''}}" catchtouchmove="preventScroll">
      <view class="nickname-sheet-header">
        <button class="nickname-sheet-action nickname-sheet-cancel" bindtap="handleMbtiClose" hover-class="nickname-sheet-action--pressed">取消</button>
        <view class="nickname-sheet-title">选择 MBTI</view>
        <button class="nickname-sheet-action nickname-sheet-confirm" bindtap="handleMbtiConfirm" hover-class="nickname-sheet-action--pressed">确定</button>
      </view>
      <view class="mbti-sheet-body">
        <view class="mbti-grid" role="radiogroup" aria-label="MBTI 类型">
          <button wx:for="{{mbtiOptions}}" wx:key="*this" class="mbti-option {{mbtiDraft === item ? 'mbti-option--selected' : ''}}" data-value="{{item}}" bindtap="handleMbtiSelect" hover-class="mbti-option--pressed" aria-label="{{item}}{{mbtiDraft === item ? '，已选择' : ''}}" aria-pressed="{{mbtiDraft === item}}">{{item}}</button>
        </view>
        <button class="mbti-clear {{mbtiDraft ? '' : 'mbti-clear--active'}}" bindtap="handleMbtiClear" hover-class="mbti-clear--pressed">暂不设置 MBTI</button>
      </view>
    </view>
  </view>
</view>
