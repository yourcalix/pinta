page { background: #f9f7f2; color: #1c1917; }
.location-picker-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom)); }
button { margin: 0; padding: 0; line-height: 1.3; }
button::after { display: none; }
.control--pressed { opacity: .7; transform: scale(.98); }
.picker-intro { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 24rpx; }
.picker-title { font-size: 38rpx; font-weight: 800; }
.picker-note { color: #78716c; font-size: 24rpx; line-height: 1.55; }
.poi-search { display: flex; height: 82rpx; overflow: hidden; background: #fff; border: 2rpx solid #e7e1d8; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(83,69,50,.06); }
.poi-search-input { flex: 1; min-width: 0; height: 82rpx; padding: 0 22rpx; font-size: 27rpx; }
.poi-search-button { flex: 0 0 126rpx; color: #fff; background: #075aa7; border: 0; font-size: 25rpx; font-weight: 700; }
.picker-error { margin-top: 18rpx; padding: 20rpx; color: #9f2d20; background: #fff0ed; border-radius: 16rpx; font-size: 24rpx; }
.map-shell { margin-top: 22rpx; overflow: hidden; background: #fff; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(83,69,50,.07); }
.poi-map { width: 100%; height: 300rpx; }
.selected-summary { display: flex; flex-direction: column; gap: 6rpx; padding: 20rpx; }
.selected-name { color: #075aa7; font-size: 27rpx; font-weight: 750; }
.selected-address, .poi-address { color: #78716c; font-size: 22rpx; line-height: 1.45; }
.poi-results { display: flex; flex-direction: column; gap: 14rpx; margin-top: 22rpx; }
.picker-state { padding: 60rpx 20rpx; color: #78716c; text-align: center; font-size: 25rpx; }
.poi-result { display: flex; width: 100%; min-height: 96rpx; box-sizing: border-box; flex-direction: column; align-items: flex-start; justify-content: center; gap: 6rpx; padding: 16rpx 20rpx; text-align: left; background: #fff; border: 2rpx solid transparent; border-radius: 18rpx; }
.poi-result--selected { border-color: #16a36a; background: #eefaf4; }
.poi-name { font-size: 27rpx; font-weight: 700; }
.picker-footer { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(249,247,242,.96); }
.confirm-button { width: 100%; height: 88rpx; color: #fff; background: #16a36a; border-radius: 44rpx; font-size: 28rpx; font-weight: 800; }
.confirm-button[disabled] { color: #a8a29e; background: #e7e1d8; }
