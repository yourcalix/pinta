<view class="location-picker-page">
  <view class="picker-intro">
    <text class="picker-title">选择一个公开地点</text>
    <text class="picker-note">请搜索餐厅、场馆或公共地标。这里不是您的实时位置。</text>
  </view>
  <view class="poi-search" role="search">
    <input class="poi-search-input" value="{{keyword}}" bindinput="handleKeywordInput" bindconfirm="handleSearch" confirm-type="search" placeholder="搜索地点 / 场馆 / 餐厅" cursor-spacing="24" aria-label="搜索高德地图地点" />
    <button class="poi-search-button" bindtap="handleSearch" hover-class="control--pressed">搜索</button>
  </view>
  <view wx:if="{{error}}" class="picker-error" role="alert">{{error}}</view>
  <view wx:if="{{selected && showMapPreview}}" class="map-shell">
    <map class="poi-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" markers="{{markers}}" scale="16" show-location="{{false}}" enable-zoom="{{true}}" aria-label="已选公开会合地点地图预览" />
    <view class="selected-summary"><text class="selected-name">已选：{{selected.label}}</text><text class="selected-address">{{selected.address}}</text></view>
  </view>
  <view class="poi-results">
    <view wx:if="{{loading}}" class="picker-state" role="status">正在搜索高德地图地点…</view>
    <view wx:elif="{{searched && !results.length && !error}}" class="picker-state">没有找到地点，请换个关键词</view>
    <button wx:for="{{results}}" wx:key="poiId" class="poi-result {{selected && selected.poiId === item.poiId ? 'poi-result--selected' : ''}}" data-index="{{index}}" bindtap="handleSelectPoi" hover-class="control--pressed" aria-label="选择{{item.label}}，{{item.address}}">
      <text class="poi-name">{{item.label}}</text><text class="poi-address">{{item.address}}</text>
    </button>
  </view>
  <view class="picker-footer"><button class="confirm-button" disabled="{{!selected}}" bindtap="handleConfirm" hover-class="control--pressed">确认公开会合地点</button></view>
</view>
