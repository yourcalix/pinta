<view class="page form-page form-page--{{meta.tone}} global-background-host" style="padding-top: {{contentTopInset}}px;">
  <block wx:if="{{type === 'food'}}">
    <image class="form-paper-background" src="./assets/food/pin_food_interface.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="form-paper-tint" aria-hidden="true"></view>
  </block>
  <block wx:else>
    <image class="global-page-background" src="/assets/images/shared/shared-paper-bg.jpg" mode="aspectFill" aria-hidden="true" />
    <view class="global-page-background-tint" aria-hidden="true"></view>
  </block>
  <image wx:if="{{type === 'companion'}}" class="companion-travel-frame" src="./assets/companion/companion-travel-frame.png" mode="aspectFill" aria-hidden="true" />

  <view class="form-navigation" style="height: {{contentTopInset}}px;">
    <view class="form-navigation-row">
      <button class="form-back-button" bindtap="handleBack" aria-label="返回上一页">
        <view class="form-back-surface" aria-hidden="true"><view class="form-back-chevron"></view></view>
      </button>
    </view>
  </view>

  <view wx:if="{{type === 'companion'}}" class="companion-form-content">
    <view class="companion-intro">
      <view class="companion-intro-mark" aria-hidden="true"></view>
      <text>{{meta.subtitle}}</text>
    </view>

    <view wx:if="{{errorMessage}}" class="error-banner companion-error-banner" role="alert">{{errorMessage}}</view>

    <view class="companion-card companion-card--basic">
      <view class="companion-card-doodle companion-card-doodle--ticket" aria-hidden="true"></view>
      <view class="companion-section-title">基本信息</view>
      <view class="field-label required">活动标题</view>
      <input class="input companion-input" maxlength="30" value="{{form.title}}" data-field="title" bindinput="handleInput" placeholder="简述你想找怎样的同行伙伴" adjust-position="true" cursor-spacing="140" aria-label="必填项，活动标题" />
      <view class="field-label">补充说明（选填）</view>
      <textarea class="textarea companion-textarea" maxlength="300" value="{{form.description}}" data-field="description" bindinput="handleInput" placeholder="补充行程安排、集合方式或注意事项" adjust-position="true" cursor-spacing="140" aria-label="补充说明，选填" />
    </view>

    <view class="companion-card companion-card--route">
      <view class="companion-card-doodle companion-card-doodle--route" aria-hidden="true">↗</view>
      <view class="companion-section-title">同行信息</view>
      <view class="two-column companion-route-grid">
        <view>
          <view class="field-label required">出发地</view>
          <input class="input companion-input" maxlength="40" value="{{form.originLabel}}" data-field="originLabel" bindinput="handleInput" placeholder="例如：地铁站出口" adjust-position="true" cursor-spacing="140" aria-label="必填项，出发地" />
        </view>
        <view>
          <view class="field-label required">目的地</view>
          <input class="input companion-input" maxlength="40" value="{{form.destinationLabel}}" data-field="destinationLabel" bindinput="handleInput" placeholder="例如：商场南门" adjust-position="true" cursor-spacing="140" aria-label="必填项，目的地" />
        </view>
      </view>
      <view class="field-label">出行方式倾向</view>
      <view class="choice-row" role="radiogroup" aria-label="出行方式倾向">
        <button wx:for="{{transportOptions}}" wx:key="value" class="choice companion-choice {{form.transportPreference === item.value ? 'choice--active' : ''}}" data-field="transportPreference" data-value="{{item.value}}" bindtap="handleChoice" role="radio" aria-checked="{{form.transportPreference === item.value}}">{{item.label}}</button>
      </view>
      <view class="field-label">行李情况</view>
      <view class="choice-row" role="radiogroup" aria-label="行李情况">
        <button wx:for="{{luggageOptions}}" wx:key="value" class="choice companion-choice {{form.luggageType === item.value ? 'choice--active' : ''}}" data-field="luggageType" data-value="{{item.value}}" bindtap="handleChoice" role="radio" aria-checked="{{form.luggageType === item.value}}">{{item.label}}</button>
      </view>
    </view>

    <view class="companion-card companion-card--preferences">
      <view class="companion-card-doodle companion-card-doodle--heart" aria-hidden="true">♡</view>
      <view class="companion-section-title">同行偏好</view>
      <view class="companion-preference-note">以下均为选填，再小众的频道也可能有人接得住</view>

      <view class="field-label">期待拼友性别</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="期待拼友性别">
        <button wx:for="{{genderPreferenceOptions}}" wx:key="value" class="companion-chip {{form.friendGenderPreference === item.value ? 'companion-chip--active' : ''}}" data-field="friendGenderPreference" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.friendGenderPreference === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">MBTI 频道</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="MBTI 频道">
        <button wx:for="{{companionMbtiOptions}}" wx:key="value" class="companion-chip {{form.mbtiPreference === item.value ? 'companion-chip--active' : ''}}" data-field="mbtiPreference" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.mbtiPreference === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">导航属性</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="导航属性">
        <button wx:for="{{navigationStyleOptions}}" wx:key="value" class="companion-chip {{form.navigationStyle === item.value ? 'companion-chip--active' : ''}}" data-field="navigationStyle" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.navigationStyle === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">出行节奏</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="出行节奏">
        <button wx:for="{{travelPaceOptions}}" wx:key="value" class="companion-chip {{form.travelPace === item.value ? 'companion-chip--active' : ''}}" data-field="travelPace" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.travelPace === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">拍照习惯</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="拍照习惯">
        <button wx:for="{{photoHabitOptions}}" wx:key="value" class="companion-chip {{form.photoHabit === item.value ? 'companion-chip--active' : ''}}" data-field="photoHabit" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.photoHabit === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">沉默兼容度</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="沉默兼容度">
        <button wx:for="{{silenceComfortOptions}}" wx:key="value" class="companion-chip {{form.silenceComfort === item.value ? 'companion-chip--active' : ''}}" data-field="silenceComfort" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.silenceComfort === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">饭后蒜味</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="饭后蒜味">
        <button wx:for="{{garlicPreferenceOptions}}" wx:key="value" class="companion-chip {{form.garlicPreference === item.value ? 'companion-chip--active' : ''}}" data-field="garlicPreference" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.garlicPreference === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">香水气场</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="香水气场">
        <button wx:for="{{fragrancePreferenceOptions}}" wx:key="value" class="companion-chip {{form.fragrancePreference === item.value ? 'companion-chip--active' : ''}}" data-field="fragrancePreference" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.fragrancePreference === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
      <view class="field-label">拖鞋出门</view>
      <view class="companion-chip-group" role="radiogroup" aria-label="拖鞋出门">
        <button wx:for="{{slippersPreferenceOptions}}" wx:key="value" class="companion-chip {{form.slippersPreference === item.value ? 'companion-chip--active' : ''}}" data-field="slippersPreference" data-value="{{item.value}}" bindtap="handleCompanionOptionalChoice" role="radio" aria-checked="{{form.slippersPreference === item.value}}"><text class="companion-chip-surface">{{item.label}}</text></button>
      </view>
    </view>

    <view class="companion-card companion-card--schedule">
      <view class="companion-card-doodle companion-card-doodle--calendar" aria-hidden="true"></view>
      <view class="companion-section-title">时间与人数</view>
      <view class="two-column companion-schedule-grid">
        <picker mode="date" start="{{minStartDate}}" end="{{maxStartDate}}" value="{{form.startDate}}" bindchange="handleDate">
          <view class="picker-field companion-picker" role="button" aria-label="选择活动日期，当前{{form.startDate || '未选择'}}"><text>{{form.startDate || '选择日期'}}</text><text aria-hidden="true">⌄</text></view>
        </picker>
        <picker mode="time" value="{{form.startTime}}" bindchange="handleCompanionTime">
          <view class="picker-field companion-picker" role="button" aria-label="选择出发时间，当前{{form.startTime || '未选择'}}"><text>{{form.startTime || '选择时间'}}</text><text aria-hidden="true">⌄</text></view>
        </picker>
      </view>
      <view class="field-label">时间弹性</view>
      <picker mode="selector" range="{{flexibilityLabels}}" value="{{flexibilityIndex}}" bindchange="handleCompanionFlexibility">
        <view class="picker-field companion-picker" role="button" aria-label="选择时间弹性，当前{{flexibilityLabels[flexibilityIndex]}}"><text>{{flexibilityLabels[flexibilityIndex]}}</text><text aria-hidden="true">⌄</text></view>
      </picker>
      <view class="companion-member-switch" role="tablist" aria-label="拼友人数设置方式">
        <button class="companion-member-mode {{form.companionMemberMode === 'fixed' ? 'companion-member-mode--active' : ''}}" data-mode="fixed" bindtap="handleCompanionMemberMode" role="tab" aria-selected="{{form.companionMemberMode === 'fixed'}}">固定拼友数</button>
        <button class="companion-member-mode {{form.companionMemberMode === 'range' ? 'companion-member-mode--active' : ''}}" data-mode="range" bindtap="handleCompanionMemberMode" role="tab" aria-selected="{{form.companionMemberMode === 'range'}}">限制人数范围</button>
      </view>
      <view wx:if="{{form.companionMemberMode === 'fixed'}}" class="companion-member-control">
        <view><view class="field-label required companion-member-label">需要几位拼友</view><text class="companion-member-note">人数不含自己，成团总人数会再加上你</text></view>
        <view class="companion-number-field"><input type="number" value="{{form.companionMinFriends}}" data-field="companionMinFriends" bindinput="handleCompanionFriendNumber" placeholder="如：3" adjust-position="true" cursor-spacing="140" aria-label="需要的拼友人数，1至19位" /><text>位</text></view>
      </view>
      <view wx:else class="companion-member-range">
        <view class="field-label required companion-member-label">可接受的拼友范围</view>
        <text class="companion-member-note">拼友 1—19 位，对应含自己的总人数 2—20 人</text>
        <view class="companion-range-fields">
          <label class="companion-range-field"><text>最少</text><input type="number" value="{{form.companionMinFriends}}" data-field="companionMinFriends" bindinput="handleCompanionFriendNumber" adjust-position="true" cursor-spacing="140" aria-label="最少需要的拼友人数，1至19位" /><text>位</text></label>
          <text class="companion-range-separator">至</text>
          <label class="companion-range-field"><text>最多</text><input type="number" value="{{form.companionMaxFriends}}" data-field="companionMaxFriends" bindinput="handleCompanionFriendNumber" adjust-position="true" cursor-spacing="140" aria-label="最多需要的拼友人数，1至19位" /><text>位</text></label>
        </view>
      </view>
    </view>

    <view class="companion-card companion-card--safety">
      <view class="companion-card-doodle companion-card-doodle--safety" aria-hidden="true">✓</view>
      <view class="companion-section-title">参与规则与安全</view>
      <view class="field-label">参与规则（选填）</view>
      <textarea class="textarea companion-textarea companion-textarea--short" maxlength="200" value="{{form.rules}}" data-field="rules" bindinput="handleInput" placeholder="例如：请守时，费用各自承担" adjust-position="true" cursor-spacing="140" aria-label="参与规则，选填" />
      <checkbox-group bindchange="handleSafety">
        <label class="agreement companion-agreement">
          <checkbox value="agreed" checked="{{safetyAgreed}}" color="#16A36A" aria-label="同意拼单安全规则" />
          <text>我确认信息真实，并同意遵守拼单安全规则。平台不提供运输、配送、担保或预订服务。</text>
        </label>
      </checkbox-group>
    </view>
  </view>

  <view wx:else class="form-content {{type === 'food' ? 'food-form-content' : ''}}">
    <view class="type-intro type-intro--{{meta.tone}}">
      <image class="type-intro-mark" src="{{typeIcon}}" aria-hidden="true" />
      <text class="type-intro-text">{{meta.subtitle}}</text>
    </view>

    <view wx:if="{{errorMessage}}" class="error-banner" role="alert">{{errorMessage}}</view>

    <view wx:if="{{type !== 'food'}}" class="form-card">
      <view class="section-title section-title--{{meta.tone}}">基本信息</view>
      <view class="field-label required">活动标题</view>
      <input class="input" maxlength="30" value="{{form.title}}" data-field="title" bindinput="handleInput" placeholder="一句话说明你想拼什么" adjust-position="true" cursor-spacing="140" aria-label="必填项，活动标题" />
      <view class="field-label">补充说明（选填）</view>
      <textarea class="textarea" maxlength="300" value="{{form.description}}" data-field="description" bindinput="handleInput" placeholder="补充时间弹性、活动偏好或注意事项" adjust-position="true" cursor-spacing="140" aria-label="补充说明，选填" />
    </view>

    <view wx:if="{{type === 'sport'}}" class="form-card">
      <view class="section-title section-title--sport">运动信息</view>
      <view class="field-label required">运动项目</view>
      <input class="input" maxlength="30" value="{{form.sportType}}" data-field="sportType" bindinput="handleInput" placeholder="例如：羽毛球、跑步、篮球" adjust-position="true" cursor-spacing="140" aria-label="必填项，运动项目" />
      <view class="field-label required">活动场地</view>
      <input class="input" maxlength="50" value="{{form.venue}}" data-field="venue" bindinput="handleInput" placeholder="例如：附近体育馆" adjust-position="true" cursor-spacing="140" aria-label="必填项，活动场地" />
      <view class="field-label">参与水平</view>
      <view class="choice-row" role="radiogroup" aria-label="参与水平">
        <button wx:for="{{levelOptions}}" wx:key="value" class="choice {{form.level === item.value ? 'choice--active' : ''}}" data-field="level" data-value="{{item.value}}" bindtap="handleChoice" role="radio" aria-checked="{{form.level === item.value}}">{{item.label}}</button>
      </view>
      <view class="field-label">活动强度</view>
      <view class="choice-row" role="radiogroup" aria-label="活动强度">
        <button wx:for="{{intensityOptions}}" wx:key="value" class="choice {{form.intensity === item.value ? 'choice--active' : ''}}" data-field="intensity" data-value="{{item.value}}" bindtap="handleChoice" role="radio" aria-checked="{{form.intensity === item.value}}">{{item.label}}</button>
      </view>
      <view class="field-label">装备要求（选填）</view>
      <input class="input" maxlength="100" value="{{form.equipment}}" data-field="equipment" bindinput="handleInput" placeholder="例如：自带球拍" adjust-position="true" cursor-spacing="140" aria-label="装备要求，选填" />
    </view>

    <view wx:else class="form-card">
      <image class="form-card-bg" src="./assets/food/fapiao.png" mode="scaleToFill" aria-hidden="true" />
      <view class="form-card-content">
        <view class="section-title section-title--food">
          <image class="section-title-icon" src="./assets/food/hotpot.png" aria-hidden="true" />
          <text class="section-title-text">饭桌信息</text>
        </view>
        <view class="field-label required field-label--venue">餐厅或饭店</view>
        <view class="venue-input-container">
          <input class="input venue-input-manual" maxlength="50" value="{{form.venue}}" data-field="venue" bindinput="handleInput" placeholder="手动输入餐厅名称" adjust-position="true" cursor-spacing="140" aria-label="必填项，餐厅或饭店" />
          <button class="venue-map-button" bindtap="handleChooseLocation" aria-label="从地图选择">
            <text class="venue-map-icon">📍</text>
            <text>地图选择</text>
          </button>
        </view>
        <view class="two-column">
          <view>
            <view class="field-label required">
              <image class="field-label-icon" src="./assets/food/sushi.png" aria-hidden="true" />
              口味菜系
            </view>
            <picker mode="selector" range="{{cuisineOptions}}" value="{{cuisineIndex}}" bindchange="handleCuisine">
              <view class="picker-field" role="button" aria-label="选择口味菜系，当前{{form.cuisine || '未选择'}}">
                <text>{{form.cuisine || '如：粤菜/火锅'}}</text>
                <text aria-hidden="true">⌄</text>
              </view>
            </picker>
            <image wx:if="{{cuisineImage}}" class="cuisine-preview-image" src="{{cuisineImage}}" mode="scaleToFill" aria-hidden="true" />
          </view>
          <view>
            <view class="field-label required">
              <image class="field-label-icon" src="./assets/food/breakfast.png" aria-hidden="true" />
              拼桌形式
            </view>
            <picker mode="selector" range="{{paymentOptions}}" value="{{paymentIndex}}" bindchange="handlePayment">
              <view class="picker-field" role="button" aria-label="选择拼桌形式，当前{{form.paymentMethod || '未选择'}}">
                <text>{{form.paymentMethod || '请选择'}}</text>
                <text aria-hidden="true">⌄</text>
              </view>
            </picker>
            <view wx:if="{{form.paymentMethod === 'Fifty Fifty (均摊)'}}">
              <view class="field-label required">人均预算</view>
              <picker mode="selector" range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="handleBudget">
                <view class="picker-field" role="button" aria-label="选择人均预算，当前{{form.budgetRange || '未选择'}}">
                  <text>{{form.budgetRange || '如：¥50/人'}}</text>
                  <text aria-hidden="true">⌄</text>
                </view>
              </picker>
            </view>
            <view wx:if="{{form.paymentMethod === 'Go Dutch (AA)'}}" class="payment-hint">
              选择此项代表各位将会仅支付自己点到的食物
            </view>
            <view wx:if="{{form.paymentMethod === '真的只是拼张桌'}}" class="payment-hint">
              此选项适用于一些多人桌的排队时间快于单/双人桌的网红店~
            </view>
          </view>
        </view>
        <view class="field-label">
          <image class="field-label-icon field-label-icon--dietary" src="./assets/food/barbecue.png" aria-hidden="true" />
          饮食偏好（选填）
        </view>
        <view class="dietary-chips">
          <button wx:for="{{dietaryOptions}}" wx:key="value" class="dietary-chip {{form.dietaryNotes && form.dietaryNotes.includes(item.value) ? 'dietary-chip--active' : ''}}" data-value="{{item.value}}" bindtap="handleDietaryToggle" role="checkbox" aria-checked="{{form.dietaryNotes && form.dietaryNotes.includes(item.value)}}">{{item.label}}</button>
        </view>
        <view class="dietary-custom">
          <input class="input" maxlength="100" value="{{form.dietaryCustom}}" data-field="dietaryCustom" bindinput="handleInput" placeholder="其他饮食偏好（选填）" adjust-position="true" cursor-spacing="140" aria-label="其他饮食偏好，选填" />
        </view>
        <view class="safety-section">
          <view class="field-label">
            <image class="field-label-icon field-label-icon--rules" src="./assets/food/burger.png" aria-hidden="true" />
            参与规则（选填）
          </view>
          <textarea class="textarea textarea--short" maxlength="200" value="{{form.rules}}" data-field="rules" bindinput="handleInput" placeholder="例如：请守时，费用各自承担" adjust-position="true" cursor-spacing="140" aria-label="参与规则，选填" />
        </view>
      </view>
    </view>

    <view class="form-card">
      <image class="form-card-bg" src="./assets/food/fapiao.png" mode="scaleToFill" aria-hidden="true" />
      <view class="form-card-content">
        <view class="section-title section-title--{{meta.tone}} section-title--time">
          <image class="section-title-icon section-title-icon--time" src="./assets/food/picnic.png" aria-hidden="true" />
          <text class="section-title-text section-title-text--time">时间与人数</text>
        </view>
      <view class="two-column picker-column">
        <picker mode="date" start="{{minStartDate}}" end="{{maxStartDate}}" value="{{form.startDate}}" bindchange="handleDate"><view class="picker-field" role="button" aria-label="选择活动日期，当前{{form.startDate || '未选择'}}"><text>{{form.startDate || '选择日期'}}</text><text aria-hidden="true">⌄</text></view></picker>
        <picker mode="selector" range="{{timeOptions}}" value="{{timeIndex}}" bindchange="handleTime"><view class="picker-field" role="button" aria-label="选择活动时间，当前{{form.startTime || '未选择'}}"><text>{{form.startTime || '选择时间'}}</text><text aria-hidden="true">⌄</text></view></picker>
      </view>
      <view wx:if="{{type === 'food'}}" class="two-column">
        <view>
          <view class="field-label">饭友性别偏好</view>
          <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="handleGenderPreference">
            <view class="picker-field" role="button" aria-label="选择饭友性别偏好，当前{{form.genderPreference || '未选择'}}">
              <text>{{form.genderPreference || '不限'}}</text>
              <text aria-hidden="true">⌄</text>
            </view>
          </picker>
        </view>
        <view>
          <view class="field-label">希望的MBTI类型</view>
          <picker mode="selector" range="{{mbtiOptions}}" value="{{mbtiIndex}}" bindchange="handleMbtiPreference">
            <view class="picker-field" role="button" aria-label="选择希望的MBTI类型，当前{{form.mbtiPreference || '未选择'}}">
              <text>{{form.mbtiPreference || '不限'}}</text>
              <text aria-hidden="true">⌄</text>
            </view>
          </picker>
        </view>
      </view>
      <view class="two-column">
        <view>
          <view class="field-label required">总人数要求（包括发起人）</view>
          <input class="input" type="number" value="{{form.minMembers}}" data-field="minMembers" bindinput="handleNumber" adjust-position="true" cursor-spacing="140" aria-label="必填项，总人数要求（包括发起人）" />
        </view>
        <view>
          <view class="field-label">想要设置人数范围？</view>
          <input class="input" value="{{type === 'food' ? form.memberRangeText : form.maxMembers}}" data-field="{{type === 'food' ? 'memberRangeText' : 'maxMembers'}}" bindinput="handleInput" placeholder="如：2-5" adjust-position="true" cursor-spacing="140" aria-label="可选，想要设置人数范围" />
        </view>
      </view>
      <checkbox-group bindchange="handleSafety">
        <label class="agreement">
          <checkbox value="agreed" checked="{{safetyAgreed}}" color="#16A36A" aria-label="同意拼单安全规则" />
          <text>我确认信息真实，并同意遵守拼单安全规则。平台不提供运输、配送、担保或预订服务。</text>
        </label>
      </checkbox-group>
      </view>
    </view>
  </view>

  <view wx:if="{{type === 'companion'}}" class="fixed-submit-bar fixed-submit-bar--companion">
    <button class="submit-button" hover-class="submit-button--pressed" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting}}" aria-label="{{submitting ? '正在发布拼同行' : '立即发布拼同行'}}">{{submitting ? '正在发布…' : '立即发布拼同行'}}</button>
  </view>
  <view wx:else class="fixed-submit-bar {{type === 'food' ? 'fixed-submit-bar--food' : ''}}">
    <button class="submit-button" hover-class="submit-button--pressed" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting}}" aria-label="{{submitting ? '正在发布拼单' : '立即发布拼单'}}">{{submitting ? '正在发布…' : '立即发布拼单'}}</button>
  </view>
</view>
