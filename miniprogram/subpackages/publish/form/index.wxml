<view class="page form-page safe-bottom">
  <view class="form-header">
    <view class="type-mark" style="color: {{typeColor}}; border-color: {{typeColor}}">{{typeLabel}}</view>
    <view class="step-copy">
      <view class="step-title">{{step === 1 ? '核心信息' : '规则与安全'}}</view>
      <view class="step-description">{{step === 1 ? '填写别人决定是否加入所需的信息' : '这些信息会帮助成员安全履约'}}</view>
    </view>
    <text class="step-count">{{step}}/2</text>
  </view>

  <view class="progress-track"><view class="progress-fill" style="width: {{step * 50}}%"></view></view>

  <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>

  <view wx:if="{{step === 1}}" class="form-card surface">
    <view class="field">
      <text class="field-label required">行程标题</text>
      <input class="input" maxlength="30" cursor-spacing="120" adjust-position="true" placeholder="例如：周五晚青茂回凼仔" value="{{form.title}}" data-field="title" bindinput="handleInput" />
      <view class="field-hint">2—30 个字，不要填写联系方式</view>
    </view>

    <view class="field">
      <text class="field-label required">起点与终点</text>
      <picker mode="multiSelector" range="{{routeColumns}}" value="{{routeIndexes}}" bindcolumnchange="handleRouteColumnChange" bindchange="handleRoute">
        <view class="picker-field" role="button" aria-label="选择合乘起点和终点，当前为{{routeLabel}}">
          <text>{{routeLabel}}</text>
          <text aria-hidden="true">›</text>
        </view>
      </picker>
      <view class="field-hint">仅支持澳门试点的 8 条校园往返路线</view>
    </view>

    <view class="two-columns">
      <view class="field column">
        <text class="field-label required">期望日期</text>
        <picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="handleDate">
          <view class="picker-field">{{form.startDate}}</view>
        </picker>
      </view>
      <view class="field column">
        <text class="field-label required">时间窗起点</text>
        <picker mode="time" value="{{form.startTime}}" data-field="startTime" bindchange="handleDate">
          <view class="picker-field">{{form.startTime}}</view>
        </picker>
      </view>
    </view>

    <view class="two-columns">
      <view class="field column">
        <text class="field-label required">截止日期</text>
        <picker mode="date" value="{{form.deadlineDate}}" data-field="deadlineDate" bindchange="handleDate">
          <view class="picker-field">{{form.deadlineDate}}</view>
        </picker>
      </view>
      <view class="field column">
        <text class="field-label required">截止时间</text>
        <picker mode="time" value="{{form.deadlineTime}}" data-field="deadlineTime" bindchange="handleDate">
          <view class="picker-field">{{form.deadlineTime}}</view>
        </picker>
      </view>
    </view>

    <view class="capacity-info-card" role="region" aria-label="成团与人数规则，固定七名乘客成团，司机不计入乘客人数">
      <view class="capacity-info-main">
        <text class="capacity-label">行程容量</text>
        <text class="capacity-value">固定 7 名乘客成团</text>
      </view>
      <view class="capacity-info-sub">司机不计入乘客人数；接车时间前司机可随时确认承接</view>
    </view>

    <button class="primary-button" bindtap="handleNext">下一步：设置规则</button>
  </view>

  <view wx:else class="form-card surface">
    <view class="field">
      <text class="field-label">补充说明</text>
      <textarea class="textarea" maxlength="300" cursor-spacing="120" adjust-position="true" placeholder="说明时间弹性、适合人群或其他必要条件" value="{{form.description}}" data-field="description" bindinput="handleInput" />
    </view>

    <block wx:if="{{type === 'ride'}}">
      <view class="field">
        <text class="field-label required">费用分摊方式</text>
        <picker mode="selector" range="{{feeOptions}}" range-key="label" value="{{feeIndex}}" data-field="feeType" data-source="feeOptions" data-index-field="feeIndex" bindchange="handleOption">
          <view class="picker-field">{{feeOptions[feeIndex].label}} <text>›</text></view>
        </picker>
        <view class="field-hint">禁止填写司机报价或具体收费金额</view>
      </view>
      <view class="field luggage-field">
        <view class="luggage-field-heading">
          <text class="field-label required">我的行李</text>
          <button class="luggage-help-button" bindtap="showLuggageHelp" aria-label="查看行李大小说明">?</button>
        </view>
        <view class="field-hint">请选择您本次同行携带的行李大小，司机将据此判断后备箱空间</view>
        <view class="luggage-chip-group" role="radiogroup" aria-label="我的行李，必选">
          <button
            wx:for="{{luggageOptions}}"
            wx:key="value"
            class="luggage-chip {{form.luggageType === item.value ? 'luggage-chip--active' : ''}}"
            data-luggage-type="{{item.value}}"
            bindtap="handleLuggageSelect"
            role="radio"
            aria-checked="{{form.luggageType === item.value}}"
            aria-label="{{item.label}}，{{item.description}}"
          >{{item.label}}</button>
        </view>
      </view>
    </block>

    <view class="field">
      <text class="field-label">参与规则</text>
      <textarea class="textarea textarea--small" maxlength="200" cursor-spacing="120" adjust-position="true" placeholder="例如：请提前10分钟到达公共会合点" value="{{form.rules}}" data-field="rules" bindinput="handleInput" />
    </view>

    <view class="field private-field">
      <text class="field-label required">成团后联系方式</text>
      <input class="input" maxlength="80" cursor-spacing="120" adjust-position="true" placeholder="只填写微信号文本，不要上传二维码" value="{{form.contactInfo}}" data-field="contactInfo" bindinput="handleInput" />
      <view class="field-hint">公开列表和详情不会返回此字段</view>
    </view>

    <view class="risk-note">
      <view class="risk-title">发布前请确认</view>
      <view>本功能仅用于澳门校园出行信息撮合。请不要提前向陌生人转账；司机承接仅向已审核的司机与车辆开放。</view>
    </view>

    <checkbox-group bindchange="handleSafety">
      <label class="agreement">
        <checkbox value="agreed" checked="{{safetyAgreed}}" color="#16A36A" />
        <text>我已阅读并同意安全规则，保证信息真实，理解获批成员将自动占用名额。</text>
      </label>
    </checkbox-group>

    <view class="button-row">
      <button class="secondary-button" bindtap="handleBack" disabled="{{submitting}}">上一步</button>
      <button class="primary-button" bindtap="handleSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '正在发布' : '同意规则并发布'}}</button>
    </view>
  </view>
</view>
