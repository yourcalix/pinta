.form-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-right: 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  padding-left: 0;
  background: #075aa7;
}

.form-paper-background,
.form-paper-tint {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.form-paper-background { z-index: 0; }

.form-paper-tint {
  z-index: 1;
  background: rgba(0, 58, 134, .14);
}

.form-navigation {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  left: 0;
  color: #fff8e7;
}

.form-navigation-row {
  position: absolute;
  right: 0;
  bottom: 8px;
  left: 0;
  height: 44px;
}

.form-back-button {
  position: absolute;
  top: 0;
  left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: 1;
}

.form-back-button::after { display: none; }

.form-back-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.form-back-chevron {
  width: 19rpx;
  height: 19rpx;
  margin-left: 7rpx;
  border-bottom: 5rpx solid #fff8e7;
  border-left: 5rpx solid #fff8e7;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.form-content {
  position: relative;
  z-index: 2;
  padding: 0rpx 32rpx 0;
}

.type-intro {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  margin: 4rpx 4rpx 20rpx;
  color: rgba(255, 248, 231, .88);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.45;
  font-family: 'KaiTi', '楷体', serif;
}

.type-intro text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-intro-text {
  margin-left: -55rpx;
  margin-right: -10rpx;
}

.type-intro-mark {
  flex: 0 0 auto;
  width: 300rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-left: -19rpx;
  margin-right: 10rpx;
}

.form-card {
  position: relative;
  margin-top: 1rpx;
  padding: 28rpx 24rpx;
  color: #102a43;
  background: transparent;
  border: 2rpx solid transparent;
  border-radius: 24rpx 20rpx 25rpx 22rpx;
  box-shadow: none;
  overflow: hidden;
}

.form-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.form-card-content {
  position: relative;
  z-index: 1;
  background: transparent;
  border-radius: 22rpx 18rpx 23rpx 20rpx;
  padding: 45rpx;
}

.section-title {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 22rpx;
  padding-left: 0;
  color: #102a43;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
  font-family: 'KaiTi', '楷体', serif;
}

.section-title::before {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 0;
  width: 7rpx;
  background: #2b8f9b;
  border-radius: 8rpx 5rpx 7rpx 4rpx;
  content: '';
  transform: rotate(2deg);
}

.section-title--sport::before { background: #705cc8; }
.section-title--food::before { background: #e8873a; }

.section-title--food::before { display: none; }
.section-title--companion::before { display: none; }
.section-title--sport::before { display: none; }

.section-title--food {
  font-size: 55rpx;
  font-weight: 600;
  font-family: 'KaiTi', '楷体', serif;
}

.section-title-icon {
  flex: 0 0 auto;
  width: 270rpx;
  height: 200rpx;
  margin-left: 14rpx;
  margin-right: 10rpx;
}

.section-title-icon--time {
  width: 290rpx;
  height: 190rpx;
  margin-left: 10rpx;
  margin-right: 10rpx;
}

.section-title--time {
  gap: 12rpx;
}

.section-title-text--time {
  margin-left: 0;
  margin-right: 0;
  font-size: 45rpx;
  transform: translateX(-20rpx);
}

.section-title-text {
  margin-left: 20rpx;
  margin-right: -10rpx;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 24rpx 0 11rpx;
  color: #243b53;
  font-size: 26rpx;
  font-weight: 620;
  line-height: 1.4;
}

.field-label--venue {
  justify-content: center;
  font-size: 32rpx;
}

.venue-input-container {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.venue-input-manual {
  flex: 1;
}

.venue-map-button {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 20rpx;
  min-height: 80rpx;
  background: #e8873a;
  color: #fff;
  border: none;
  border-radius: 15rpx 13rpx 16rpx 14rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.venue-map-icon {
  font-size: 28rpx;
}

.field-label-icon {
  flex: 0 0 auto;
  width: 100rpx;
  height: 80rpx;
}

.field-label-icon--dietary {
  width: 150rpx;
  height: 100rpx;
}

.field-label-icon--rules {
  width: 130rpx;
  height: 100rpx;
}

.section-title + .field-label { margin-top: 0; }
.required::after { color: #e84a36; content: ' *'; }

.dietary-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dietary-chip {
  min-height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #52667a;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 28rpx;
  font-size: 24rpx;
  line-height: 52rpx;
}

.dietary-chip::after { display: none; }

.dietary-chip--active {
  color: #bd6426;
  background: #fff3e9;
  border-color: #e8873a;
  font-weight: 650;
}

.dietary-custom {
  margin-top: 16rpx;
}

.safety-section {
  margin-top: 24rpx;
}

.cuisine-preview-image {
  width: 100%;
  height: 200rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  background: #f4efe6;
}

.payment-hint {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  color: #52667a;
  background: #fff3e9;
  border: 2rpx solid #e8873a;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.input,
.textarea,
.picker-field {
  width: 100%;
  box-sizing: border-box;
  color: #102a43;
  background: transparent;
  border: 2rpx solid transparent;
  border-radius: 15rpx 13rpx 16rpx 14rpx;
  font-size: 26rpx;
}

.input {
  min-height: 80rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 150rpx;
  max-height: 220rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.textarea--short { min-height: 20rpx; }

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 20rpx;
}

.two-column {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.picker-column { margin-bottom: 2rpx; }

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice {
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #52667a;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 15rpx 12rpx 14rpx 13rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.choice::after { display: none; }

.choice--active {
  color: #1c6672;
  background: #e8f6f4;
  border-color: #2b8f9b;
  font-weight: 650;
}

.form-page--sport .choice--active {
  color: #5e4dad;
  background: #f1effb;
  border-color: #705cc8;
}

.form-page--food .choice--active {
  color: #bd6426;
  background: #fff3e9;
  border-color: #e8873a;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #52667a;
  font-size: 24rpx;
  line-height: 1.58;
}

.agreement checkbox { flex-shrink: 0; }

.error-banner {
  margin: 0 0 20rpx;
  padding: 18rpx 22rpx;
  color: #963f35;
  background: #fff0e9;
  border: 2rpx solid #efc2b8;
  border-radius: 18rpx 15rpx 19rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(7, 35, 70, .14);
  font-size: 24rpx;
  line-height: 1.45;
}

.fixed-submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: transparent;
  border-top: none;
  box-shadow: none;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 24rpx;
  color: #fff;
  background: #16a36a;
  border: 0;
  border-radius: 22rpx 19rpx 23rpx 20rpx;
  box-shadow: 0 7rpx 16rpx rgba(3, 49, 31, .26);
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
  transition: transform 120ms ease, opacity 120ms ease;
}

.submit-button::after { display: none; }
.submit-button[disabled] { opacity: .68; }
.submit-button--pressed { opacity: .92; transform: scale(.98); }

@media (max-width: 340px) {
  .form-content { padding-right: 24rpx; padding-left: 24rpx; }
  .type-intro { margin-bottom: 16rpx; font-size: 23rpx; }
  .form-card { padding: 24rpx 20rpx; }
  .two-column { grid-template-columns: 1fr; gap: 0; }
  .picker-column { gap: 14rpx; }
  .picker-column picker + picker { margin-top: 0; }
  .fixed-submit-bar { padding-right: 24rpx; padding-left: 24rpx; }
}
