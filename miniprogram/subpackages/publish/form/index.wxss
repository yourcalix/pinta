.form-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-right: 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  padding-left: 0;
  background: #075aa7;
}

.form-navigation {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  left: 0;
  color: #fff8e7;
}

.form-navigation-row {
  position: absolute;
  right: 0;
  bottom: 8px;
  left: 0;
  height: 44px;
}

.form-back-button {
  position: absolute;
  top: 0;
  left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: 1;
}

.form-back-button::after { display: none; }

.form-back-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.form-back-chevron {
  width: 19rpx;
  height: 19rpx;
  margin-left: 7rpx;
  border-bottom: 5rpx solid #fff8e7;
  border-left: 5rpx solid #fff8e7;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.form-content {
  position: relative;
  z-index: 2;
  padding: 4rpx 32rpx 0;
}

.type-intro {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  margin: 4rpx 4rpx 20rpx;
  color: rgba(255, 248, 231, .88);
  font-size: 24rpx;
  font-weight: 550;
  line-height: 1.45;
}

.type-intro text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-intro-mark {
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  background: #4cc6c4;
  border: 4rpx solid rgba(255, 248, 231, .75);
  border-radius: 46% 54% 44% 56%;
  box-shadow: 0 3rpx 8rpx rgba(2, 30, 70, .22);
  transform: rotate(-8deg);
}

.type-intro--sport .type-intro-mark { background: #9b83e7; }
.type-intro--food .type-intro-mark { background: #f49b55; }

.form-card {
  position: relative;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  color: #102a43;
  background: #fff8ee;
  border: 2rpx solid rgba(234, 219, 206, .95);
  border-radius: 24rpx 20rpx 25rpx 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(7, 35, 70, .18);
}

.section-title {
  position: relative;
  margin: 0 0 22rpx;
  padding-left: 18rpx;
  color: #102a43;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
}

.section-title::before {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 0;
  width: 7rpx;
  background: #2b8f9b;
  border-radius: 8rpx 5rpx 7rpx 4rpx;
  content: '';
  transform: rotate(2deg);
}

.section-title--sport::before { background: #705cc8; }
.section-title--food::before { background: #e8873a; }

.field-label {
  display: block;
  margin: 24rpx 0 11rpx;
  color: #243b53;
  font-size: 26rpx;
  font-weight: 620;
  line-height: 1.4;
}

.section-title + .field-label { margin-top: 0; }
.required::after { color: #e84a36; content: ' *'; }

.input,
.textarea,
.picker-field {
  width: 100%;
  box-sizing: border-box;
  color: #102a43;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 15rpx 13rpx 16rpx 14rpx;
  font-size: 26rpx;
}

.input {
  min-height: 80rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 150rpx;
  max-height: 220rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.textarea--short { min-height: 124rpx; }

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 20rpx;
}

.two-column {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.picker-column { margin-bottom: 2rpx; }

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice {
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #52667a;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 15rpx 12rpx 14rpx 13rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.choice::after { display: none; }

.choice--active {
  color: #1c6672;
  background: #e8f6f4;
  border-color: #2b8f9b;
  font-weight: 650;
}

.form-page--sport .choice--active {
  color: #5e4dad;
  background: #f1effb;
  border-color: #705cc8;
}

.form-page--food .choice--active {
  color: #bd6426;
  background: #fff3e9;
  border-color: #e8873a;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #52667a;
  font-size: 24rpx;
  line-height: 1.58;
}

.agreement checkbox { flex-shrink: 0; }

.error-banner {
  margin: 0 0 20rpx;
  padding: 18rpx 22rpx;
  color: #963f35;
  background: #fff0e9;
  border: 2rpx solid #efc2b8;
  border-radius: 18rpx 15rpx 19rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(7, 35, 70, .14);
  font-size: 24rpx;
  line-height: 1.45;
}

.fixed-submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(7, 73, 147, .94);
  border-top: 2rpx solid rgba(255, 248, 231, .18);
  box-shadow: 0 -8rpx 22rpx rgba(2, 29, 70, .22);
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 24rpx;
  color: #fff;
  background: #16a36a;
  border: 0;
  border-radius: 22rpx 19rpx 23rpx 20rpx;
  box-shadow: 0 7rpx 16rpx rgba(3, 49, 31, .26);
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
  transition: transform 120ms ease, opacity 120ms ease;
}

.submit-button::after { display: none; }
.submit-button[disabled] { opacity: .68; }
.submit-button--pressed { opacity: .92; transform: scale(.98); }

@media (max-width: 340px) {
  .form-content { padding-right: 24rpx; padding-left: 24rpx; }
  .type-intro { margin-bottom: 16rpx; font-size: 23rpx; }
  .form-card { padding: 24rpx 20rpx; }
  .two-column { grid-template-columns: 1fr; gap: 0; }
  .picker-column { gap: 14rpx; }
  .picker-column picker + picker { margin-top: 0; }
  .fixed-submit-bar { padding-right: 24rpx; padding-left: 24rpx; }
}
