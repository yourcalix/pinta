.form-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding-right: 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  padding-left: 0;
  background: #075aa7;
}

.form-page--food {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.form-page--companion {
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
}

.form-paper-background,
.form-paper-tint {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.form-paper-background { z-index: 0; }

.form-paper-tint {
  z-index: 1;
  background: rgba(0, 58, 134, .14);
}

.form-navigation {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  left: 0;
  color: #fff8e7;
}

.form-navigation-row {
  position: absolute;
  right: 0;
  bottom: 8px;
  left: 0;
  height: 44px;
}

.form-back-button {
  position: absolute;
  top: 0;
  left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  line-height: 1;
}

.form-back-button::after { display: none; }

.form-back-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.form-back-chevron {
  width: 19rpx;
  height: 19rpx;
  margin-left: 7rpx;
  border-bottom: 5rpx solid #fff8e7;
  border-left: 5rpx solid #fff8e7;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.form-content {
  position: relative;
  z-index: 2;
  padding: 0rpx 32rpx 0;
}

.type-intro {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  margin: 4rpx 4rpx 20rpx;
  color: rgba(255, 248, 231, .88);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.45;
  font-family: 'KaiTi', '楷体', serif;
}

.type-intro text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-intro-text {
  margin-left: -55rpx;
  margin-right: -10rpx;
}

.type-intro-mark {
  flex: 0 0 auto;
  width: 300rpx;
  height: 200rpx;
  border-radius: 50%;
  margin-left: -19rpx;
  margin-right: 10rpx;
}

.form-card {
  position: relative;
  margin-top: 1rpx;
  padding: 28rpx 24rpx;
  color: #102a43;
  background: transparent;
  border: 2rpx solid transparent;
  border-radius: 24rpx 20rpx 25rpx 22rpx;
  box-shadow: none;
  overflow: hidden;
}

.form-card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

.type-intro-mark,
.section-title-icon,
.field-label-icon,
.cuisine-preview-image,
.form-card-bg {
  pointer-events: none;
  user-select: none;
}

.form-card-content {
  position: relative;
  z-index: 1;
  background: transparent;
  border-radius: 22rpx 18rpx 23rpx 20rpx;
  padding: 45rpx;
}

.section-title {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 22rpx;
  padding-left: 0;
  color: #102a43;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
  font-family: 'KaiTi', '楷体', serif;
}

.section-title::before {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 0;
  width: 7rpx;
  background: #2b8f9b;
  border-radius: 8rpx 5rpx 7rpx 4rpx;
  content: '';
  transform: rotate(2deg);
}

.section-title--sport::before { background: #705cc8; }
.section-title--food::before { background: #e8873a; }

.section-title--food::before { display: none; }
.section-title--companion::before { display: none; }
.section-title--sport::before { display: none; }

.section-title--food {
  font-size: 55rpx;
  font-weight: 600;
  font-family: 'KaiTi', '楷体', serif;
}

.section-title-icon {
  flex: 0 0 auto;
  width: 270rpx;
  height: 200rpx;
  margin-left: 14rpx;
  margin-right: 10rpx;
}

.section-title-icon--time {
  width: 290rpx;
  height: 190rpx;
  margin-left: 10rpx;
  margin-right: 10rpx;
}

.section-title--time {
  gap: 12rpx;
}

.section-title-text--time {
  margin-left: 0;
  margin-right: 0;
  font-size: 45rpx;
  transform: translateX(-20rpx);
}

.section-title-text {
  margin-left: 20rpx;
  margin-right: -10rpx;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 24rpx 0 11rpx;
  color: #243b53;
  font-size: 26rpx;
  font-weight: 620;
  line-height: 1.4;
}

.field-label--venue {
  justify-content: center;
  font-size: 32rpx;
}

.venue-input-container {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.venue-input-manual {
  flex: 1;
}

.venue-map-button {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 20rpx;
  min-height: 80rpx;
  background: #e8873a;
  color: #fff;
  border: none;
  border-radius: 15rpx 13rpx 16rpx 14rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.venue-map-icon {
  font-size: 28rpx;
}

.public-meeting-point { margin-top: 22rpx; }
.public-meeting-point .field-label { margin-top: 0; }
.meeting-point-button {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 14rpx;
  margin: 0;
  padding: 14rpx 18rpx;
  color: #17324d;
  text-align: left;
  background: #fffdf8;
  border: 2rpx dashed #8ab6aa;
  border-radius: 17rpx 14rpx 18rpx 15rpx;
}
.meeting-point-button::after { display: none; }
.meeting-point-button--pressed { opacity: .72; transform: scale(.99); }
.meeting-point-button--food { border-color: #e39a5c; background: rgba(255, 251, 241, .88); }
.meeting-point-icon { flex: 0 0 auto; color: #16816e; font-size: 34rpx; font-weight: 800; }
.meeting-point-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.meeting-point-name { overflow: hidden; font-size: 25rpx; font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }
.meeting-point-address { overflow: hidden; color: #6b756f; font-size: 20rpx; font-weight: 450; text-overflow: ellipsis; white-space: nowrap; }
.meeting-point-arrow { flex: 0 0 auto; color: #7c8a83; font-size: 38rpx; }
.meeting-point-privacy { display: block; margin-top: 9rpx; color: #78827d; font-size: 19rpx; line-height: 1.5; }

.field-label-icon {
  flex: 0 0 auto;
  width: 100rpx;
  height: 80rpx;
}

.field-label-icon--dietary {
  width: 150rpx;
  height: 100rpx;
}

.field-label-icon--rules {
  width: 130rpx;
  height: 100rpx;
}

.section-title + .field-label { margin-top: 0; }
.required::after { color: #e84a36; content: ' *'; }

.dietary-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dietary-chip {
  min-height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #52667a;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 28rpx;
  font-size: 24rpx;
  line-height: 52rpx;
}

.dietary-chip::after { display: none; }

.dietary-chip--active {
  color: #bd6426;
  background: #fff3e9;
  border-color: #e8873a;
  font-weight: 650;
}

.dietary-custom {
  margin-top: 16rpx;
}

.safety-section {
  margin-top: 24rpx;
}

.cuisine-preview-image {
  width: 100%;
  height: 200rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  background: #f4efe6;
}

.payment-hint {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  color: #52667a;
  background: #fff3e9;
  border: 2rpx solid #e8873a;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.input,
.textarea,
.picker-field {
  width: 100%;
  box-sizing: border-box;
  color: #102a43;
  background: transparent;
  border: 2rpx solid transparent;
  border-radius: 15rpx 13rpx 16rpx 14rpx;
  font-size: 26rpx;
}

.input {
  min-height: 80rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 150rpx;
  max-height: 220rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.textarea--short { min-height: 20rpx; }

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 0 20rpx;
}

.two-column {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.picker-column { margin-bottom: 2rpx; }

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice {
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #52667a;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 15rpx 12rpx 14rpx 13rpx;
  font-size: 24rpx;
  line-height: 60rpx;
}

.choice::after { display: none; }

.choice--active {
  color: #1c6672;
  background: #e8f6f4;
  border-color: #2b8f9b;
  font-weight: 650;
}

.form-page--sport .choice--active {
  color: #5e4dad;
  background: #f1effb;
  border-color: #705cc8;
}

.form-page--food .choice--active {
  color: #bd6426;
  background: #fff3e9;
  border-color: #e8873a;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #52667a;
  font-size: 24rpx;
  line-height: 1.58;
}

.agreement checkbox { flex-shrink: 0; }

.error-banner {
  margin: 0 0 20rpx;
  padding: 18rpx 22rpx;
  color: #963f35;
  background: #fff0e9;
  border: 2rpx solid #efc2b8;
  border-radius: 18rpx 15rpx 19rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(7, 35, 70, .14);
  font-size: 24rpx;
  line-height: 1.45;
}

.fixed-submit-bar {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: transparent;
  border-top: none;
  box-shadow: none;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 24rpx;
  color: #fff;
  background: #16a36a;
  border: 0;
  border-radius: 22rpx 19rpx 23rpx 20rpx;
  box-shadow: 0 7rpx 16rpx rgba(3, 49, 31, .26);
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
  transition: transform 120ms ease, opacity 120ms ease;
}

.submit-button::after { display: none; }
.submit-button[disabled] { opacity: .68; }
.submit-button--pressed { opacity: .92; transform: scale(.98); }

.companion-travel-frame {
  position: fixed;
  z-index: 1;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  user-select: none;
  transform: translateZ(0);
}

.companion-form-content {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 100%;
  padding: 4rpx 54rpx 0;
}

.companion-intro {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  margin: 4rpx 8rpx 22rpx;
  color: rgba(255, 248, 231, .94);
  font-size: 25rpx;
  font-weight: 620;
  line-height: 1.45;
}

.companion-intro-mark {
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  background: #4cc6c4;
  border: 4rpx solid rgba(255, 248, 231, .8);
  border-radius: 46% 54% 44% 56%;
  box-shadow: 0 3rpx 8rpx rgba(2, 30, 70, .22);
  transform: rotate(-8deg);
}

.companion-error-banner { margin-right: 8rpx; margin-left: 8rpx; }

.form-page--companion .companion-card {
  --crayon-color: #f5cf76;
  position: relative;
  box-sizing: border-box;
  width: calc(100% - 20rpx);
  margin: 0 10rpx 28rpx;
  padding: 30rpx 26rpx;
  color: #1b1b1b;
  background: #fff8ee;
  border-radius: 30rpx 19rpx 27rpx 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(7, 35, 70, .12);
}

.form-page--companion .companion-card::before,
.form-page--companion .companion-card::after {
  position: absolute;
  z-index: 0;
  pointer-events: none;
  border: 7rpx solid var(--crayon-color);
  content: '';
}

.form-page--companion .companion-card::before {
  inset: -5rpx -3rpx -4rpx -6rpx;
  border-radius: 38rpx 21rpx 34rpx 25rpx;
  opacity: .86;
  transform: rotate(-.35deg);
}

.form-page--companion .companion-card::after {
  inset: -1rpx -6rpx -6rpx -2rpx;
  border-width: 3rpx;
  border-radius: 24rpx 37rpx 20rpx 39rpx;
  opacity: .72;
  transform: rotate(.48deg);
}

.form-page--companion .companion-card .companion-section-title,
.form-page--companion .companion-card .field-label,
.form-page--companion .companion-card .input,
.form-page--companion .companion-card .textarea,
.form-page--companion .companion-card .two-column,
.form-page--companion .companion-card .choice-row,
.form-page--companion .companion-card .companion-preference-note,
.form-page--companion .companion-card .companion-chip-group,
.form-page--companion .companion-card .companion-member-switch,
.form-page--companion .companion-card .companion-member-control,
.form-page--companion .companion-card .companion-member-range,
.form-page--companion .companion-card picker,
.form-page--companion .companion-card checkbox-group {
  position: relative;
  z-index: 1;
}

.form-page--companion .companion-card--basic { --crayon-color: #f5cf76; }
.form-page--companion .companion-card--route { --crayon-color: #93d5e8; }
.form-page--companion .companion-card--preferences { --crayon-color: #efb8c8; }
.form-page--companion .companion-card--schedule { --crayon-color: #c8afe9; }
.form-page--companion .companion-card--safety { --crayon-color: #9ed9bf; }

.companion-section-title {
  position: relative;
  min-height: 54rpx;
  margin: 0 0 20rpx;
  padding: 0 94rpx 0 18rpx;
  color: #17324d;
  font-family: 'KaiTi', '楷体', serif;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 54rpx;
}

.companion-section-title::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 7rpx;
  background: var(--crayon-color);
  border-radius: 8rpx 5rpx 7rpx 4rpx;
  content: '';
  transform: rotate(2deg);
}

.companion-card-doodle {
  position: absolute !important;
  z-index: 2 !important;
  top: 14rpx;
  right: 24rpx;
  box-sizing: border-box;
  width: 66rpx;
  height: 58rpx;
  color: #59768a;
  border: 5rpx solid currentColor;
  border-radius: 12rpx 8rpx 14rpx 9rpx;
  opacity: .78;
  pointer-events: none;
  user-select: none;
  transform: rotate(3deg);
  text-align: center;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.companion-card-doodle--ticket { border-style: dashed; color: #bc9741; }
.companion-card-doodle--route { color: #378ba5; transform: rotate(-5deg); }
.companion-card-doodle--heart { color: #c46f8b; border-radius: 50%; transform: rotate(5deg); }
.companion-card-doodle--calendar { color: #8066a8; }
.companion-card-doodle--calendar::before,
.companion-card-doodle--calendar::after {
  position: absolute;
  top: -13rpx;
  width: 5rpx;
  height: 18rpx;
  background: currentColor;
  border-radius: 6rpx;
  content: '';
}
.companion-card-doodle--calendar::before { left: 13rpx; }
.companion-card-doodle--calendar::after { right: 13rpx; }
.companion-card-doodle--safety { color: #4b9c78; border-radius: 28rpx 24rpx 36rpx 32rpx; transform: rotate(-4deg); }

.form-page--companion .field-label,
.form-page--companion .agreement { color: #243b53; }

.form-page--companion .companion-input,
.form-page--companion .companion-textarea,
.form-page--companion .companion-picker {
  color: #17324d;
  background: #fffdf8;
  border: 2rpx solid #dfd6c8;
}

.companion-textarea--short { min-height: 124rpx; }
.companion-preference-note { margin: -8rpx 0 16rpx; color: #657486; font-size: 22rpx; line-height: 1.5; }

.companion-chip-group {
  display: flex;
  flex-wrap: wrap;
  column-gap: 10rpx;
  row-gap: 0;
  margin-top: -4rpx;
}

.companion-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 4rpx;
  color: #52667a;
  background: transparent;
  border: 0;
  font-size: 22rpx;
  line-height: 1.2;
}

.companion-chip::after,
.companion-member-mode::after { display: none; }

.companion-chip-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 56rpx;
  padding: 0 18rpx;
  background: #f4efe6;
  border: 2rpx solid #e4d9ca;
  border-radius: 28rpx;
}

.companion-chip--active .companion-chip-surface {
  color: #1c6672;
  background: #e8f6f4;
  border-color: #2b8f9b;
  font-weight: 700;
}

.companion-member-switch {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  background: #ece5d9;
  border-radius: 20rpx 17rpx 21rpx 18rpx;
}

.companion-member-mode {
  min-height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  color: #657486;
  background: transparent;
  border: 0;
  border-radius: 15rpx 12rpx 16rpx 13rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 72rpx;
}

.companion-member-mode--active { color: #147c85; background: #fffdf8; box-shadow: 0 4rpx 10rpx rgba(19, 59, 76, .13); }
.companion-member-control { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; }
.companion-member-label { margin: 0; }
.companion-member-note { display: block; margin-top: 6rpx; color: #657486; font-size: 21rpx; line-height: 1.45; }
.companion-number-field { display: flex; align-items: center; gap: 10rpx; color: #17324d; font-size: 26rpx; font-weight: 700; }
.companion-number-field input { box-sizing: border-box; width: 122rpx; height: 80rpx; padding: 0 8rpx; color: #17324d; background: #fffdf8; border: 2rpx solid #dfd6c8; border-radius: 14rpx 12rpx 15rpx 13rpx; text-align: center; }
.companion-member-range { margin-top: 20rpx; }
.companion-range-fields { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 12rpx; padding: 14rpx; background: rgba(255, 255, 255, .58); border-radius: 18rpx; }
.companion-range-field { display: flex; flex: 1; min-width: 0; align-items: center; gap: 8rpx; color: #52667a; font-size: 22rpx; }
.companion-range-field input { box-sizing: border-box; min-width: 0; width: 86rpx; height: 72rpx; padding: 0 5rpx; color: #147c85; background: #fffdf8; border: 2rpx solid #dfd6c8; border-radius: 12rpx; font-size: 24rpx; font-weight: 700; text-align: center; }
.companion-range-separator { flex: 0 0 auto; color: #657486; font-size: 22rpx; }
.companion-agreement { margin-top: 22rpx; }
.fixed-submit-bar--companion { z-index: 20; }

@media (max-width: 340px) {
  .form-content { padding-right: 24rpx; padding-left: 24rpx; }
  .food-form-content { padding-right: 24rpx; padding-left: 24rpx; }
  .type-intro { margin-bottom: 16rpx; font-size: 23rpx; }
  .form-card { padding: 24rpx 20rpx; }
  .two-column { grid-template-columns: 1fr; gap: 0; }
  .picker-column { gap: 14rpx; }
  .picker-column picker + picker { margin-top: 0; }
  .fixed-submit-bar { padding-right: 24rpx; padding-left: 24rpx; }
  .companion-form-content { padding-right: 38rpx; padding-left: 38rpx; }
  .form-page--companion .companion-card { width: calc(100% - 12rpx); margin-right: 6rpx; margin-left: 6rpx; padding: 26rpx 20rpx; }
  .companion-route-grid,
  .companion-schedule-grid { grid-template-columns: 1fr; gap: 14rpx; }
  .companion-member-control { align-items: flex-start; }
  .companion-range-fields { padding: 12rpx 8rpx; }
  .companion-range-field { gap: 5rpx; font-size: 20rpx; }
  .companion-range-field input { width: 70rpx; }
}
