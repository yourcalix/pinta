page {
  min-height: 100%;
  background: #f9f7f2;
}

.memory-preview-page {
  display: flex;
  align-items: center;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)) 28rpx;
  color: #172033;
  background: #f9f7f2;
}

.memory-preview-status {
  box-sizing: border-box;
  width: 694rpx;
  margin-bottom: 20rpx;
  padding: 0 12rpx;
  color: #68727e;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.memory-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 694rpx;
  height: 860rpx;
  overflow: hidden;
  padding: 24rpx;
  color: #fff;
  background: linear-gradient(180deg, #4fa4f8 0%, #207be5 100%);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 34rpx rgba(32, 123, 229, 0.24);
  isolation: isolate;
}

.memory-panel-background,
.memory-panel-shade {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  user-select: none;
}

.memory-panel-background {
  opacity: 0.62;
}

.memory-panel-shade {
  background: linear-gradient(180deg, rgba(32, 123, 229, 0.03) 0%, rgba(32, 123, 229, 0.14) 43%, rgba(15, 91, 177, 0.34) 100%);
}

.memory-panel-glow {
  position: absolute;
  z-index: 0;
  top: -120rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
  user-select: none;
}

.memory-masthead {
  position: relative;
  z-index: 1;
  flex: 1 1 auto;
  box-sizing: border-box;
  min-height: 0;
  padding: 0 14rpx 12rpx;
  pointer-events: none;
  user-select: none;
}

.memory-watermark {
  color: rgba(255, 255, 255, 0.45);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 4rpx;
}

.memory-art-title {
  display: inline-block;
  max-width: 100%;
  margin-top: 12rpx;
  color: #fff;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(12, 60, 130, 0.45), 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  transform: rotate(-3deg);
  transform-origin: left center;
}

.memory-art-title-first {
  font-size: 42rpx;
  line-height: 1.15;
}

.memory-art-title-second {
  display: flex;
  align-items: center;
  margin-top: -2rpx;
  font-size: 52rpx;
  line-height: 1.08;
}

.memory-title-accent {
  color: #ffe600;
}

.memory-camera {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 36rpx;
  margin-left: 14rpx;
  border: 2rpx solid #fff;
  border-radius: 6rpx;
  transform: rotate(12deg) translateY(2rpx);
}

.memory-camera::before {
  position: absolute;
  top: -8rpx;
  left: 7rpx;
  width: 15rpx;
  height: 7rpx;
  background: #fff;
  border-radius: 3rpx 3rpx 0 0;
  content: '';
}

.memory-camera-lens {
  position: absolute;
  top: 8rpx;
  left: 15rpx;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
}

.memory-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  line-height: 1.4;
  text-shadow: 0 2rpx 8rpx rgba(12, 60, 130, 0.35);
}

.memory-grid {
  position: relative;
  z-index: 1;
  display: grid;
  flex: 0 0 588rpx;
  grid-template-columns: 315rpx 315rpx;
  grid-template-rows: 286rpx 286rpx;
  gap: 16rpx;
  pointer-events: none;
  user-select: none;
}

.memory-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx dashed rgba(255, 255, 255, 0.35);
  border-radius: 22rpx;
  pointer-events: none;
  user-select: none;
}

.memory-slot--lead {
  grid-row: 1 / 3;
  height: 588rpx;
}

.memory-slot--top {
  grid-column: 2;
  grid-row: 1;
}

.memory-slot--bottom {
  grid-column: 2;
  grid-row: 2;
}

.memory-slot-camera {
  position: relative;
  box-sizing: border-box;
  width: 36rpx;
  height: 29rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.66);
  border-radius: 6rpx;
  transform: rotate(-4deg);
}

.memory-slot-camera--large {
  width: 52rpx;
  height: 42rpx;
}

.memory-slot-camera::before {
  position: absolute;
  top: -7rpx;
  left: 6rpx;
  width: 12rpx;
  height: 6rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.66);
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
  content: '';
}

.memory-slot-camera--large::before {
  top: -9rpx;
  left: 9rpx;
  width: 17rpx;
  height: 8rpx;
}

.memory-slot-lens {
  position: absolute;
  top: 7rpx;
  left: 12rpx;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.66);
  border-radius: 50%;
}

.memory-slot-camera--large .memory-slot-lens {
  top: 11rpx;
  left: 18rpx;
  width: 14rpx;
  height: 14rpx;
}

.memory-slot-copy {
  margin-top: 16rpx;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.35;
  text-align: center;
}

.memory-slot-copy--large {
  margin-top: 22rpx;
  font-size: 24rpx;
}

.memory-slot-copy text {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 18rpx;
  font-weight: 500;
}

@media (max-width: 340px) {
  .memory-preview-page {
    padding-top: 30rpx;
  }

  .memory-preview-status {
    width: 600rpx;
    margin-bottom: 18rpx;
  }

  .memory-panel {
    width: 600rpx;
    height: 744rpx;
    padding: 18rpx;
    border-radius: 24rpx;
  }

  .memory-masthead {
    padding: 0 10rpx 8rpx;
  }

  .memory-watermark {
    font-size: 18rpx;
  }

  .memory-art-title {
    margin-top: 8rpx;
  }

  .memory-art-title-first {
    font-size: 36rpx;
  }

  .memory-art-title-second {
    font-size: 44rpx;
  }

  .memory-subtitle {
    margin-top: 6rpx;
    font-size: 19rpx;
  }

  .memory-grid {
    flex-basis: 508rpx;
    grid-template-columns: 272rpx 272rpx;
    grid-template-rows: 248rpx 248rpx;
    gap: 12rpx;
  }

  .memory-slot--lead {
    height: 508rpx;
  }
}
