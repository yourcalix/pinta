<view class="memory-preview-page">
  <view class="memory-preview-status" role="status">拼友成团故事分享与精选晒图功能正在筹备中，近期开放</view>

  <view class="memory-panel" role="region" aria-label="成团记忆专题画报，记录每一次顺利成团的珍贵瞬间，分享功能即将开放">
