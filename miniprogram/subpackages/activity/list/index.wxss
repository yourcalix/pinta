page { color: #111827; background: #f9f7f2; }
.all-activities-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); background: #f9f7f2; }
button { margin: 0; padding: 0; line-height: 1.25; }
button::after { display: none; }
.control--pressed { opacity: 0.68; transform: scale(0.97); }
.activity-tools { position: sticky; z-index: 20; top: 0; box-sizing: border-box; padding: 18rpx 28rpx 14rpx; background: rgba(249, 247, 242, 0.96); border-bottom: 1rpx solid rgba(231, 226, 217, 0.74); }
.activity-search { display: flex; width: 100%; height: 68rpx; box-sizing: border-box; align-items: center; padding: 0 14rpx 0 24rpx; background: #fff; border: 1.5rpx solid #efece6; border-radius: 34rpx; box-shadow: 0 5rpx 16rpx rgba(83, 69, 50, 0.05); }
.activity-search-icon { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; margin-right: 12rpx; opacity: 0.62; }
.activity-search-input { flex: 1; min-width: 0; height: 68rpx; color: #1c1917; font-size: 25rpx; font-weight: 500; line-height: 68rpx; }
.activity-search-placeholder { color: #a8a29e; }
.activity-search-clear { flex: 0 0 56rpx; width: 56rpx; height: 68rpx; color: #78716c; background: transparent; border: 0; font-size: 32rpx; line-height: 68rpx; }
.activity-filter-scroll { width: 100%; margin-top: 12rpx; white-space: nowrap; }
.activity-filter-track { display: inline-flex; gap: 14rpx; padding-right: 4rpx; }
.activity-filter-chip { display: inline-flex; min-width: 112rpx; height: 54rpx; box-sizing: border-box; align-items: center; justify-content: center; padding: 0 22rpx; color: #78716c; background: #fff; border: 1.5rpx solid #efece6; border-radius: 27rpx; font-size: 22rpx; font-weight: 650; transition: opacity 100ms ease, transform 100ms ease; }
.activity-filter-chip--active { color: #fff; background: #111827; border-color: #111827; }
.activity-list-content { padding: 18rpx 28rpx 0; }
.all-activity-list, .all-activity-skeleton-list { display: flex; flex-direction: column; }
.all-activity-skeleton { display: flex; width: 100%; min-height: 390rpx; box-sizing: border-box; margin-bottom: 20rpx; overflow: hidden; background: #fff; border: 1.5rpx solid #efece6; border-radius: 24rpx; box-shadow: 0 5rpx 16rpx rgba(83, 69, 50, 0.05); }
.skeleton-cover { flex: 0 0 46%; min-height: 390rpx; background: #e9e4dc; animation: pulse 1s ease-in-out infinite alternate; }
.skeleton-copy { flex: 1; padding: 26rpx 20rpx; }
.skeleton-line { height: 22rpx; margin-top: 20rpx; background: #ece8e1; border-radius: 11rpx; animation: pulse 1s ease-in-out infinite alternate; }
.skeleton-line--date { width: 62%; height: 30rpx; margin-top: 0; }
.skeleton-line--title { width: 100%; margin-top: 34rpx; }
.skeleton-line--title-short { width: 74%; margin-top: 10rpx; }
.skeleton-line--meta { width: 84%; margin-top: 30rpx; }
.activity-list-footer { min-height: 108rpx; }
.activity-footer-state { display: flex; min-height: 100rpx; align-items: center; justify-content: center; gap: 10rpx; color: #a8a29e; font-size: 22rpx; }
.activity-footer-spinner { width: 24rpx; height: 24rpx; box-sizing: border-box; border: 3rpx solid #ded8cf; border-top-color: #f59e0b; border-radius: 50%; animation: spin 0.7s linear infinite; }
.activity-footer-retry { width: 100%; min-height: 88rpx; color: #8a5b00; background: #fff5d8; border: 1rpx solid #f2d28b; border-radius: 44rpx; font-size: 22rpx; font-weight: 650; }
.activity-footer-state--end { padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.activity-empty-shell { overflow: hidden; background: #fff; border: 1rpx solid #efece6; border-radius: 24rpx; box-shadow: 0 5rpx 16rpx rgba(83, 69, 50, 0.05); }
@keyframes pulse { from { opacity: 0.55; } to { opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 340px) {
  .activity-tools { padding: 14rpx 20rpx 12rpx; }
  .activity-search { height: 60rpx; padding: 0 12rpx 0 18rpx; border-radius: 30rpx; }
  .activity-search-input { height: 60rpx; font-size: 22rpx; line-height: 60rpx; }
  .activity-search-clear { width: 50rpx; height: 60rpx; font-size: 28rpx; line-height: 60rpx; }
  .activity-filter-track { gap: 10rpx; }
  .activity-filter-chip { min-width: 96rpx; height: 48rpx; padding: 0 16rpx; border-radius: 24rpx; font-size: 20rpx; }
  .activity-list-content { padding: 14rpx 20rpx 0; }
  .all-activity-skeleton { min-height: 350rpx; margin-bottom: 14rpx; border-radius: 20rpx; }
  .skeleton-cover { flex-basis: 43%; min-height: 350rpx; }
  .skeleton-copy { padding: 20rpx 16rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .activity-filter-chip { transition: none; }
  .skeleton-cover, .skeleton-line, .activity-footer-spinner { animation: none; }
}
