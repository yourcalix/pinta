<view class="page detail-page safe-bottom">
  <view wx:if="{{loading}}" class="loading-block surface">正在加载活动详情…</view>
  <empty-state wx:elif="{{errorCode === 'TAKEDOWN' || errorCode === 'NOT_FOUND'}}" symbol="!" title="{{error}}" action-text="返回发现页" bindaction="handleGoDiscover" />
  <empty-state wx:elif="{{errorCode}}" symbol="!" title="{{error}}" action-text="重新加载" bindaction="handleRetry" />
  <block wx:elif="{{activity}}">
    <view class="detail-hero detail-hero--{{activity.typeTone}} surface"><view class="type-tag type-tag--{{activity.typeTone}}">{{activity.typeIcon}} {{activity.typeLabel}}</view><status-badge label="{{activity.statusLabel}}" tone="{{activity.statusTone}}" /><button class="share-chip-button" open-type="share" aria-label="分享活动">分享</button><view class="detail-title">{{activity.title}}</view><view class="detail-description">{{activity.description || '发起者暂未填写补充说明'}}</view></view>
    <view class="info-card surface"><view class="info-row"><text class="info-label">时间</text><text>{{activity.displayTime}}</text></view><view class="info-row"><text class="info-label">地点</text><text>{{activity.sceneLine}}</text></view><view class="info-row"><text class="info-label">人数</text><text>{{activity.memberCount}} / {{activity.maxMembers}} 人 · {{activity.minMembers}} 人成团</text></view><view wx:if="{{activity.rules}}" class="info-row"><text class="info-label">规则</text><text>{{activity.rules}}</text></view></view>
    <view class="owner-card surface"><image src="../../../assets/images/discover/brand-puzzle.png" mode="aspectFit" aria-hidden="true" /><view><view class="owner-label">发起人</view><view class="owner-name">{{activity.owner.nickname}}</view></view></view>
    <view class="safety-card"><view class="safety-title">拼单安全提示</view><view>成团后请在成员空间核验身份并自行确认安排；平台不提供运输、配送、担保或预订服务。</view></view>
    <button wx:if="{{activity.viewerRole === 'owner' && activity.status === 'RECRUITING'}}" class="primary-button" bindtap="handleManage">管理拼单与申请</button>
    <button wx:if="{{(activity.viewerRole === 'owner' || activity.viewerRole === 'member') && (activity.status === 'FORMED' || activity.status === 'IN_PROGRESS')}}" class="primary-button" bindtap="handleGroup">进入成员空间</button>
    <button wx:if="{{activity.canApply}}" class="primary-button primary-button--{{activity.typeTone}}" bindtap="handleApplyOpen">申请加入</button>
    <view wx:elif="{{activity.viewerApplication && activity.viewerApplication.status === 'PENDING'}}" class="application-state">加入申请审核中</view>
    <button class="report-link" bindtap="handleReport">举报活动</button>
  </block>
  <view wx:if="{{showApply}}" class="apply-modal"><view class="apply-backdrop" bindtap="handleApplyClose"></view><view class="apply-sheet"><view class="apply-title">申请加入{{activity.typeLabel}}</view><textarea class="apply-note" maxlength="120" value="{{note}}" bindinput="handleNote" placeholder="选填：向发起者简单介绍你的安排" /><view class="apply-actions"><button class="secondary-button" bindtap="handleApplyClose">取消</button><button class="primary-button" loading="{{applying}}" disabled="{{applying}}" bindtap="handleApplySubmit">提交申请</button></view></view></view>
</view>
