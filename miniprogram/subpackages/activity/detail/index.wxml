<view class="page detail-page safe-bottom">
  <view class="detail-content" aria-hidden="{{driverSheetVisible || qaModal.visible}}">
  <view wx:if="{{loading}}" class="detail-skeleton surface">
    <view class="skeleton-line short"></view>
    <view class="skeleton-line title"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line medium"></view>
  </view>

  <empty-state
    wx:elif="{{errorCode === 'TAKEDOWN' || errorCode === 'NOT_FOUND'}}"
    symbol="!"
    title="{{errorCode === 'TAKEDOWN' ? '活动已被处理' : '活动不存在'}}"
    description="{{errorCode === 'TAKEDOWN' ? '该活动已被平台处理，暂不可查看。你可以返回发现页查看其他活动。' : '该活动可能已失效或分享链接不完整。你可以返回发现页查看其他活动。'}}"
    action-text="返回发现页"
    bindaction="handleGoDiscover"
  />

  <empty-state
    wx:elif="{{errorCode}}"
    symbol="!"
    title="{{error}}"
    description="页面暂时无法获取最新活动信息，请稍后重试。"
    action-text="重新加载"
    bindaction="loadDetail"
  />

  <block wx:elif="{{activity}}">
    <view class="status-strip status-strip--{{activity.statusTone}}">
      <status-badge label="{{activity.statusLabel}}" tone="{{activity.statusTone}}" />
      <text wx:if="{{activity.remaining > 0}}">还差 {{activity.remainingToForm}} 人满 7 人</text>
      <text wx:elif="{{activity.status === 'FORMED'}}">7 名乘客已满员</text>
      <text wx:else>当前状态不可继续申请</text>
    </view>

    <view wx:if="{{activity.type === 'ride'}}" class="detail-mode-switch" aria-label="选择详情页视角">
      <button class="detail-mode-option {{viewMode === 'passenger' ? 'detail-mode-option--active' : ''}}" data-value="passenger" bindtap="handleViewModeChange">乘客加入</button>
      <button class="detail-mode-option detail-mode-option--driver {{viewMode === 'driver' ? 'detail-mode-option--active-driver' : ''}}" data-value="driver" bindtap="handleViewModeChange">司机承接</button>
    </view>

    <view class="detail-card surface">
      <view class="type-line" style="color: {{activity.typeColor}}">{{activity.typeIcon}} {{activity.typeLabel}}</view>
      <view class="detail-heading">
        <view class="detail-title">{{activity.title}}</view>
        <button class="share-chip-button" open-type="share" aria-label="分享活动">分享</button>
      </view>
      <view class="owner-line">由 {{activity.owner.nickname}} 发起</view>

      <view class="time-card">
        <view class="time-main">{{activity.displayTime}}</view>
        <view class="time-sub">{{activity.city}} · {{activity.district}} · {{activity.placeLabel}}</view>
      </view>

      <view class="detail-row" wx:for="{{detailRows}}" wx:key="label">
        <text class="row-label">{{item.label}}</text>
        <text class="row-value">{{item.value}}</text>
      </view>

      <view class="description-block" wx:if="{{activity.description}}">
        <view class="block-title">活动说明</view>
        <view class="block-text">{{activity.description}}</view>
      </view>

      <view class="description-block" wx:if="{{activity.rules}}">
        <view class="block-title">参与规则</view>
        <view class="block-text">{{activity.rules}}</view>
      </view>

      <view class="locked-card">
        <view class="lock-title">{{activity.type === 'ride' ? '隐私联系方式' : '成团后解锁'}}</view>
        <view class="lock-text">{{activity.type === 'ride' ? '每位成员的电话不会公开；司机成功承接后，才可查看本次行程有效成员的联系电话与行李。' : '联系方式和具体会合说明不会出现在公开详情中，仅有效成员可以查看。'}}</view>
      </view>
    </view>

    <view class="risk-card">
      <view class="risk-title">安全提示</view>
      <view wx:if="{{activity.type === 'ride'}}">平台不提供车辆或在线收款。请勿提前向陌生人转账；司机承接仅向已通过合规审核的账号开放。</view>
      <view wx:elif="{{activity.type === 'product'}}">平台不提供收款与商品担保，建议到货后当面验货交付。</view>
      <view wx:else>线下见面请选择公共场所，并将行程告知亲友。</view>
    </view>

    <view wx:if="{{viewMode === 'driver' && activity.type === 'ride'}}" class="driver-card surface">
      <view class="driver-card-heading">
        <view>
          <view class="block-title">司机承接</view>
          <view class="driver-card-subtitle">接车时间前可确认承接，无需等待满员</view>
        </view>
        <status-badge wx:if="{{activity.driverStatusLabel}}" label="{{activity.driverStatusLabel}}" tone="{{activity.driverStatusTone}}" />
      </view>
      <view wx:if="{{driverLoading}}" class="driver-local-state">正在核验司机资格…</view>
      <view wx:elif="{{activity.rideFulfillment && activity.rideFulfillment.status === 'ASSIGNED'}}" class="driver-local-state driver-local-state--assigned">
        <view>该行程已有司机承接</view>
        <view wx:if="{{activity.rideFulfillment.pickupAt}}">已确认接送时间：{{activity.driverStatusLabel}}</view>
      </view>
      <view wx:elif="{{!activity.driverAcceptable}}" class="driver-local-state">{{activity.driverUnacceptableReason || '暂不可承接'}}</view>
      <view wx:elif="{{!driverProfile || !driverProfile.canAcceptRide}}" class="driver-local-state">
        <view>司机资格审核中或尚未申请，暂不可承接</view>
        <view class="driver-local-hint">试点阶段仅向已核验澳门驾驶资格的司机开放</view>
      </view>
      <view wx:elif="{{!driverVehicles.length}}" class="driver-local-state">暂无审核通过的车辆，不可承接</view>
      <button wx:else class="driver-primary-button" bindtap="handleOpenDriverSheet">选择接送时间</button>
    </view>

    <view wx:if="{{viewMode === 'driver' && activity.viewerRole === 'driver' && activity.rideFulfillment && activity.rideFulfillment.status === 'ASSIGNED'}}" class="driver-contacts-card surface" role="region" aria-label="本次行程成员联系方式">
      <view class="driver-contacts-heading">
        <view>
          <view class="block-title">成员联系方式</view>
          <view class="driver-contacts-subtitle">仅当前承接司机可见，请只用于本次接送联系</view>
        </view>
        <button class="driver-contacts-retry" wx:if="{{driverContacts.error}}" bindtap="handleRetryDriverContacts">重试</button>
      </view>
      <view wx:if="{{driverContacts.loading}}" class="driver-contact-state" role="status">正在安全加载成员电话…</view>
      <view wx:elif="{{driverContacts.error}}" class="driver-contact-state driver-contact-state--error" role="status">{{driverContacts.error}}</view>
      <view wx:elif="{{!driverContacts.items.length}}" class="driver-contact-state">暂无有效成员</view>
      <view wx:else class="driver-contact-list">
        <view class="driver-contact-item" wx:for="{{driverContacts.items}}" wx:key="memberId">
          <view class="driver-contact-main">
            <view class="driver-contact-name">{{item.nickname}} <text class="driver-contact-role">{{item.roleLabel}}</text></view>
            <text class="driver-contact-phone" user-select="true" aria-label="电话 {{item.phoneAriaLabel}}">{{item.phone}}</text>
            <view class="driver-contact-luggage">行李：{{item.luggageLabel}}</view>
          </view>
          <button class="driver-contact-call" data-phone="{{item.phone}}" bindtap="handleCallMember" aria-label="拨打{{item.nickname}}的电话">拨打</button>
        </view>
      </view>
    </view>

    <view wx:if="{{viewMode === 'passenger' && activity.type === 'ride' && activity.canJoinRide}}" class="apply-card surface">
      <view class="block-title">立即加入拼车</view>
      <view class="join-ride-hint">加入即占用名额；司机确认承接前可自由退出。</view>
      <view class="join-ride-subhint">校园互助合乘；能否出行以司机承接为准。成员电话仅向成功承接的司机开放。</view>
      <view class="join-luggage-heading">
        <view>
          <view class="join-luggage-title">请选择您的行李</view>
          <view class="join-luggage-subtitle">每个人独立申报，便于司机确认行程</view>
        </view>
        <button class="luggage-help-button" bindtap="showLuggageHelp" aria-label="查看行李大小说明">?</button>
      </view>
      <view class="luggage-chip-group" role="radiogroup" aria-label="请选择您的行李，必选">
        <button
          wx:for="{{luggageOptions}}"
          wx:key="value"
          class="luggage-chip {{selectedLuggageType === item.value ? 'luggage-chip--active' : ''}}"
          data-luggage-type="{{item.value}}"
          bindtap="handleLuggageSelect"
          role="radio"
          aria-checked="{{selectedLuggageType === item.value}}"
          aria-label="{{item.label}}，{{item.description}}"
        >{{item.label}}</button>
      </view>
      <view class="join-phone-field">
        <view class="join-luggage-title">本人联系电话</view>
        <view class="join-luggage-subtitle">司机成功承接后可查看，仅用于本次接送联系</view>
        <view class="join-phone-row">
          <picker mode="selector" range="{{phoneRegionOptions}}" range-key="label" value="{{phoneRegionIndex}}" bindchange="handlePhoneRegion">
            <view class="join-phone-region" role="button" aria-label="选择电话地区，当前为{{phoneRegionOptions[phoneRegionIndex].label}}">{{phoneRegionOptions[phoneRegionIndex].code}} <text aria-hidden="true">⌄</text></view>
          </picker>
          <input class="input join-phone-input" type="number" maxlength="11" cursor-spacing="120" adjust-position="true" placeholder="{{phonePlaceholder}}" value="{{phoneNumber}}" bindinput="handlePhoneInput" />
        </view>
      </view>
      <button class="primary-button" loading="{{pending}}" disabled="{{pending || !selectedLuggageType || !phoneNumber}}" bindtap="handleJoinRide" aria-busy="{{pending}}">{{pending ? '正在抢位中…' : (!selectedLuggageType ? '请先选择行李类型' : (!phoneNumber ? '请填写本人联系电话' : '立即加入拼车'))}}</button>
    </view>

    <view wx:if="{{viewMode === 'passenger' && activity.type !== 'ride' && activity.canApply}}" class="apply-card surface">
      <view class="block-title">申请加入</view>
      <textarea class="textarea apply-note" maxlength="120" cursor-spacing="120" adjust-position="true" placeholder="选填：说明行李、数量、经验或时间情况" value="{{note}}" bindinput="handleNote" />
      <checkbox-group bindchange="handleConsent">
        <label class="consent-row">
          <checkbox value="consent" checked="{{consent}}" color="#16A36A" />
          <text>我理解发起者批准后会自动加入并占用名额；如有变化会及时退出。</text>
        </label>
      </checkbox-group>
      <button class="primary-button" loading="{{pending}}" disabled="{{pending || !consent}}" bindtap="handleApply">提交申请</button>
    </view>

    <view wx:if="{{viewMode === 'passenger' && activity.type === 'ride' && activity.viewerRole === 'member' && activity.canLeaveRide}}" class="state-card surface">
      <view>
        <view class="state-title">已加入拼车</view>
        <view class="state-description">司机确认承接前，你可以随时退出并释放名额。</view>
      </view>
      <button class="danger-button compact-button" bindtap="handleLeaveRide" disabled="{{pending}}">退出拼车</button>
    </view>

    <view wx:if="{{viewMode === 'passenger' && activity.type === 'ride' && activity.rideExitLocked}}" class="ride-exit-lock-card surface" role="status" aria-label="提示：司机已确认承接，退出权限已锁定，当前不可自行退出">
      <view class="state-title">退出权限已锁定</view>
      <view class="state-description">司机已确认承接，当前不可退出；如无法出行，请联系发起者或司机。</view>
    </view>

    <view wx:if="{{viewMode === 'passenger' && activity.type !== 'ride' && activity.viewerRole === 'applicant' && activity.viewerApplication.status === 'PENDING'}}" class="state-card surface">
      <view>
        <view class="state-title">申请已提交</view>
        <view class="state-description">等待发起者处理；获批后会自动占用名额。</view>
      </view>
      <button class="secondary-button compact-button" bindtap="handleWithdraw" disabled="{{pending}}">撤回申请</button>
    </view>

    <button wx:if="{{viewMode === 'passenger' && activity.viewerRole === 'owner' && (activity.status === 'RECRUITING' || activity.status === 'FORMED')}}" class="primary-button bottom-action" bindtap="handleManage">{{activity.type === 'ride' ? '管理行程' : '管理申请'}}</button>
    <button wx:if="{{viewMode === 'passenger' && (activity.viewerRole === 'owner' || activity.viewerRole === 'member') && (activity.status === 'FORMED' || activity.status === 'IN_PROGRESS')}}" class="primary-button bottom-action" bindtap="handleGroup">进入成团页</button>
    <button wx:if="{{viewMode === 'passenger' && (activity.viewerRole === 'guest' || activity.viewerRole === 'applicant') && !activity.canApply && !(activity.viewerApplication && activity.viewerApplication.status === 'PENDING')}}" class="unavailable-button bottom-action" disabled>{{activity.type === 'ride' ? activity.joinUnavailableTip : activity.statusLabel + '，暂不可申请'}}</button>

    <view class="qa-card surface" aria-role="region" aria-label="公开问答">
      <view class="qa-heading">
        <view>
          <view class="block-title">公开问答</view>
          <view class="qa-subtitle">围绕时间、地点和参与细节公开沟通</view>
        </view>
        <button wx:if="{{qa.canAsk}}" class="qa-action qa-ask-action" bindtap="handleOpenAsk" aria-label="向发起者提问">我要提问</button>
      </view>

      <view wx:if="{{qa.loading}}" class="qa-local-state" aria-role="status" aria-label="正在加载公开问答">正在加载问答…</view>
      <view wx:elif="{{qa.error}}" class="qa-local-state qa-error" aria-role="status">
        <text>{{qa.error}}</text>
        <button class="qa-action qa-retry-action" bindtap="handleRetryQuestions">重新加载</button>
      </view>
      <view wx:elif="{{!qa.items.length}}" class="qa-local-state">
        <text>还没有公开问题</text>
        <text class="qa-empty-hint">有需要确认的细节，可以先问问发起者。</text>
      </view>
      <block wx:else>
        <view class="qa-item" wx:for="{{qa.previewItems}}" wx:key="id">
          <view class="qa-meta">{{item.askerName}} · {{item.createdLabel}}</view>
          <view class="qa-question"><text class="qa-mark">问</text><text class="qa-content">{{item.content}}</text></view>
          <view wx:if="{{item.answer}}" class="qa-answer">
            <text class="qa-mark qa-mark--answer">答</text>
            <view class="qa-answer-main">
              <text class="qa-content">{{item.answer.content}}</text>
              <text class="qa-responder">{{item.answer.responderName}}</text>
            </view>
          </view>
          <view wx:else class="qa-unanswered">
            <text>等待发起者回答</text>
            <button
              wx:if="{{item.canAnswer}}"
              class="qa-action qa-answer-action"
              data-id="{{item.id}}"
              data-content="{{item.content}}"
              bindtap="handleOpenAnswer"
              aria-label="回答问题：{{item.content}}"
            >回答</button>
          </view>
        </view>
        <button wx:if="{{qa.items.length > 3}}" class="qa-toggle" bindtap="handleToggleQuestions">{{qa.expanded ? '收起问答' : '查看全部 ' + qa.items.length + ' 条问答'}}</button>
        <view wx:if="{{qa.expanded && qa.nextCursor}}" class="qa-limit-hint">仅展示最新 10 条问答</view>
      </block>
    </view>

    <button class="report-link" bindtap="handleReport">举报此活动</button>
  </block>
  </view>

  <view wx:if="{{driverSheetVisible}}" class="driver-modal" catchtouchmove="preventTouchMove" aria-role="dialog" aria-label="选择接送时间">
    <view class="driver-backdrop" bindtap="handleCloseDriverSheet"></view>
    <view class="driver-sheet" catchtap="preventTouchMove">
      <view class="driver-sheet-handle" aria-hidden="true"></view>
      <view class="driver-sheet-heading">
        <view>
          <view class="driver-sheet-title">确认承接行程</view>
          <view class="driver-sheet-subtitle">请谨慎承接，确认后请按时接送</view>
        </view>
        <button class="driver-sheet-close" bindtap="handleCloseDriverSheet" disabled="{{driverPending}}">关闭</button>
      </view>

      <view class="driver-sheet-field">
        <view class="field-label">承接车辆</view>
        <picker mode="selector" range="{{driverVehicles}}" range-key="plateMasked" value="{{vehicleIndex}}" bindchange="handleVehicleChange">
          <view class="driver-vehicle-picker">
            <text>{{driverVehicles[vehicleIndex].type}} · {{driverVehicles[vehicleIndex].plateMasked}}</text>
            <text>›</text>
          </view>
        </picker>
      </view>

      <view class="driver-sheet-field">
        <view class="field-label">接送时间（15 分钟档）</view>
        <view class="pickup-slot-grid">
          <button
            wx:for="{{pickupSlots}}"
            wx:key="value"
            class="pickup-slot {{selectedPickupAt === item.value ? 'pickup-slot--active' : ''}}"
            data-value="{{item.value}}"
            bindtap="handlePickupSlot"
          >{{item.label}}</button>
        </view>
      </view>

      <view class="driver-sheet-notice">本试点不在线收款。承接前请确认车辆与驾驶资格状态有效。</view>
      <button class="driver-primary-button" loading="{{driverPending}}" disabled="{{driverPending || !selectedPickupAt}}" bindtap="handleAcceptRide">{{driverPending ? '正在确认' : '确认承接'}}</button>
    </view>
  </view>

  <view wx:if="{{qaModal.visible}}" class="qa-modal" catchtouchmove="preventTouchMove" aria-role="dialog" aria-label="{{qaModal.type === 'answer' ? '回答公开问题' : '发布公开问题'}}">
    <view class="qa-backdrop" bindtap="handleCloseQuestion" catchtouchmove="preventTouchMove"></view>
    <view class="qa-sheet" catchtap="preventTouchMove" catchtouchmove="preventTouchMove">
      <view class="qa-sheet-handle" aria-hidden="true"></view>
      <view class="qa-sheet-heading">
        <view class="qa-sheet-title">{{qaModal.type === 'answer' ? '回答问题' : '向发起者提问'}}</view>
        <button class="qa-close" bindtap="handleCloseQuestion" disabled="{{qaModal.submitting}}" aria-label="关闭">关闭</button>
      </view>
      <view wx:if="{{qaModal.type === 'answer'}}" class="qa-target-question">{{qaModal.targetContent}}</view>
      <textarea
        class="textarea qa-input"
        maxlength="{{qaModal.type === 'answer' ? 300 : 200}}"
        cursor-spacing="140"
        adjust-position="true"
        auto-focus="true"
        placeholder="{{qaModal.type === 'answer' ? '公开回答参与者的问题' : '请描述需要确认的时间、地点或参与细节'}}"
        value="{{qaModal.content}}"
        bindinput="handleQuestionInput"
      />
      <view class="qa-input-footer">
        <text>{{qaModal.content.length}} / {{qaModal.type === 'answer' ? 300 : 200}}</text>
        <button class="primary-button qa-submit" loading="{{qaModal.submitting}}" disabled="{{qaModal.submitting}}" bindtap="handleSubmitQuestion">{{qaModal.type === 'answer' ? '发布回答' : '发布问题'}}</button>
      </view>
    </view>
  </view>
</view>
