.detail-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); background: #fff; color: #161616; }
button::after { display: none; }
.detail-navigation { position: fixed; z-index: 50; top: 0; left: 0; right: 0; pointer-events: none; transition: background-color 180ms ease, box-shadow 180ms ease; }
.detail-navigation--solid { background: rgba(255,255,255,.96); box-shadow: 0 1rpx 0 rgba(0,0,0,.08); }
.back-button { position: absolute; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 44px; min-height: 44px; margin: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.88); color: #101010; font-size: 34px; line-height: 1; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.13); pointer-events: auto; }
.detail-navigation--solid .back-button { background: transparent; box-shadow: none; }
.detail-hero { position: relative; width: 100%; height: calc(75vh + 48rpx); min-height: 900rpx; overflow: hidden; background: #f16b99; }
.detail-hero--sport { background: #c9b7ef; }
.detail-hero--food { background: #f4aa75; }
.hero-art { width: 100%; height: 100%; background: transparent; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.24) 0%, transparent 22%, transparent 72%, rgba(0,0,0,.22) 100%); pointer-events: none; }
.hero-caption { position: absolute; left: 34rpx; bottom: 82rpx; display: flex; flex-direction: column; gap: 4rpx; color: #fff; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.3); }
.hero-caption text:last-child { font-size: 28rpx; letter-spacing: 1rpx; }
.hero-fallback { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: #fff; font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-fallback text:first-child { font-size: 82rpx; font-weight: 900; letter-spacing: 8rpx; }
.hero-sentinel { position: absolute; left: 0; right: 0; bottom: 0; height: 2rpx; }
.detail-panel { position: relative; z-index: 2; margin-top: -48rpx; padding: 34rpx 32rpx 48rpx; border-radius: 42rpx 42rpx 0 0; background: #fff; box-shadow: 0 -10rpx 28rpx rgba(0,0,0,.08); }
.detail-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.type-tag { display: inline-flex; padding: 7rpx 13rpx; border-radius: 8rpx; background: #f1f1f1; color: #171717; font-size: 23rpx; font-weight: 700; }
.type-tag--companion { background: #e4f5ef; color: #08785c; }
.type-tag--sport { background: #eee8fb; color: #58408f; }
.type-tag--food { background: #ffeadc; color: #a4421b; }
.archive-label { color: #777; font-size: 24rpx; }
.detail-title { margin-top: 20rpx; font-size: 39rpx; line-height: 1.35; font-weight: 800; overflow-wrap: anywhere; word-break: break-all; }
.detail-subline { margin-top: 12rpx; color: #8a8a8a; font-size: 25rpx; line-height: 1.45; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.info-card { margin-top: 34rpx; padding: 0 22rpx; border-radius: 24rpx; background: #f7f7f7; }
.info-row { display: flex; align-items: flex-start; gap: 14rpx; min-height: 96rpx; padding: 24rpx 0; box-sizing: border-box; border-bottom: 1rpx solid #e5e5e5; font-size: 27rpx; line-height: 1.55; }
.info-symbol { flex: 0 0 30rpx; color: #111; text-align: center; font-size: 24rpx; }
.info-label { flex: 0 0 120rpx; color: #171717; font-weight: 750; }
.info-value { flex: 1; min-width: 0; color: #333; overflow-wrap: anywhere; word-break: break-all; }
.info-arrow { flex: 0 0 24rpx; color: #bbb; font-size: 42rpx; line-height: .85; }
.member-row { padding: 25rpx 0 27rpx; }
.member-heading { display: flex; align-items: center; gap: 14rpx; font-size: 27rpx; line-height: 1.4; }
.member-heading .info-label { flex: none; }
.member-count { color: #999; font-weight: 400; }
.detail-avatar-group { display: flex; align-items: center; gap: 14rpx; margin: 24rpx 0 0 44rpx; pointer-events: none; }
.detail-avatar { display: flex; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; overflow: hidden; box-sizing: border-box; border: 2rpx solid #dedede; border-radius: 50%; background: #fff; }
.detail-avatar image { width: 100%; height: 100%; }
.detail-avatar--empty { border: 2rpx dashed #bcbcbc; background: transparent; color: #aaa; font-size: 34rpx; }
.avatar-more { display: flex; min-width: 72rpx; height: 72rpx; padding: 0 10rpx; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 40rpx; background: #222; color: #fff; font-size: 24rpx; }
.group-hint { margin: 16rpx 0 0 44rpx; color: #858585; font-size: 23rpx; }
.content-section { padding: 44rpx 8rpx; border-bottom: 12rpx solid #f6f6f6; }
.section-title { margin-bottom: 26rpx; color: #101010; font-size: 32rpx; font-weight: 800; }
.detail-description { display: block; color: #292929; font-size: 29rpx; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.arrangement-list { margin-top: 26rpx; }
.arrangement-row { display: flex; gap: 22rpx; padding: 13rpx 0; color: #333; font-size: 27rpx; line-height: 1.65; }
.arrangement-label { flex: 0 0 124rpx; color: #777; }
.arrangement-value { flex: 1; min-width: 0; overflow-wrap: anywhere; word-break: break-all; }
.owner-card { display: flex; align-items: center; gap: 18rpx; }
.owner-avatar { display: flex; flex: 0 0 68rpx; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 50%; background: #161616; color: #fff; font-size: 30rpx; }
.owner-copy { min-width: 0; }
.owner-label { color: #888; font-size: 23rpx; }
.owner-name { margin-top: 5rpx; font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.safety-card { margin: 36rpx 8rpx 0; padding: 28rpx; border-radius: 20rpx; background: #f1f8f5; color: #65706b; font-size: 24rpx; line-height: 1.7; }
.safety-title { margin-bottom: 8rpx; color: #183c31; font-size: 27rpx; font-weight: 750; }
.report-link { min-height: 44px; margin: 18rpx 0 0; padding: 12rpx; background: transparent; color: #888; font-size: 24rpx; }
.detail-action-bar { position: fixed; z-index: 60; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 6rpx; min-height: 112rpx; padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom)); box-sizing: content-box; background: rgba(255,255,255,.98); border-top: 1rpx solid #e8e8e8; }
.footer-tool { display: flex; flex: 0 0 88rpx; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 2rpx 3rpx; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; border-radius: 16rpx; background: transparent; color: #242424; font-size: 22rpx; font-weight: 500; line-height: 1.25; }
.footer-icon { font-size: 38rpx; font-weight: 700; line-height: 1; }
.footer-tool--disabled { color: #aaa; }
.primary-button, .sheet-primary-button, .secondary-button { display: flex; min-height: 88rpx; margin: 0; padding: 12rpx 24rpx; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 48rpx; font-size: 30rpx; font-weight: 800; line-height: 1.3; }
.primary-button { flex: 1; min-width: 0; margin-left: 8rpx; background: #181818; color: #2cff9a; }
.primary-label { display: block; max-width: 100%; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.primary-button--disabled, .primary-button[disabled] { background: #e7e7e7; color: #8b8b8b; }
.primary-button--pressed { transform: scale(.98); opacity: .9; }
.utility-button--pressed { background: #e8f8ef; transform: scale(.97); }
.detail-error { min-height: 100vh; box-sizing: border-box; background: #fff; }
.detail-loading { min-height: 100vh; box-sizing: border-box; background: #fff; }
.skeleton-cover { height: 75vh; background: #ececec; }
.skeleton-panel { position: relative; margin-top: -48rpx; padding: 44rpx 32rpx; border-radius: 42rpx 42rpx 0 0; background: #fff; }
.skeleton-panel view { height: 32rpx; margin: 24rpx 0; border-radius: 8rpx; background: #ececec; }
.skeleton-panel view:last-child { width: 65%; }
.apply-modal { position: fixed; z-index: 100; inset: 0; }
.apply-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.54); }
.apply-sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fff; }
.apply-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.apply-title { font-size: 31rpx; font-weight: 800; }
.close-button { display: flex; flex: 0 0 44px; min-height: 44px; margin: 0; padding: 0; align-items: center; justify-content: center; background: transparent; color: #111; font-size: 32px; }
.apply-help { margin-top: 8rpx; color: #777; font-size: 24rpx; line-height: 1.55; }
.apply-note { width: 100%; height: 150rpx; margin-top: 20rpx; padding: 18rpx; box-sizing: border-box; border-radius: 18rpx; background: #f5f5f5; font-size: 28rpx; }
.apply-actions { display: flex; gap: 16rpx; margin-top: 22rpx; }
.secondary-button { flex: 0 0 28%; background: #ededed; color: #333; }
.sheet-primary-button { flex: 1; background: #181818; color: #2cff9a; }
@media (max-width: 340px) {
  .detail-panel { padding-left: 24rpx; padding-right: 24rpx; }
  .detail-title { font-size: 35rpx; }
  .info-card { padding-left: 16rpx; padding-right: 16rpx; }
  .info-row { gap: 8rpx; font-size: 24rpx; }
  .info-label { flex-basis: 104rpx; }
  .detail-avatar-group { gap: 8rpx; margin-left: 36rpx; }
  .detail-avatar { flex-basis: 62rpx; width: 62rpx; height: 62rpx; }
  .avatar-more { min-width: 62rpx; height: 62rpx; }
  .detail-action-bar { padding-left: 12rpx; padding-right: 12rpx; }
  .footer-tool { flex-basis: 88rpx; min-width: 88rpx; }
  .primary-button { padding-left: 12rpx; padding-right: 12rpx; font-size: 24rpx; }
}
