.detail-page{min-height:100vh;padding:24rpx;background:#075aa7;box-sizing:border-box}
.surface{background:#fff;border-radius:24rpx;border:1rpx solid #e5ebe7;box-shadow:0 8rpx 24rpx rgba(18,38,25,.06)}
.loading-block{padding:32rpx;text-align:center;color:#657269}
.detail-hero{position:relative;padding:30rpx}
.type-tag{display:inline-flex;padding:8rpx 14rpx;border-radius:14rpx;font-size:23rpx;font-weight:700;margin-right:12rpx}
.type-tag--companion{color:#2f69b6;background:#edf4fd}
.type-tag--sport{color:#5e4dad;background:#f1effb}
.type-tag--food{color:#c86e28;background:#fff3e9}
.detail-title{margin-top:24rpx;font-size:38rpx;font-weight:700;color:#17231d;line-height:1.35}
.detail-description{margin-top:14rpx;color:#617067;font-size:26rpx;line-height:1.65}
.info-card{margin-top:22rpx;padding:8rpx 28rpx}
.info-row{display:flex;gap:24rpx;padding:22rpx 0;border-bottom:1rpx solid #edf1ef;color:#35423b;font-size:25rpx;line-height:1.5}
.info-row:last-child{border-bottom:0}
.info-label{flex:0 0 70rpx;color:#7a867f}
.owner-card{display:flex;align-items:center;gap:18rpx;margin-top:22rpx;padding:24rpx}
.owner-card image{width:70rpx;height:70rpx}
.owner-label{font-size:22rpx;color:#7a867f}
.owner-name{margin-top:4rpx;font-size:27rpx;font-weight:600}
.safety-card{margin-top:22rpx;padding:22rpx 24rpx;color:#5c6a62;background:#f0f7f3;border:1rpx dashed #cfe1d6;border-radius:20rpx;font-size:23rpx;line-height:1.55}
.safety-title{color:#244b39;font-weight:700;margin-bottom:6rpx}
.primary-button,.secondary-button{width:100%;min-height:88rpx;margin-top:22rpx;border-radius:18rpx;font-size:27rpx;font-weight:600}
.primary-button{color:#fff;background:#16a36a}
.primary-button--companion{background:#3d7fd6}
.primary-button--sport{background:#705cc8}
.primary-button--food{background:#e8873a}
.primary-button::after,.secondary-button::after{display:none}
.secondary-button{color:#415047;background:#eef2f0}
.application-state{margin-top:22rpx;padding:24rpx;text-align:center;color:#637168;background:#eef2f0;border-radius:18rpx}
.report-link{margin:18rpx auto 0;color:#fff0dc;background:transparent;font-size:23rpx;text-shadow:0 1rpx 3rpx rgba(7,35,70,.24)}
.report-link::after{display:none}
.apply-modal{position:fixed;z-index:100;inset:0}
.apply-backdrop{position:absolute;inset:0;background:rgba(10,20,15,.38)}
.apply-sheet{position:absolute;left:0;right:0;bottom:0;padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));background:#fff;border-radius:30rpx 30rpx 0 0}
.apply-title{font-size:32rpx;font-weight:700}
.apply-note{width:100%;min-height:160rpx;margin-top:20rpx;padding:18rpx;box-sizing:border-box;background:#f4f7f5;border-radius:16rpx}
.apply-actions{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.apply-actions button{margin-top:22rpx}
.share-chip-button{position:absolute;top:16rpx;right:18rpx;min-width:88rpx;min-height:88rpx;margin:0;padding:0 16rpx;color:#496258;background:rgba(255,255,255,.86);border-radius:44rpx;font-size:23rpx;line-height:88rpx}
.share-chip-button::after{display:none}
