.detail-page {
  padding-top: 20rpx;
}

.status-strip,
.type-line,
.detail-row,
.state-card,
.consent-row {
  display: flex;
  align-items: center;
}

.status-strip {
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  color: #3e4b44;
  background: #edf4f0;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.detail-mode-switch {
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
  padding: 8rpx;
  background: #e8edeb;
  border-radius: 20rpx;
}

.detail-mode-option {
  flex: 1;
  min-height: 80rpx;
  margin: 0;
  color: #536159;
  background: transparent;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.detail-mode-option--active {
  color: #126a48;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(24, 60, 44, 0.08);
  font-weight: 650;
}

.detail-mode-option--active-driver {
  color: #245b98;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(36, 91, 152, 0.1);
  font-weight: 650;
}

.detail-card {
  padding: 30rpx 26rpx;
}

.type-line {
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 650;
}

.detail-heading {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
}

.detail-title {
  flex: 1 1 400rpx;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 720;
  line-height: 1.35;
}

.share-chip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 116rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  color: #118557;
  background: #eef7f2;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.owner-line {
  margin-top: 10rpx;
  color: #728078;
  font-size: 24rpx;
}

.time-card {
  margin: 26rpx 0 10rpx;
  padding: 22rpx;
  background: #f4f8f6;
  border-radius: 16rpx;
}

.time-main {
  font-size: 29rpx;
  font-weight: 650;
}

.time-sub {
  margin-top: 8rpx;
  color: #66736c;
  font-size: 24rpx;
}

.detail-row {
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #edf0ee;
  font-size: 26rpx;
}

.row-label {
  color: #738078;
}

.row-value {
  max-width: 68%;
  color: #26322c;
  font-weight: 560;
  text-align: right;
}

.description-block {
  margin-top: 28rpx;
}

.block-title,
.state-title,
.risk-title,
.lock-title {
  font-size: 28rpx;
  font-weight: 650;
}

.block-text {
  margin-top: 10rpx;
  color: #4f5c55;
  line-height: 1.65;
  white-space: pre-wrap;
}

.locked-card {
  margin-top: 28rpx;
  padding: 22rpx;
  color: #34527a;
  background: #f0f6ff;
  border: 1rpx solid #dce7f7;
  border-radius: 16rpx;
}

.lock-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.risk-card {
  margin-top: 18rpx;
  padding: 22rpx;
  color: #76581f;
  background: #fff8e8;
  border: 1rpx solid #f0ddb3;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.apply-card,
.state-card,
.driver-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.driver-card {
  border: 1rpx solid #d9e7fa;
  background: #f6f9fe;
}

.driver-card-heading,
.driver-sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.driver-card-subtitle,
.driver-sheet-subtitle,
.driver-local-hint {
  margin-top: 7rpx;
  color: #677b94;
  font-size: 23rpx;
  line-height: 1.5;
}

.driver-local-state {
  margin-top: 20rpx;
  padding: 22rpx;
  color: #53677f;
  background: #fff;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.driver-local-state--assigned {
  color: #1e5a45;
  background: #edf8f3;
}

.driver-primary-button {
  min-height: 88rpx;
  margin-top: 22rpx;
  color: #fff;
  background: #3478f6;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.apply-note {
  min-height: 140rpx;
  margin-top: 16rpx;
}

.consent-row {
  align-items: flex-start;
  gap: 10rpx;
  margin: 20rpx 0;
  color: #59655e;
  font-size: 24rpx;
  line-height: 1.5;
}

.state-card {
  justify-content: space-between;
  gap: 20rpx;
}

.state-description {
  margin-top: 6rpx;
  color: #6d7972;
  font-size: 24rpx;
}

.compact-button {
  flex: 0 0 auto;
  min-height: 70rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
}

.bottom-action {
  margin-top: 22rpx;
}

.unavailable-button {
  min-height: 88rpx;
  color: #6d7972;
  background: #e9edeb;
  font-size: 28rpx;
}

.qa-card {
  margin-top: 22rpx;
  padding: 26rpx;
}

.qa-heading,
.qa-question,
.qa-answer,
.qa-unanswered,
.qa-sheet-heading,
.qa-input-footer {
  display: flex;
  align-items: center;
}

.qa-heading {
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.qa-subtitle {
  margin-top: 6rpx;
  color: #78847d;
  font-size: 24rpx;
  line-height: 1.45;
}

.qa-action {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 22rpx;
  color: #118557;
  background: #eef7f2;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.qa-ask-action {
  flex: 0 0 auto;
}

.qa-local-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 42rpx 20rpx 24rpx;
  color: #6d7972;
  font-size: 25rpx;
  text-align: center;
}

.qa-empty-hint {
  color: #8a958f;
  font-size: 24rpx;
}

.qa-error {
  color: #80555a;
}

.qa-retry-action {
  margin-top: 4rpx;
}

.qa-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf0ee;
}

.qa-meta,
.qa-responder,
.qa-unanswered,
.qa-limit-hint {
  color: #7b8780;
  font-size: 24rpx;
}

.qa-question,
.qa-answer {
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.qa-answer {
  padding: 18rpx;
  background: #f5f8f6;
  border-radius: 14rpx;
}

.qa-mark {
  flex: 0 0 auto;
  min-width: 38rpx;
  color: #fff;
  background: #66736c;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 38rpx;
  text-align: center;
}

.qa-mark--answer {
  background: #16a36a;
}

.qa-content {
  min-width: 0;
  color: #344139;
  font-size: 27rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.qa-answer-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.qa-unanswered {
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-left: 50rpx;
}

.qa-answer-action {
  min-width: 104rpx;
  flex: 0 0 auto;
}

.qa-toggle {
  min-height: 88rpx;
  margin-top: 12rpx;
  color: #118557;
  background: transparent;
  font-size: 25rpx;
}

.qa-limit-hint {
  text-align: center;
}

.qa-modal {
  position: fixed;
  z-index: 200;
  inset: 0;
}

.driver-modal {
  position: fixed;
  z-index: 220;
  inset: 0;
}

.driver-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(17, 27, 34, 0.5);
}

.driver-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.driver-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  background: #d9dfdc;
  border-radius: 999rpx;
}

.driver-sheet-title {
  font-size: 32rpx;
  font-weight: 680;
}

.driver-sheet-close {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 8rpx 12rpx 24rpx;
  color: #69756e;
  background: transparent;
  font-size: 25rpx;
}

.driver-sheet-field {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #3e4b44;
  font-size: 25rpx;
  font-weight: 650;
}

.driver-vehicle-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 14rpx 20rpx;
  background: #f5f8f7;
  border: 1rpx solid #e1e7e4;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.pickup-slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.pickup-slot {
  min-height: 88rpx;
  margin: 0;
  color: #40546c;
  background: #f2f6fb;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.pickup-slot--active {
  color: #fff;
  background: #3478f6;
  border-color: #3478f6;
  font-weight: 650;
}

.driver-sheet-notice {
  margin-top: 22rpx;
  padding: 18rpx;
  color: #795d28;
  background: #fff8e8;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.qa-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(21, 31, 26, 0.48);
}

.qa-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.qa-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  background: #d9dfdc;
  border-radius: 999rpx;
}

.qa-sheet-heading,
.qa-input-footer {
  justify-content: space-between;
  gap: 20rpx;
}

.qa-sheet-title {
  font-size: 32rpx;
  font-weight: 680;
}

.qa-close {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 8rpx 12rpx 24rpx;
  color: #69756e;
  background: transparent;
  font-size: 25rpx;
}

.qa-target-question {
  margin-top: 14rpx;
  padding: 18rpx;
  color: #59655e;
  background: #f5f8f6;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}

.qa-input {
  min-height: 210rpx;
  margin-top: 18rpx;
}

.qa-input-footer {
  margin-top: 18rpx;
  color: #7b8780;
  font-size: 24rpx;
}

.qa-submit {
  min-width: 220rpx;
  margin: 0;
}

.report-link {
  min-height: 76rpx;
  margin-top: 18rpx;
  color: #8a4a4e;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.4;
}

.join-ride-hint,
.join-ride-subhint {
  margin-top: 12rpx;
  color: #52615a;
  font-size: 25rpx;
  line-height: 1.55;
}

.join-ride-subhint { color: #748078; }

.join-luggage-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.join-luggage-title {
  color: #2f3d35;
  font-size: 27rpx;
  font-weight: 650;
}

.join-luggage-subtitle {
  margin-top: 6rpx;
  color: #748078;
  font-size: 23rpx;
  line-height: 1.45;
}

.luggage-help-button {
  flex: 0 0 auto;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: -20rpx -14rpx -12rpx 0;
  padding: 0;
  color: #11784f;
  background: transparent;
  font-size: 28rpx;
  line-height: 88rpx;
}

.luggage-chip-group {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0 22rpx;
}

.luggage-chip {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  color: #344139;
  background: #f0f4f2;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.luggage-chip::after,
.luggage-help-button::after {
  display: none;
}

.luggage-chip--active {
  color: #11784f;
  background: #e8f5ee;
  border-color: #16a36a;
  font-weight: 650;
}

.join-phone-field {
  margin: 8rpx 0 24rpx;
}

.join-phone-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 14rpx;
}

.join-phone-region {
  box-sizing: border-box;
  min-width: 176rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 18rpx;
  color: #28513f;
  background: #f7faf8;
  border: 1rpx solid #cadbd2;
  border-radius: 14rpx;
  font-size: 26rpx;
}

.join-phone-input {
  flex: 1;
  min-width: 0;
}

.driver-contacts-card {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #cfe0f3;
  background: #f6f9ff;
}

.driver-contacts-heading,
.driver-contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.driver-contacts-subtitle,
.driver-contact-luggage {
  margin-top: 6rpx;
  color: #6d7880;
  font-size: 23rpx;
  line-height: 1.45;
}

.driver-contacts-retry,
.driver-contact-call {
  flex: 0 0 auto;
  min-width: 112rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  color: #1b5d94;
  background: #ffffff;
  border: 1rpx solid #9fc3e3;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 88rpx;
}

.driver-contacts-retry::after,
.driver-contact-call::after {
  display: none;
}

.driver-contact-state {
  margin-top: 20rpx;
  padding: 24rpx;
  color: #68747b;
  background: #ffffff;
  border-radius: 14rpx;
  font-size: 25rpx;
  text-align: center;
}

.driver-contact-state--error {
  color: #a13c43;
  background: #fff5f5;
}

.driver-contact-list {
  margin-top: 18rpx;
}

.driver-contact-item {
  padding: 22rpx 0;
  border-top: 1rpx solid #dce6ef;
}

.driver-contact-main {
  flex: 1;
  min-width: 0;
}

.driver-contact-name {
  color: #27342d;
  font-size: 28rpx;
  font-weight: 650;
}

.driver-contact-role {
  margin-left: 8rpx;
  color: #5b7182;
  font-size: 22rpx;
  font-weight: 400;
}

.driver-contact-phone {
  display: block;
  margin-top: 8rpx;
  color: #185b91;
  font-size: 31rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.ride-exit-lock-card {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #dfe8e3;
  background: #f7faf8;
}

.detail-skeleton {
  margin-top: 30rpx;
  padding: 32rpx;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 22rpx;
  background: #edf1ef;
  border-radius: 10rpx;
}

.skeleton-line:first-child { margin-top: 0; }
.skeleton-line.short { width: 28%; }
.skeleton-line.title { width: 76%; height: 40rpx; }
.skeleton-line.medium { width: 54%; }
