.detail-page {
  padding-top: 20rpx;
}

.status-strip,
.type-line,
.detail-row,
.state-card,
.consent-row {
  display: flex;
  align-items: center;
}

.status-strip {
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  color: #3e4b44;
  background: #edf4f0;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.detail-card {
  padding: 30rpx 26rpx;
}

.type-line {
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 650;
}

.detail-heading {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
}

.detail-title {
  flex: 1 1 400rpx;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 720;
  line-height: 1.35;
}

.share-chip-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 116rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  color: #118557;
  background: #eef7f2;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.owner-line {
  margin-top: 10rpx;
  color: #728078;
  font-size: 24rpx;
}

.time-card {
  margin: 26rpx 0 10rpx;
  padding: 22rpx;
  background: #f4f8f6;
  border-radius: 16rpx;
}

.time-main {
  font-size: 29rpx;
  font-weight: 650;
}

.time-sub {
  margin-top: 8rpx;
  color: #66736c;
  font-size: 24rpx;
}

.detail-row {
  justify-content: space-between;
  min-height: 72rpx;
  border-bottom: 1rpx solid #edf0ee;
  font-size: 26rpx;
}

.row-label {
  color: #738078;
}

.row-value {
  max-width: 68%;
  color: #26322c;
  font-weight: 560;
  text-align: right;
}

.description-block {
  margin-top: 28rpx;
}

.block-title,
.state-title,
.risk-title,
.lock-title {
  font-size: 28rpx;
  font-weight: 650;
}

.block-text {
  margin-top: 10rpx;
  color: #4f5c55;
  line-height: 1.65;
  white-space: pre-wrap;
}

.locked-card {
  margin-top: 28rpx;
  padding: 22rpx;
  color: #34527a;
  background: #f0f6ff;
  border: 1rpx solid #dce7f7;
  border-radius: 16rpx;
}

.lock-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.risk-card {
  margin-top: 18rpx;
  padding: 22rpx;
  color: #76581f;
  background: #fff8e8;
  border: 1rpx solid #f0ddb3;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.apply-card,
.state-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.apply-note {
  min-height: 140rpx;
  margin-top: 16rpx;
}

.consent-row {
  align-items: flex-start;
  gap: 10rpx;
  margin: 20rpx 0;
  color: #59655e;
  font-size: 24rpx;
  line-height: 1.5;
}

.state-card {
  justify-content: space-between;
  gap: 20rpx;
}

.state-description {
  margin-top: 6rpx;
  color: #6d7972;
  font-size: 24rpx;
}

.compact-button {
  flex: 0 0 auto;
  min-height: 70rpx;
  margin: 0;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
}

.bottom-action {
  margin-top: 22rpx;
}

.unavailable-button {
  min-height: 88rpx;
  color: #6d7972;
  background: #e9edeb;
  font-size: 28rpx;
}

.qa-card {
  margin-top: 22rpx;
  padding: 26rpx;
}

.qa-heading,
.qa-question,
.qa-answer,
.qa-unanswered,
.qa-sheet-heading,
.qa-input-footer {
  display: flex;
  align-items: center;
}

.qa-heading {
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.qa-subtitle {
  margin-top: 6rpx;
  color: #78847d;
  font-size: 24rpx;
  line-height: 1.45;
}

.qa-action {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 22rpx;
  color: #118557;
  background: #eef7f2;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.qa-ask-action {
  flex: 0 0 auto;
}

.qa-local-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 42rpx 20rpx 24rpx;
  color: #6d7972;
  font-size: 25rpx;
  text-align: center;
}

.qa-empty-hint {
  color: #8a958f;
  font-size: 24rpx;
}

.qa-error {
  color: #80555a;
}

.qa-retry-action {
  margin-top: 4rpx;
}

.qa-item {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #edf0ee;
}

.qa-meta,
.qa-responder,
.qa-unanswered,
.qa-limit-hint {
  color: #7b8780;
  font-size: 24rpx;
}

.qa-question,
.qa-answer {
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.qa-answer {
  padding: 18rpx;
  background: #f5f8f6;
  border-radius: 14rpx;
}

.qa-mark {
  flex: 0 0 auto;
  min-width: 38rpx;
  color: #fff;
  background: #66736c;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 38rpx;
  text-align: center;
}

.qa-mark--answer {
  background: #16a36a;
}

.qa-content {
  min-width: 0;
  color: #344139;
  font-size: 27rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.qa-answer-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.qa-unanswered {
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  padding-left: 50rpx;
}

.qa-answer-action {
  min-width: 104rpx;
  flex: 0 0 auto;
}

.qa-toggle {
  min-height: 88rpx;
  margin-top: 12rpx;
  color: #118557;
  background: transparent;
  font-size: 25rpx;
}

.qa-limit-hint {
  text-align: center;
}

.qa-modal {
  position: fixed;
  z-index: 200;
  inset: 0;
}

.qa-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(21, 31, 26, 0.48);
}

.qa-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.qa-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  background: #d9dfdc;
  border-radius: 999rpx;
}

.qa-sheet-heading,
.qa-input-footer {
  justify-content: space-between;
  gap: 20rpx;
}

.qa-sheet-title {
  font-size: 32rpx;
  font-weight: 680;
}

.qa-close {
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 8rpx 12rpx 24rpx;
  color: #69756e;
  background: transparent;
  font-size: 25rpx;
}

.qa-target-question {
  margin-top: 14rpx;
  padding: 18rpx;
  color: #59655e;
  background: #f5f8f6;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-all;
}

.qa-input {
  min-height: 210rpx;
  margin-top: 18rpx;
}

.qa-input-footer {
  margin-top: 18rpx;
  color: #7b8780;
  font-size: 24rpx;
}

.qa-submit {
  min-width: 220rpx;
  margin: 0;
}

.report-link {
  min-height: 76rpx;
  margin-top: 18rpx;
  color: #8a4a4e;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.4;
}

.detail-skeleton {
  margin-top: 30rpx;
  padding: 32rpx;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 22rpx;
  background: #edf1ef;
  border-radius: 10rpx;
}

.skeleton-line:first-child { margin-top: 0; }
.skeleton-line.short { width: 28%; }
.skeleton-line.title { width: 76%; height: 40rpx; }
.skeleton-line.medium { width: 54%; }
