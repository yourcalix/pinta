.leju-progress-mask {
  position: fixed;
  z-index: 1050;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(15, 20, 17, 0);
  opacity: 0;
  pointer-events: none;
  transition: background-color 220ms ease, opacity 220ms ease;
}

.leju-progress-mask--open {
  background: rgba(15, 20, 17, .74);
  opacity: 1;
  pointer-events: auto;
}

.leju-progress-dialog {
  position: relative;
  display: flex;
  width: 84vw;
  max-width: 640rpx;
  max-height: 82vh;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  opacity: 0;
  transform: translate3d(0, 28rpx, 0) scale(.92);
  transform-origin: 50% 54%;
  transition: opacity 200ms ease, transform 220ms ease;
  backface-visibility: hidden;
}

.leju-progress-dialog--open {
  opacity: 1;
  animation: leju-progress-dialog-in 460ms cubic-bezier(.2, .9, .25, 1.1) both;
}

.leju-progress-image {
  display: block;
  width: 100%;
  height: auto;
  flex: 0 0 auto;
  border-radius: 30rpx;
  box-shadow: 0 28rpx 72rpx rgba(0, 0, 0, .46);
  opacity: 0;
  pointer-events: none;
  user-select: none;
  transition: opacity 120ms ease;
}

.leju-progress-image--ready { opacity: 1; }

.leju-progress-caption {
  display: flex;
  min-height: 52rpx;
  margin-top: 28rpx;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .4);
  white-space: nowrap;
}

.leju-progress-caption__text { flex: 0 0 auto; }

.leju-progress-caption__rays {
  position: relative;
  width: 30rpx;
  height: 38rpx;
  flex: 0 0 auto;
  pointer-events: none;
}

.leju-progress-caption__ray {
  position: absolute;
  display: block;
  width: 6rpx;
  border-radius: 999rpx;
  background: #FFCA38;
  box-shadow: 0 2rpx 8rpx rgba(255, 186, 40, .28);
}

.leju-progress-caption__ray--outer { height: 20rpx; }
.leju-progress-caption__ray--inner { height: 14rpx; }

.leju-progress-caption__rays--left .leju-progress-caption__ray--outer {
  left: 2rpx;
  bottom: 2rpx;
  transform: rotate(-56deg);
}

.leju-progress-caption__rays--left .leju-progress-caption__ray--inner {
  right: 4rpx;
  top: 2rpx;
  transform: rotate(-28deg);
}

.leju-progress-caption__rays--right .leju-progress-caption__ray--inner {
  left: 4rpx;
  top: 2rpx;
  transform: rotate(28deg);
}

.leju-progress-caption__rays--right .leju-progress-caption__ray--outer {
  right: 2rpx;
  bottom: 2rpx;
  transform: rotate(56deg);
}

.leju-progress-actions {
  display: flex;
  width: 78%;
  max-width: 500rpx;
  margin-top: 22rpx;
  flex-direction: column;
  align-items: stretch;
  gap: 2rpx;
}

.leju-progress-button {
  display: flex;
  width: 100%;
  flex: 0 0 auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  transition: transform 100ms ease, opacity 100ms ease;
}

.leju-progress-button::after,
.leju-progress-close::after { display: none; }

.leju-progress-button--later {
  color: rgba(255, 253, 248, .8);
  background: transparent;
  border: 0;
  font-size: 26rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .24);
}

.leju-progress-button--collect {
  color: #124A2E;
  min-height: 96rpx;
  border: 2rpx solid rgba(255, 255, 255, .65);
  border-radius: 999rpx;
  background: linear-gradient(180deg, #FFE785 0%, #FFBA2E 52%, #FFA812 100%);
  box-shadow:
    inset 0 3rpx 6rpx rgba(255, 255, 255, .85),
    inset 0 -4rpx 8rpx rgba(204, 115, 0, .35),
    0 12rpx 36rpx rgba(255, 175, 20, .42);
  font-size: 32rpx;
  letter-spacing: 0;
}

.leju-progress-button__spark {
  margin-right: 10rpx;
  color: #124A2E;
  font-size: 28rpx;
  line-height: 1;
}

.leju-progress-button--pressed { transform: scale(.96); opacity: .88; }

.leju-progress-button--collect.leju-progress-button--pressed {
  opacity: 1;
  box-shadow:
    inset 0 2rpx 5rpx rgba(255, 255, 255, .72),
    inset 0 -3rpx 7rpx rgba(204, 115, 0, .3),
    0 7rpx 22rpx rgba(255, 175, 20, .32);
}

.leju-progress-close {
  position: absolute;
  z-index: 2;
  top: -8rpx;
  right: -10rpx;
  display: flex;
  width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: transparent;
  transition: transform 100ms ease, opacity 100ms ease;
}

.leju-progress-close--pressed { transform: scale(.92); opacity: .72; }

.leju-progress-close__surface {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, .38);
  border-radius: 50%;
  background: rgba(255, 255, 255, .16);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .22), inset 0 2rpx 0 rgba(255, 255, 255, .16);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

@keyframes leju-progress-dialog-in {
  0% { opacity: 0; transform: translate3d(0, 28rpx, 0) scale(.92); }
  68% { opacity: 1; transform: translate3d(0, -2rpx, 0) scale(1.02); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@media (max-width: 340px), (max-height: 680px) {
  .leju-progress-mask { padding: 34rpx 24rpx calc(30rpx + env(safe-area-inset-bottom)); }
  .leju-progress-dialog { width: 62vw; max-width: 420rpx; }
  .leju-progress-image { border-radius: 24rpx; }
  .leju-progress-caption { min-height: 42rpx; margin-top: 12rpx; gap: 12rpx; font-size: 30rpx; }
  .leju-progress-caption__rays { width: 24rpx; height: 30rpx; }
  .leju-progress-caption__ray { width: 5rpx; }
  .leju-progress-caption__ray--outer { height: 14rpx; }
  .leju-progress-caption__ray--inner { height: 10rpx; }
  .leju-progress-actions { width: 100%; max-width: 420rpx; margin-top: 10rpx; gap: 0; }
  .leju-progress-button { min-height: 88rpx; padding: 0 10rpx; font-size: 23rpx; }
  .leju-progress-button--collect { min-height: 88rpx; font-size: 28rpx; }
  .leju-progress-button--later { font-size: 24rpx; }
  .leju-progress-close { top: -8rpx; right: -10rpx; }
  .leju-progress-close__surface { width: 62rpx; height: 62rpx; font-size: 32rpx; }
}
