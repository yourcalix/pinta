.group-page {
  padding-top: 22rpx;
}

.loading-block {
  margin-top: 60rpx;
  padding: 50rpx;
  color: #718078;
  text-align: center;
}

.formed-hero {
  padding: 34rpx 28rpx;
  text-align: center;
}

.celebrate {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  color: #fff;
  background: #16a36a;
  border-radius: 30rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.formed-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 720;
}

.formed-description {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.formed-meta {
  margin-top: 10rpx;
  color: #6e7a73;
  font-size: 24rpx;
}

.contact-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title,
.safety-title,
.meeting-title {
  font-size: 29rpx;
  font-weight: 650;
}

.card-description {
  margin-top: 5rpx;
  color: #748078;
  font-size: 23rpx;
}

.contact-locked {
  padding: 34rpx 6rpx 4rpx;
  text-align: center;
}

.lock-symbol {
  color: #5378a7;
  font-size: 50rpx;
}

.lock-copy {
  margin: 12rpx 0 24rpx;
  color: #68756e;
  font-size: 24rpx;
}

.contact-open {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f2f7ff;
  border: 1rpx solid #dce8f8;
  border-radius: 18rpx;
}

.contact-label {
  color: #63738b;
  font-size: 24rpx;
}

.contact-value {
  display: block;
  margin-top: 10rpx;
  color: #1d3556;
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

.member-actions {
  flex: 0 0 auto;
  max-width: 250rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.message-member {
  min-width: 88rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #9fd4b4;
  border-radius: 32rpx;
  background: #e8f6ef;
  color: #11784f;
  font-size: 23rpx;
  line-height: 64rpx;
  font-weight: 700;
}

.message-member::after { display: none; }
.message-member--pressed { opacity: 0.8; transform: scale(0.97); }

.contact-help {
  margin-top: 8rpx;
  color: #6b786f;
  font-size: 24rpx;
  line-height: 1.5;
}

.member-list {
  margin-top: 22rpx;
  border-top: 1rpx solid #edf1ef;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  border-bottom: 1rpx solid #edf1ef;
}

.member-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: #16794f;
  background: #e8f6ef;
  border-radius: 18rpx;
  font-weight: 650;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  color: #1c2a23;
  font-size: 26rpx;
  font-weight: 650;
}

.member-role,
.contact-muted {
  margin-top: 4rpx;
  color: #839088;
  font-size: 22rpx;
}

.contact-value {
  max-width: 230rpx;
  color: #16794f;
  font-size: 23rpx;
  overflow-wrap: anywhere;
  text-align: right;
}

.contact-action {
  width: 100%;
  min-height: 82rpx;
  margin: 24rpx 0 0;
}

.contact-action::after {
  display: none;
}

.copy-button {
  margin-top: 20rpx;
}

.meeting-block {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #dce6f3;
  color: #3e4d61;
  line-height: 1.55;
}

.meeting-title {
  margin-bottom: 8rpx;
}

.meeting-note {
  margin-top: 8rpx;
  color: #5e6e82;
  font-size: 24rpx;
}

.safety-card {
  margin-top: 18rpx;
  padding: 22rpx;
  color: #75561c;
  background: #fff8e8;
  border: 1rpx solid #f0ddb3;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.bottom-action {
  margin-top: 22rpx;
}

.report-link {
  min-height: 76rpx;
  margin-top: 16rpx;
  color: #90464b;
  background: transparent;
  font-size: 25rpx;
  line-height: 1.4;
}
