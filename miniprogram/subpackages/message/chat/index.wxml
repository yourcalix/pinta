<view class="chat-page global-background-host">
  <image class="global-page-background" src="/assets/images/shared/shared-paper-bg.webp" mode="aspectFill" aria-hidden="true" />
  <view class="global-page-background-tint" aria-hidden="true"></view>

  <view wx:if="{{loading}}" class="chat-state">正在打开私信…</view>
  <view wx:elif="{{error}}" class="chat-state" role="alert"><text>{{error}}</text><button bindtap="handleRetry">重新加载</button></view>
  <block wx:else>
    <view class="peer-strip">
      <view class="peer-avatar" aria-hidden="true">{{peerInitial}}</view>
      <view class="peer-copy"><text class="peer-name">{{conversation.peer.nickname}}</text><text class="peer-source">{{conversation.source ? '共同活动：' + conversation.source.title : '一对一私信'}}</text></view>
      <button class="peer-report" bindtap="handleReport" aria-label="举报这段私信">举报</button>
    </view>

    <scroll-view class="message-scroll" scroll-y="true" scroll-into-view="{{scrollIntoView}}" enhanced="true" show-scrollbar="false">
      <view class="older-area">
        <button wx:if="{{hasMore && !loadingOlder}}" bindtap="handleLoadOlder">加载更早消息</button>
        <text wx:elif="{{loadingOlder}}">正在加载…</text>
        <button wx:elif="{{olderError}}" bindtap="handleLoadOlder">{{olderError}}</button>
      </view>
      <view wx:if="{{!messages.length}}" class="chat-empty">还没有消息，说声你好吧</view>
      <view wx:for="{{messages}}" wx:key="id" id="{{item.anchorId}}" class="message-row {{item.isMine ? 'message-row--mine' : ''}}">
        <view class="message-bubble"><text user-select="true">{{item.text}}</text><text class="message-time">{{item.displayTime}}</text></view>
      </view>
      <view class="scroll-spacer"></view>
    </scroll-view>

    <view class="composer">
      <text wx:if="{{!messagingAvailable}}" class="composer-closed">共同活动已结束，历史私信仅供查看</text>
      <textarea
        wx:else
        class="composer-input"
        value="{{text}}"
        maxlength="500"
        auto-height="true"
        adjust-position="true"
        cursor-spacing="20"
        placeholder="输入消息（暂不支持联系方式或外链）"
        bindinput="handleInput"
        aria-label="私信内容"
      />
      <button wx:if="{{messagingAvailable}}" class="send-button" bindtap="handleSend" disabled="{{sending || !canSend}}" hover-class="send-button--pressed">{{sending ? '发送中' : '发送'}}</button>
    </view>
  </block>
</view>
