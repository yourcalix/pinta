page { height: 100%; background: #075aa7; }
.chat-page { position: relative; height: 100vh; overflow: hidden; background: #075aa7; }
.peer-strip { position: relative; z-index: 2; min-height: 90rpx; padding: 14rpx 24rpx; display: flex; align-items: center; background: #fff8ee; border-bottom: 2rpx solid #eadbc7; box-sizing: border-box; }
.peer-avatar { width: 56rpx; height: 56rpx; border-radius: 19rpx 16rpx 20rpx 17rpx; background: #16a36a; color: white; font-size: 27rpx; line-height: 56rpx; font-weight: 700; text-align: center; }
.peer-copy { flex: 1; min-width: 0; margin-left: 15rpx; }
.peer-report { flex: 0 0 auto; min-width: 88rpx; min-height: 64rpx; margin: 0; padding: 0 18rpx; border: 2rpx solid rgba(16,42,67,.18); border-radius: 32rpx; background: rgba(255,248,238,.76); color: #52677a; font-size: 22rpx; line-height: 60rpx; }
.peer-report::after { display: none; }
.peer-name, .peer-source { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.peer-name { color: #102a43; font-size: 28rpx; font-weight: 800; }
.peer-source { margin-top: 2rpx; color: #627d78; font-size: 21rpx; }
.message-scroll { position: relative; z-index: 1; height: calc(100vh - 90rpx - 116rpx - env(safe-area-inset-bottom)); box-sizing: border-box; }
.older-area { min-height: 70rpx; display: flex; align-items: center; justify-content: center; color: rgba(255,248,238,.8); font-size: 22rpx; }
.older-area button { margin: 0; padding: 10rpx 24rpx; border: 0; background: rgba(255,248,238,.18); color: #fff8ee; font-size: 22rpx; line-height: 34rpx; border-radius: 28rpx; }
.older-area button::after { display: none; }
.message-row { display: flex; padding: 9rpx 24rpx; justify-content: flex-start; }
.message-row--mine { justify-content: flex-end; }
.message-bubble { max-width: 72%; padding: 17rpx 20rpx 11rpx; border: 2rpx solid rgba(234,219,199,.95); border-radius: 22rpx 22rpx 22rpx 7rpx; background: #fff8ee; color: #102a43; font-size: 27rpx; line-height: 39rpx; box-shadow: 0 5rpx 12rpx rgba(5,39,85,.13); word-break: break-all; overflow-wrap: anywhere; }
.message-row--mine .message-bubble { border-color: #b4dfc4; border-radius: 22rpx 22rpx 7rpx 22rpx; background: #dff2e7; }
.message-time { display: block; margin-top: 5rpx; color: #82958c; font-size: 18rpx; line-height: 24rpx; text-align: right; }
.chat-empty { padding: 120rpx 40rpx; color: rgba(255,248,238,.78); font-size: 25rpx; text-align: center; }
.scroll-spacer { height: 24rpx; }
.composer { position: fixed; z-index: 3; left: 0; right: 0; bottom: 0; min-height: 116rpx; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); display: flex; align-items: flex-end; gap: 14rpx; background: #fff8ee; border-top: 2rpx solid #eadbc7; box-sizing: border-box; }
.composer-closed { flex: 1; min-height: 72rpx; display: flex; align-items: center; justify-content: center; color: #627d78; font-size: 24rpx; line-height: 34rpx; text-align: center; }
.composer-input { flex: 1; min-width: 0; max-height: 180rpx; min-height: 72rpx; padding: 16rpx 20rpx; border: 2rpx solid #d8d4c9; border-radius: 25rpx 22rpx 24rpx 20rpx; background: #fff; color: #102a43; font-size: 26rpx; line-height: 38rpx; box-sizing: border-box; }
.send-button { flex: 0 0 104rpx; width: 104rpx; min-height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: 36rpx; background: #16a36a; color: #fff; font-size: 25rpx; line-height: 72rpx; font-weight: 700; }
.send-button::after { display: none; }.send-button[disabled] { background: #b9cfc1; color: #f7fbf8; }.send-button--pressed { opacity: .82; transform: scale(.97); }
.chat-state { position: relative; z-index: 2; min-height: 440rpx; padding: 80rpx 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff8ee; font-size: 27rpx; text-align: center; box-sizing: border-box; }
.chat-state button { min-height: 88rpx; margin-top: 24rpx; padding: 0 38rpx; border: 0; border-radius: 44rpx; background: #fff8ee; color: #11784f; font-weight: 700; }.chat-state button::after { display: none; }
