page { height: 100%; background: #075aa7; }
.group-page { display: flex; height: 100vh; flex-direction: column; box-sizing: border-box; color: #111827; }
.group-nav { position: absolute; z-index: 4; top: 0; right: 0; left: 0; background: #fff8ee; border-bottom: 1rpx solid #eadbce; }
.back { position: absolute; bottom: 0; left: 8rpx; width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 0; background: transparent; font-size: 60rpx; line-height: 80rpx; }
.back::after,.retry::after,.older button::after,.send::after { display: none; }
.nav-title { position: absolute; right: 190rpx; bottom: 0; left: 96rpx; overflow: hidden; font-size: 30rpx; font-weight: 700; line-height: 88rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.state { display: flex; z-index: 1; flex: 1; margin: 24rpx; padding: 80rpx 40rpx; align-items: center; justify-content: center; flex-direction: column; border-radius: 28rpx; background: #fff8ee; color: #6b7280; text-align: center; }
.state-title { color: #111827; font-size: 34rpx; font-weight: 750; }.state-copy { margin-top: 16rpx; font-size: 26rpx; }
.retry { min-height: 88rpx; margin-top: 28rpx; padding: 0 40rpx; border: 0; border-radius: 44rpx; background: #18191d; color: #22c55e; font-size: 26rpx; line-height: 88rpx; }
.messages { z-index: 1; flex: 1; width: 100%; height: 0; min-height: 0; }
.older { display: flex; min-height: 72rpx; align-items: center; justify-content: center; color: #9ca3af; font-size: 22rpx; }
.older button { min-height: 64rpx; margin: 0; border: 0; background: transparent; color: #6b7280; font-size: 22rpx; }
.empty { display: flex; padding: 180rpx 40rpx; align-items: center; flex-direction: column; gap: 12rpx; color: #9ca3af; font-size: 25rpx; }.empty-title { color: #374151; font-size: 31rpx; font-weight: 700; }
.message { display: flex; padding: 10rpx 24rpx; align-items: flex-start; gap: 12rpx; }.message.mine { justify-content: flex-end; }
.avatar { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; border-radius: 50%; background: #d1fae5; color: #166534; font-size: 28rpx; font-weight: 700; line-height: 68rpx; text-align: center; }
.message-main { display: flex; max-width: 72%; min-width: 0; flex-direction: column; }.mine .message-main { align-items: flex-end; }
.sender { margin: 0 0 6rpx 6rpx; color: #6b7280; font-size: 21rpx; }
.bubble { padding: 17rpx 21rpx; border-radius: 8rpx 24rpx 24rpx; background: #fff; box-shadow: 0 3rpx 12rpx rgba(0,0,0,.06); font-size: 28rpx; line-height: 1.45; overflow-wrap: anywhere; word-break: break-all; }
.mine .bubble { border-radius: 24rpx 24rpx 8rpx 24rpx; background: #dcfce7; }
.scroll-space { height: 24rpx; }
.composer { z-index: 2; flex: 0 0 auto; min-height: 104rpx; padding: 14rpx 20rpx calc(12rpx + env(safe-area-inset-bottom)); background: #fff8ee; border-top: 1rpx solid #eadbce; box-sizing: border-box; }
.compose-row { display: flex; align-items: flex-end; gap: 14rpx; }.input { flex: 1; min-width: 0; min-height: 72rpx; max-height: 180rpx; padding: 14rpx 20rpx; border-radius: 18rpx; background: #f3f4f6; font-size: 28rpx; line-height: 42rpx; box-sizing: border-box; }
.send { flex: 0 0 116rpx; min-height: 72rpx; margin: 0; padding: 0; border: 0; border-radius: 36rpx; background: #18191d; color: #22c55e; font-size: 25rpx; font-weight: 700; line-height: 72rpx; }.send[disabled] { background: #e5e7eb; color: #9ca3af; }
.hint,.send-error { display: block; margin-top: 8rpx; font-size: 20rpx; }.hint { color: #9ca3af; }.send-error { color: #dc2626; }.readonly { min-height: 76rpx; color: #6b7280; font-size: 25rpx; line-height: 76rpx; text-align: center; }
