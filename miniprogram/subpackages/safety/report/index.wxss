.report-page {
  padding-top: 36rpx;
}

.report-title {
  color: #fff8ee;
  font-size: 40rpx;
  font-weight: 720;
  text-shadow: 0 2rpx 5rpx rgba(7, 35, 70, 0.28);
}

.report-description {
  margin-top: 12rpx;
  color: #e6eef6;
  font-size: 25rpx;
  line-height: 1.6;
  text-shadow: 0 1rpx 3rpx rgba(7, 35, 70, 0.22);
}

.error-banner {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  color: #a72a30;
  background: #fff0f0;
  border-radius: 16rpx;
}

.reason-card,
.description-card {
  margin-top: 24rpx;
  padding: 10rpx 24rpx;
}

.reason-row {
  display: flex;
  align-items: flex-start;
  min-height: 126rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0ee;
}

.reason-row:last-child {
  border-bottom: 0;
}

.reason-row radio {
  margin-top: 4rpx;
  transform: scale(0.9);
}

.reason-copy {
  flex: 1;
  margin-left: 14rpx;
}

.reason-title {
  font-size: 27rpx;
  font-weight: 650;
}

.reason-description {
  margin-top: 7rpx;
  color: #758079;
  font-size: 23rpx;
  line-height: 1.5;
}

.description-card {
  padding-top: 24rpx;
  padding-bottom: 18rpx;
}

.counter {
  margin-top: 8rpx;
  color: #89938e;
  font-size: 22rpx;
  text-align: right;
}

.submit-button {
  margin-top: 26rpx;
}
