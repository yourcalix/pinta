page {
  --brand: #16a36a;
  --brand-dark: #118557;
  --ride: #3478f6;
  --product: #f59e0b;
  --buddy: #7c5cfc;
  --danger: #e5484d;
  --warning: #d97706;
  --text: #18201c;
  --muted: #66716b;
  --line: #e6ebe8;
  --surface: #ffffff;
  --page: #f5f7f6;
  background: #075aa7;
  color: var(--text);
  font-size: 28rpx;
}

.global-background-host {
  position: relative;
  z-index: 0;
  min-height: 100vh;
  background: #075aa7;
}

.global-page-background,
.global-page-background-tint {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
}

.global-page-background {
  z-index: -2;
  opacity: 0.88;
}

.global-page-background-tint {
  z-index: -1;
  transform: translateZ(0);
  background: linear-gradient(180deg, rgba(7, 45, 90, 0.45) 0%, rgba(7, 90, 167, 0.15) 35%, rgba(7, 90, 167, 0.35) 100%);
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.surface {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(25, 54, 40, 0.05);
}

.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 650;
}

.muted {
  color: var(--muted);
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 18rpx 28rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.primary-button {
  background: var(--brand);
  color: #fff;
}

.primary-button[disabled] {
  background: #a9cdbb;
  color: #f4fbf7;
}

.secondary-button {
  background: #eef7f2;
  color: var(--brand-dark);
}

.danger-button {
  background: #fff0f0;
  color: var(--danger);
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.required::after {
  content: ' *';
  color: var(--danger);
}

.input,
.textarea,
.picker-field {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  background: #f8faf9;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  color: var(--text);
}

.textarea {
  min-height: 180rpx;
}

.safe-bottom {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
