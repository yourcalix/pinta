<view class="tab-shell {{hidden ? 'tab-shell--hidden' : ''}}" role="tablist" aria-label="主导航">
  <view class="tab-paper" aria-hidden="true"></view>
  <view class="tab-row">
    <view
      wx:for="{{items}}"
      wx:key="pagePath"
      class="tab-item {{item.publish ? 'tab-item--publish' : ''}} {{selected === index ? 'tab-item--selected' : ''}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
      hover-class="tab-item--pressed"
      hover-stay-time="80"
      role="tab"
      aria-selected="{{selected === index}}"
      aria-label="{{item.message && unread ? item.text + '，' + unreadLabel + '条未读' : item.publish ? '发布新拼单' : item.text}}"
    >
      <block wx:if="{{item.publish}}">
        <view class="publish-circle" aria-hidden="true"><image class="publish-plus-image" src="{{item.iconSrc}}" mode="aspectFit" /></view>
        <text class="publish-label">发布</text>
      </block>
      <block wx:else>
        <image class="tab-icon-image" src="{{item.iconSrc}}" mode="aspectFit" aria-hidden="true" />
        <view wx:if="{{item.message && unread}}" class="unread-badge" aria-hidden="true">{{unreadLabel}}</view>
        <text class="tab-label">{{item.text}}</text>
        <view class="tab-selected-dot {{selected === index ? '' : 'tab-selected-dot--hidden'}}" aria-hidden="true"></view>
      </block>
    </view>
  </view>
</view>
