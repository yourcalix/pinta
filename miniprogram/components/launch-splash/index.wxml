<view
  class="launch-splash {{exiting ? 'launch-splash--exiting' : ''}}"
  aria-role="alert"
  aria-label="拼吧正在加载，请稍候"
  catchtouchmove="preventTouchMove"
>
  <image
    class="launch-splash__image"
    src="../../assets/images/launch/macau-companion-launch.jpg"
    mode="aspectFill"
    data-asset="macau-companion-launch"
    aria-hidden="true"
    binderror="handleAssetError"
  />
</view>
