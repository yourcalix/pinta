.launch-splash {
  position: fixed;
  z-index: 9999;
  inset: 0;
  overflow: hidden;
  background-color: #f7ba3e;
  opacity: 1;
  will-change: opacity;
}

.launch-splash--exiting {
  opacity: 0;
  pointer-events: none;
  transition: opacity 300ms ease-out;
}

.launch-splash__image {
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
