.launch-splash {
  position: fixed;
  z-index: 9999;
  inset: 0;
  overflow: hidden;
  background: #fff;
  opacity: 1;
}

.launch-splash--exiting {
  opacity: 0;
  transition: opacity 500ms ease-out;
}

.launch-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.launch-progress-card {
  position: absolute;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  left: 50%;
  box-sizing: border-box;
  width: 520rpx;
  max-width: 86vw;
  padding: 24rpx 28rpx 32rpx;
  color: #e7f8f0;
  background: rgba(18, 22, 28, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.38);
  transform: translateX(-50%);
}

.launch-progress-copy {
  display: block;
  margin-bottom: 18rpx;
  color: #d9e7e0;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.launch-track-container {
  position: relative;
  width: 460rpx;
  height: 156rpx;
  margin: 0 auto;
}

.launch-groove {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.5));
}

.launch-cube-slot {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  transform-origin: 50% 100%;
  pointer-events: none;
}

.launch-cube {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.launch-cube--active {
  animation: launch-cube-drop 360ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes launch-cube-drop {
  0% {
    opacity: 0;
    transform: translateY(-80rpx);
  }
  67% {
    opacity: 1;
    transform: translateY(3rpx) scaleY(0.92);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scaleY(1);
  }
}
