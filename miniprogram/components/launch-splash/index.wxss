.launch-splash {
  position: fixed;
  z-index: 9999;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 38%, rgba(137, 238, 181, 0.22), rgba(245, 250, 247, 0) 38%),
    linear-gradient(180deg, #fbfdfc 0%, #f5faf7 100%);
  opacity: 1;
}

.launch-splash--exiting {
  opacity: 0;
  transition: opacity 300ms ease-out;
}

.launch-content {
  position: absolute;
  top: 24vh;
  right: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.launch-puzzle-scene {
  position: relative;
  width: 78vw;
  height: 78vw;
  min-width: 420rpx;
  min-height: 420rpx;
  max-width: 580rpx;
  max-height: 580rpx;
}

.launch-puzzle-scene--complete {
  animation: launch-puzzle-lock 300ms ease-out 350ms both;
}

.launch-piece-drop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-120rpx);
  transform-origin: center bottom;
  will-change: opacity, transform;
}

.launch-piece-drop--top-left {
  z-index: 4;
}

.launch-piece-drop--top-right {
  z-index: 5;
}

.launch-piece-drop--bottom-left {
  z-index: 2;
}

.launch-piece-drop--bottom-right {
  z-index: 3;
}

.launch-piece-drop--active {
  animation: launch-piece-drop 350ms cubic-bezier(0.2, 0.82, 0.25, 1) both;
}

.launch-piece-drop--waiting {
  opacity: 0.78;
  animation: launch-piece-wait 1200ms ease-in-out infinite;
}

.launch-piece-static,
.launch-piece-image {
  display: block;
  width: 100%;
  height: 100%;
}

.launch-piece-image {
  transform: translateZ(0);
}

.launch-title {
  display: block;
  margin-top: 60rpx;
  color: #163a2b;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.launch-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #587a6c;
  font-size: 28rpx;
  line-height: 1.45;
  letter-spacing: 2rpx;
  text-align: center;
}

.launch-progress-segments {
  display: flex;
  gap: 16rpx;
  margin-top: 52rpx;
}

.launch-progress-segment {
  width: 76rpx;
  height: 14rpx;
  background: #d3e0d8;
  border-radius: 999rpx;
  transition: background-color 180ms ease-out, opacity 180ms ease-out;
}

.launch-progress-segment--1.launch-progress-segment--active {
  background: #16a36a;
}

.launch-progress-segment--2.launch-progress-segment--active {
  background: #2ebd85;
}

.launch-progress-segment--3.launch-progress-segment--active {
  background: #5cd19e;
}

.launch-progress-segment--4.launch-progress-segment--active {
  background: #8ee3b8;
}

.launch-progress-segment--waiting {
  animation: launch-segment-wait 1200ms ease-in-out infinite;
}

@keyframes launch-piece-drop {
  0% {
    opacity: 0;
    transform: translateY(-120rpx) scale(0.96);
  }
  72% {
    opacity: 1;
    transform: translateY(5rpx) scale(1.01, 0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes launch-piece-wait {
  0%, 100% {
    opacity: 0.55;
    transform: translateY(-104rpx);
  }
  50% {
    opacity: 0.82;
    transform: translateY(-96rpx);
  }
}

@keyframes launch-puzzle-lock {
  0%, 100% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.025, 0.985);
  }
}

@keyframes launch-segment-wait {
  0%, 100% { opacity: 0.38; }
  50% { opacity: 0.78; }
}

@keyframes launch-piece-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (max-height: 700px) {
  .launch-content {
    top: 17vh;
  }

  .launch-puzzle-scene {
    width: 75vw;
    height: 75vw;
    min-width: 380rpx;
    min-height: 380rpx;
    max-width: 520rpx;
    max-height: 520rpx;
  }

  .launch-title {
    margin-top: 36rpx;
  }

  .launch-progress-segments {
    margin-top: 30rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .launch-piece-drop--active {
    animation: launch-piece-fade 180ms ease-out both;
  }

  .launch-piece-drop--waiting,
  .launch-progress-segment--waiting,
  .launch-puzzle-scene--complete {
    animation: none;
  }
}
