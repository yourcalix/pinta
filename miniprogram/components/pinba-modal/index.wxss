.pinba-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 12000;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 150rpx 40rpx calc(96rpx + env(safe-area-inset-bottom));
  background: rgba(20, 27, 24, 0);
  opacity: 0;
  transition: background-color 220ms ease, opacity 220ms ease;
}

.pinba-modal-mask--open {
  background: rgba(20, 27, 24, 0.42);
  opacity: 1;
}

.pinba-modal-card {
  position: relative;
  width: 620rpx;
  max-width: calc(100vw - 80rpx);
  max-height: calc(100vh - 260rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding: 182rpx 44rpx 40rpx;
  border: 1rpx solid rgba(116, 128, 120, 0.12);
  border-radius: 40rpx;
  background: #FFFDF8;
  box-shadow: 0 30rpx 80rpx rgba(39, 49, 44, 0.2);
  opacity: 0;
  transform: translate3d(0, 10rpx, 0) scale(0.96);
  transform-origin: 50% 55%;
  transition: opacity 210ms ease, transform 210ms ease;
  backface-visibility: hidden;
  overflow: visible;
}

.pinba-modal-card--open {
  opacity: 1;
  animation: pinba-modal-card-in 360ms cubic-bezier(.2, .76, .24, 1) both;
}

.pinba-modal-art {
  position: absolute;
  top: -104rpx;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  opacity: 0;
  transform: translate3d(-50%, 20rpx, 0) scale(.92);
  transform-origin: center;
  pointer-events: none;
  user-select: none;
  backface-visibility: hidden;
}

.pinba-modal-art--open {
  opacity: 1;
  animation: pinba-modal-art-in 480ms cubic-bezier(.2, .76, .24, 1) both;
}

.pinba-modal-content {
  width: 100%;
  max-height: 36vh;
  text-align: center;
}

.pinba-modal-title,
.pinba-modal-description {
  display: block;
  overflow-wrap: anywhere;
}

.pinba-modal-title {
  color: #27312C;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.pinba-modal-description {
  margin-top: 20rpx;
  color: #748078;
  font-size: 27rpx;
  line-height: 1.6;
}

.pinba-modal-actions {
  display: flex;
  width: 100%;
  margin-top: 34rpx;
  gap: 18rpx;
}

.pinba-modal-button {
  position: relative;
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 26rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1;
  transition: transform 100ms ease, opacity 100ms ease;
  white-space: nowrap;
}

.pinba-modal-button::after {
  display: none;
}

.pinba-modal-button--primary {
  color: #FFFFFF;
  background: #16A36A;
  box-shadow: 0 10rpx 24rpx rgba(22, 163, 106, 0.2);
}

.pinba-modal-button--secondary {
  color: #59655F;
  background: #F2F5F3;
}

.pinba-modal-button--danger {
  color: #D9685E;
  background: #FFF1EF;
  box-shadow: none;
}

.pinba-modal-button--pressed {
  transform: scale(.97);
  opacity: .86;
}

.pinba-modal-button--loading .pinba-modal-button-label {
  opacity: 0;
}

.pinba-modal-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.pinba-modal-loading view {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  animation: pinba-modal-loading-dot 900ms ease-in-out infinite;
}

.pinba-modal-loading view:nth-child(2) { animation-delay: 120ms; }
.pinba-modal-loading view:nth-child(3) { animation-delay: 240ms; }

@keyframes pinba-modal-card-in {
  0% { opacity: 0; transform: translate3d(0, 14rpx, 0) scale(.92); }
  68% { opacity: 1; transform: translate3d(0, -2rpx, 0) scale(1.02); }
  100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes pinba-modal-art-in {
  0% { opacity: 0; transform: translate3d(-50%, 20rpx, 0) scale(.92); }
  70% { opacity: 1; transform: translate3d(-50%, -5rpx, 0) scale(1.03); }
  100% { opacity: 1; transform: translate3d(-50%, 0, 0) scale(1); }
}

@keyframes pinba-modal-loading-dot {
  0%, 70%, 100% { transform: translateY(0); opacity: .48; }
  35% { transform: translateY(-5rpx); opacity: 1; }
}

@media (max-width: 340px), (max-height: 620px) {
  .pinba-modal-mask {
    padding: 128rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));
  }

  .pinba-modal-card {
    width: 620rpx;
    max-width: calc(100vw - 72rpx);
    max-height: calc(100vh - 206rpx - env(safe-area-inset-bottom));
    padding: 150rpx 34rpx 32rpx;
    border-radius: 34rpx;
  }

  .pinba-modal-art {
    top: -90rpx;
    width: 240rpx;
    height: 240rpx;
  }

  .pinba-modal-content { max-height: 30vh; }
  .pinba-modal-title { font-size: 34rpx; }
  .pinba-modal-description { margin-top: 14rpx; font-size: 25rpx; }
  .pinba-modal-actions { margin-top: 26rpx; gap: 16rpx; }
  .pinba-modal-button { padding: 0 16rpx; font-size: 26rpx; }
}
