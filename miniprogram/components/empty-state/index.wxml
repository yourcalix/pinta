<view class="pinba-empty-state pinba-empty-state--{{resolvedSize}} custom-class {{animation ? 'pinba-empty-state--animated' : ''}}" role="group" aria-label="{{title}}{{description ? '，' + description : ''}}">
  <image class="pinba-empty-state__image" src="{{imageSrc}}" mode="aspectFit" lazy-load="{{lazyLoad}}" aria-hidden="{{imageAriaLabel ? false : true}}" aria-label="{{imageAriaLabel}}" />
  <view wx:if="{{title}}" class="pinba-empty-state__title" aria-hidden="true">{{title}}</view>
  <view wx:if="{{description}}" class="pinba-empty-state__description" aria-hidden="true">{{description}}</view>
  <button wx:if="{{showButton && resolvedButtonText}}" class="pinba-empty-state__button {{loading ? 'pinba-empty-state__button--loading' : ''}} {{disabled ? 'pinba-empty-state__button--disabled' : ''}}" hover-class="pinba-empty-state__button--pressed" hover-stay-time="70" bindtap="handleAction" aria-disabled="{{disabled || loading}}" aria-label="{{loading ? resolvedButtonText + '，处理中' : resolvedButtonText}}">
    <view wx:if="{{loading}}" class="pinba-empty-state__spinner" aria-hidden="true"></view>
    <text aria-hidden="true">{{resolvedButtonText}}</text>
  </button>
  <view class="pinba-empty-state__footer"><slot name="footer"></slot></view>
</view>
