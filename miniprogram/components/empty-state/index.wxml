<view class="empty-state">
  <view class="empty-symbol">{{symbol}}</view>
  <view class="empty-title">{{title}}</view>
  <view class="empty-description" wx:if="{{description}}">{{description}}</view>
  <button wx:if="{{actionText}}" class="empty-action" bindtap="handleAction">{{actionText}}</button>
</view>
