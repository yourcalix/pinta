.activity-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx 22rpx 30rpx;
  overflow: hidden;
  background: #fff8ee;
  border: 3rpx solid rgba(255, 240, 201, 0.92);
  border-radius: 29rpx 25rpx 31rpx 27rpx;
  box-shadow: 0 10rpx 0 rgba(4, 48, 104, 0.2), 0 18rpx 32rpx rgba(3, 41, 91, 0.18);
  transform: translateZ(0);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.activity-card--pressed {
  box-shadow: 0 5rpx 0 rgba(4, 48, 104, 0.22), 0 10rpx 18rpx rgba(3, 41, 91, 0.16);
  transform: translateY(4rpx) scale(0.993);
}

.activity-card::before {
  content: '';
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 8rpx;
  background: #129b69;
  border-radius: 0 7rpx 7rpx 0;
}

.activity-card--companion::before { background: #167fb1; }
.activity-card--sport::before { background: #6655b4; }
.activity-card--food::before { background: #d8662e; }

.card-head,
.card-tags,
.type-tag,
.meta-item,
.card-footer,
.owner-line,
.capacity-link {
  display: flex;
  align-items: center;
}

.card-head { justify-content: space-between; flex-wrap: wrap; gap: 10rpx 16rpx; }
.card-tags { min-width: 0; flex-wrap: wrap; gap: 8rpx; }

.type-tag {
  gap: 8rpx;
  padding: 7rpx 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 15rpx 13rpx 16rpx 12rpx;
  font-size: 23rpx;
  font-weight: 720;
}

.type-tag--companion { color: #176c97; background: #dff3ef; }
.type-tag--sport { color: #55439f; background: #ece7f7; }
.type-tag--food { color: #b45123; background: #ffead8; }
.type-symbol { font-size: 23rpx; }

.legacy-tag {
  padding: 7rpx 13rpx;
  color: #65675f;
  background: #eee7dc;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.activity-title {
  margin-top: 16rpx;
  color: #102a43;
  font-size: 31rpx;
  font-weight: 760;
  line-height: 1.35;
  word-break: break-all;
}

.meta-list { margin-top: 14rpx; }

.meta-item {
  gap: 10rpx;
  min-width: 0;
  margin-top: 8rpx;
  color: #596975;
  font-size: 23rpx;
  line-height: 1.4;
}

.meta-item:first-child { margin-top: 0; }
.meta-icon { flex: 0 0 30rpx; width: 30rpx; color: #187c69; text-align: center; }
.meta-text { min-width: 0; word-break: break-all; }

.member-progress {
  height: 8rpx;
  margin-top: 17rpx;
  overflow: hidden;
  background: #e5d9ca;
  border-radius: 8rpx;
}

.member-progress-fill { height: 100%; background: #129b69; border-radius: inherit; }
.member-progress-fill--companion { background: #167fb1; }
.member-progress-fill--sport { background: #6655b4; }
.member-progress-fill--food { background: #d8662e; }

.card-footer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 2rpx dashed #dfd1c0;
}

.owner-line { min-width: 0; gap: 10rpx; color: #56646d; font-size: 22rpx; }

.owner-avatar {
  display: flex;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  overflow: hidden;
  color: #fff8ee;
  background: #16835c;
  border: 2rpx solid #0e6949;
  border-radius: 48% 52% 46% 54%;
  font-size: 21rpx;
  font-weight: 700;
}

.owner-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.capacity-link {
  flex-shrink: 0;
  gap: 8rpx;
  color: #137d58;
  font-size: 23rpx;
  font-weight: 700;
}

.capacity-arrow { font-size: 34rpx; line-height: 1; }

@media (max-width: 340px) {
  .activity-card { padding-right: 22rpx; padding-left: 26rpx; }
  .activity-title { font-size: 29rpx; }
  .owner-name { max-width: 180rpx; }
}

/* Opt-in discovery layout. The compact personal-center card stays unchanged. */
.activity-card--discover {
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  min-height: 390rpx;
  margin-bottom: 18rpx;
  padding: 0;
  background: #fff;
  border: 1.5rpx solid #edf2f7;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
}
.activity-card--discover.activity-card--pressed { background: #f9fafb; box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.05); transform: scale(0.995); }
.activity-card--discover::before { display: none; }
.activity-card--discover .card-cover {
  position: relative;
  isolation: isolate;
  flex: 0 0 46%;
  width: 46%;
  min-height: 390rpx;
  overflow: hidden;
  background: #f6f7f9;
  border-radius: 21rpx 0 0 21rpx;
  pointer-events: none;
}
.activity-card--discover .card-cover--companion { background: linear-gradient(150deg, #d9ecff 0%, #b9d9f3 52%, #70a8d1 100%); }
.activity-card--discover .card-cover--sport { background: linear-gradient(150deg, #ebe7ff 0%, #d8d0f1 52%, #8379bd 100%); }
.activity-card--discover .card-cover--food { background: linear-gradient(150deg, #fff0dd 0%, #f7d5b8 52%, #d88c61 100%); }
.activity-card--discover .card-cover-image {
  position: absolute;
  z-index: 0;
  top: 46rpx;
  left: 50%;
  display: block;
  width: 230rpx;
  height: 230rpx;
  pointer-events: none;
  transform: translateX(-50%);
}
.card-cover-fallback {
  position: absolute;
  z-index: 0;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #63746c;
  font-size: 24rpx;
}
.cover-fallback-symbol { font-size: 64rpx; color: #16835c; }
.card-cover-type {
  position: absolute;
  z-index: 3;
  top: 16rpx;
  left: 16rpx;
  max-width: calc(100% - 32rpx);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 36rpx;
  padding: 0 12rpx;
  overflow: hidden;
  color: #0f172a;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-cover-scrim {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  left: 0;
  height: 52%;
  background: linear-gradient(180deg, rgba(6, 23, 42, 0) 0%, rgba(6, 23, 42, 0.45) 45%, rgba(6, 23, 42, 0.85) 100%);
}
.card-cover-footer {
  position: absolute;
  z-index: 2;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.cover-capacity {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 4rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 6rpx rgba(6, 23, 42, 0.48);
  white-space: nowrap;
}
.activity-card--discover .card-copy {
  display: flex;
  flex: 0 0 54%;
  width: 54%;
  min-width: 0;
  flex-direction: column;
  box-sizing: border-box;
  padding: 22rpx 20rpx 20rpx;
}
.editorial-date-row,
.editorial-date-block,
.editorial-date-meta {
  display: flex;
  align-items: center;
}
.editorial-date-row { justify-content: space-between; gap: 12rpx; }
.editorial-date-block { min-width: 0; gap: 10rpx; }
.editorial-date {
  flex-shrink: 0;
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
  line-height: 1;
}
.editorial-date-meta {
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.15;
  white-space: nowrap;
}
.editorial-status { flex-shrink: 0; }
.activity-card--discover .activity-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 14rpx;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.36;
  overflow-wrap: anywhere;
}
.archive-prefix { font-size: 24rpx; color: #65675f; font-weight: 500; }
.activity-card--discover .meta-item { gap: 6rpx; color: #64748b; font-size: 24rpx; font-weight: 500; }
.activity-card--discover .editorial-place { margin-top: 12rpx; }
.activity-card--discover .meta-icon { flex-basis: 24rpx; width: 24rpx; }
.activity-card--discover .meta-text { flex: 1; }
.activity-card--discover .meta-text--place { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.activity-card--discover .owner-line {
  min-width: 0;
  margin-top: 10rpx;
  gap: 8rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 600;
}
.activity-card--discover .owner-avatar,
.owner-avatar-image {
  display: block;
  flex: 0 0 32rpx;
  box-sizing: border-box;
  width: 32rpx;
  height: 32rpx;
  border: 1.5rpx solid #e5e7eb;
  border-radius: 50%;
  background: #f5f6f8;
}
.activity-card--discover .owner-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #16835c;
  font-size: 20rpx;
  font-weight: 700;
}
.owner-avatar-image { overflow: hidden; }
.owner-name { min-width: 0; }
.owner-role { flex-shrink: 0; color: #94a3b8; font-size: 24rpx; font-weight: 600; }
.activity-description {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  overflow: hidden;
  color: #475569;
  background: #f8fafc;
  border: 1rpx solid #edf1f5;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.42;
  overflow-wrap: anywhere;
}
.description-mark { margin-right: 4rpx; color: #16a36a; font-size: 30rpx; font-weight: 800; }
.member-avatar-group { display: flex; align-items: center; flex-shrink: 0; pointer-events: none; }
.member-avatar-slot { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 2rpx solid #fff; border-radius: 50%; background: #f5f6f8; }
.member-avatar-slot + .member-avatar-slot { margin-left: -10rpx; }
.member-avatar-slot image { display: block; width: 100%; height: 100%; border-radius: 50%; pointer-events: none; }
.member-avatar-slot--empty { border: 2rpx dashed #d8dde3; background: #f6f7f9; color: #9ca3af; }
.member-avatar-slot--filled { animation: member-avatar-enter 220ms ease-out both; }
.member-avatar-more { margin-left: 6rpx; color: #fff; font-size: 24rpx; font-weight: 700; text-shadow: 0 2rpx 6rpx rgba(6, 23, 42, 0.48); white-space: nowrap; }
.activity-card--discover.activity-card--large-text { align-items: flex-start; flex-direction: column; }
.activity-card--large-text .card-cover { flex-basis: auto; width: 100%; min-height: 260rpx; border-radius: 23rpx 23rpx 0 0; }
.activity-card--large-text .card-copy { flex-basis: auto; width: 100%; }
.activity-card--large-text .activity-title { display: block; -webkit-line-clamp: unset; overflow: visible; }
.activity-card--large-text .activity-description { display: block; -webkit-line-clamp: unset; overflow: visible; }
.activity-card--large-text .meta-text--place { white-space: normal; overflow: visible; }
.activity-card--large-text .owner-line { flex-basis: 100%; }
.activity-card--large-text .owner-name { white-space: normal; overflow-wrap: anywhere; }
@media (max-width: 340px) {
  .activity-card--discover { min-height: 350rpx; margin-bottom: 14rpx; border-radius: 18rpx; }
  .activity-card--discover .card-cover { flex-basis: 43%; width: 43%; min-height: 350rpx; border-radius: 17rpx 0 0 17rpx; }
  .activity-card--discover .card-cover-image { top: 38rpx; width: 190rpx; height: 190rpx; }
  .activity-card--discover .card-copy { flex-basis: 57%; width: 57%; padding: 16rpx 16rpx 14rpx; }
  .editorial-date { font-size: 32rpx; }
  .editorial-date-block { gap: 7rpx; }
  .activity-card--discover .activity-title { margin-top: 10rpx; font-size: 28rpx; line-height: 1.32; }
  .activity-card--discover .editorial-place,
  .activity-card--discover .owner-line,
  .activity-description { margin-top: 8rpx; }
  .member-avatar-slot { width: 30rpx; height: 30rpx; }
  .member-avatar-slot + .member-avatar-slot { margin-left: -8rpx; }
  .activity-card--discover .owner-avatar,
  .owner-avatar-image { flex-basis: 28rpx; width: 28rpx; height: 28rpx; }
  .activity-description { padding: 6rpx 10rpx; }
  .activity-card--large-text .card-cover { width: 100%; min-height: 250rpx; border-radius: 19rpx 19rpx 0 0; }
}

@keyframes member-avatar-enter {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .member-avatar-slot--filled { animation: none; }
}
