.activity-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx 22rpx 30rpx;
  overflow: hidden;
  background: #fff8ee;
  border: 3rpx solid rgba(255, 240, 201, 0.92);
  border-radius: 29rpx 25rpx 31rpx 27rpx;
  box-shadow: 0 10rpx 0 rgba(4, 48, 104, 0.2), 0 18rpx 32rpx rgba(3, 41, 91, 0.18);
  transform: translateZ(0);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

.activity-card--pressed {
  box-shadow: 0 5rpx 0 rgba(4, 48, 104, 0.22), 0 10rpx 18rpx rgba(3, 41, 91, 0.16);
  transform: translateY(4rpx) scale(0.993);
}

.activity-card::before {
  content: '';
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 8rpx;
  background: #129b69;
  border-radius: 0 7rpx 7rpx 0;
}

.activity-card--companion::before { background: #167fb1; }
.activity-card--sport::before { background: #6655b4; }
.activity-card--food::before { background: #d8662e; }

.card-head,
.card-tags,
.type-tag,
.meta-item,
.card-footer,
.owner-line,
.capacity-link {
  display: flex;
  align-items: center;
}

.card-head { justify-content: space-between; flex-wrap: wrap; gap: 10rpx 16rpx; }
.card-tags { min-width: 0; flex-wrap: wrap; gap: 8rpx; }

.type-tag {
  gap: 8rpx;
  padding: 7rpx 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 15rpx 13rpx 16rpx 12rpx;
  font-size: 23rpx;
  font-weight: 720;
}

.type-tag--companion { color: #176c97; background: #dff3ef; }
.type-tag--sport { color: #55439f; background: #ece7f7; }
.type-tag--food { color: #b45123; background: #ffead8; }
.type-symbol { font-size: 23rpx; }

.legacy-tag {
  padding: 7rpx 13rpx;
  color: #65675f;
  background: #eee7dc;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.activity-title {
  margin-top: 16rpx;
  color: #102a43;
  font-size: 31rpx;
  font-weight: 760;
  line-height: 1.35;
  word-break: break-all;
}

.meta-list { margin-top: 14rpx; }

.meta-item {
  gap: 10rpx;
  min-width: 0;
  margin-top: 8rpx;
  color: #596975;
  font-size: 23rpx;
  line-height: 1.4;
}

.meta-item:first-child { margin-top: 0; }
.meta-icon { flex: 0 0 30rpx; width: 30rpx; color: #187c69; text-align: center; }
.meta-text { min-width: 0; word-break: break-all; }

.member-progress {
  height: 8rpx;
  margin-top: 17rpx;
  overflow: hidden;
  background: #e5d9ca;
  border-radius: 8rpx;
}

.member-progress-fill { height: 100%; background: #129b69; border-radius: inherit; }
.member-progress-fill--companion { background: #167fb1; }
.member-progress-fill--sport { background: #6655b4; }
.member-progress-fill--food { background: #d8662e; }

.card-footer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 2rpx dashed #dfd1c0;
}

.owner-line { min-width: 0; gap: 10rpx; color: #56646d; font-size: 22rpx; }

.owner-avatar {
  display: flex;
  flex: 0 0 42rpx;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  overflow: hidden;
  color: #fff8ee;
  background: #16835c;
  border: 2rpx solid #0e6949;
  border-radius: 48% 52% 46% 54%;
  font-size: 21rpx;
  font-weight: 700;
}

.owner-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.capacity-link {
  flex-shrink: 0;
  gap: 8rpx;
  color: #137d58;
  font-size: 23rpx;
  font-weight: 700;
}

.capacity-arrow { font-size: 34rpx; line-height: 1; }

@media (max-width: 340px) {
  .activity-card { padding-right: 22rpx; padding-left: 26rpx; }
  .activity-title { font-size: 29rpx; }
  .owner-name { max-width: 180rpx; }
}

/* Opt-in discovery layout. The compact personal-center card stays unchanged. */
.activity-card--discover {
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  min-height: 300rpx;
  padding: 18rpx;
}
.activity-card--discover::before { display: none; }
.card-cover {
  position: relative;
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 254rpx;
  overflow: hidden;
  background: #eee9df;
  border-radius: 20rpx 17rpx 22rpx 18rpx;
  pointer-events: none;
}
.card-cover--companion { background: #edf4fd; }
.card-cover--sport { background: #f1effb; }
.card-cover--food { background: #fff3e9; }
.card-cover-image { display: block; width: 100%; height: 100%; pointer-events: none; }
.card-cover-fallback {
  display: flex;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #63746c;
  font-size: 24rpx;
}
.cover-fallback-symbol { font-size: 64rpx; color: #16835c; }
.card-copy { flex: 1; min-width: 0; }
.activity-card--discover .card-head { gap: 8rpx; }
.activity-card--discover .type-tag { padding: 5rpx 10rpx; font-size: 24rpx; }
.activity-card--discover .activity-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.35;
  overflow-wrap: anywhere;
}
.archive-prefix { font-size: 24rpx; color: #65675f; font-weight: 500; }
.activity-card--discover .meta-list { margin-top: 12rpx; }
.activity-card--discover .meta-item { gap: 6rpx; font-size: 24rpx; }
.activity-card--discover .meta-icon { flex-basis: 24rpx; width: 24rpx; }
.activity-card--discover .meta-text { flex: 1; }
.activity-card--discover .meta-text--place { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.activity-card--discover .card-footer { margin-top: 14rpx; padding-top: 0; border-top: 0; gap: 8rpx; flex-wrap: wrap; }
.activity-card--discover .owner-line { flex: 1; gap: 8rpx; font-size: 24rpx; }
.activity-card--discover .owner-avatar { flex-basis: 32rpx; width: 32rpx; height: 32rpx; font-size: 20rpx; }
.activity-card--discover .capacity-link {
  margin-left: auto;
  font-size: 24rpx;
  transform-origin: right center;
  animation: capacity-progress-enter 560ms cubic-bezier(0.2, 0.8, 0.2, 1) 180ms both;
}
.activity-card--discover .capacity-arrow { animation: capacity-arrow-nudge 700ms ease-out 300ms both; }
.activity-card--discover.activity-card--large-text { align-items: flex-start; }
.activity-card--large-text .activity-title { display: block; -webkit-line-clamp: unset; overflow: visible; }
.activity-card--large-text .meta-text--place { white-space: normal; overflow: visible; }
.activity-card--large-text .owner-line { flex-basis: 100%; }
.activity-card--large-text .owner-name { white-space: normal; overflow-wrap: anywhere; }
@media (max-width: 340px) {
  .activity-card--discover { gap: 16rpx; padding: 16rpx; }
  .card-cover { flex-basis: 170rpx; width: 170rpx; height: 230rpx; }
  .activity-card--discover .activity-title { font-size: 30rpx; }
}

@keyframes capacity-progress-enter {
  0% { opacity: 0.5; transform: translateY(4rpx) scale(0.94); }
  68% { opacity: 1; transform: translateY(-1rpx) scale(1.04); }
  100% { opacity: 1; transform: none; }
}
@keyframes capacity-arrow-nudge {
  0%, 52%, 100% { transform: translateX(0); }
  76% { transform: translateX(4rpx); }
}

@media (prefers-reduced-motion: reduce) {
  .activity-card--discover .capacity-link,
  .activity-card--discover .capacity-arrow { animation: none; }
}
