<view wx:if="{{item && variant === 'home-preview'}}" class="activity-card activity-card--home-preview activity-card--{{item.typeTone}} {{largeText ? 'activity-card--large-text' : ''}}" bindtap="handleTap" hover-class="activity-card--pressed" hover-stay-time="80" role="button" aria-label="{{item.accessibilityLabel}}">
  <view class="home-preview-owner" aria-hidden="true">
    <image wx:if="{{ownerAvatar && !ownerAvatar.empty}}" class="home-preview-owner-avatar" src="{{ownerAvatar.src}}" mode="{{ownerAvatar.mode}}" data-slot-id="{{ownerAvatar.id}}" data-src="{{ownerAvatar.src}}" lazy-load="{{true}}" binderror="handleOwnerAvatarError" />
    <view wx:else class="home-preview-owner-avatar home-preview-owner-avatar--fallback">{{item.ownerInitial}}</view>
    <text class="home-preview-owner-name">{{item.ownerNickname}}</text>
    <text class="home-preview-time">{{item.editorialDate}}</text>
  </view>
  <view class="home-preview-title" aria-hidden="true"><text wx:if="{{item.legacy && item.legacy.readOnly}}" class="home-preview-archive-prefix">历史 · </text>{{item.title}}</view>
  <view class="home-preview-cover home-preview-cover--{{item.typeTone}}" aria-hidden="true">
    <image wx:if="{{coverSrc && !coverFailed}}" class="home-preview-cover-image" src="{{coverSrc}}" data-src="{{coverSrc}}" mode="aspectFit" lazy-load="{{true}}" binderror="handleCoverError" />
    <view wx:else class="home-preview-cover-fallback"><text>✦</text></view>
    <view class="home-preview-capacity">{{item.capacityLabel}}</view>
  </view>
</view>
<view wx:elif="{{item && variant === 'discover'}}" class="activity-card activity-card--discover activity-card--{{item.typeTone}} {{largeText ? 'activity-card--large-text' : ''}}" bindtap="handleTap" hover-class="activity-card--pressed" hover-stay-time="80" role="button" aria-label="{{item.accessibilityLabel}}">
  <view class="card-cover card-cover--{{item.typeTone}}" aria-hidden="true">
    <image wx:if="{{coverSrc && !coverFailed}}" class="card-cover-image" src="{{coverSrc}}" data-src="{{coverSrc}}" mode="aspectFit" lazy-load="{{true}}" binderror="handleCoverError" />
    <view wx:else class="card-cover-fallback"><text class="cover-fallback-symbol">✦</text><text>{{item.typeLabel}}</text></view>
    <view class="card-cover-type"># {{item.typeLabel}}</view>
    <view class="card-cover-scrim"></view>
    <view class="card-cover-footer">
      <view class="member-avatar-group">
        <view wx:for="{{avatarSlots}}" wx:key="id" wx:for-item="slot" class="member-avatar-slot {{slot.empty ? 'member-avatar-slot--empty' : 'member-avatar-slot--filled'}}" style="z-index: {{slot.layer}}; animation-delay: {{slot.delay}}ms;">
          <image wx:if="{{!slot.empty}}" src="{{slot.src}}" mode="{{slot.mode}}" data-index="{{index}}" data-slot-id="{{slot.id}}" data-src="{{slot.src}}" lazy-load="{{true}}" binderror="handleAvatarError" />
          <text wx:else>+</text>
        </view>
        <text wx:if="{{item.hiddenMemberCount}}" class="member-avatar-more">+{{item.hiddenMemberCount}}</text>
      </view>
      <view class="cover-capacity"><text>{{item.capacityLabel}}</text><text>›</text></view>
    </view>
  </view>
  <view class="card-copy" aria-hidden="true">
    <view class="editorial-date-row">
      <view class="editorial-date-block"><text class="editorial-date">{{item.editorialDate}}</text><view class="editorial-date-meta"><text>{{item.editorialWeekday}}</text><text>{{item.editorialTime}}</text></view></view>
      <view class="editorial-status"><status-badge label="{{item.statusLabel}}" tone="{{item.statusTone}}" /></view>
    </view>
    <view class="activity-title"><text wx:if="{{item.legacy && item.legacy.readOnly}}" class="archive-prefix">历史 · </text>{{item.title}}</view>
    <view class="meta-item editorial-place"><text class="meta-icon">⌖</text><text class="meta-text meta-text--place">{{item.sceneLine}}</text><text wx:if="{{item.distanceLabel}}" class="distance-badge">{{item.distanceLabel}}</text></view>
    <view class="owner-line">
      <image wx:if="{{ownerAvatar && !ownerAvatar.empty}}" class="owner-avatar-image" src="{{ownerAvatar.src}}" mode="{{ownerAvatar.mode}}" data-slot-id="{{ownerAvatar.id}}" data-src="{{ownerAvatar.src}}" lazy-load="{{true}}" binderror="handleOwnerAvatarError" />
      <view wx:else class="owner-avatar">{{item.ownerInitial}}</view><text class="owner-name">{{item.ownerNickname}}</text><text class="owner-role">发起</text>
    </view>
    <view wx:if="{{item.displayDescription}}" class="activity-description"><text class="description-mark">“</text>{{item.displayDescription}}</view>
  </view>
</view>
<view wx:elif="{{item}}" class="activity-card activity-card--{{item.typeTone}}" bindtap="handleTap" hover-class="activity-card--pressed" hover-stay-time="80" role="button" aria-label="{{item.accessibilityLabel}}">
  <view class="card-head">
    <view class="card-tags">
      <view class="type-tag type-tag--{{item.typeTone}}"><text class="type-symbol" aria-hidden="true">{{item.typeIcon}}</text><text>{{item.typeLabel}}</text></view>
      <view wx:if="{{item.legacy && item.legacy.readOnly}}" class="legacy-tag">历史归档</view>
    </view>
    <status-badge label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
  </view>
  <view class="activity-title">{{item.title}}</view>
  <view class="meta-list">
    <view class="meta-item"><text class="meta-icon" aria-hidden="true">◷</text><text class="meta-text">{{item.displayTime}}</text></view>
    <view class="meta-item"><text class="meta-icon" aria-hidden="true">⌖</text><text class="meta-text">{{item.sceneLine}}</text></view>
  </view>
  <view class="member-progress" aria-hidden="true"><view class="member-progress-fill member-progress-fill--{{item.typeTone}}" style="width: {{item.progressPercent}}%;"></view></view>
  <view class="card-footer">
    <view class="owner-line"><view class="owner-avatar" aria-hidden="true">{{item.ownerInitial}}</view><text class="owner-name">{{item.ownerNickname}}</text></view>
    <view class="capacity-link"><text>{{item.capacityLabel}}</text><text class="capacity-arrow" aria-hidden="true">›</text></view>
  </view>
</view>
