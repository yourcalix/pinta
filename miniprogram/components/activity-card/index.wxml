<view
  wx:if="{{item}}"
  class="activity-card"
  bindtap="handleTap"
  role="button"
  aria-label="{{item.accessibilityLabel}}"
>
  <view class="route-heading">
    <text class="route-code">{{item.routeCode}}</text>
    <view class="route-line">
      <text>{{item.originLabel}}</text>
      <text class="route-arrow">→</text>
      <text>{{item.destinationLabel}}</text>
    </view>
    <text class="card-chevron" aria-hidden="true">›</text>
  </view>

  <view class="trip-meta">
    <view class="meta-item">
      <text class="meta-icon" aria-hidden="true">◷</text>
      <text>{{item.timeWindowLabel}}</text>
    </view>
    <view class="meta-item">
      <text class="meta-icon" aria-hidden="true">♙</text>
      <text>{{item.capacityLabel}}</text>
    </view>
  </view>

  <view class="card-badges">
    <status-badge label="{{item.statusLabel}}" tone="{{item.statusTone}}" />
    <status-badge wx:if="{{item.driverStatusLabel}}" label="{{item.driverStatusLabel}}" tone="{{item.driverStatusTone}}" />
  </view>

  <view class="card-visual-band" aria-hidden="true">
    <view class="passenger-avatars">
      <block wx:for="{{item.avatarSlots}}" wx:key="id" wx:for-item="slot">
        <image
          class="passenger-avatar {{slot.empty ? 'passenger-avatar--empty' : ''}}"
          src="{{slot.src}}"
          mode="aspectFit"
          aria-hidden="true"
        />
      </block>
    </view>

    <view class="route-voxel-scene">
      <image wx:if="{{item.originLocationId === 'QINGMAO'}}" class="route-node route-node--start" src="../../assets/images/discover/node-start-green.png" mode="aspectFit" aria-hidden="true" />
      <image wx:elif="{{item.originLocationId === 'HENGQIN'}}" class="route-node route-node--start" src="../../assets/images/discover/node-start-blue.png" mode="aspectFit" aria-hidden="true" />
      <image wx:elif="{{item.originLocationId === 'TAIPA_CAMPUS'}}" class="route-node route-node--start" src="../../assets/images/discover/node-end-taipa.png" mode="aspectFit" aria-hidden="true" />
      <image wx:else class="route-node route-node--start" src="../../assets/images/discover/node-end-golden-dragon.png" mode="aspectFit" aria-hidden="true" />

      <view class="route-dotted-line"></view>
      <image class="route-car" src="../../assets/images/discover/ride-car-green.png" mode="aspectFit" aria-hidden="true" />

      <image wx:if="{{item.destinationLocationId === 'QINGMAO'}}" class="route-node route-node--end" src="../../assets/images/discover/node-start-green.png" mode="aspectFit" aria-hidden="true" />
      <image wx:elif="{{item.destinationLocationId === 'HENGQIN'}}" class="route-node route-node--end" src="../../assets/images/discover/node-start-blue.png" mode="aspectFit" aria-hidden="true" />
      <image wx:elif="{{item.destinationLocationId === 'TAIPA_CAMPUS'}}" class="route-node route-node--end" src="../../assets/images/discover/node-end-taipa.png" mode="aspectFit" aria-hidden="true" />
      <image wx:else class="route-node route-node--end" src="../../assets/images/discover/node-end-golden-dragon.png" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>
</view>
