.privacy-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(20, 31, 26, 0.5);
}

.privacy-dialog {
  box-sizing: border-box;
  width: 100%;
  padding: 34rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  color: #1f2c25;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.privacy-description {
  margin-top: 16rpx;
  color: #59665f;
  font-size: 28rpx;
  line-height: 1.65;
}

.privacy-contract {
  min-height: 88rpx;
  margin: 12rpx 0 0;
  padding: 0;
  color: #167a54;
  background: transparent;
  font-size: 26rpx;
  line-height: 88rpx;
  text-align: left;
}

.privacy-contract::after,
.privacy-button::after {
  border: 0;
}

.privacy-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.privacy-button {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.privacy-button-secondary {
  color: #46534c;
  background: #eef2f0;
}

.privacy-button-primary {
  color: #fff;
  background: #16a36a;
}
