<view wx:if="{{visible}}" class="privacy-mask" catchtouchmove="preventTouchMove">
  <view class="privacy-dialog" aria-role="dialog" aria-label="剪贴板隐私说明">
    <view class="privacy-title">剪贴板隐私说明</view>
    <view class="privacy-description">为方便你一键复制发起者的联系方式，拼吧需要使用你的剪贴板。拒绝不会影响查看联系信息或使用其他功能。</view>
    <button class="privacy-contract" bindtap="handleOpenPrivacyContract">查看《拼吧小程序隐私保护指引》</button>
    <view class="privacy-actions">
      <button class="privacy-button privacy-button-secondary" bindtap="handleRejectPrivacyAuthorization">暂不同意</button>
      <button id="agree-btn" class="privacy-button privacy-button-primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">同意并继续</button>
    </view>
  </view>
</view>
